# ~/.config/mako/config

# Normal notifications
font=JetBrainsMono Nerd Font 10


# Colors
background-color=#303446
text-color=#c6d0f5
border-color=#8caaee
progress-color=over #414559

border-size=2
padding=10
margin=10
width=400
height=100
default-timeout=4000

[urgency=high]
border-color=#ef9f76
default-timeout=0

# --generated auto_dnd
[mode=auto_dnd]
invisible=1
# --end
