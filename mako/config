# ~/.config/mako/config

# Normal notifications
font=JetBrainsMono Nerd Font 10

# Colors (Monochrome)
background-color=#1a1a1a
text-color=#e0e0e0
border-color=#ffffff
progress-color=over #4d4d4d

border-size=2
padding=10
margin=10
width=400
height=100
default-timeout=4000

[urgency=high]
border-color=#999999
default-timeout=0

# --generated auto_dnd
[mode=auto_dnd]
invisible=1
# --end
