@@ -0,0 +1,35 @@
+import { FlexBox } from '@vulcan-ai/vulcan-ui/lib/components/Flex/FlexBox';
+import { Grid } from '@vulcan-ai/vulcan-ui/lib/components/Grid';
+import React from 'react';
+import { LoadingCircular } from 'src/app/components/LoadingCircular';
+import { ChartFragment } from 'src/apps/common/__generated__/types';
+import { AnalyticChartWidgetWrapper, AnalyticChartWidgetWrapperProps } from './AnalyticChartWidgetWrapper';
+
+interface Props {
+  chartsQuery: { loading: boolean; data?: { result: ChartFragment[] } | null };
+  widgetProps: Omit<AnalyticChartWidgetWrapperProps, 'chart'>;
+}
+
+export function AnalyticChartsGrid({ chartsQuery, widgetProps }: Props) {
+  if (chartsQuery.loading) {
+    return (
+      <Grid item xs={12}>
+        <FlexBox m={3} justifyContent="center" alignItems="center" height={widgetProps.height}>
+          <LoadingCircular />
+        </FlexBox>
+      </Grid>
+    );
+  }
+
+  return (
+    <>
+      {chartsQuery.data?.result.map((chart) => (
+        <Grid key={chart.id} item md={6} xs={12}>
+          <FlexBox p={3}>
+            <AnalyticChartWidgetWrapper {...widgetProps} chart={chart} />
+          </FlexBox>
+        </Grid>
+      ))}
+    </>
+  );
+}
