 import { DateRange } from '@vulcan-ai/frontend-shared/lib/src/commons/form/fields/DateRange/interfaces';
+import addDays from 'date-fns/addDays';
+import differenceInDays from 'date-fns/differenceInDays';
 import subMonths from 'date-fns/subMonths';
 
 /*
@@ -10,13 +12,17 @@ export function getDateRangeString(dateRange: DateRange) {
 
 const DEFAULT_ANALYTICS_DATA_RETENTION_MONTHS = 6;
 
+export function getAnalyticsDataRetentionMonths(analyticsDataRetentionMonths?: number): number {
+  return analyticsDataRetentionMonths ?? DEFAULT_ANALYTICS_DATA_RETENTION_MONTHS;
+}
+
 export function getMinimumAnalyticsDate(analyticsDataRetentionMonths?: number): Date {
   const now = new Date();
 
   // set to date 1 of the months, to make sure no missing date (e.g. feb only until 28/29)
   now.setDate(1);
 
-  const maximumMonths = (analyticsDataRetentionMonths ?? DEFAULT_ANALYTICS_DATA_RETENTION_MONTHS) - 1;
+  const maximumMonths = getAnalyticsDataRetentionMonths(analyticsDataRetentionMonths) - 1;
   return subMonths(now, maximumMonths);
 }
 
@@ -25,3 +31,40 @@ const MAXIMUM_ANALYTICS_DATE_RANGE = 31;
 export function getMaximumAnalyticsDateRange(maxDateRange?: number): number {
   return maxDateRange ?? MAXIMUM_ANALYTICS_DATE_RANGE;
 }
+
+export function getMaxEndDate(startDate: Date | string | null | undefined, maximumAnalyticsDateRange: number): Date {
+  const today = new Date();
+  if (!startDate) return today;
+
+  const calculatedMaxEndDate = addDays(new Date(startDate), maximumAnalyticsDateRange);
+  return calculatedMaxEndDate < today ? calculatedMaxEndDate : today;
+}
+
+export function getMinEndDate(startDate: Date | string | null | undefined): Date {
+  return startDate ? new Date(startDate) : new Date();
+}
+
+/*
+Returns adjusted end date when start/end date range violates constraints, or null if no adjustment needed.
+*/
+export function getAdjustedEndDate(
+  startDate: Date | string,
+  endDate: Date | string,
+  maximumAnalyticsDateRange: number,
+): Date | null {
+  const startDateObj = new Date(startDate);
+  const endDateObj = new Date(endDate);
+
+  if (startDateObj > endDateObj) {
+    return startDateObj;
+  }
+
+  const currentRangeDays = differenceInDays(endDateObj, startDateObj);
+  if (currentRangeDays > maximumAnalyticsDateRange) {
+    const adjustedEndDate = addDays(startDateObj, maximumAnalyticsDateRange);
+    const today = new Date();
+    return adjustedEndDate < today ? adjustedEndDate : today;
+  }
+
+  return null;
+}
