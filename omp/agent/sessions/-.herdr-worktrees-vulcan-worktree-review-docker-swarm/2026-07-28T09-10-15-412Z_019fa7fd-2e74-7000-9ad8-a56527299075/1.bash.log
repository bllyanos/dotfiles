Fscripts%2Fstart%2Fvalidate_docker_images.sh?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,45 +0,0 @@\n-#!/bin/bash\n-\n-set -e\n-\n-# Get DOCKER_TAG from command-line argument\n-DOCKER_TAG=\"${1:-}\"\n-\n-# Docker images to validate (from manifest.json start.docker_images)\n-DOCKER_IMAGES=(\n-  \"682361690817.dkr.ecr.us-east-1.amazonaws.com/apache/tika:3.2.5\"\n-  \"682361690817.dkr.ecr.us-east-1.amazonaws.com/erikvl87/languagetool:6.6-1\"\n-  \"682361690817.dkr.ecr.us-east-1.amazonaws.com/gotenberg/gotenberg:8.24.3\"\n-  \"682361690817.dkr.ecr.us-east-1.amazonaws.com/vulcan-ai/presidio-analyzer:v1.1.14\"\n-  \"682361690817.dkr.ecr.us-east-1.amazonaws.com/vulcan-ai/vulcan/audiowaveform-generator:\\${DOCKER_TAG}\"\n-  \"datasaur/backend-on-premise:\\${DOCKER_TAG}\"\n-  \"datasaur/frontend-on-premise:\\${DOCKER_TAG}\"\n-  \"datasaur/proxy-on-premise:\\${DOCKER_TAG}\"\n-  \"mariadb:10.6.19\"\n-  \"rabbitmq:3.13.7-management-alpine\"\n-  \"redis:7.2.9-alpine3.21\"\n-)\n-\n-# Resolve ${DOCKER_TAG} in image names\n-for i in \"${!DOCKER_IMAGES[@]}\"; do\n-  DOCKER_IMAGES[$i]=$(echo \"${DOCKER_IMAGES[$i]}\" | sed \"s/\\${DOCKER_TAG}/${DOCKER_TAG:-}/g\")\n-done\n-\n-# Validate each image\n-for image in \"${DOCKER_IMAGES[@]}\"; do\n-  echo -n \"  $image...\"\n-  if docker image inspect \"$image\" > /dev/null 2>&1; then\n-    echo \" ✓ found\"\n-  else\n-    echo \" ✗\"\n-    echo \"    Error: not found\"\n-    echo \"✗ Docker images validation failed: $image not found\"\n-    echo \"\"\n-    echo \"Next step:\"\n-    echo \"  ./datasaur-cli install\"\n-    exit 1\n-  fi\n-done\n-\n-echo \"✓ Docker images validation success\"\n-echo \"\""},{"sha":"74a43626f94ab72659894599923b029bcb947747","filename":"datasaur-cli/docker/nlp/build/scripts/stop/stop.sh","status":"removed","additions":0,"deletions":3,"changes":3,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbuild%2Fscripts%2Fstop%2Fstop.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbuild%2Fscripts%2Fstop%2Fstop.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdocker%2Fnlp%2Fbuild%2Fscripts%2Fstop%2Fstop.sh?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,3 +0,0 @@\n-#!/bin/bash\n-\n-docker compose --env-file datasaur.env down"},{"sha":"6ab2501b35210870fdeef5731365dd30a518c9cf","filename":"datasaur-cli/docker/nlp/docker-compose.build.yaml","status":"removed","additions":0,"deletions":29,"changes":29,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fdocker-compose.build.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fdocker-compose.build.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdocker%2Fnlp%2Fdocker-compose.build.yaml?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,29 +0,0 @@\n-services:\n-  backend-on-premise:\n-    build:\n-      context: ../..\n-      dockerfile: docker/nlp/backend.Dockerfile\n-      network: host\n-      args:\n-        CI_REGISTRY: $CI_REGISTRY\n-        DOCKER_TAG: $PULL_DOCKER_TAG\n-        EXPIRED_DATE: $EXPIRED_DATE\n-    image: datasaur/backend-on-premise:$DOCKER_TAG\n-\n-  frontend-on-premise:\n-    build:\n-      context: ../..\n-      dockerfile: docker/nlp/frontend.Dockerfile\n-      network: host\n-      args:\n-        CI_REGISTRY: $CI_REGISTRY\n-        DOCKER_TAG: $PULL_DOCKER_TAG\n-        EXPIRED_DATE: $EXPIRED_DATE\n-    image: datasaur/frontend-on-premise:$DOCKER_TAG\n-\n-  proxy-on-premise:\n-    build:\n-      context: ../../services/proxy\n-      args:\n-        - NGINX_CONF_FILENAME=nlp.conf\n-    image: datasaur/proxy-on-premise:$DOCKER_TAG"},{"sha":"8443d527cd3a29974005c40778c3316cd572976a","filename":"datasaur-cli/docker/nlp/frontend.Dockerfile","status":"removed","additions":0,"deletions":25,"changes":25,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Ffrontend.Dockerfile","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Ffrontend.Dockerfile","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdocker%2Fnlp%2Ffrontend.Dockerfile?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,25 +0,0 @@\n-ARG CI_REGISTRY\n-ARG DOCKER_TAG\n-FROM ${CI_REGISTRY}/vulcan-ai/vulcan/frontend:${DOCKER_TAG}\n-\n-ARG EXPIRED_DATE\n-\n-USER root\n-\n-RUN apk update && \\\n-  apk add --no-cache \\\n-    busybox-extras \\\n-    curl \\\n-    dcron \\\n-    libcap \\\n-    nano -f\n-\n-COPY services/frontend /usr/src/app/\n-RUN chown -R 111:111 /usr/src/app && \\\n-  chmod -R +w /usr/src/app\n-\n-RUN sed -i \"s/EXPIRED_DATE/${EXPIRED_DATE}/g\" /usr/src/app/entrypoint.sh\n-\n-USER 111:111\n-\n-ENTRYPOINT [\"/usr/src/app/entrypoint.sh\"]"},{"sha":"8fda58c5915d6de6c0875cd75d45573d41e5d2be","filename":"datasaur-cli/services/backend/app.on-prem.json","status":"removed","additions":0,"deletions":16,"changes":16,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fbackend%2Fapp.on-prem.json","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fbackend%2Fapp.on-prem.json","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fservices%2Fbackend%2Fapp.on-prem.json?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,16 +0,0 @@\n-{\n-  \"session\" : {\n-    \"secure\": false\n-  },\n-  \"notification\": {\n-    \"internalNotificationEmails\": []\n-  },\n-  \"textModule\": {\n-    \"maxTokensPerSentence\": 999999999\n-  },\n-  \"enableEmailVerification\": false,\n-  \"enableTeamCreationLimit\": false,\n-  \"mail\": {\n-    \"enable\": false\n-  }\n-}"},{"sha":"bc3442145650f9382825bd23a050e21528d996a8","filename":"datasaur-cli/services/backend/entrypoint.sh","status":"removed","additions":0,"deletions":45,"changes":45,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fbackend%2Fentrypoint.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fbackend%2Fentrypoint.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fservices%2Fbackend%2Fentrypoint.sh?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,45 +0,0 @@\n-#!/bin/bash\n-\n-set -e\n-\n-expiredDate=$(date -d EXPIRED_DATE +%s)\n-now=$(date +%s)\n-\n-if [[ $now -ge $expiredDate ]]; then\n-  echo Datasaur has expired! Please contact support@datasaur.ai. >&2\n-  exit 1\n-fi\n-\n-node ./scripts/retrieve-secrets.js > /usr/src/app/secrets.env\n-while IFS=\"=\" read -r key value; do\n-  case \"$key\" in\n-    '#'*) ;;\n-    *)\n-      declare $key=\"$value\"\n-      export $key > /dev/null\n-  esac\n-done < /usr/src/app/secrets.env\n-rm /usr/src/app/secrets.env\n-\n-node ./scripts/retrieve-environment-variables.js > /usr/src/app/configuration.env\n-while IFS=\"=\" read -r key value; do\n-  case \"$key\" in\n-    '#'*) ;;\n-    *)\n-      declare $key=\"$value\"\n-      export $key > /dev/null\n-  esac\n-done < /usr/src/app/configuration.env\n-rm /usr/src/app/configuration.env\n-\n-VERSION=$(node -p \"require('./package.json').version || ''\")\n-export FRONTEND_VERSION=\"$VERSION\"\n-export APP_VERSION=\"$VERSION\"\n-\n-if [[ \"$1\" == \"big\" ]]; then\n-  exec node --experimental-worker --max-old-space-size=8192 dist/main.js\n-elif [[ \"$1\" == \"xl\" ]]; then\n-  exec node --experimental-worker --max-old-space-size=16384 dist/main.js\n-else\n-  exec node --experimental-worker --max-old-space-size=4096 dist/main.js\n-fi"},{"sha":"5bf950ebab4eacaad7440034273e28055eed0722","filename":"datasaur-cli/services/frontend/entrypoint.sh","status":"removed","additions":0,"deletions":15,"changes":15,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Ffrontend%2Fentrypoint.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Ffrontend%2Fentrypoint.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fservices%2Ffrontend%2Fentrypoint.sh?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,15 +0,0 @@\n-#!/bin/bash\n-\n-set -e\n-\n-expiredDate=$(date -d EXPIRED_DATE +%s)\n-now=$(date +%s)\n-\n-if [ $now -ge $expiredDate ]; then\n-  echo Datasaur has expired! Please contact support@datasaur.ai. >&2\n-  exit 1\n-else\n-  node ./scripts/override-assets.js\n-\n-  node server.js\n-fi"},{"sha":"d0aa9ca628f7b3bdf6114e5956e93496d4d515c8","filename":"datasaur-cli/services/proxy/Dockerfile","status":"removed","additions":0,"deletions":4,"changes":4,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fproxy%2FDockerfile","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fproxy%2FDockerfile","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fservices%2Fproxy%2FDockerfile?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,4 +0,0 @@\n-FROM nginx:1.28\n-ARG NGINX_CONF_FILENAME\n-COPY $NGINX_CONF_FILENAME /etc/nginx/conf.d\n-COPY backend_upstream.conf /etc/nginx/conf.d"},{"sha":"d66ea00eaf1fb128e0840dad59574917168aeb4c","filename":"datasaur-cli/services/proxy/backend_upstream.conf","status":"removed","additions":0,"deletions":9,"changes":9,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fproxy%2Fbackend_upstream.conf","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fproxy%2Fbackend_upstream.conf","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fservices%2Fproxy%2Fbackend_upstream.conf?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,9 +0,0 @@\n-# upstream 1 backend instance(s) (up to 10)\n-# the reserved ports is 8080-8089\n-upstream backend-group {\n-    server backend:8080;\n-}\n-\n-upstream url-inspector-group {\n-    server url-inspector:8080;\n-}"},{"sha":"126c9530d69ad90d3c493b997804db3396e3eaa0","filename":"datasaur-cli/services/proxy/nlp.conf","status":"removed","additions":0,"deletions":78,"changes":78,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fproxy%2Fnlp.conf","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fservices%2Fproxy%2Fnlp.conf","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fservices%2Fproxy%2Fnlp.conf?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,78 +0,0 @@\n-# - main entry point for the whole app\n-# - the only publicly exposed service (+ CDN if static files are hosted in CDN)\n-# - as the proxy to the internal services\n-\n-# services:\n-# - backend : http://backend:8080\n-# - frontend: http://frontend:3080\n-\n-log_format latency '$remote_addr - $remote_user [$time_local] '\n-                           '\"$request\" $status $body_bytes_sent '\n-                           '\"$http_referer\" \"$http_user_agent\"'\n-                           '\"rt=$request_time\" '\n-                           '\"urt=$upstream_response_time\" '\n-                           '\"uct=$upstream_connect_time\" '\n-                           '\"uht=$upstream_header_time\"';\n-\n-server {\n-    listen                  443 ssl;\n-    ssl_certificate         /etc/nginx/conf.d/.ssl/app.crt;\n-    ssl_certificate_key     /etc/nginx/conf.d/.ssl/app.key;\n-    access_log  /var/log/nginx/access.log latency;\n-\n-    # pass to url inspector\n-    location ~ ^/api(/v1/audio|/url-inspector|/static/serve-private)(.*)$ {\n-        proxy_read_timeout 3000s;\n-        proxy_connect_timeout 600s;\n-        proxy_send_timeout 600s;\n-        send_timeout 600s;\n-        proxy_set_header Host $http_host;\n-        proxy_set_header X-Forwarded-Proto $scheme;\n-        proxy_set_header X-Real-IP $remote_addr;\n-        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n-\n-        client_max_body_size 1024M;\n-\n-        proxy_pass http://url-inspector-group;\n-    }\n-\n-    # pass to backend\n-    location ~ ^/(api|admin|graphql|auth|export|internal)(.*)$ {\n-        proxy_read_timeout 3000s;\n-        proxy_connect_timeout 600s;\n-        proxy_send_timeout 600s;\n-        send_timeout 600s;\n-        proxy_set_header Host $http_host;\n-        proxy_set_header X-Forwarded-Proto $scheme;\n-        proxy_set_header X-Real-IP $remote_addr;\n-        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n-\n-        client_max_body_size 1024M;\n-\n-        # commented instead of deleting this.\n-        # maybe useful later, to increase proxy buffer size if response data from backend is too big from default configuration\n-        # proxy_buffer_size 16k;\n-        # proxy_buffers 4 16k;\n-        # proxy_busy_buffers_size 16k;\n-\n-        proxy_pass http://backend-group;\n-    }\n-\n-    # CSR files that is required to be under the same domain, requested under different domain.\n-    # Pass to the CSR server (or to its CDN).\n-    location /manifest.json {\n-        add_header 'Access-Control-Allow-Origin' '*';\n-        proxy_pass http://frontend:3080/manifest.json;\n-    }\n-    location /static/ {\n-        add_header 'Access-Control-Allow-Origin' '*';\n-        proxy_pass http://frontend:3080/static/;\n-    }\n-\n-    # For SSR, all incoming request should go there\n-    # CSR will\n-    location / {\n-        add_header 'Access-Control-Allow-Origin' '*';\n-        proxy_pass http://frontend:3080;\n-    }\n-}"},{"sha":"5c1e027f120e8f2216a7c344b0a7254233903cc9","filename":"docs/superpowers/specs/2026-07-17-docker-swarm-proxy-registry-stacks-design.md","status":"added","additions":1516,"deletions":0,"changes":1516,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/docs%2Fsuperpowers%2Fspecs%2F2026-07-17-docker-swarm-proxy-registry-stacks-design.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/docs%2Fsuperpowers%2Fspecs%2F2026-07-17-docker-swarm-proxy-registry-stacks-design.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/docs%2Fsuperpowers%2Fspecs%2F2026-07-17-docker-swarm-proxy-registry-stacks-design.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e"},{"sha":"7c1b1a30c997dcc6b5d0d1ffb7d5c77652bb3c48","filename":"docs/superpowers/specs/2026-07-21-datasaur-cli-architecture-design.md","status":"added","additions":146,"deletions":0,"changes":146,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/docs%2Fsuperpowers%2Fspecs%2F2026-07-21-datasaur-cli-architecture-design.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/docs%2Fsuperpowers%2Fspecs%2F2026-07-21-datasaur-cli-architecture-design.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/docs%2Fsuperpowers%2Fspecs%2F2026-07-21-datasaur-cli-architecture-design.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,146 @@\n+# Datasaur CLI Architecture\n+\n+Consolidates four prior specs (uv migration, test coverage, logging system,\n+version refactor) into one current-state reference. All four are fully\n+implemented; this document describes the resulting architecture and, per\n+section, why it looks this way.\n+\n+## Overview\n+\n+`on-premise/datasaur-cli/` is a click-based CLI (`src/main.py` /\n+`src/command/cli.py`) for managing Datasaur on-premise installations. It's\n+packaged with uv (non-installable, `package = false`), built into a\n+standalone binary via PyInstaller (`build.sh`), and has full pytest coverage\n+across `src/`.\n+\n+## Tooling: uv\n+\n+- `pyproject.toml` holds `[project]` metadata and the 8 runtime deps (click,\n+  jsonschema, packaging, pydantic, pyinstaller, python-dotenv, PyYAML,\n+  requests); `[tool.uv] package = false` since nothing imports this as an\n+  installable package — PyInstaller runs directly against `src/main.py`.\n+- `uv.lock` is committed for reproducible installs.\n+- `.python-version` pins `3.14.4`, read natively by uv.\n+- Day to day: `uv sync` to install, `uv run python -m src.main <cmd>` to run,\n+  `./build.sh` to produce the PyInstaller binary (internally uses\n+  `uv sync` / `uv run pyinstaller`).\n+\n+**Why:** replaced a pyenv + pip/requirements.txt setup. `setup.py` was dead\n+code (imported a package path that didn't exist, nothing invoked it) and was\n+deleted rather than fixed, since nothing needs `datasaur-cli` to be pip-\n+installable.\n+\n+## Testing\n+\n+- pytest, one `test_<module>.py` per `src/**/*.py` file (excluding\n+  `__init__.py`/`constants.py`), mirroring the src path under `tests/`.\n+- `unittest.mock.patch`/`MagicMock` for subprocess, requests, and any\n+  filesystem-mutating call unsafe/slow to run for real.\n+- `tmp_path`/`monkeypatch` for real file I/O where the module's whole job\n+  *is* file I/O (yaml_file, env_file, manifest_file_reader, validators).\n+- No conftest.py, no shared fixtures module, no pytest-cov/pytest-mock — not\n+  needed at this scope.\n+- Current state: 570 tests passing, one test file per src file.\n+\n+**Why:** started at 8 tested files out of 48. Built out in six batches,\n+easy → hard (common/ simple → common/ complex → option/prompt/entrypoints →\n+action leaves → run_workflow subsystem → click_commands_service.py), each a\n+green-suite commit before the next, so later batches could reuse patterns\n+from earlier ones. No coverage-percentage gate was introduced — the target\n+was \"every file has tests,\" not a numeric threshold.\n+\n+## Logging\n+\n+- `src/common/logger.py` — level-gated facade (`error`/`warn`/`info`/\n+  `debug`/`trace`) that wraps `click.echo(click.style(...))`. Root `cli`\n+  group has a repeatable `-v` flag: none = INFO (today's console output,\n+  unchanged), `-v` = DEBUG (+ resolved args, per-action duration), `-vv` =\n+  TRACE (+ raw subprocess/docker command lines). `error`/`warn` always print\n+  regardless of level.\n+- `src/common/event_log.py` — `record(...)` writes one structured JSON line\n+  per action execution to `./datasaur-cli.log` (fields: `ts`, `command`,\n+  `action_number`, `action`, `args`, `duration_ms`, `outcome`, `error`),\n+  always, independent of `-v`. Called from `ActionsService.run()`, which\n+  wraps each action's `validate()` + `run()` — one record per action,\n+  regardless of what the action itself logs.\n+- Redaction: `Action.sensitive_args() -> List[str]` (default `[]`, opt-in\n+  per action) combined with the existing `redact_if_sensitive(key, value)`\n+  heuristic in `src/common/helper.py` — an arg is redacted to `\"***\"` if\n+  either flags it.\n+- Ordering convention: when an action logs a subprocess's raw `stdout` (an\n+  `Output: ...` line) alongside its own `✓`/`✗` verdict on that subprocess,\n+  the raw output logs **first**, the verdict line **after** — the evidence\n+  before the judgment, not the reverse.\n+- Exception handling: `ActionsService.run()` catches uncaught exceptions,\n+  writes an `outcome: \"error\"` event with full traceback in the log file,\n+  prints one clean `logger.error(...)` line to the console (no raw\n+  traceback at the terminal), and returns `False` — the same contract\n+  callers already relied on.\n+\n+**Why:** every action/command/validator called `click.echo` directly (387\n+call sites) with no verbosity control and no structured record — an\n+uncaught exception just crashed with a raw traceback. Modeled on\n+[loggingsucks.com](https://loggingsucks.com/)'s \"wide events\" idea: one rich\n+structured record per unit of work, rather than scattered log lines. No log\n+rotation, no configurable log path, no command-level (whole-invocation)\n+event, and no named `--log-level` were introduced — deliberately out of\n+scope at this size.\n+\n+**Follow-up fix (2026-07-22): Output-before-verdict ordering.** Seven\n+actions (`docker-stack-deploy`, `docker-stack-rm`, `docker-swarm-leave`,\n+`docker-swarm-join`, `docker-compose-up`, `docker-compose-stop-services`,\n+`docker-compose-down`) logged their `✓`/`✗` verdict line *before* the\n+subprocess's own `Output: ...` line, reading backwards — the tool announcing\n+a result before showing the output that justified it. Fixed by swapping the\n+two `logger` calls in each action, on every branch that logs both (success\n+and, where present, failure), to match the ordering convention stated above.\n+No behavior change beyond console line order; no test previously asserted\n+on this text, so new tests were added (one assertion per branch, per file)\n+checking `Output:` appears before the verdict line in captured stdout.\n+\n+**Follow-up fix (2026-07-22): strip the Output line's trailing newline.**\n+The reordering above surfaced a second, previously-invisible bug: `result.\n+stdout` already ends with its own newline, and interpolating it raw into\n+`f\"  Output: {result.stdout}\"` plus `click.echo`'s own trailing newline left\n+a blank line wedged between the output and the following verdict line —\n+invisible before the reorder, since the blank line used to land right before\n+the action's own trailing blank-line separator instead of in the middle.\n+Fixed with `.rstrip()` at all 10 call sites across the same 7 actions. Each\n+file's ordering test above gained a second assertion (`\"\\n\\n✓\"`/`\"\\n\\n✗\" not\n+in out`) guarding against the blank line reappearing.\n+\n+## Versioning\n+\n+- `build.sh`: if `--version` is passed, uses it; otherwise reads `.version`\n+  from `vulcan-backend/package.json` (via `uv run python -c \"import json;\n+  ...\"`, relative path `../../vulcan-backend/package.json`). No silent\n+  fallback — a missing/unparseable package.json with no `--version` exits 1.\n+- Before invoking `pyinstaller`, `build.sh` generates `src/_version.py`\n+  (`__version__ = \"<VERSION>\"`), gitignored, bundled into the binary by\n+  PyInstaller like any other module.\n+- `src/__init__.py` imports `__version__` from `src._version`, falling back\n+  to `\"0.0.0-dev\"` when that file doesn't exist (dev/test runs where\n+  `build.sh` hasn't generated it).\n+- `src/command/cli.py` has `@click.version_option(version=__version__,\n+  prog_name=\"datasaur-cli\")` on the `cli` group, so the built binary\n+  supports `datasaur-cli --version` / `-V`.\n+\n+**Why:** `build.sh --version` used to default to a hardcoded, stale\n+`\"1.0.0\"` in `src/__init__.py`, disconnected from `pyproject.toml`'s own\n+inert `version = \"1.0.0\"` field, and there was no way to check a built\n+binary's version at all. `vulcan-backend/package.json` is now the single\n+source of truth for the default. `pyproject.toml`'s `version` field stays\n+untouched — it's inert (`package = false`, never read by any code path).\n+\n+## Verification\n+\n+- `uv sync && uv run pytest -q` — full suite green (570 passed as of this\n+  writing).\n+- `uv run python -m src.main hello -n john` — sanity-check a command runs\n+  and produces the expected console output at default verbosity, `-v`, and\n+  `-vv`.\n+- `cat datasaur-cli.log` after a command run — confirms one JSONL record\n+  per action, secrets redacted.\n+- `./build.sh` (no `--version`) — binary's `--version` output matches\n+  `vulcan-backend/package.json`'s version.\n+- `./build.sh --version 9.9.9` — binary's `--version` output is `9.9.9`."},{"sha":"45a55267b6d67208b335bc19f2434cff67f116e5","filename":"on-premise/datasaur-cli/.gitignore","status":"renamed","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2F.gitignore","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2F.gitignore","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2F.gitignore?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -27,6 +27,7 @@ datasaur-cli.spec\n venv/\n env/\n ENV/\n+.venv/\n \n # IDE\n .vscode/\n@@ -38,3 +39,12 @@ ENV/\n .pytest_cache/\n .coverage\n htmlcov/\n+\n+# Generated files\n+/*.env\n+state.yaml\n+src/_version.py\n+/datasaur-cli.log\n+\n+# Config files\n+examples/gl-chat-setup/config.yaml\n\\ No newline at end of file","previous_filename":"datasaur-cli/datasaur-cli/.gitignore"},{"sha":"0104088a93f37ef69b3acfee50577590324a0769","filename":"on-premise/datasaur-cli/.python-version","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2F.python-version","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2F.python-version","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2F.python-version?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1 @@\n+3.14.4"},{"sha":"cf5968dde8b2a21f3e305b560c811de8bf1e2f69","filename":"on-premise/datasaur-cli/README.md","status":"added","additions":92,"deletions":0,"changes":92,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2FREADME.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2FREADME.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2FREADME.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,92 @@\n+# Datasaur CLI\n+\n+CLI tool for managing Datasaur on-premise installation. This tool simplifies the installation, upgrade, and uninstallation of your Datasaur application packaged as Docker containers.\n+\n+## Features\n+\n+- 🚀 Simple installation process\n+- 🔄 Easy upgrades with data preservation\n+- 🗑️ Clean uninstallation\n+- 📊 Status checking and health monitoring\n+- 🐳 Docker-based deployment management\n+\n+## Installation\n+\n+### Prerequisites\n+\n+- [uv](https://docs.astral.sh/uv/getting-started/installation/) >= 0.9\n+- [Docker](https://docs.docker.com/engine/install/) >= 28.5.2\n+- [Docker Compose](https://docs.docker.com/engine/install/) >= 2.40.3\n+\n+### Setup\n+\n+uv manages both the Python version (pinned in `.python-version`) and dependencies (declared in `pyproject.toml`). From this directory, run:\n+\n+```\n+uv sync\n+```\n+\n+This creates a `.venv` with Python 3.14.4 and installs all dependencies. Re-run `uv sync` any time `pyproject.toml` changes.\n+\n+## Development\n+\n+### Project Structure\n+\n+```\n+cli/\n+├── src/\n+│   ├── __init__.py      # Package initialization and version\n+│   └── main.py          # Main entry point\n+├── pyproject.toml       # Project metadata and dependencies\n+├── uv.lock              # Locked dependency versions\n+└── README.md            # This file\n+```\n+\n+### Running the CLI\n+\n+You can run the CLI directly:\n+\n+```bash\n+uv run python -m src.main\n+uv run python -m src.main hello\n+uv run python -m src.main hello -n john\n+uv run python -m src.main hello -n john --age 17\n+```\n+\n+## Building Standalone Executable\n+\n+### Requirements\n+\n+- Python 3.14.4+ (for building only)\n+- uv (installs PyInstaller and all build dependencies automatically via `uv sync`)\n+\n+### Build\n+\n+To create a standalone executable that customers can run without Python installation:\n+\n+```bash\n+./build.sh\n+```\n+\n+This will create an executable file in `dist/datasaur-cli`\n+\n+### Basic Commands\n+\n+```bash\n+./datasaur-cli\n+./datasaur-cli hello\n+./datasaur-cli hello -n john\n+./datasaur-cli hello -n john --age 17\n+```\n+\n+### Workflow\n+\n+Here's the real world workflow:\n+\n+```bash\n+./datasaur-cli install\n+./datasaur-cli configure\n+./datasaur-cli start\n+./datasaur-cli stop\n+./datasaur-cli upgrade\n+```"},{"sha":"72033defe3efcee2fe0a551aeed1afff3ddf2e25","filename":"on-premise/datasaur-cli/build.sh","status":"renamed","additions":32,"deletions":7,"changes":39,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fbuild.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fbuild.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fbuild.sh?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -5,14 +5,15 @@\n \n set -e\n \n-VERSION=$(python3 -c \"from datasaur_cli import __version__; print(__version__)\" 2>/dev/null || echo \"0.1.0\")\n+VERSION=\"\"\n OUTPUT_NAME=\"datasaur-cli\"\n+PACKAGE_JSON=\"../../vulcan-backend/package.json\"\n \n usage() {\n   echo \"Usage: $0 [options]\"\n   echo \"\"\n   echo \"Options:\"\n-  echo \"  --version <version>    Set version (default: from __init__.py)\"\n+  echo \"  --version <version>    Set version (default: vulcan-backend/package.json's version)\"\n   echo \"  --output <name>        Output filename (default: datasaur-cli)\"\n   echo \"  --help                 Show this help\"\n   echo \"\"\n@@ -22,30 +23,54 @@ usage() {\n }\n \n check_dependencies() {\n-  if ! command -v pyinstaller &> /dev/null; then\n-    echo \"PyInstaller not found. Installing...\"\n-    pip install pyinstaller\n+  echo \"Syncing dependencies with uv...\"\n+  uv sync\n+}\n+\n+resolve_version() {\n+  if [[ -n \"$VERSION\" ]]; then\n+    return\n+  fi\n+\n+  if [[ ! -f \"$PACKAGE_JSON\" ]]; then\n+    echo \"Error: --version not given and $PACKAGE_JSON not found\" >&2\n+    exit 1\n+  fi\n+\n+  VERSION=$(uv run python -c \"import json; print(json.load(open('$PACKAGE_JSON'))['version'])\" 2>/dev/null)\n+  if [[ -z \"$VERSION\" ]]; then\n+    echo \"Error: --version not given and could not read version from $PACKAGE_JSON\" >&2\n+    exit 1\n   fi\n }\n \n+write_version_file() {\n+  echo \"__version__ = \\\"${VERSION}\\\"\" > src/_version.py\n+}\n+\n main() {\n+  resolve_version\n+\n   echo \"Building standalone executable for datasaur-cli...\"\n   echo \"Version: ${VERSION}\"\n \n   check_dependencies\n \n+  trap 'rm -f src/_version.py' EXIT\n+  write_version_file\n+\n   # Clean previous builds\n   rm -rf build/ dist/ *.spec\n \n   # Build standalone executable\n   echo \"Creating standalone executable...\"\n-  pyinstaller \\\n+  uv run pyinstaller \\\n     --name=\"${OUTPUT_NAME}\" \\\n     --onefile \\\n     --console \\\n     --clean \\\n     --noconfirm \\\n-    datasaur_cli/cli.py\n+    src/main.py\n \n   file_path=\"dist/${OUTPUT_NAME}\"\n   if [[ ! -f \"$file_path\" ]]; then","previous_filename":"datasaur-cli/datasaur-cli/build.sh"},{"sha":"a2bad79c4ec76c910fb0f6c98ef6b60d1cd02dba","filename":"on-premise/datasaur-cli/docs/manifest.md","status":"added","additions":1938,"deletions":0,"changes":1938,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fdocs%2Fmanifest.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fdocs%2Fmanifest.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fdocs%2Fmanifest.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,1938 @@\n+# `manifest.yaml` Reference\n+\n+`manifest.yaml` is the single source of truth for the `datasaur-cli` tool. It drives everything — environment checks, Docker image loading, interactive configuration menus, service start/stop — without requiring any Python changes. Understanding this file is the primary skill needed to configure, extend, or adapt the CLI for a new deployment.\n+\n+---\n+\n+## Table of Contents\n+\n+1. [How the CLI reads the manifest](#1-how-the-cli-reads-the-manifest)\n+2. [Top-level structure](#2-top-level-structure)\n+3. [`version`](#3-version)\n+4. [`operating_systems`](#4-operating_systems)\n+5. [`software_requirements`](#5-software_requirements)\n+6. [`services`](#6-services)\n+7. [`commands`](#7-commands)\n+   - [Action object](#71-action-object)\n+   - [`options` — CLI flags](#72-options--cli-flags)\n+   - [`prompts` — interactive prompts](#73-prompts--interactive-prompts)\n+   - [`args` and template interpolation](#74-args-and-template-interpolation)\n+   - [GL Chat commands](#75-gl-chat-commands)\n+     - [Phase overview](#751-phase-overview)\n+     - [`gl-chat-setup` — full wizard](#752-gl-chat-setup--full-wizard)\n+     - [`gl-chat-llmlabs` — Phase 1 only](#753-gl-chat-llmlabs--phase-1-only)\n+     - [`gl-chat-configure` — Phase 2 only](#754-gl-chat-configure--phase-2-only)\n+     - [Individual Phase 1 steps](#755-individual-phase-1-steps)\n+     - [Individual Phase 2 steps](#756-individual-phase-2-steps)\n+     - [Config file (`--config`)](#757-config-file---config)\n+8. [Built-in actions reference](#8-built-in-actions-reference)\n+   - [`hello-world`](#81-hello-world)\n+   - [`load-docker-images`](#82-load-docker-images)\n+   - [`run-workflow`](#83-run-workflow)\n+     - [`switch-input` (built-in)](#831-switch-input)\n+     - [`set-environment-variables` (built-in)](#832-set-environment-variables)\n+   - [`create-docker-resources`](#84-create-docker-resources)\n+   - [`validate-files`](#85-validate-files)\n+   - [`script-runner`](#86-script-runner)\n+   - [`docker-compose-up`](#87-docker-compose-up)\n+   - [`docker-compose-down`](#88-docker-compose-down)\n+   - **LLM Labs actions**\n+     - [`llmlabs-setup`](#89-llmlabs-setup)\n+     - [`llmlabs-create-kb`](#810-llmlabs-create-kb)\n+     - [`llmlabs-create-app`](#811-llmlabs-create-app)\n+     - [`llmlabs-create-rag-config`](#812-llmlabs-create-rag-config)\n+     - [`llmlabs-deploy`](#813-llmlabs-deploy)\n+     - [`llmlabs-create-api-key`](#814-llmlabs-create-api-key)\n+   - **GL Chat actions**\n+     - [`glchat-configure`](#815-glchat-configure)\n+     - [`glchat-create-env`](#816-glchat-create-env)\n+     - [`glchat-create-provider`](#817-glchat-create-provider)\n+     - [`glchat-create-model`](#818-glchat-create-model)\n+     - [`glchat-create-preset`](#819-glchat-create-preset)\n+     - [`glchat-create-app`](#820-glchat-create-app)\n+9. [Version constraint syntax](#9-version-constraint-syntax)\n+10. [State persistence (`state.yaml`)](#10-state-persistence-stateyaml)\n+11. [How to add a new command](#11-how-to-add-a-new-command)\n+12. [How to add a new action](#12-how-to-add-a-new-action)\n+13. [`command_modules` — Extending the CLI with external modules](#13-command_modules--extending-the-cli-with-external-modules)\n+14. [Full annotated example](#14-full-annotated-example)\n+\n+---\n+\n+## 1. How the CLI reads the manifest\n+\n+At startup, before any user command is executed, `datasaur-cli` always runs through this fixed sequence (see `src/main.py`):\n+\n+```\n+manifest.yaml\n+  │\n+  ▼ yaml.safe_load()\n+  dict\n+  │\n+  ├── operating_systems      →  check /etc/os-release\n+  ├── software_requirements  →  run docker/docker-compose --version\n+  ├── services               →  registered for use by load-docker-images at runtime\n+  └── commands               →  dynamically build Click subcommands and register them\n+```\n+\n+**Key rules:**\n+\n+- The manifest is parsed with `yaml.safe_load()` — standard YAML, no custom tags.\n+- `version` is the only field validated by schema (via Pydantic). All other keys are consumed at runtime by their respective consumers.\n+- If any startup check fails (bad OS, missing software, unknown `action` name), the CLI exits before registering any commands.\n+- The manifest file **must** live at the working directory root and be named `manifest.yaml`.\n+\n+---\n+\n+## 2. Top-level structure\n+\n+```yaml\n+version: \"...\"                  # required\n+command_modules:                # optional; list of external module directories\n+  - examples/gl-chat-setup\n+operating_systems:              # optional\n+  ubuntu: \">=20.04\"\n+  rhel: \">=9\"\n+software_requirements:          # optional\n+  docker: \">=28.5.2\"\n+  docker-compose: \">=2.40.3\"\n+services:                       # optional; used by load-docker-images\n+  - name: ...\n+    image: ...\n+    file_path: ...\n+commands:                       # optional; each key becomes a CLI subcommand\n+  <command-name>:\n+    - action: ...\n+```\n+\n+`command_modules` is how you extend the CLI with external feature packages — see [section 13](#13-command_modules--extending-the-cli-with-external-modules) for full details.\n+\n+---\n+\n+## 3. `version`\n+\n+```yaml\n+version: \"6.144.0\"\n+```\n+\n+- **Type**: string\n+- **Required**: yes\n+- **Purpose**: Displayed at startup as `✓ Manifest version: 6.144.0`. Has no other runtime effect.\n+- The value may contain a shell-style variable placeholder (e.g., `${DOCKER_TAG}`) if the manifest is pre-processed by a shell or CI pipeline before the CLI runs. The CLI itself does **not** perform shell variable substitution on this field.\n+\n+---\n+\n+## 4. `operating_systems`\n+\n+```yaml\n+operating_systems:\n+  ubuntu: \">=20.04\"\n+  rhel: \">=9\"\n+```\n+\n+- **Type**: mapping\n+- **Supported keys**: `ubuntu`, `rhel`\n+- **Value**: a version constraint string (see [section 9](#9-version-constraint-syntax))\n+- **Validation logic** (`src/common/operating_systems_validator.py`):\n+  - Reads `/etc/os-release` and extracts `VERSION_ID`.\n+  - Checks if the running OS matches **at least one** of the listed keys (OR logic).\n+  - Non-Linux systems fail the check.\n+- Omitting this key entirely skips OS validation.\n+\n+---\n+\n+## 5. `software_requirements`\n+\n+```yaml\n+software_requirements:\n+  docker: \">=28.5.2\"\n+  docker-compose: \">=2.40.3\"\n+```\n+\n+- **Type**: mapping\n+- **Supported keys**: `docker`, `docker-compose`\n+- **Value**: a version constraint string\n+- **Validation logic** (`src/common/software_requirements_validator.py`):\n+  - `docker`: runs `docker version -f {{.Server.Version}}` and checks the result.\n+  - `docker-compose`: runs `docker compose version --short` and checks the result.\n+  - **Both** must pass (AND logic). A missing or incorrect version for either will abort the CLI.\n+- Omitting this key entirely skips software validation.\n+\n+---\n+\n+## 6. `services`\n+\n+```yaml\n+services:\n+  - name: backend\n+    image: vulcan-ai/vulcan/backend:6.144.0\n+    file_path: ./images/vulcan-ai-vulcan-backend-6.144.0.tar.gz\n+  - name: frontend\n+    image: vulcan-ai/vulcan/frontend:6.144.0\n+    file_path: ./images/vulcan-ai-vulcan-frontend-6.144.0.tar.gz\n+```\n+\n+- **Type**: list of service objects\n+- **Consumed by**: the [`load-docker-images`](#82-load-docker-images) action (re-reads `manifest.yaml` at action runtime)\n+\n+Each service object:\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `name` | string | yes | Logical name; used in log output |\n+| `image` | string | yes | Docker image tag to assign after loading |\n+| `file_path` | string | yes | Path to the `.tar.gz` image archive, relative to the manifest |\n+\n+The `load-docker-images` action also checks for a `.sha256` sidecar file next to the `.tar.gz`. If present, it verifies the archive's SHA-256 checksum before loading.\n+\n+---\n+\n+## 7. `commands`\n+\n+Each key under `commands` becomes a `datasaur-cli` subcommand. The value is a **list** of action objects that run in order when the command is invoked.\n+\n+```yaml\n+commands:\n+  install:\n+    - action: load-docker-images\n+  start:\n+    - action: create-docker-resources\n+      args:\n+        networks:\n+          - datasaur\n+    - action: docker-compose-up\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+```\n+\n+Running `datasaur-cli install` executes `load-docker-images`. Running `datasaur-cli start` executes `create-docker-resources` then `docker-compose-up` in sequence. If any action fails, subsequent actions in the same command are skipped.\n+\n+### 7.1 Action object\n+\n+Every item in a command list is an **action object**:\n+\n+```yaml\n+- action: <action-name>       # required\n+  options:                    # optional — declares CLI flags\n+    ...\n+  prompts:                    # optional — declares interactive prompts\n+    ...\n+  args:                       # optional — data passed to the action\n+    ...\n+```\n+\n+All actions in a command share their declared `options` and `prompts`. Duplicates are resolved by keeping the first declaration (order in the list matters).\n+\n+### 7.2 `options` — CLI flags\n+\n+`options` declares named CLI flags for the command. They appear as `--flag` arguments to the subcommand.\n+\n+```yaml\n+options:\n+  name:\n+    required: true\n+    short: n        # -n shorthand\n+    type: string\n+  age:\n+    short: a\n+    type: integer\n+```\n+\n+| Field | Type | Default | Description |\n+|---|---|---|---|\n+| `required` | boolean | `false` | Whether the flag must be provided |\n+| `short` | single char | none | Single-letter shorthand (e.g. `n` → `-n`) |\n+| `long` | string | key name | Long flag name (defaults to the key, e.g. `--name`) |\n+| `type` | string | `string` | One of `string`, `integer`, `number`, `array` |\n+\n+`type` values map to Python/Click types:\n+\n+| Manifest type | Click/Python type | Notes |\n+|---|---|---|\n+| `string` | `str` | Default |\n+| `integer` | `int` | |\n+| `number` | `float` | |\n+| `array` | variadic | Consumes all remaining positional arguments (`nargs=-1`) |\n+\n+Options declared here are merged with any built-in options contributed by the action itself (e.g., `run-workflow` contributes `--action`). Manifest declarations win on name conflicts.\n+\n+### 7.3 `prompts` — interactive prompts\n+\n+`prompts` at the command level declares prompts shown to the user **before any action in the command runs**:\n+\n+```yaml\n+prompts:\n+  install_dir:\n+    text: \"Installation directory\"\n+    default: /usr/local/\n+    hide_input: false\n+```\n+\n+| Field | Type | Default | Description |\n+|---|---|---|---|\n+| `text` | string | key name | The question displayed to the user |\n+| `default` | any | none | Pre-filled default value |\n+| `hide_input` | boolean | `false` | Masks input (use for passwords) |\n+| `default_from_state` | string | none | State key whose value pre-fills the prompt; if the key exists in `state.yaml`, it overrides `default`. Used by GL Chat / LLM Labs commands to carry IDs forward across steps. |\n+\n+> **Note**: This is different from the `prompts` field inside `set-environment-variables` flow actions, which has a richer schema. See [section 8.3.2](#832-set-environment-variables).\n+\n+### 7.4 `args` and template interpolation\n+\n+`args` is a free-form mapping passed to the action after interpolation. Values may contain **template placeholders**:\n+\n+```yaml\n+args:\n+  name: \"{options[name]}\"\n+  install_dir: \"{prompts[install_dir]}\"\n+  biodata: \"{options[name]} - {options[age]}\"\n+```\n+\n+**Interpolation rules** (implemented in `src/action/actions_service.py` using Python's `str.format()`):\n+\n+| Syntax | Resolves to |\n+|---|---|\n+| `{options[key]}` | The CLI flag value for `key` |\n+| `{prompts[key]}` | The interactive prompt value for `key` |\n+| `\"{options[name]} - {options[age]}\"` | Compound: both values concatenated |\n+\n+Additional rules:\n+\n+- **Recursion**: interpolation is applied to all strings in nested dicts and lists, so deep structures are fully resolved.\n+- **Missing key**: if the key does not exist in `options` or `prompts`, the field resolves to `None`.\n+- **`\"None\"` string**: if a resolved string equals the literal `\"None\"`, it is also converted to `None`.\n+- **Non-string values** (integers, booleans, lists): passed through unchanged — no interpolation is applied.\n+\n+---\n+\n+### 7.5 GL Chat commands\n+\n+This section documents every `datasaur-cli` command related to GL Chat and LLM Labs setup. The commands are split into two phases and can be run as a single combined wizard or step-by-step.\n+\n+#### 7.5.1 Phase overview\n+\n+```\n+Phase 1 — LLM Labs (Datasaur API)\n+  Creates the RAG backend: vector store → LLM application → RAG config → deployment → API key.\n+\n+Phase 2 — GL Chat (GL Chat Admin API)\n+  Wires the RAG backend into GL Chat: env var → provider → model → RAGO preset → chatbot app.\n+```\n+\n+**Command decision tree:**\n+\n+```\n+Do you need to set up both phases from scratch?\n+  └─ YES → datasaur-cli gl-chat-setup          (combined wizard, all prompts upfront)\n+\n+Do you only need Phase 1 (LLM Labs)?\n+  └─ YES → datasaur-cli gl-chat-llmlabs        (Phase 1 wizard)\n+         or run the individual steps in order:\n+              datasaur-cli gl-chat-create-kb\n+              datasaur-cli gl-chat-create-rag-config\n+              datasaur-cli gl-chat-deploy\n+              datasaur-cli gl-chat-create-api-key\n+\n+Do you only need Phase 2 (GL Chat), e.g. LLM Labs is already deployed?\n+  └─ YES → datasaur-cli gl-chat-configure      (Phase 2 wizard, reads Phase 1 outputs from state)\n+         or run the individual steps in order:\n+              datasaur-cli gl-chat-create-env\n+              datasaur-cli gl-chat-create-provider\n+              datasaur-cli gl-chat-create-model\n+              datasaur-cli gl-chat-create-preset\n+              datasaur-cli gl-chat-create-app\n+```\n+\n+Each command writes its outputs to `state.yaml`. Subsequent commands pre-fill connection prompts from state — press **Enter** to confirm, or type a new value to override.\n+\n+---\n+\n+#### 7.5.2 `gl-chat-setup` — full wizard\n+\n+Runs Phase 1 (LLM Labs) immediately followed by Phase 2 (GL Chat) in one command. All prompts are collected before any API call is made.\n+\n+**Underlying actions:** `llmlabs-setup` → `glchat-configure`\n+\n+**Prompts collected (Phase 1):**\n+\n+| Prompt | Description |\n+|---|---|\n+| Datasaur API URL | e.g. `https://app.datasaur.ai` |\n+| Team ID | |\n+| Client ID | OAuth2 client ID |\n+| Client Secret | OAuth2 client secret *(masked)* |\n+| Knowledge Base name | |\n+| Vector Store Provider | `DATASAUR` or `EXTERNAL` |\n+| Embedding Model ID | Required when provider is `DATASAUR`; leave blank otherwise |\n+| Collection ID | Required when provider is `EXTERNAL`; leave blank otherwise |\n+| Application name | |\n+| RAG Config name | default: `default` |\n+| LLM Model ID | |\n+| Deployment name | default: `deployment` |\n+| API Key name | Display name for the created team API key |\n+\n+**Prompts collected (Phase 2):**\n+\n+| Prompt | Description |\n+|---|---|\n+| GL Chat Admin URL | e.g. `http://localhost:8000` |\n+| Admin username | |\n+| Admin password | *(masked)* |\n+| Env var name for API key | e.g. `LLMLABS_API_KEY` |\n+| Provider internal name | No spaces, e.g. `llmlabs-rag` |\n+| Provider display name | |\n+| Model internal name | No spaces |\n+| Model display name | |\n+| Model description | Leave blank to use display name |\n+| Enable citations? | `true` or `false`; default `true` |\n+| Chatbot ID | Unique slug, e.g. `llmlabs-rag-app` |\n+| GL Chat application name | |\n+| Description | |\n+\n+> `deployment_url` and `llmlabs_api_key` are NOT prompted in Phase 2 — they flow automatically from Phase 1 via state.\n+\n+**Example:**\n+\n+```bash\n+datasaur-cli gl-chat-setup\n+```\n+\n+---\n+\n+#### 7.5.3 `gl-chat-llmlabs` — Phase 1 only\n+\n+Runs all five LLM Labs steps in one command (knowledge base → app → RAG config → deployment → API key). Use this when GL Chat is already configured or when you want to run Phase 2 separately later.\n+\n+**Underlying action:** `llmlabs-setup`\n+\n+**Prompts collected:** Same as the Phase 1 prompts listed in `gl-chat-setup` above.\n+\n+**Example:**\n+\n+```bash\n+datasaur-cli gl-chat-llmlabs\n+# Then later:\n+datasaur-cli gl-chat-configure\n+```\n+\n+---\n+\n+#### 7.5.4 `gl-chat-configure` — Phase 2 only\n+\n+Runs all five GL Chat steps in one command. Expects `deployment_url` and `llmlabs_api_key` to be present in `state.yaml` (written by a prior `gl-chat-llmlabs` run) or prompts for them explicitly.\n+\n+**Underlying action:** `glchat-configure`\n+\n+**Prompts collected:**\n+\n+| Prompt | `default_from_state` key | Description |\n+|---|---|---|\n+| GL Chat Admin URL | `glchat_url` | |\n+| Admin username | — | |\n+| Admin password | — | *(masked)* |\n+| LLM Labs deployment URL | `deployment_url` | Pre-filled from state if Phase 1 was run |\n+| LLM Labs API key | `llmlabs_api_key` | Pre-filled from state if Phase 1 was run *(masked)* |\n+| Env var name for API key | `glchat_key_name` | e.g. `LLMLABS_API_KEY` |\n+| Provider internal name | — | |\n+| Provider display name | — | |\n+| Model internal name | — | |\n+| Model display name | — | |\n+| Model description | — | |\n+| Enable citations? | — | default `true` |\n+| Chatbot ID | — | |\n+| GL Chat application name | — | |\n+| Description | — | |\n+\n+**Example:**\n+\n+```bash\n+# After gl-chat-llmlabs has already run:\n+datasaur-cli gl-chat-configure\n+```\n+\n+---\n+\n+#### 7.5.5 Individual Phase 1 steps\n+\n+Run these in order when you need to re-run or debug a specific LLM Labs step. Each step writes its output to `state.yaml`; subsequent steps read from state to pre-fill their prompts.\n+\n+| Order | Command | Action | State keys written |\n+|---|---|---|---|\n+| 1 | `datasaur-cli gl-chat-create-kb` | `llmlabs-create-kb` | `vector_store_id`, `api_url`, `team_id` |\n+| 2 | `datasaur-cli gl-chat-create-rag-config` | `llmlabs-create-rag-config` | `rag_config_id` |\n+| 3 | `datasaur-cli gl-chat-deploy` | `llmlabs-deploy` | `deployment_url` |\n+| 4 | `datasaur-cli gl-chat-create-api-key` | `llmlabs-create-api-key` | `llmlabs_api_key` |\n+\n+> **Note:** The `gl-chat-create-app` command name is reused in Phase 2 (step 2.5) for the GL Chat application. Because YAML does not allow duplicate keys, the Phase 2 definition wins — `datasaur-cli gl-chat-create-app` runs `glchat-create-app`, not `llmlabs-create-app`. To create the LLM Application, use `datasaur-cli gl-chat-llmlabs` or `gl-chat-setup`.\n+\n+**Prompts with `default_from_state`** on each step command (pre-filled from state if available):\n+\n+- `gl-chat-create-kb` — no pre-fills (first step)\n+- `gl-chat-create-rag-config` — `api_url`, `client_id`, `client_secret`, `llm_application_id`, `vector_store_id`\n+- `gl-chat-deploy` — `api_url`, `client_id`, `client_secret`, `llm_application_id`, `rag_config_id`\n+- `gl-chat-create-api-key` — `api_url`, `team_id`, `client_id`, `client_secret`\n+\n+---\n+\n+#### 7.5.6 Individual Phase 2 steps\n+\n+Run these in order when you need to re-run or debug a specific GL Chat step.\n+\n+| Order | Command | Action | State keys written |\n+|---|---|---|---|\n+| 1 | `datasaur-cli gl-chat-create-env` | `glchat-create-env` | `glchat_key_name`, `glchat_url` |\n+| 2 | `datasaur-cli gl-chat-create-provider` | `glchat-create-provider` | `glchat_provider_id` |\n+| 3 | `datasaur-cli gl-chat-create-model` | `glchat-create-model` | `glchat_model_id` |\n+| 4 | `datasaur-cli gl-chat-create-preset` | `glchat-create-preset` | `glchat_preset_id`, `glchat_pipeline_id` |\n+| 5 | `datasaur-cli gl-chat-create-app` | `glchat-create-app` | *(none)* |\n+\n+**Prompts with `default_from_state`** on each step command (pre-filled from state if available):\n+\n+- `gl-chat-create-env` — `glchat_url`, `glchat_key_name`, `llmlabs_api_key`\n+- `gl-chat-create-provider` — `glchat_url`, `glchat_key_name`\n+- `gl-chat-create-model` — `glchat_url`, `deployment_url`, `glchat_provider_id`, `glchat_key_name`\n+- `gl-chat-create-preset` — `glchat_url`, `glchat_model_id`\n+- `gl-chat-create-app` — `glchat_url`, `glchat_preset_id`\n+\n+---\n+\n+#### 7.5.7 Config file (`--config`)\n+\n+Every `datasaur-cli` command automatically accepts a `--config` flag:\n+\n+```bash\n+datasaur-cli gl-chat-setup --config configs/gl-chat-setup.yaml\n+```\n+\n+The config file is a plain YAML file. **Each key must match a prompt name exactly.** When a key is present, its value is used directly and the interactive prompt is skipped — the value is echoed to the terminal but not re-asked. This enables fully non-interactive / automated runs.\n+\n+**Precedence:** config file values take priority over `default_from_state` and over `default`.\n+\n+**Template:** `configs/gl-chat-setup.yaml.example` contains a ready-to-copy template for `gl-chat-setup`:\n+\n+```yaml\n+# Config for: datasaur-cli gl-chat-setup\n+# Usage: datasaur-cli gl-chat-setup --config configs/gl-chat-setup.yaml\n+\n+# ── Phase 1: LLM Labs ────────────────────────────────────────────────────────\n+api_url: https://app.datasaur.ai\n+team_id: \"1\"\n+client_id: your-client-id\n+client_secret: your-client-secret\n+\n+kb_name: My Knowledge Base\n+kb_provider: DATASAUR            # DATASAUR or EXTERNAL\n+embedding_model_id: \"\"           # Leave blank if kb_provider is EXTERNAL\n+collection_id: \"\"                # Leave blank if kb_provider is DATASAUR\n+\n+app_name: My LLM Application\n+rag_config_name: default\n+model_id: your-model-id\n+deployment_name: deployment\n+llmlabs_key_name: LLM LABS API KEY\n+\n+# ── Phase 2: GL Chat ─────────────────────────────────────────────────────────\n+glchat_url: http://localhost:8000\n+username: admin\n+password: your-admin-password\n+\n+glchat_key_name: LLMLABS_API_KEY\n+\n+provider_name: llmlabs-rag\n+provider_display_name: LLM Labs RAG\n+\n+model_name: llmlabs-rag-model\n+model_display_name: LLM Labs RAG Model\n+model_description: \"\"\n+citations: \"true\"\n+\n+chatbot_id: llmlabs-rag-app\n+glchat_app_name: My RAG App\n+app_description: \"\"\n+```\n+\n+The same `--config` flag works on any command. For individual step commands, only include the keys for the prompts that command asks. For example, a config file for `gl-chat-create-kb` only needs `api_url`, `team_id`, `client_id`, `client_secret`, `kb_name`, `kb_provider`, `embedding_model_id`, and `collection_id`.\n+\n+> **Security note:** Config files may contain credentials (`client_secret`, `password`, `llmlabs_api_key`). Do not commit them to version control. The `.yaml.example` file contains only placeholder values and is safe to commit.\n+\n+---\n+\n+## 8. Built-in actions reference\n+\n+### 8.1 `hello-world`\n+\n+A debug/demo action. Prints the resolved context and args. No side effects.\n+\n+```yaml\n+- action: hello-world\n+  options:\n+    name:\n+      required: true\n+      short: n\n+      type: string\n+    age:\n+      short: a\n+      type: integer\n+  prompts:\n+    install_dir:\n+      text: \"Installation directory\"\n+      default: /usr/local/\n+  args:\n+    name: \"{options[name]}\"\n+    age: \"{options[age]}\"\n+    install_dir: \"{prompts[install_dir]}\"\n+    files:\n+      - file_path: install.sh\n+      - file_path: run.sh\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `name` | string | yes | Printed in output |\n+| `age` | string | no | Printed in output |\n+| `files` | list | yes | Each entry: `{ file_path: string }` |\n+\n+---\n+\n+### 8.2 `load-docker-images`\n+\n+Loads Docker images from `.tar.gz` archives listed under [`services`](#6-services). Takes no `args` — it reads `services` directly from `manifest.yaml` at runtime.\n+\n+```yaml\n+- action: load-docker-images\n+```\n+\n+**Behavior:**\n+\n+1. Validates that each archive file exists, is readable, and has correct permissions (0644 or 0664).\n+2. If a `.sha256` sidecar file exists alongside the archive, verifies the checksum before loading.\n+3. If `pigz` is available on `PATH`, loads using `pigz -dc {file_path} | docker load` (parallel decompression). Otherwise uses `docker load -i {file_path}`.\n+\n+No `options`, `prompts`, or `args` are needed.\n+\n+---\n+\n+### 8.3 `run-workflow`\n+\n+Runs an interactive, branching workflow. It acts as a state machine where each node is a **flow action** (defined in `args.actions`) and the entry points are defined in `args.workflow`.\n+\n+```yaml\n+- action: run-workflow\n+  args:\n+    workflow:\n+      - vector-db\n+    actions:\n+      - name: main-menu\n+        action: switch-input\n+        title: \"Select which service to configure:\"\n+        cases:\n+          - name: Database\n+            action: database-menu\n+          - name: \"Vector Database\"\n+            action: vector-db\n+      - name: vector-db\n+        action: set-environment-variables\n+        title: \"Vector DB\"\n+        prompts:\n+          OPENSEARCH_USERNAME:\n+            text: \"OpenSearch Username\"\n+            generate: true\n+            generate_length: 8\n+            required: true\n+        targets:\n+          - file_path: vector-db.env\n+            values:\n+              OPENSEARCH_USERNAME: \"prompts[OPENSEARCH_USERNAME]\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `workflow` | list of strings | yes | Ordered list of flow action `name` values to run as entry points |\n+| `actions` | list of flow action objects | yes | All flow action definitions (the full state machine) |\n+\n+Each flow action object:\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `name` | string | yes | Unique identifier; referenced in `workflow` and `cases[].action` |\n+| `action` | string | yes | Built-in action: `switch-input` or `set-environment-variables` |\n+| `title` | string | yes | Displayed to the user before the action runs |\n+| *(additional fields)* | — | — | Depends on the `action` value — see below |\n+\n+**Built-in CLI option contributed by `run-workflow`:**\n+\n+| Flag | Short | Description |\n+|---|---|---|\n+| `--action` | `-a` | Skip the `workflow` entry points and jump directly to a named flow action |\n+\n+Example: `datasaur-cli configure -a vector-db` skips the main menu and goes straight to the `vector-db` flow action.\n+\n+**Execution flow:**\n+\n+1. The `workflow` list is iterated in order; each named flow action runs.\n+2. A `switch-input` flow action returns a `GOTO <name>` result, which causes `run-workflow` to execute the named flow action next.\n+3. If the user selects \"Exit\" in a `switch-input`, the workflow terminates.\n+4. An **infinite loop guard** tracks visited flow action names. If any name is visited twice, the CLI aborts with an error.\n+\n+#### 8.3.1 `switch-input`\n+\n+Displays a numbered menu and routes execution to another flow action based on user selection.\n+\n+```yaml\n+- name: main-menu\n+  action: switch-input\n+  title: \"Select which service you want to configure:\"\n+  cases:\n+    - name: Database\n+      action: database-menu\n+    - name: \"Vector Database\"\n+      action: vector-db\n+```\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `title` | string | yes | Menu header text |\n+| `cases` | list | yes | Menu items; each has `name` (display text) and `action` (flow action name to GOTO) |\n+\n+An \"Exit\" option is always appended automatically as the last item.\n+\n+#### 8.3.2 `set-environment-variables`\n+\n+Collects values from the user via prompts and writes them to `.env` files.\n+\n+```yaml\n+- name: database.managed-service\n+  action: set-environment-variables\n+  title: \"Database Managed Service\"\n+  prompts:\n+    DATABASE_HOST:\n+      text: \"Database Host\"\n+      required: true\n+    DATABASE_PASSWORD:\n+      text: \"Database Password\"\n+      generate: true\n+      generate_length: 16\n+      min_length: 8\n+      required: true\n+  targets:\n+    - file_path: datasaur.env\n+      values:\n+        DATABASE_HOST: \"prompts[DATABASE_HOST]\"\n+        DATABASE_PASSWORD: \"prompts[DATABASE_PASSWORD]\"\n+        DATABASE_PORT: \"3306\"           # literal value\n+```\n+\n+**`prompts` schema** (inside `set-environment-variables`):\n+\n+Each key is the environment variable name referenced in `targets`. The value is a prompt definition:\n+\n+| Field | Type | Default | Description |\n+|---|---|---|---|\n+| `text` | string | key name | Displayed prompt question |\n+| `description` | string | none | Appended to `text` as `\"text (description)\"` |\n+| `default` | string | none | Static default value |\n+| `generate` | boolean | `false` | Auto-generate a random alphanumeric default |\n+| `generate_length` | integer | `16` | Length of the auto-generated string |\n+| `required` | boolean | `false` | If `false` and no default/generate, the prompt is silently skipped with an empty value |\n+| `min_length` | integer | none | Minimum accepted length; user is re-prompted if too short |\n+| `max_length` | integer | none | Maximum accepted length |\n+| `allowed_characters` | string | none | Comma-separated list: `alphabet`, `digit`, `special` |\n+| `hide_input` | boolean | `false` | Masks input (for passwords) |\n+\n+**`targets` schema:**\n+\n+Each target writes collected values to a `.env` file:\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `file_path` | string | yes | Path to the `.env` file (created if it does not exist) |\n+| `values` | mapping | yes | Maps env var key → value expression |\n+\n+Value expressions in `targets[*].values`:\n+\n+| Expression | Result |\n+|---|---|\n+| `\"prompts[KEY]\"` | Replaced with the user-entered value for the prompt named `KEY` |\n+| `\"localhost\"` | Written verbatim as a literal string |\n+\n+**State persistence**: Previously entered values are saved to `state.yaml` and pre-filled as defaults on subsequent runs. See [section 10](#10-state-persistence-stateyaml).\n+\n+---\n+\n+### 8.4 `create-docker-resources`\n+\n+Creates Docker networks and volumes if they do not already exist (idempotent).\n+\n+```yaml\n+- action: create-docker-resources\n+  args:\n+    networks:\n+      - datasaur\n+    volumes:\n+      - vulcan_db_data\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `networks` | list of strings | no | Docker network names to create (`docker network create`) |\n+| `volumes` | list of strings | no | Docker volume names to create (`docker volume create`) |\n+\n+If a resource already exists, a warning is printed and execution continues.\n+\n+---\n+\n+### 8.5 `validate-files`\n+\n+Validates that files and directories exist with the expected permissions and ownership.\n+\n+```yaml\n+- action: validate-files\n+  args:\n+    files:\n+      - path: folder1/file1\n+        permissions: 0644\n+        owner: \"$(id -u):$(id -g)\"\n+      - path: folder/*\n+        permissions: 0644\n+        owner: \"$(id -u):$(id -g)\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `files` | list | yes | List of file/directory validation entries |\n+\n+Each entry:\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `path` | string | yes | Path to validate; supports `*` and `?` glob wildcards |\n+| `permissions` | string | no | Expected octal permissions, e.g. `\"0644\"`, `\"0755\"` |\n+| `owner` | string | no | Expected owner as `\"UID:GID\"` or `\"user:group\"`; `$(id -u):$(id -g)` resolves to the current user |\n+\n+**Glob and precedence rules:**\n+\n+- Wildcard paths (e.g. `folder/*`) are expanded using `glob.glob()`.\n+- If a specific (non-wildcard) entry exists for a path, it takes precedence over any wildcard that also matches — the wildcard validation is not applied to that path.\n+\n+---\n+\n+### 8.6 `script-runner`\n+\n+Runs one or more shell scripts with arguments.\n+\n+```yaml\n+- action: script-runner\n+  options:\n+    name:\n+      required: true\n+      short: n\n+      type: string\n+  prompts:\n+    install_dir:\n+      text: \"Installation directory\"\n+      default: /usr/local/\n+  args:\n+    scripts:\n+      - name: migrate\n+        file_path: ./migrate.sh\n+        args:\n+          - --name\n+          - \"{options[name]}\"\n+          - --install_dir\n+          - \"{prompts[install_dir]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `scripts` | list | yes | List of scripts to run in order |\n+\n+Each script entry:\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `name` | string | yes | Logical name for log output |\n+| `file_path` | string | yes | Path to the script file |\n+| `args` | list of strings | no | Arguments passed to the script; support template interpolation |\n+\n+**Execution details:**\n+\n+- If the script file is not executable, it is run with `bash` or `sh` (whichever is found on `PATH`).\n+- The script must exit with code `0`; any non-zero exit aborts the command.\n+- Template interpolation (`{options[...]}`, `{prompts[...]}`) is supported in the `args` list.\n+\n+---\n+\n+### 8.7 `docker-compose-up`\n+\n+Starts Docker Compose services in detached mode.\n+\n+```yaml\n+- action: docker-compose-up\n+  args:\n+    docker_compose_file: docker-compose.yaml\n+    env_files:\n+      - datasaur.env\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `env_files` | list of strings | yes | `.env` files passed via `--env-file` |\n+| `docker_compose_file` | string | no | Compose file passed via `-f`; uses Docker default if omitted |\n+\n+Runs: `docker compose [--env-file f]... [-f compose_file] up -d`\n+\n+All files are validated for existence before execution.\n+\n+---\n+\n+### 8.8 `docker-compose-down`\n+\n+Stops Docker Compose services.\n+\n+```yaml\n+- action: docker-compose-down\n+  args:\n+    docker_compose_file: docker-compose.yaml\n+    env_files:\n+      - datasaur.env\n+```\n+\n+**`args` schema:** Identical to [`docker-compose-up`](#87-docker-compose-up).\n+\n+Runs: `docker compose [--env-file f]... [-f compose_file] down`\n+\n+---\n+\n+### 8.9 `llmlabs-setup`\n+\n+An **orchestrator** that runs all five LLM Labs setup steps in sequence:\n+1. Create Knowledge Base (`llmlabs-create-kb`)\n+2. Create LLM Application (`llmlabs-create-app`)\n+3. Create RAG Config (`llmlabs-create-rag-config`)\n+4. Deploy Application (`llmlabs-deploy`)\n+5. Create API Key (`llmlabs-create-api-key`)\n+\n+State is threaded between steps automatically — the KB ID written in step 1 is read by step 3, etc. Used by the `gl-chat-llmlabs` and `gl-chat-setup` commands.\n+\n+```yaml\n+- action: llmlabs-setup\n+  args:\n+    api_url: \"{prompts[api_url]}\"\n+    client_id: \"{prompts[client_id]}\"\n+    client_secret: \"{prompts[client_secret]}\"\n+    team_id: \"{prompts[team_id]}\"\n+    kb_name: \"{prompts[kb_name]}\"\n+    kb_provider: \"{prompts[kb_provider]}\"\n+    embedding_model_id: \"{prompts[embedding_model_id]}\"\n+    collection_id: \"{prompts[collection_id]}\"\n+    app_name: \"{prompts[app_name]}\"\n+    rag_config_name: \"{prompts[rag_config_name]}\"\n+    model_id: \"{prompts[model_id]}\"\n+    deployment_name: \"{prompts[deployment_name]}\"\n+    llmlabs_key_name: \"{prompts[llmlabs_key_name]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `api_url` | string | yes | Datasaur API base URL (e.g. `https://app.datasaur.ai`) |\n+| `client_id` | string | yes | OAuth2 client ID |\n+| `client_secret` | string | yes | OAuth2 client secret |\n+| `team_id` | string | yes | Datasaur team ID |\n+| `kb_name` | string | yes | Name for the knowledge base (vector store) |\n+| `kb_provider` | string | yes | Vector store provider: `DATASAUR` or `EXTERNAL` |\n+| `embedding_model_id` | string | no | Embedding model ID (for `DATASAUR` provider) |\n+| `collection_id` | string | no | External collection ID (for `EXTERNAL` provider) |\n+| `app_name` | string | yes | Name for the LLM Application |\n+| `rag_config_name` | string | yes | Name for the RAG config (default: `\"default\"`) |\n+| `model_id` | string | yes | LLM model ID to attach to the RAG config |\n+| `deployment_name` | string | yes | Name for the deployment (default: `\"deployment\"`) |\n+| `llmlabs_key_name` | string | yes | Display name for the API key to create |\n+\n+**State keys written:** `vector_store_id`, `api_url`, `team_id`, `llm_application_id`, `rag_config_id`, `deployment_url`, `llmlabs_api_key`\n+\n+---\n+\n+### 8.10 `llmlabs-create-kb`\n+\n+Creates a LLM Vector Store (Knowledge Base). Authenticates via OAuth2 (`POST /api/oauth/token`), then calls the `createLlmVectorStore` GraphQL mutation.\n+\n+```yaml\n+- action: llmlabs-create-kb\n+  args:\n+    api_url: \"{prompts[api_url]}\"\n+    client_id: \"{prompts[client_id]}\"\n+    client_secret: \"{prompts[client_secret]}\"\n+    team_id: \"{prompts[team_id]}\"\n+    kb_name: \"{prompts[kb_name]}\"\n+    kb_provider: \"{prompts[kb_provider]}\"\n+    embedding_model_id: \"{prompts[embedding_model_id]}\"\n+    collection_id: \"{prompts[collection_id]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `api_url` | string | yes | Datasaur API base URL |\n+| `client_id` | string | yes | OAuth2 client ID |\n+| `client_secret` | string | yes | OAuth2 client secret |\n+| `team_id` | string | yes | Datasaur team ID |\n+| `kb_name` | string | yes | Name for the knowledge base |\n+| `kb_provider` | string | yes | `DATASAUR` or `EXTERNAL` |\n+| `embedding_model_id` | string | no | Embedding model ID (for `DATASAUR` provider) |\n+| `collection_id` | string | no | External collection ID (for `EXTERNAL` provider) |\n+\n+**State keys written:** `vector_store_id`, `api_url`, `team_id`\n+\n+---\n+\n+### 8.11 `llmlabs-create-app`\n+\n+Creates an LLM Application. Calls `createLlmApplication` to get an auto-generated ID, then `updateLlmApplication` to set the display name.\n+\n+```yaml\n+- action: llmlabs-create-app\n+  args:\n+    api_url: \"{prompts[api_url]}\"\n+    client_id: \"{prompts[client_id]}\"\n+    client_secret: \"{prompts[client_secret]}\"\n+    team_id: \"{prompts[team_id]}\"\n+    app_name: \"{prompts[app_name]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `api_url` | string | yes | Datasaur API base URL |\n+| `client_id` | string | yes | OAuth2 client ID |\n+| `client_secret` | string | yes | OAuth2 client secret |\n+| `team_id` | string | yes | Datasaur team ID |\n+| `app_name` | string | yes | Display name for the application |\n+\n+**State keys written:** `llm_application_id`\n+\n+> **Note**: The manifest key `gl-chat-create-app` also appears in Phase 2 (step 2.5) mapping to the `glchat-create-app` action. Because YAML does not allow duplicate keys, the second definition wins — the `gl-chat-create-app` command runs `glchat-create-app`, not `llmlabs-create-app`. Run `gl-chat-create-kb` through `gl-chat-create-api-key` individually to exercise each LLM Labs step.\n+\n+---\n+\n+### 8.12 `llmlabs-create-rag-config`\n+\n+Creates a RAG Config for an LLM Application and attaches an LLM model and vector store. Calls `createLlmApplicationPlaygroundRagConfig` then `updateLlmApplicationPlaygroundRagConfig`.\n+\n+```yaml\n+- action: llmlabs-create-rag-config\n+  args:\n+    api_url: \"{prompts[api_url]}\"\n+    client_id: \"{prompts[client_id]}\"\n+    client_secret: \"{prompts[client_secret]}\"\n+    llm_application_id: \"{prompts[llm_application_id]}\"\n+    rag_config_name: \"{prompts[rag_config_name]}\"\n+    model_id: \"{prompts[model_id]}\"\n+    vector_store_id: \"{prompts[vector_store_id]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `api_url` | string | yes | Datasaur API base URL |\n+| `client_id` | string | yes | OAuth2 client ID |\n+| `client_secret` | string | yes | OAuth2 client secret |\n+| `llm_application_id` | string | yes | ID of the target LLM Application |\n+| `rag_config_name` | string | yes | Name for the RAG config |\n+| `model_id` | string | yes | LLM model ID to attach |\n+| `vector_store_id` | string | yes | Vector store ID to attach |\n+\n+**State keys written:** `rag_config_id`\n+\n+---\n+\n+### 8.13 `llmlabs-deploy`\n+\n+Deploys an LLM Application via `upsertLlmApplicationDeployment`. Saves the deployment URL as `{api_url}/api/deployment/{teamId}/{deploymentId}`.\n+\n+```yaml\n+- action: llmlabs-deploy\n+  args:\n+    api_url: \"{prompts[api_url]}\"\n+    client_id: \"{prompts[client_id]}\"\n+    client_secret: \"{prompts[client_secret]}\"\n+    llm_application_id: \"{prompts[llm_application_id]}\"\n+    rag_config_id: \"{prompts[rag_config_id]}\"\n+    deployment_name: \"{prompts[deployment_name]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `api_url` | string | yes | Datasaur API base URL |\n+| `client_id` | string | yes | OAuth2 client ID |\n+| `client_secret` | string | yes | OAuth2 client secret |\n+| `llm_application_id` | string | yes | LLM Application ID |\n+| `rag_config_id` | string | yes | RAG Config ID (written by `llmlabs-create-rag-config`) |\n+| `deployment_name` | string | yes | Display name for the deployment |\n+\n+**State keys written:** `deployment_url`\n+\n+---\n+\n+### 8.14 `llmlabs-create-api-key`\n+\n+Creates a team API key via `createTeamApiKey`. The key value is saved to state so the downstream `glchat-configure` action can use it without re-prompting.\n+\n+```yaml\n+- action: llmlabs-create-api-key\n+  args:\n+    api_url: \"{prompts[api_url]}\"\n+    client_id: \"{prompts[client_id]}\"\n+    client_secret: \"{prompts[client_secret]}\"\n+    team_id: \"{prompts[team_id]}\"\n+    llmlabs_key_name: \"{prompts[llmlabs_key_name]}\"\n+```\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `api_url` | string | yes | Datasaur API base URL |\n+| `client_id` | string | yes | OAuth2 client ID |\n+| `client_secret` | string | yes | OAuth2 client secret |\n+| `team_id` | string | yes | Datasaur team ID |\n+| `llmlabs_key_name` | string | yes | Display name for the API key |\n+\n+**State keys written:** `llmlabs_api_key`\n+\n+---\n+\n+### 8.15 `glchat-configure`\n+\n+An **orchestrator** that runs all five GL Chat setup steps in sequence:\n+1. Create env var (`glchat-create-env`) — stores the LLM Labs API key\n+2. Create provider (`glchat-create-provider`)\n+3. Create model (`glchat-create-model`) — prompts for a prompt template group selection\n+4. Create RAGO preset (`glchat-create-preset`) — prompts for pipeline selection\n+5. Create GL Chat application (`glchat-create-app`) — prompts for KB and pipeline selection\n+\n+`deployment_url` and `llmlabs_api_key` are resolved from explicit args first, then from `state.yaml` — so when this action follows `llmlabs-setup` (as in `gl-chat-setup`), no re-prompting is needed.\n+\n+Used by the `gl-chat-setup` and `gl-chat-configure` commands.\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `glchat_url` | string | yes | GL Chat admin base URL (e.g. `http://localhost:8000`) |\n+| `username` | string | yes | Admin username |\n+| `password` | string | yes | Admin password |\n+| `glchat_key_name` | string | yes | Env var name for the LLM Labs API key (e.g. `LLMLABS_API_KEY`) |\n+| `provider_name` | string | yes | Internal provider name (no spaces, e.g. `llmlabs-rag`) |\n+| `provider_display_name` | string | yes | Human-readable provider name |\n+| `model_name` | string | yes | Internal model name (no spaces) |\n+| `model_display_name` | string | yes | Human-readable model name |\n+| `model_description` | string | no | Model description; defaults to `model_display_name` |\n+| `citations` | string | no | Enable citations: `\"true\"` or `\"false\"` (default `\"true\"`) |\n+| `chatbot_id` | string | yes | Unique chatbot slug (e.g. `llmlabs-rag-app`) |\n+| `glchat_app_name` | string | yes | Display name for the GL Chat application |\n+| `app_description` | string | no | Application description (default `\"\"`) |\n+| `deployment_url` | string | no* | LLM Labs deployment URL (\\*required if not in state) |\n+| `llmlabs_api_key` | string | no* | LLM Labs API key (\\*required if not in state) |\n+\n+**State keys read:** `deployment_url`, `llmlabs_api_key`\n+\n+**State keys written:** `glchat_key_name`, `glchat_url`, `glchat_provider_id`, `glchat_model_id`, `glchat_preset_id`, `glchat_pipeline_id`\n+\n+---\n+\n+### 8.16 `glchat-create-env`\n+\n+Stores an LLM Labs API key as a named environment variable in GL Chat via `POST /admin/envs`.\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `glchat_url` | string | yes | GL Chat admin base URL |\n+| `username` | string | yes | Admin username |\n+| `password` | string | yes | Admin password |\n+| `glchat_key_name` | string | yes | Name of the env var to create |\n+| `llmlabs_api_key` | string | yes | API key value to store |\n+\n+**State keys written:** `glchat_key_name`, `glchat_url`\n+\n+---\n+\n+### 8.17 `glchat-create-provider`\n+\n+Creates a provider record in GL Chat via `POST /admin/providers`. The provider uses `lm_invoker_type: datasaur` and references the env var holding the LLM Labs credentials.\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `glchat_url` | string | yes | GL Chat admin base URL |\n+| `username` | string | yes | Admin username |\n+| `password` | string | yes | Admin password |\n+| `provider_name` | string | yes | Internal provider name (no spaces) |\n+| `provider_display_name` | string | yes | Human-readable provider name |\n+| `glchat_key_name` | string | yes | Env var name holding LLM Labs credentials |\n+\n+**State keys written:** `glchat_provider_id`\n+\n+---\n+\n+### 8.18 `glchat-create-model`\n+\n+Creates a model record in GL Chat via `POST /admin/models`. At runtime, fetches all prompt template groups (`GET /admin/prompt-template-groups/all`) and prompts the user to select one. The model's `model_kwargs` encodes `base_url` (deployment URL) and `citations`.\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `glchat_url` | string | yes | GL Chat admin base URL |\n+| `username` | string | yes | Admin username |\n+| `password` | string | yes | Admin password |\n+| `model_name` | string | yes | Internal model name (no spaces) |\n+| `model_display_name` | string | yes | Human-readable model name |\n+| `deployment_url` | string | yes | LLM Labs deployment URL |\n+| `citations` | string | no | `\"true\"` or `\"false\"` (default `\"true\"`) |\n+| `glchat_provider_id` | string | yes | ID of the GL Chat provider to attach to |\n+| `model_description` | string | no | Defaults to `model_display_name` if omitted |\n+| `glchat_key_name` | string | no | Env var name for credentials (encoded in `model_env_kwargs`) |\n+\n+**Interactive at runtime:** prompts the user to select a prompt template group from a numbered list.\n+\n+**State keys written:** `glchat_model_id`\n+\n+---\n+\n+### 8.19 `glchat-create-preset`\n+\n+Creates (or reuses) a RAGO preset in GL Chat.\n+\n+**At runtime**, the user is asked whether to use an existing preset or create a new one:\n+\n+- **Use existing**: fetches all presets (`GET /admin/presets`); shows a searchable numbered list if >10 results; saves the selected preset ID.\n+- **Create new**:\n+  1. Prompts for a preset ID slug (if not in `args`)\n+  2. Fetches RAGO pipelines (`GET /admin/pipelines?type=RAGO`) and shows a numbered list; user selects one\n+  3. Fetches pipeline detail to find the `supported_model_ids` config field\n+  4. Creates the preset via `POST /admin/presets`, wiring the model\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `glchat_url` | string | yes | GL Chat admin base URL |\n+| `username` | string | yes | Admin username |\n+| `password` | string | yes | Admin password |\n+| `glchat_model_id` | string | yes | GL Chat model ID to wire into the preset |\n+| `preset_id` | string | no | Preset slug; prompted at runtime if not provided |\n+\n+**State keys written:** `glchat_preset_id`, `glchat_pipeline_id`\n+\n+---\n+\n+### 8.20 `glchat-create-app`\n+\n+Creates a GL Chat chatbot application via `POST /admin/chatbots` (form-encoded). At runtime the user is guided through selecting a knowledge base and pipeline; catalog metadata (`prompt_builder_catalog_id`, `lmrp_catalog_id`) is fetched automatically from the pipeline's `metadata_`.\n+\n+**Interactive at runtime:**\n+1. Lists knowledge bases (`GET /admin/knowledge-bases/all`); user selects one\n+2. Lists pipelines (`GET /admin/pipelines`); user selects one; catalog IDs are read from `pipeline.metadata_`\n+3. Fetches prompt-builder and lmrp catalog details to resolve their `level` values\n+4. Resolves `user_id` from the explicit arg or from `GET /auth/me`\n+\n+**`args` schema:**\n+\n+| Field | Type | Required | Description |\n+|---|---|---|---|\n+| `glchat_url` | string | yes | GL Chat admin base URL |\n+| `username` | string | yes | Admin username |\n+| `password` | string | yes | Admin password |\n+| `chatbot_id` | string | yes | Unique chatbot slug (e.g. `llmlabs-rag-app`) |\n+| `glchat_app_name` | string | yes | Display name for the chatbot |\n+| `app_description` | string | no | Description (default `\"\"`) |\n+| `glchat_preset_id` | string | yes | ID of the GL Chat preset to use |\n+| `user_id` | string | no | Admin user ID; auto-detected from `/auth/me` if blank |\n+\n+**State keys written:** _(none)_\n+\n+---\n+\n+## 9. Version constraint syntax\n+\n+Used in `operating_systems` and `software_requirements`. The syntax mirrors common package manager conventions:\n+\n+| Syntax | Meaning | Example |\n+|---|---|---|\n+| `>=1.2.3` | At least this version | `>=20.04` |\n+| `>1.2.3` | Strictly greater | `>1.0.0` |\n+| `<=1.2.3` | At most this version | `<=3.0.0` |\n+| `<1.2.3` | Strictly less | `<2.0.0` |\n+| `=1.2.3` or `==1.2.3` | Exactly this version | `==9` |\n+| `!=1.2.3` | Anything except this | `!=1.5.0` |\n+| `~1.2.3` | Tilde range: `>=1.2.3 <1.3.0` | `~2.40.3` |\n+| `^1.2.3` | Caret range: `>=1.2.3 <2.0.0` | `^28.0.0` |\n+| `1.2.*` or `1.x` | Wildcard patch/minor | `28.*` |\n+| `1.2.3 - 2.3.4` | Hyphen range (inclusive) | `20.04 - 22.04` |\n+| `>=1.0 <2.0` | AND (space-separated) | `>=20.04 <23.00` |\n+| `1.0 \\|\\| 2.0` | OR | `>=9 \\|\\| >=8.9` |\n+\n+---\n+\n+## 10. State persistence (`state.yaml`)\n+\n+Two distinct persistence mechanisms write to `state.yaml`:\n+\n+**`set-environment-variables` flow action** (inside `run-workflow`): saves collected prompt values under a composite key.\n+\n+**Key format**: `{command_name}—{action_index}—{flow_action_name}`\n+\n+Example `state.yaml` after running `datasaur-cli configure`:\n+\n+```yaml\n+configure—0—vector-db:\n+  OPENSEARCH_USERNAME: myuser\n+  OPENSEARCH_PASSWORD: mypassword\n+last_updated_at: \"2024-01-15T10:30:00.000000\"\n+```\n+\n+**LLM Labs and GL Chat actions**: save individual values as top-level flat keys so they can be read back by subsequent commands via `default_from_state`.\n+\n+Example `state.yaml` after running `datasaur-cli gl-chat-setup`:\n+\n+```yaml\n+api_url: https://app.datasaur.ai\n+team_id: \"12345\"\n+vector_store_id: vs_abc123\n+llm_application_id: app_def456\n+rag_config_id: rc_ghi789\n+deployment_url: https://app.datasaur.ai/api/deployment/12345/dep_jkl012\n+llmlabs_api_key: key_mno345\n+glchat_url: http://localhost:8000\n+glchat_key_name: LLMLABS_API_KEY\n+glchat_provider_id: prov_pqr678\n+glchat_model_id: mdl_stu901\n+glchat_preset_id: pre_vwx234\n+glchat_pipeline_id: pip_yz5678\n+last_updated_at: \"2024-01-15T10:30:00.000000\"\n+```\n+\n+**State keys reference:**\n+\n+| Key | Written by | Used by (via `default_from_state`) |\n+|---|---|---|\n+| `api_url` | `llmlabs-create-kb` | `gl-chat-create-app`, `gl-chat-create-rag-config`, `gl-chat-deploy`, `gl-chat-create-api-key` |\n+| `team_id` | `llmlabs-create-kb` | `gl-chat-create-app`, `gl-chat-create-api-key` |\n+| `vector_store_id` | `llmlabs-create-kb` | `gl-chat-create-rag-config` |\n+| `llm_application_id` | `llmlabs-create-app` | `gl-chat-create-rag-config`, `gl-chat-deploy` |\n+| `rag_config_id` | `llmlabs-create-rag-config` | `gl-chat-deploy` |\n+| `deployment_url` | `llmlabs-deploy` | `gl-chat-configure`, `gl-chat-create-model` |\n+| `llmlabs_api_key` | `llmlabs-create-api-key` | `gl-chat-configure`, `gl-chat-create-env` |\n+| `glchat_url` | `glchat-create-env` | `gl-chat-create-provider`, `gl-chat-create-model`, `gl-chat-create-preset`, `gl-chat-create-app` |\n+| `glchat_key_name` | `glchat-create-env` | `gl-chat-create-provider`, `gl-chat-create-model` |\n+| `glchat_provider_id` | `glchat-create-provider` | `gl-chat-create-model` |\n+| `glchat_model_id` | `glchat-create-model` | `gl-chat-create-preset` |\n+| `glchat_preset_id` | `glchat-create-preset` | `gl-chat-create-app` |\n+| `client_id` | `gl-chat-create-rag-config` prompts | `gl-chat-create-rag-config`, `gl-chat-deploy`, `gl-chat-create-api-key` |\n+| `client_secret` | `gl-chat-create-rag-config` prompts | `gl-chat-create-rag-config`, `gl-chat-deploy`, `gl-chat-create-api-key` |\n+\n+Both `state.yaml` files can be edited manually to change pre-filled defaults, or deleted entirely to start fresh.\n+\n+---\n+\n+## 11. How to add a new command\n+\n+Adding a new CLI command requires **only a manifest change** — no Python code changes needed, as long as you only use existing actions.\n+\n+**Example**: an `upgrade` command that stops services, loads new images, and restarts:\n+\n+```yaml\n+commands:\n+  upgrade:\n+    - action: docker-compose-down\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+    - action: load-docker-images\n+    - action: docker-compose-up\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+```\n+\n+This registers `datasaur-cli upgrade` automatically at the next startup.\n+\n+**Rules:**\n+\n+- The command name must be a valid YAML key and a valid Click command name (lowercase, hyphens allowed).\n+- The value must be a **list** (even if it contains only one action).\n+- All `action` values must match the name of a registered action (see [section 8](#8-built-in-actions-reference)).\n+- `options` and `prompts` declared across multiple action objects in the same command are merged; on name conflicts, the first declaration wins.\n+\n+---\n+\n+## 12. How to add a new action\n+\n+Adding a new action requires writing Python code. There are three steps.\n+\n+### Step 1: Implement the `Action` interface\n+\n+Create a new file, e.g. `src/action/start/send_notification_action.py`:\n+\n+```python\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel\n+\n+from src.action.action import Action\n+\n+\n+class SendNotificationArgsModel(BaseModel):\n+    webhook_url: str\n+    message: str\n+\n+\n+class SendNotificationAction(Action):\n+    def name(self) -> str:\n+        # This string is what you write in manifest.yaml under `action:`.\n+        return \"send-notification\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        # Built-in CLI options this action always contributes to any command\n+        # that uses it. Return {} if none.\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        # Called for ALL actions in a command before any run() executes.\n+        # Return False to abort the entire command before it starts.\n+        try:\n+            SendNotificationArgsModel(**args)\n+            return True\n+        except Exception as e:\n+            print(f\"Validation error: {e}\")\n+            return False\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        # context fields available at runtime:\n+        #   context[\"command_name\"]   - the CLI subcommand (e.g. \"start\")\n+        #   context[\"option_values\"]  - dict of resolved CLI flag values\n+        #   context[\"prompt_values\"]  - dict of resolved prompt values\n+        #   context[\"action_number\"]  - 0-based index of this action in the command\n+        #\n+        # args: the resolved args dict from manifest.yaml.\n+        # All {options[...]} and {prompts[...]} placeholders are already resolved.\n+        #\n+        # Return False to abort subsequent actions in the command.\n+\n+        parsed = SendNotificationArgsModel(**args)\n+\n+        import json\n+        import urllib.request\n+\n+        payload = json.dumps({\"text\": parsed.message}).encode()\n+        req = urllib.request.Request(\n+            parsed.webhook_url,\n+            data=payload,\n+            headers={\"Content-Type\": \"application/json\"},\n+            method=\"POST\",\n+        )\n+        try:\n+            urllib.request.urlopen(req)\n+            print(\"Notification sent.\")\n+            return True\n+        except Exception as e:\n+            print(f\"Failed to send notification: {e}\")\n+            return False\n+```\n+\n+**`Action` interface contract** (`src/action/action.py`):\n+\n+| Method | Returns | When called | Description |\n+|---|---|---|---|\n+| `name()` | `str` | Startup | The action identifier written in `manifest.yaml` under `action:` |\n+| `options()` | `Dict[str, Any]` | Startup | Built-in CLI options this action always contributes |\n+| `validate(args)` | `bool` | Before any `run()` | Validate the resolved args; `False` aborts the entire command |\n+| `run(context, args)` | `bool` | In sequence | Execute the action; `False` aborts subsequent actions |\n+\n+### Step 2: Register the action\n+\n+Open `src/action/actions_service.py` and add the new class to `_get_action_instances()`:\n+\n+```python\n+# src/action/actions_service.py\n+\n+from src.action.start.send_notification_action import SendNotificationAction  # add import\n+\n+class ActionsService:\n+    def _get_action_instances(self) -> List[object]:\n+        return [\n+            ApiCallAction(),\n+            # GL Chat actions\n+            GlChatCreateEnvAction(),\n+            GlChatCreateProviderAction(),\n+            GlChatCreateModelAction(),\n+            GlChatCreatePresetAction(),\n+            GlChatCreateAppAction(),\n+            GlChatSetupAction(),\n+            # LLM Labs actions\n+            LlmLabsCreateApiKeyAction(),\n+            LlmLabsCreateAppAction(),\n+            LlmLabsCreateKbAction(),\n+            LlmLabsCreateRagConfigAction(),\n+            LlmLabsDeployAction(),\n+            LlmLabsSetupAction(),\n+            # Infrastructure actions\n+            CreateDockerResourcesAction(),\n+            DockerComposeDownAction(),\n+            DockerComposeUpAction(),\n+            HelloWorldAction(),\n+            LoadDockerImageAction(),\n+            RunWorkflowAction(),\n+            ScriptRunnerAction(),\n+            SendNotificationAction(),                  # add here\n+            ValidateFilesAndDirectoriesAction(),\n+        ]\n+```\n+\n+### Step 3: Use the action in `manifest.yaml`\n+\n+```yaml\n+commands:\n+  deploy:\n+    - action: docker-compose-up\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+    - action: send-notification\n+      options:\n+        env:\n+          required: true\n+          short: e\n+          type: string\n+      args:\n+        webhook_url: \"https://hooks.example.com/notify\"\n+        message: \"Deployment complete on {options[env]}\"\n+```\n+\n+**Verifying:**\n+\n+```bash\n+# Run the test suite\n+pytest tests/\n+\n+# Build the binary\n+./build.sh\n+\n+# Test manually\n+./dist/datasaur-cli deploy -e production\n+```\n+\n+---\n+\n+## 13. `command_modules` — Extending the CLI with external modules\n+\n+`command_modules` is the plugin mechanism that lets you ship new commands and Python actions as a standalone package, without modifying the core CLI binary or `src/`.\n+\n+### How it works\n+\n+Two things happen when the CLI starts up:\n+\n+**Step 1 — manifest merge** (`ManifestFileReader`): For each path listed under `command_modules`, the CLI reads `{module_path}/manifest.yaml` and merges its `commands:` block into the root manifest. The module manifest only needs a `commands:` key — `version`, `operating_systems`, `services`, etc. are ignored.\n+\n+**Step 2 — Python action loading** (`ActionsService`): The CLI dynamically imports `{module_path}/actions/__init__.py` using Python's `importlib`. It calls `get_actions()` from that file and registers the returned action instances alongside the built-in actions.\n+\n+```\n+root manifest.yaml\n+  └── command_modules: [examples/gl-chat-setup]\n+        │\n+        ├─ ManifestFileReader\n+        │    └── reads examples/gl-chat-setup/manifest.yaml\n+        │         └── merges `commands:` into root\n+        │\n+        └─ ActionsService\n+             └── importlib loads examples/gl-chat-setup/actions/__init__.py\n+                   └── get_actions() → [GlChatCreateAppAction, LlmLabsDeployAction, ...]\n+```\n+\n+### Module directory contract\n+\n+Any directory listed under `command_modules` must follow this structure:\n+\n+```\n+your-module/\n+├── manifest.yaml          # commands fragment — only `commands:` key is read\n+└── actions/\n+    └── __init__.py        # must exist; must define get_actions() → List[Action]\n+```\n+\n+**`manifest.yaml`** (module-level) — commands only:\n+```yaml\n+commands:\n+  my-command:\n+    actions:\n+      - action: my-custom-action\n+        args:\n+          foo: \"{prompts[foo]}\"\n+```\n+\n+**`actions/__init__.py`** — the entry point:\n+```python\n+import sys\n+from pathlib import Path\n+\n+# Add parent dir to sys.path so `from actions.subpackage.xxx import ...` works\n+sys.path.insert(0, str(Path(__file__).parent.parent))\n+\n+from actions.mypackage.my_action import MyCustomAction\n+\n+def get_actions():\n+    return [MyCustomAction()]\n+```\n+\n+If `get_actions` is missing, the module loads without error but contributes zero actions.\n+\n+### Delivery structure\n+\n+When shipping a module to customers, the delivery package looks like this:\n+\n+```\n+datasaur-gl-chat-setup/          ← zip and deliver this folder\n+├── datasaur-cli                  ← binary (no Python required on customer machine)\n+├── manifest.yaml                 ← root manifest; declares command_modules\n+└── examples/\n+    └── gl-chat-setup/\n+        ├── manifest.yaml         ← commands fragment (only `commands:` key)\n+        ├── config.yaml.example   ← template for --config flag\n+        └── actions/\n+            ├── __init__.py       ← get_actions() entry point\n+            ├── glchat/           ← GL Chat-specific action classes\n+            │   └── *.py\n+            └── llmlabs/          ← LLM Labs-specific action classes\n+                └── *.py\n+```\n+\n+Customer runs:\n+```bash\n+cd datasaur-gl-chat-setup/\n+./datasaur-cli gl-chat-setup --config examples/gl-chat-setup/config.yaml\n+```\n+\n+No Python installation required — the binary is self-contained. The module's Python files are loaded at runtime by the binary via `importlib`.\n+\n+### Module Python files can import from `src/`\n+\n+Actions inside a module can import from the frozen `src/` bundle in the binary:\n+\n+```python\n+# works inside examples/gl-chat-setup/actions/llmlabs/my_action.py\n+from src.action.action import Action\n+from src.common.datasaur_graphql_action import DatasaurGraphQLAction\n+from src.common.request_client import get_access_token, graphql\n+```\n+\n+This works because PyInstaller populates `sys.modules` with the frozen `src/` package at startup. External module files resolve `src.*` imports against the bundled code — no separate install needed.\n+\n+### Multiple modules\n+\n+`command_modules` accepts any number of paths. Each contributes its own commands and actions:\n+\n+```yaml\n+command_modules:\n+  - examples/gl-chat-setup\n+  - examples/another-feature\n+  - /opt/customer-extensions/custom-module\n+```\n+\n+Later entries do not override earlier entries on action name conflicts (first registration wins).\n+\n+---\n+\n+## 14. Full annotated example\n+\n+The `manifest.yaml` from this repository, with inline comments explaining every field:\n+\n+```yaml\n+# The manifest version. Printed at startup as \"✓ Manifest version: ...\".\n+# Can be a shell placeholder if the file is pre-processed before the CLI runs\n+# (e.g. using envsubst in a CI pipeline).\n+version: \"${DOCKER_TAG}\"\n+\n+# OS validation: the host must be Ubuntu >=20.04 OR RHEL >=9.\n+# At least one entry must match (OR logic). Omit this key to skip OS validation.\n+operating_systems:\n+  ubuntu: \">=20.04\"\n+  rhel: \">=9\"\n+\n+# Software validation: Docker >=28.5.2 AND Docker Compose >=2.40.3 must be installed.\n+# Both must pass (AND logic). Omit this key to skip software validation.\n+software_requirements:\n+  docker: \">=28.5.2\"\n+  docker-compose: \">=2.40.3\"\n+\n+# Docker image archives to load during the `install` command.\n+# Each entry pairs a logical name with its .tar.gz archive path.\n+services:\n+  - name: backend\n+    image: vulcan-ai/vulcan/backend:6.144.0\n+    file_path: ./images/vulcan-ai-vulcan-backend-6.144.0.tar.gz\n+  - name: frontend\n+    image: vulcan-ai/vulcan/frontend:6.144.0\n+    file_path: ./images/vulcan-ai-vulcan-frontend-6.144.0.tar.gz\n+\n+commands:\n+  # datasaur-cli hello -n Alice\n+  # Demonstrates options, prompts, template interpolation, and multiple actions.\n+  hello:\n+    - action: hello-world\n+      options:\n+        name:\n+          required: true\n+          short: n        # accessible as -n\n+          type: string\n+      prompts:\n+        install_dir:\n+          text: \"Installation directory\"\n+          default: /usr/local/\n+          hide_input: false\n+      args:\n+        name: \"{options[name]}\"                # resolved from --name flag\n+        install_dir: \"{prompts[install_dir]}\"  # resolved from prompt\n+        files:\n+          - file_path: install.sh\n+\n+    # Second action in the same command. Shares options/prompts declared above,\n+    # and adds a new `age` option. Both action objects run in sequence.\n+    - action: hello-world\n+      options:\n+        name:\n+          required: true\n+          short: n\n+          type: string\n+        age:\n+          short: a\n+          type: integer\n+      prompts:\n+        install_dir:\n+          text: \"Installation directory\"\n+          default: /usr/local/\n+          hide_input: false\n+      args:\n+        name: \"{options[name]}\"\n+        age: \"{options[age]}\"\n+        biodata: \"{options[name]} - {options[age]}\"  # compound interpolation\n+        install_dir: \"{prompts[install_dir]}\"\n+        files:\n+          - file_path: install.sh\n+          - file_path: run.sh\n+\n+  # datasaur-cli install\n+  # Loads all Docker images listed under `services`.\n+  # No options, prompts, or args needed.\n+  install:\n+    - action: load-docker-images\n+\n+  # datasaur-cli configure\n+  # Interactive configuration wizard using a branching workflow (state machine).\n+  configure:\n+    - action: run-workflow\n+      args:\n+        # Entry points: the workflow starts at the first name in this list.\n+        # To skip directly to a flow action: datasaur-cli configure -a vector-db\n+        workflow:\n+          - vector-db\n+\n+        # Full state machine definition. Each entry is a flow action node.\n+        actions:\n+          # A menu node: displays choices and GOTOs the selected flow action.\n+          - name: main-menu\n+            action: switch-input\n+            title: \"Select which service you want to configure:\"\n+            cases:\n+              - name: Database\n+                action: database-menu        # GOTO database-menu on selection\n+              - name: \"Vector Database\"\n+                action: vector-db            # GOTO vector-db on selection\n+\n+          # A sub-menu node: further branches the database configuration.\n+          - name: database-menu\n+            action: switch-input\n+            title: \"Which database service do you want?\"\n+            cases:\n+              - name: \"Managed service (e.g. AWS RDS)\"\n+                action: database.managed-service\n+              - name: \"Self-managed service (e.g. MariaDB as Docker container)\"\n+                action: database.self-managed-service\n+\n+          # Collects connection info for an external managed database.\n+          # All prompts are required; user must provide values.\n+          - name: database.managed-service\n+            action: set-environment-variables\n+            title: \"Database Managed Service\"\n+            prompts:\n+              DATABASE_HOST:\n+                text: \"Database Host\"\n+                required: true\n+              DATABASE_PORT:\n+                text: \"Database Port\"\n+                required: true\n+              DATABASE_USERNAME:\n+                text: \"Database Username\"\n+                required: true\n+              DATABASE_PASSWORD:\n+                text: \"Database Password\"\n+                required: true\n+              DATABASE_NAME:\n+                text: \"Database Name\"\n+                required: true\n+            targets:\n+              - file_path: datasaur.env\n+                values:\n+                  # \"prompts[KEY]\" is replaced with the user-entered value for KEY.\n+                  INSTALLATION_PATH: \"prompts[DATABASE_HOST]\"\n+                  DATABASE_HOST: \"prompts[DATABASE_HOST]\"\n+                  DATABASE_PORT: \"prompts[DATABASE_PORT]\"\n+                  DATABASE_USERNAME: \"prompts[DATABASE_USERNAME]\"\n+                  DATABASE_PASSWORD: \"prompts[DATABASE_PASSWORD]\"\n+                  DATABASE_NAME: \"prompts[DATABASE_NAME]\"\n+\n+          # Self-managed: credentials are auto-generated as defaults,\n+          # and host/port are written as hardcoded literals.\n+          - name: database.self-managed-service\n+            action: set-environment-variables\n+            title: \"Database Self-Managed Service\"\n+            prompts:\n+              DATABASE_USERNAME:\n+                text: \"Database Username\"\n+                generate: true          # auto-generates an 8-char alphanumeric default\n+                generate_length: 8\n+                min_length: 4\n+                required: true\n+              DATABASE_PASSWORD:\n+                text: \"Database Password\"\n+                generate: true\n+                generate_length: 8\n+                min_length: 4\n+                required: true\n+              DATABASE_NAME:\n+                text: \"Database Name\"\n+                generate: true\n+                generate_length: 4\n+                min_length: 4\n+                required: true\n+            targets:\n+              - file_path: datasaur.env\n+                values:\n+                  DATABASE_HOST: \"localhost\"    # literal — not from a prompt\n+                  DATABASE_PORT: \"3306\"         # literal\n+                  DATABASE_USERNAME: \"prompts[DATABASE_USERNAME]\"\n+                  DATABASE_PASSWORD: \"prompts[DATABASE_PASSWORD]\"\n+                  DATABASE_NAME: \"prompts[DATABASE_NAME]\"\n+\n+          # Configures the vector database credentials.\n+          - name: vector-db\n+            action: set-environment-variables\n+            title: \"Vector DB\"\n+            prompts:\n+              OPENSEARCH_USERNAME:\n+                text: \"OpenSearch Username\"\n+                description: \"This is the login credential's username. It can be filled with any string.\"\n+                generate: true\n+                generate_length: 8\n+                required: true\n+              OPENSEARCH_PASSWORD:\n+                text: \"OpenSearch Password\"\n+                description: \"This is the login credential's password. It can be filled with any string.\"\n+                generate: true\n+                generate_length: 8\n+                required: true\n+            targets:\n+              - file_path: vector-db.env\n+                values:\n+                  OPENSEARCH_USERNAME: \"prompts[OPENSEARCH_USERNAME]\"\n+                  OPENSEARCH_PASSWORD: \"prompts[OPENSEARCH_PASSWORD]\"\n+\n+  # datasaur-cli start -n <name>\n+  # Creates Docker resources, validates files, runs migrations, then starts services.\n+  start:\n+    # Create the Docker network and volume if they do not already exist (idempotent).\n+    - action: create-docker-resources\n+      args:\n+        networks:\n+          - datasaur\n+        volumes:\n+          - vulcan_db_data\n+\n+    # Verify that expected files/directories exist with correct permissions and ownership.\n+    - action: validate-files\n+      args:\n+        files:\n+          - path: folder1/folder\n+            permissions: 0644\n+            owner: \"$(id -u):$(id -g)\"   # $(id -u):$(id -g) resolves to the current user\n+          - path: folder1/file1\n+            permissions: 0644\n+            owner: \"$(id -u):$(id -g)\"\n+          - path: folder/*               # wildcard: matches all files under folder/\n+            permissions: 0644            # specific entries above take precedence over wildcards\n+            owner: \"$(id -u):$(id -g)\"\n+\n+    # Run the database migration script, passing values from options and prompts.\n+    - action: script-runner\n+      options:\n+        name:\n+          required: true\n+          short: n\n+          type: string\n+      prompts:\n+        install_dir:\n+          text: \"Installation directory\"\n+          default: /usr/local/\n+          hide_input: false\n+      args:\n+        scripts:\n+          - name: migrate\n+            file_path: ./migrate.sh\n+            args:\n+              - --name\n+              - \"{options[name]}\"          # resolved from -n flag\n+              - --install_dir\n+              - \"{prompts[install_dir]}\"   # resolved from prompt\n+\n+    # Start all services in detached mode.\n+    - action: docker-compose-up\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+\n+  # datasaur-cli stop\n+  # Stops all running services.\n+  stop:\n+    - action: docker-compose-down\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+```"},{"sha":"604a21d0905fbf154490d2ad6adc3b1b6bfd7bea","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/README.md","status":"added","additions":66,"deletions":0,"changes":66,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2FREADME.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2FREADME.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2FREADME.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,66 @@\n+# GL Chat Setup Example\n+\n+End-to-end setup for a GL Chat application backed by a Datasaur LLM Labs RAG deployment.\n+\n+## Overview\n+\n+**Phase 1 — LLM Labs** (Datasaur GraphQL API):\n+1. Create Knowledge Base (vector store)\n+2. Create LLM Application\n+3. Create RAG Config (attach model + vector store)\n+4. Deploy the application\n+5. Create an API key for the deployment\n+\n+**Phase 2 — GL Chat** (GL Chat Admin REST API):\n+1. Store the LLM Labs API key as an environment variable\n+2. Create a provider pointing at LLM Labs\n+3. Create a model pointing at the deployment URL\n+4. Create a RAGO preset\n+5. Create the chatbot application\n+\n+## Commands\n+\n+### Full setup (Phase 1 + Phase 2)\n+```bash\n+datasaur-cli gl-chat-setup --config examples/gl-chat-setup/config.yaml\n+```\n+\n+### Phase 1 only (LLM Labs)\n+```bash\n+datasaur-cli gl-chat-llmlabs --config examples/gl-chat-setup/config.yaml\n+```\n+\n+### Phase 2 only (GL Chat, using existing deployment)\n+```bash\n+datasaur-cli gl-chat-configure --config examples/gl-chat-setup/config.yaml\n+```\n+\n+### Individual steps\n+\n+Phase 1:\n+```bash\n+datasaur-cli gl-chat-create-kb\n+datasaur-cli gl-chat-create-app\n+datasaur-cli gl-chat-create-rag-config\n+datasaur-cli gl-chat-deploy\n+datasaur-cli gl-chat-create-api-key\n+```\n+\n+Phase 2:\n+```bash\n+datasaur-cli gl-chat-create-env\n+datasaur-cli gl-chat-create-provider\n+datasaur-cli gl-chat-create-model\n+datasaur-cli gl-chat-create-preset\n+datasaur-cli gl-chat-create-chatbot\n+```\n+\n+## Config file\n+\n+Copy `config.yaml.example` to `config.yaml`, fill in your values, then pass it with `--config`.\n+\n+Each command that accepts `--config` will read prompt values from the file, skipping interactive input for any key that matches.\n+\n+## State\n+\n+Each command writes its outputs to `state.yaml` in the working directory. Subsequent commands read defaults from state, so you only need to type connection details once."},{"sha":"c6179a4ec4e6bd1dbf7e1d936051c19ec6efaa44","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/__init__.py","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2F__init__.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,25 @@\n+import sys\n+from pathlib import Path\n+\n+sys.path.insert(0, str(Path(__file__).parent.parent))\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction  # noqa: F401 (registers path)\n+from actions.glchat.create_app_action import GlChatCreateAppAction\n+from actions.glchat.create_env_action import GlChatCreateEnvAction\n+from actions.glchat.create_model_action import GlChatCreateModelAction\n+from actions.glchat.create_preset_action import GlChatCreatePresetAction\n+from actions.glchat.create_provider_action import GlChatCreateProviderAction\n+from actions.glchat.setup_action import GlChatSetupAction\n+from actions.llmlabs.deploy_action import LlmLabsDeployAction\n+\n+\n+def get_actions():\n+    return [\n+        GlChatCreateEnvAction(),\n+        GlChatCreateProviderAction(),\n+        GlChatCreateModelAction(),\n+        GlChatCreatePresetAction(),\n+        GlChatCreateAppAction(),\n+        GlChatSetupAction(),\n+        LlmLabsDeployAction(),\n+    ]"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/__init__.py","status":"renamed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2F__init__.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","previous_filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/helpers/__init__.py"},{"sha":"eaa75f7035bd3e6f2f2055b23e3f347259f1ed29","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/base_glchat_action.py","status":"added","additions":64,"deletions":0,"changes":64,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fbase_glchat_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fbase_glchat_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fbase_glchat_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,64 @@\n+from typing import Any, Dict, Optional, Tuple\n+\n+import click\n+import requests\n+import urllib3\n+\n+from src.action.action import Action\n+from src.common.helper import redact_if_sensitive\n+from src.common.request_client import _SSL_VERIFY\n+from src.common.state_service import StateService\n+\n+if not _SSL_VERIFY:\n+    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n+\n+_token_cache: Dict[Tuple[str, str], str] = {}\n+\n+\n+class BaseGlChatAction(Action):\n+    def __init__(self):\n+        self.state_service = StateService()\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def _login(self, glchat_url: str, username: str, password: str) -> Optional[str]:\n+        cache_key = (glchat_url, username)\n+        cached = _token_cache.get(cache_key)\n+        if cached:\n+            return cached\n+\n+        endpoint = f\"{glchat_url}/auth/direct-api-login\"\n+        try:\n+            response = requests.post(\n+                endpoint,\n+                json={\"username\": username, \"password\": password},\n+                headers={\"Content-Type\": \"application/json\"},\n+                timeout=30,\n+                verify=_SSL_VERIFY,\n+            )\n+        except requests.RequestException as e:\n+            click.echo(click.style(f\"✗ Login failed: {e}\", fg=\"red\"))\n+            return None\n+\n+        if response.status_code not in (200, 201):\n+            click.echo(\n+                click.style(\n+                    f\"✗ Login failed: HTTP {response.status_code}: {response.text}\",\n+                    fg=\"red\",\n+                )\n+            )\n+            return None\n+\n+        token = response.json().get(\"access_token\")\n+        if not token:\n+            click.echo(click.style(\"✗ No access_token in login response\", fg=\"red\"))\n+            return None\n+\n+        _token_cache[cache_key] = token\n+        click.echo(click.style(f\"✓ Logged in as {username}\", fg=\"green\"))\n+        return token\n+\n+    def _save(self, key: str, value: Any) -> None:\n+        self.state_service.set(key, value)\n+        click.echo(f\"  Saved {key} = {redact_if_sensitive(key, value)}\")"},{"sha":"bdd4d7b1d07ea162e21b670cc8c7092c776bc285","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/create_app_action.py","status":"added","additions":138,"deletions":0,"changes":138,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_app_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_app_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_app_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,138 @@\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction\n+from src.common.request_client import http_get, http_post\n+\n+\n+class CreateAppArgsModel(BaseModel):\n+    glchat_url: str\n+    username: str\n+    password: str\n+    chatbot_id: str\n+    glchat_app_name: str\n+    app_description: Optional[str] = \"\"\n+    glchat_preset_id: str\n+    user_id: Optional[str] = None\n+\n+\n+class GlChatCreateAppAction(BaseGlChatAction):\n+    def name(self) -> str:\n+        return \"glchat-create-app\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            CreateAppArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def _pick(self, label: str, items: List[Dict], *name_keys: str) -> Optional[Dict]:\n+        \"\"\"Show a numbered list and return the user's chosen item.\"\"\"\n+        if not items:\n+            click.echo(click.style(f\"✗ No {label} options found\", fg=\"red\"))\n+            return None\n+        keys = name_keys or (\"name\",)\n+        for i, item in enumerate(items):\n+            display = next((item.get(k) for k in keys if item.get(k)), item.get(\"id\", \"?\"))\n+            click.echo(f\"  [{i + 1}] {display}\")\n+        choice = click.prompt(f\"  Select {label}\", type=click.IntRange(1, len(items)))\n+        return items[choice - 1]\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        click.echo(f\"Running `{self.name()}` action...\")\n+\n+        glchat_url = args[\"glchat_url\"]\n+        token = self._login(glchat_url, args[\"username\"], args[\"password\"])\n+        if token is None:\n+            return False\n+\n+        # Select knowledge base\n+        kbs = http_get(glchat_url, token, \"/admin/knowledge-bases/all\")\n+        if not kbs or not isinstance(kbs, List):\n+            click.echo(click.style(\"✗ No knowledge bases found\", fg=\"red\"))\n+            return False\n+        kb = self._pick(\"knowledge base\", kbs, \"knowledge_base_name\", \"name\")\n+        if not kb:\n+            return False\n+        kb_id = kb.get(\"id\") or kb.get(\"knowledge_base_id\")\n+        if not kb_id:\n+            click.echo(click.style(f\"✗ Could not determine knowledge base ID. Keys: {list(kb.keys())}\", fg=\"red\"))\n+            return False\n+\n+        # Select pipeline → get prompt-builder and lmrp catalog IDs from metadata_\n+        pipelines = http_get(glchat_url, token, \"/admin/pipelines\")\n+        if not pipelines or not isinstance(pipelines, List):\n+            click.echo(click.style(\"✗ No pipelines found\", fg=\"red\"))\n+            return False\n+        for i, p in enumerate(pipelines):\n+            click.echo(f\"  [{i + 1}] {p.get('name', '?')}  ({p.get('type', '?')})\")\n+        pipeline_choice = click.prompt(\"  Select pipeline\", type=click.IntRange(1, len(pipelines)))\n+        pipeline = pipelines[pipeline_choice - 1]\n+        metadata = pipeline.get(\"metadata_\") or {}\n+        pb_catalog_id = metadata.get(\"prompt_builder_catalog_id\")\n+        lmrp_catalog_id = metadata.get(\"lmrp_catalog_id\")\n+        if not pb_catalog_id or not lmrp_catalog_id:\n+            click.echo(click.style(\n+                f\"✗ Pipeline '{pipeline.get('name')}' has no catalog IDs in metadata_. Got: {metadata}\",\n+                fg=\"red\",\n+            ))\n+            return False\n+\n+        pb_catalog = http_get(glchat_url, token, f\"/admin/prompt-builder-catalogs/{pb_catalog_id}\")\n+        if not pb_catalog or not isinstance(pb_catalog, dict):\n+            click.echo(click.style(\"✗ Failed to fetch prompt-builder catalog detail\", fg=\"red\"))\n+            return False\n+        pb_catalog_level = pb_catalog.get(\"level\")\n+        if not pb_catalog_level:\n+            click.echo(click.style(f\"✗ prompt-builder catalog has no 'level' field. Keys: {list(pb_catalog.keys())}\", fg=\"red\"))\n+            return False\n+\n+        lmrp_catalog = http_get(glchat_url, token, f\"/admin/lmrp-catalogs/{lmrp_catalog_id}\")\n+        if not lmrp_catalog or not isinstance(lmrp_catalog, dict):\n+            click.echo(click.style(\"✗ Failed to fetch lmrp catalog detail\", fg=\"red\"))\n+            return False\n+        lmrp_catalog_level = lmrp_catalog.get(\"level\")\n+        if not lmrp_catalog_level:\n+            click.echo(click.style(f\"✗ lmrp catalog has no 'level' field. Keys: {list(lmrp_catalog.keys())}\", fg=\"red\"))\n+            return False\n+\n+        user_id = args.get(\"user_id\") or None\n+        if not user_id:\n+            me = http_get(glchat_url, token, \"/auth/me\")\n+            if me and isinstance(me, dict):\n+                user_id = me.get(\"id\")\n+        if not user_id:\n+            click.echo(click.style(\"✗ Could not determine user_id. Provide it explicitly via the user_id prompt.\", fg=\"red\"))\n+            return False\n+\n+        body = {\n+            \"chatbot_id\": args[\"chatbot_id\"],\n+            \"chatbot_name\": args[\"glchat_app_name\"],\n+            \"description\": args.get(\"app_description\") or \"\",\n+            \"knowledge_base_id\": kb_id,\n+            \"preset_id\": args[\"glchat_preset_id\"],\n+            \"user_id\": user_id,\n+            \"prompt_builder_catalog_level\": pb_catalog_level,\n+            \"lmrp_catalog_level\": lmrp_catalog_level,\n+            \"is_question_library\": False,\n+            \"use_tenant_logo\": True,\n+            \"show_app_logo\": False,\n+            \"enable_default_agent\": False,\n+        }\n+        click.echo(f\"  chatbot_id={body['chatbot_id']!r}  preset_id={body['preset_id']!r}  kb_id={body['knowledge_base_id']!r}\")\n+        data = http_post(glchat_url, token, \"/admin/chatbots\", body, form=True)\n+        if data is None:\n+            return False\n+\n+        click.echo(click.style(\"✓ GL Chat application created\", fg=\"green\"))\n+        click.echo()\n+        return True"},{"sha":"2d3529ba1e617b584e5c8eb27ea76a51e7174471","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/create_env_action.py","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_env_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_env_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_env_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,59 @@\n+from typing import Any, Dict\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction\n+from src.common.request_client import http_post\n+\n+\n+class CreateEnvArgsModel(BaseModel):\n+    glchat_url: str\n+    username: str\n+    password: str\n+    glchat_key_name: str\n+    llmlabs_api_key: str\n+\n+\n+class GlChatCreateEnvAction(BaseGlChatAction):\n+    def name(self) -> str:\n+        return \"glchat-create-env\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            CreateEnvArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        click.echo(f\"Running `{self.name()}` action...\")\n+\n+        token = self._login(args[\"glchat_url\"], args[\"username\"], args[\"password\"])\n+        if token is None:\n+            return False\n+\n+        data = http_post(\n+            args[\"glchat_url\"],\n+            token,\n+            \"/admin/envs\",\n+            {\n+                \"name\": args[\"glchat_key_name\"],\n+                \"value\": args[\"llmlabs_api_key\"],\n+            },\n+        )\n+        if data is None:\n+            return False\n+\n+        self._save(\"glchat_key_name\", args[\"glchat_key_name\"])\n+        self._save(\"glchat_url\", args[\"glchat_url\"])\n+\n+        click.echo(click.style(\"✓ GL Chat env var created\", fg=\"green\"))\n+        click.echo()\n+        return True"},{"sha":"43c1a8675c369e58cb4b1f08bd809c3cf7aa243e","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/create_model_action.py","status":"added","additions":103,"deletions":0,"changes":103,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_model_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_model_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_model_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,103 @@\n+import json\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction\n+from src.common.request_client import http_get, http_post\n+\n+\n+class CreateModelArgsModel(BaseModel):\n+    glchat_url: str\n+    username: str\n+    password: str\n+    model_name: str\n+    model_display_name: str\n+    deployment_url: str\n+    citations: str = \"true\"\n+    glchat_provider_id: str\n+    model_description: Optional[str] = None\n+    glchat_key_name: Optional[str] = None\n+\n+\n+class GlChatCreateModelAction(BaseGlChatAction):\n+    def name(self) -> str:\n+        return \"glchat-create-model\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            CreateModelArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        click.echo(f\"Running `{self.name()}` action...\")\n+\n+        glchat_url = args[\"glchat_url\"]\n+        token = self._login(glchat_url, args[\"username\"], args[\"password\"])\n+        if token is None:\n+            return False\n+\n+        # Select prompt template group\n+        groups = http_get(glchat_url, token, \"/admin/prompt-template-groups/all\")\n+        if not groups or not isinstance(groups, List) or len(groups) == 0:\n+            click.echo(click.style(\"✗ No prompt template groups found\", fg=\"red\"))\n+            return False\n+        for i, g in enumerate(groups):\n+            click.echo(f\"  [{i + 1}] {g.get('name', g.get('id', '?'))}\")\n+        group_choice = click.prompt(\"  Select prompt template group\", type=click.IntRange(1, len(groups)))\n+        pt_group_id = groups[group_choice - 1][\"id\"]\n+\n+        citations = str(args.get(\"citations\", \"true\")).lower() == \"true\"\n+        model_kwargs = json.dumps({\n+            \"base_url\": args[\"deployment_url\"],\n+            \"citations\": citations,\n+        })\n+        glchat_key_name = args.get(\"glchat_key_name\") or \"\"\n+        model_env_kwargs = json.dumps({\"credentials\": glchat_key_name}) if glchat_key_name else \"{}\"\n+        description = args.get(\"model_description\") or args[\"model_display_name\"]\n+\n+        data = http_post(\n+            glchat_url,\n+            token,\n+            \"/admin/models\",\n+            {\n+                \"name\": args[\"model_name\"],\n+                \"display_name\": args[\"model_display_name\"],\n+                \"description\": description,\n+                \"icon\": \"\",\n+                \"supported_attachments\": {},\n+                \"is_active\": True,\n+                \"prompt_template_group_id\": pt_group_id,\n+                \"provider_id\": args[\"glchat_provider_id\"],\n+                \"model_kwargs\": model_kwargs,\n+                \"model_env_kwargs\": model_env_kwargs,\n+                \"type\": \"LLM\",\n+            },\n+        )\n+        if data is None:\n+            return False\n+\n+        model_id = data.get(\"id\")\n+        if not model_id:\n+            click.echo(\n+                click.style(\n+                    \"✗ Model created but no `id` returned. Check the API response.\",\n+                    fg=\"red\",\n+                )\n+            )\n+            return False\n+\n+        self._save(\"glchat_model_id\", model_id)\n+\n+        click.echo(click.style(\"✓ GL Chat model created\", fg=\"green\"))\n+        click.echo()\n+        return True"},{"sha":"a07f310e749d54e2c9dafbdc05c51a648ff6e048","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/create_preset_action.py","status":"added","additions":174,"deletions":0,"changes":174,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_preset_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_preset_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_preset_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,174 @@\n+import json\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction\n+from src.common.request_client import http_get, http_post\n+\n+_SUPPORTED_MODEL_IDS_FIELD = \"supported_model_ids\"\n+_FILTER_THRESHOLD = 10\n+\n+\n+class CreatePresetArgsModel(BaseModel):\n+    glchat_url: str\n+    username: str\n+    password: str\n+    preset_id: Optional[str] = None\n+    glchat_model_id: str\n+    pipeline_name: Optional[str] = None\n+\n+\n+class GlChatCreatePresetAction(BaseGlChatAction):\n+    def name(self) -> str:\n+        return \"glchat-create-preset\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            CreatePresetArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        click.echo(f\"Running `{self.name()}` action...\")\n+\n+        glchat_url = args[\"glchat_url\"]\n+        token = self._login(glchat_url, args[\"username\"], args[\"password\"])\n+        if token is None:\n+            return False\n+\n+        use_existing = click.confirm(\"  Use an existing preset?\", default=False)\n+\n+        if use_existing:\n+            preset_id = self._select_existing_preset(glchat_url, token)\n+            if preset_id is None:\n+                return False\n+            self._save(\"glchat_preset_id\", preset_id)\n+            click.echo(click.style(\"✓ Using existing GL Chat preset\", fg=\"green\"))\n+            click.echo()\n+            return True\n+\n+        return self._create_preset(glchat_url, token, args)\n+\n+    def _select_existing_preset(\n+        self, glchat_url: str, token: str\n+    ) -> Optional[str]:\n+        presets = http_get(glchat_url, token, \"/admin/presets\")\n+        if not presets or not isinstance(presets, List):\n+            click.echo(click.style(\"✗ Failed to fetch presets\", fg=\"red\"))\n+            return None\n+        if not presets:\n+            click.echo(click.style(\"✗ No presets available\", fg=\"red\"))\n+            return None\n+\n+        while True:\n+            filtered = presets\n+            if len(presets) > _FILTER_THRESHOLD:\n+                search = click.prompt(\n+                    f\"  {len(presets)} presets found. Type to filter by name (leave blank to show all)\"\n+                )\n+                if search.strip():\n+                    term = search.strip().lower()\n+                    filtered = [\n+                        p for p in presets\n+                        if term in (p.get(\"pipeline_preset_id\") or \"\").lower()\n+                        or term in (p.get(\"pipeline\", {}).get(\"name\") or \"\").lower()\n+                    ]\n+                if not filtered:\n+                    click.echo(click.style(f\"  No presets matched '{search}'. Try again.\", fg=\"yellow\"))\n+                    continue\n+\n+            for i, p in enumerate(filtered):\n+                preset_slug = p.get(\"pipeline_preset_id\", p.get(\"id\", \"?\"))\n+                pipeline_name = p.get(\"pipeline\", {}).get(\"name\", \"\")\n+                click.echo(f\"  [{i + 1}] {preset_slug}  ({pipeline_name})\")\n+            click.echo(f\"  [0] Search again\")\n+\n+            choice = click.prompt(\n+                \"  Select preset\",\n+                type=click.IntRange(0, len(filtered)),\n+            )\n+            if choice == 0:\n+                continue\n+\n+            selected = filtered[choice - 1]\n+            preset_id = selected.get(\"id\")\n+            preset_slug = selected.get(\"pipeline_preset_id\", preset_id)\n+            click.echo(f\"  Selected: {preset_slug} ({preset_id})\")\n+            return preset_id\n+\n+    def _create_preset(\n+        self, glchat_url: str, token: str, args: Dict[str, Any]\n+    ) -> bool:\n+        preset_id = args.get(\"preset_id\") or click.prompt(\"  Preset ID (unique slug, e.g. llmlabs-rag-preset)\")\n+\n+        pipelines = http_get(glchat_url, token, \"/admin/pipelines?type=RAGO\")\n+        if not pipelines or not isinstance(pipelines, List):\n+            click.echo(click.style(\"✗ Failed to fetch RAGO pipelines\", fg=\"red\"))\n+            return False\n+        for i, p in enumerate(pipelines):\n+            components = \", \".join(c.get(\"name\", \"\") for c in (p.get(\"components\") or []))\n+            click.echo(f\"  [{i + 1}] {p.get('name', '?')}  [{components}]\")\n+        choice = click.prompt(\"  Select pipeline\", type=click.IntRange(1, len(pipelines)))\n+        pipeline = pipelines[choice - 1]\n+        pipeline_id = pipeline[\"id\"]\n+        click.echo(f\"  Using pipeline: {pipeline.get('name')} ({pipeline_id})\")\n+\n+        pipeline_detail = http_get(glchat_url, token, f\"/admin/pipelines/{pipeline_id}\")\n+        if not pipeline_detail:\n+            click.echo(click.style(\"✗ Failed to fetch pipeline detail\", fg=\"red\"))\n+            return False\n+\n+        config_fields = (\n+            pipeline_detail.get(\"config_fields\")\n+            or pipeline_detail.get(\"fields\")\n+            or pipeline_detail.get(\"configFields\")\n+            or []\n+        )\n+\n+        model_id_field = next(\n+            (f for f in config_fields if f.get(\"name\") == _SUPPORTED_MODEL_IDS_FIELD),\n+            None,\n+        )\n+        if not model_id_field:\n+            click.echo(\n+                click.style(\n+                    f\"✗ `{_SUPPORTED_MODEL_IDS_FIELD}` field not found in pipeline config. \"\n+                    f\"Available fields: {[f.get('name') for f in config_fields]}\",\n+                    fg=\"red\",\n+                )\n+            )\n+            return False\n+\n+        data = http_post(\n+            glchat_url,\n+            token,\n+            \"/admin/presets\",\n+            {\n+                \"pipeline_preset_id\": preset_id,\n+                \"pipeline_id\": pipeline_id,\n+                \"config_payload\": [\n+                    {\n+                        \"id\": model_id_field[\"id\"],\n+                        \"value\": json.dumps([args[\"glchat_model_id\"]]),\n+                    }\n+                ],\n+            },\n+        )\n+        if data is None:\n+            return False\n+\n+        self._save(\"glchat_preset_id\", data.get(\"id\") or preset_id)\n+        self._save(\"glchat_pipeline_id\", pipeline_id)\n+\n+        click.echo(click.style(\"✓ GL Chat RAGO preset created\", fg=\"green\"))\n+        click.echo()\n+        return True"},{"sha":"e0a56e5d4144b801f6745acd768409f95ff30db4","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/create_provider_action.py","status":"added","additions":78,"deletions":0,"changes":78,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_provider_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_provider_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fcreate_provider_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,78 @@\n+import json\n+from typing import Any, Dict\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction\n+from src.common.request_client import http_get, http_post\n+\n+\n+class CreateProviderArgsModel(BaseModel):\n+    glchat_url: str\n+    username: str\n+    password: str\n+    provider_name: str\n+    provider_display_name: str\n+    glchat_key_name: str\n+\n+\n+class GlChatCreateProviderAction(BaseGlChatAction):\n+    def name(self) -> str:\n+        return \"glchat-create-provider\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            CreateProviderArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        click.echo(f\"Running `{self.name()}` action...\")\n+\n+        glchat_url = args[\"glchat_url\"]\n+        token = self._login(glchat_url, args[\"username\"], args[\"password\"])\n+        if token is None:\n+            return False\n+\n+        provider_env_kwargs = json.dumps({\"credentials\": args[\"glchat_key_name\"]})\n+\n+        data = http_post(\n+            glchat_url,\n+            token,\n+            \"/admin/providers\",\n+            {\n+                \"name\": args[\"provider_name\"],\n+                \"display_name\": args[\"provider_display_name\"],\n+                \"lm_invoker_type\": \"datasaur\",\n+                \"provider_kwargs\": \"{}\",\n+                \"provider_env_kwargs\": provider_env_kwargs,\n+                \"is_active\": True,\n+                \"icon\": \"\",\n+            },\n+        )\n+        if data is None:\n+            return False\n+\n+        provider_id = data.get(\"id\")\n+        if not provider_id:\n+            click.echo(\n+                click.style(\n+                    \"✗ Provider created but no `id` returned. Check the API response.\",\n+                    fg=\"red\",\n+                )\n+            )\n+            return False\n+\n+        self._save(\"glchat_provider_id\", provider_id)\n+\n+        click.echo(click.style(\"✓ GL Chat provider created\", fg=\"green\"))\n+        click.echo()\n+        return True"},{"sha":"6c0e0a609ccedae4b792b9f4fbf861914792670d","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/glchat/setup_action.py","status":"added","additions":147,"deletions":0,"changes":147,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fsetup_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fsetup_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fglchat%2Fsetup_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,147 @@\n+from typing import Any, Dict, Optional\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.glchat.base_glchat_action import BaseGlChatAction\n+from actions.glchat.create_app_action import GlChatCreateAppAction\n+from actions.glchat.create_env_action import GlChatCreateEnvAction\n+from actions.glchat.create_model_action import GlChatCreateModelAction\n+from actions.glchat.create_preset_action import GlChatCreatePresetAction\n+from actions.glchat.create_provider_action import GlChatCreateProviderAction\n+\n+\n+class GlChatSetupArgsModel(BaseModel):\n+    glchat_url: str\n+    username: str\n+    password: str\n+    glchat_key_name: str\n+    provider_name: str\n+    provider_display_name: str\n+    model_name: str\n+    model_display_name: str\n+    model_description: Optional[str] = None\n+    citations: str = \"true\"\n+    preset_id: Optional[str] = None\n+    chatbot_id: str\n+    glchat_app_name: str\n+    app_description: Optional[str] = \"\"\n+    deployment_url: Optional[str] = None\n+    llmlabs_api_key: Optional[str] = None\n+    user_id: Optional[str] = None\n+\n+\n+class GlChatSetupAction(BaseGlChatAction):\n+    def name(self) -> str:\n+        return \"glchat-configure\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            GlChatSetupArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+\n+        connection = {\n+            \"glchat_url\": args[\"glchat_url\"],\n+            \"username\": args[\"username\"],\n+            \"password\": args[\"password\"],\n+        }\n+\n+        deployment_url = args.get(\"deployment_url\") or self._from_state(\"deployment_url\")\n+        llmlabs_api_key = args.get(\"llmlabs_api_key\") or self._from_state(\"llmlabs_api_key\")\n+\n+        if not deployment_url:\n+            click.echo(\n+                click.style(\n+                    \"✗ deployment_url is missing. \"\n+                    \"Run `gl-chat-llmlabs` first, or provide it via the prompt.\",\n+                    fg=\"red\",\n+                )\n+            )\n+            return False\n+        if not llmlabs_api_key:\n+            click.echo(\n+                click.style(\n+                    \"✗ llmlabs_api_key is missing. \"\n+                    \"Run `gl-chat-llmlabs` first, or provide it via the prompt.\",\n+                    fg=\"red\",\n+                )\n+            )\n+            return False\n+\n+        # Step 2.1 — Create env var\n+        if not GlChatCreateEnvAction().run(context, {\n+            **connection,\n+            \"glchat_key_name\": args[\"glchat_key_name\"],\n+            \"llmlabs_api_key\": llmlabs_api_key,\n+        }):\n+            return False\n+\n+        # Step 2.2 — Create provider\n+        if not GlChatCreateProviderAction().run(context, {\n+            **connection,\n+            \"provider_name\": args[\"provider_name\"],\n+            \"provider_display_name\": args[\"provider_display_name\"],\n+            \"glchat_key_name\": args[\"glchat_key_name\"],\n+        }):\n+            return False\n+        provider_id = self._from_state(\"glchat_provider_id\")\n+        if not provider_id:\n+            click.echo(click.style(\"✗ glchat_provider_id not found in state\", fg=\"red\"))\n+            return False\n+\n+        # Step 2.3 — Create model\n+        if not GlChatCreateModelAction().run(context, {\n+            **connection,\n+            \"model_name\": args[\"model_name\"],\n+            \"model_display_name\": args[\"model_display_name\"],\n+            \"model_description\": args.get(\"model_description\"),\n+            \"deployment_url\": deployment_url,\n+            \"citations\": args.get(\"citations\", \"true\"),\n+            \"glchat_provider_id\": provider_id,\n+            \"glchat_key_name\": args.get(\"glchat_key_name\"),\n+        }):\n+            return False\n+        model_id = self._from_state(\"glchat_model_id\")\n+        if not model_id:\n+            click.echo(click.style(\"✗ glchat_model_id not found in state\", fg=\"red\"))\n+            return False\n+\n+        # Step 2.4 — Create RAGO preset\n+        if not GlChatCreatePresetAction().run(context, {\n+            **connection,\n+            \"glchat_model_id\": model_id,\n+        }):\n+            return False\n+        preset_id = self._from_state(\"glchat_preset_id\")\n+        if not preset_id:\n+            click.echo(click.style(\"✗ glchat_preset_id not found in state\", fg=\"red\"))\n+            return False\n+\n+        # Step 2.5 — Create GL Chat application\n+        if not GlChatCreateAppAction().run(context, {\n+            **connection,\n+            \"chatbot_id\": args[\"chatbot_id\"],\n+            \"glchat_app_name\": args[\"glchat_app_name\"],\n+            \"app_description\": args.get(\"app_description\") or \"\",\n+            \"glchat_preset_id\": preset_id,\n+            \"user_id\": args.get(\"user_id\"),\n+        }):\n+            return False\n+\n+        click.echo(click.style(\"✓ GL Chat configuration complete\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def _from_state(self, key: str) -> Optional[str]:\n+        value, ok = self.state_service.get(key)\n+        return value if ok and value else None"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/llmlabs/__init__.py","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2F__init__.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e"},{"sha":"e891766cdf998284f1a7f209f7183b5e357f4d9b","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/llmlabs/base_llmlabs_action.py","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2Fbase_llmlabs_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2Fbase_llmlabs_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2Fbase_llmlabs_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,19 @@\n+from typing import Any, Dict\n+\n+import click\n+\n+from src.action.action import Action\n+from src.common.helper import redact_if_sensitive\n+from src.common.state_service import StateService\n+\n+\n+class BaseLlmLabsAction(Action):\n+    def __init__(self):\n+        self.state_service = StateService()\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def _save(self, key: str, value: Any) -> None:\n+        self.state_service.set(key, value)\n+        click.echo(f\"  Saved {key} = {redact_if_sensitive(key, value)}\")"},{"sha":"c89a3f81e5954b359cfbc1024d7c7c4af2788584","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/actions/llmlabs/deploy_action.py","status":"added","additions":87,"deletions":0,"changes":87,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2Fdeploy_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2Fdeploy_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Factions%2Fllmlabs%2Fdeploy_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,87 @@\n+from typing import Any, Dict\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+\n+from actions.llmlabs.base_llmlabs_action import BaseLlmLabsAction\n+from src.common.request_client import get_access_token, graphql\n+\n+_MUTATION = \"\"\"\n+mutation UpsertLlmApplicationDeployment(\n+  $llmApplicationId: ID!\n+  $name: String!\n+  $baseLlmRagConfigId: ID!\n+) {\n+  upsertLlmApplicationDeployment(input: {\n+    llmApplicationId: $llmApplicationId\n+    name: $name\n+    baseLlmRagConfigId: $baseLlmRagConfigId\n+  }) {\n+    id\n+    llmApplication {\n+      teamId\n+    }\n+  }\n+}\n+\"\"\"\n+\n+\n+class DeployArgsModel(BaseModel):\n+    api_url: str\n+    client_id: str\n+    client_secret: str\n+    llm_application_id: str\n+    rag_config_id: str\n+    deployment_name: str\n+\n+\n+class LlmLabsDeployAction(BaseLlmLabsAction):\n+    def name(self) -> str:\n+        return \"llmlabs-deploy\"\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        click.echo(f\"Validating `{self.name()}` action...\")\n+        try:\n+            DeployArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            click.echo(e)\n+            click.echo(click.style(\"✗ Action is invalid\", fg=\"red\"))\n+            return False\n+        click.echo(click.style(\"✓ Action is valid\", fg=\"green\"))\n+        click.echo()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        click.echo(f\"Running `{self.name()}` action...\")\n+\n+        token = get_access_token(args[\"api_url\"], args[\"client_id\"], args[\"client_secret\"])\n+        if token is None:\n+            return False\n+\n+        data = graphql(\n+            url=f\"{args['api_url']}/graphql\",\n+            token=token,\n+            query=_MUTATION,\n+            variables={\n+                \"llmApplicationId\": args[\"llm_application_id\"],\n+                \"name\": args[\"deployment_name\"],\n+                \"baseLlmRagConfigId\": args[\"rag_config_id\"],\n+            },\n+        )\n+        if data is None:\n+            return False\n+\n+        deployment = data[\"upsertLlmApplicationDeployment\"]\n+        deployment_id = deployment[\"id\"]\n+        team_id = deployment[\"llmApplication\"][\"teamId\"]\n+\n+        # Construct the URL following the same pattern as generateUrlName in vulcan-backend:\n+        # ${appUrl}/api/deployment/${teamId}/${deploymentId}\n+        api_url = args[\"api_url\"].rstrip(\"/\")\n+        deployment_url = f\"{api_url}/api/deployment/{team_id}/{deployment_id}\"\n+        self._save(\"deployment_url\", deployment_url)\n+\n+        click.echo(click.style(\"✓ Application deployed\", fg=\"green\"))\n+        click.echo()\n+        return True"},{"sha":"680614e82916e6a0c9b5b0379dc1117713adaa80","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/config.yaml.example","status":"added","additions":39,"deletions":0,"changes":39,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Fconfig.yaml.example","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Fconfig.yaml.example","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Fconfig.yaml.example?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,39 @@\n+# Config for: datasaur-cli gl-chat-setup  (or gl-chat-llmlabs)\n+# Usage: datasaur-cli gl-chat-setup --config examples/gl-chat-setup/config.yaml\n+# This runs both Phase 1 (LLM Labs) and Phase 2 (GL Chat) in one go.\n+\n+# ── Phase 1: LLM Labs ────────────────────────────────────────────────────────\n+api_url: https://app.datasaur.ai\n+team_id: \"1\"\n+client_id: your-client-id\n+client_secret: your-client-secret\n+\n+kb_name: My Knowledge Base\n+kb_provider: DATASAUR            # DATASAUR or EXTERNAL\n+embedding_model_id: \"\"           # Leave blank if kb_provider is EXTERNAL\n+collection_id: \"\"                # Leave blank if kb_provider is DATASAUR\n+\n+app_name: My LLM Application\n+rag_config_name: default\n+model_id: your-model-id\n+deployment_name: deployment\n+llmlabs_key_name: LLM LABS API KEY\n+\n+# ── Phase 2: GL Chat ─────────────────────────────────────────────────────────\n+glchat_url: http://localhost:8000\n+username: admin\n+password: your-admin-password\n+\n+glchat_key_name: LLMLABS_API_KEY\n+\n+provider_name: llmlabs-rag\n+provider_display_name: LLM Labs RAG\n+\n+model_name: llmlabs-rag-model\n+model_display_name: LLM Labs RAG Model\n+model_description: \"\"\n+citations: \"true\"\n+\n+chatbot_id: llmlabs-rag-app\n+glchat_app_name: My RAG App\n+app_description: \"\""},{"sha":"0b387f3bc82fc3ae6103ba7751422a128cf5d9e1","filename":"on-premise/datasaur-cli/examples/gl-chat-setup/manifest.yaml","status":"added","additions":928,"deletions":0,"changes":928,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Fmanifest.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Fmanifest.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fexamples%2Fgl-chat-setup%2Fmanifest.yaml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,928 @@\n+commands:\n+\n+  # ── Phase 1: LLM Labs — all steps in one command ─────────────────────────────\n+  gl-chat-llmlabs:\n+    config: true\n+    actions:\n+      # Step 1.1 — Create Knowledge Base\n+      - action: datasaur-graphql\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL (e.g. https://app.datasaur.ai)\"\n+          team_id:\n+            text: \"Team ID\"\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          kb_name:\n+            text: \"Knowledge Base name\"\n+          kb_provider:\n+            text: \"Vector Store Provider (DATASAUR or EXTERNAL)\"\n+            default: \"DATASAUR\"\n+          embedding_model_id:\n+            text: \"Embedding Model ID (leave blank if provider is EXTERNAL)\"\n+            default: \"\"\n+          collection_id:\n+            text: \"Collection ID (leave blank if provider is DATASAUR)\"\n+            default: \"\"\n+          app_name:\n+            text: \"Application name\"\n+          rag_config_name:\n+            text: \"RAG Config name\"\n+            default: \"default\"\n+          model_id:\n+            text: \"LLM Model ID\"\n+          deployment_name:\n+            text: \"Deployment name\"\n+            default: \"deployment\"\n+          llmlabs_key_name:\n+            text: \"API Key name (for the deployed application)\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmVectorStore(\n+              $name: String!\n+              $teamId: ID!\n+              $provider: GqlLlmVectorStoreProvider!\n+              $llmEmbeddingModelId: ID\n+              $collectionId: String\n+            ) {\n+              createLlmVectorStore(input: {\n+                name: $name\n+                teamId: $teamId\n+                provider: $provider\n+                llmEmbeddingModelId: $llmEmbeddingModelId\n+                collectionId: $collectionId\n+              }) {\n+                id\n+              }\n+            }\n+          variables:\n+            name: \"{prompts[kb_name]}\"\n+            teamId: \"{prompts[team_id]}\"\n+            provider: \"{prompts[kb_provider]}\"\n+            llmEmbeddingModelId: \"{prompts[embedding_model_id]}\"\n+            collectionId: \"{prompts[collection_id]}\"\n+          save_state:\n+            vector_store_id: \"createLlmVectorStore.id\"\n+          display_name: \"Create Knowledge Base\"\n+\n+      # Step 1.2a — Create LLM Application (get auto-assigned ID)\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmApplication($teamId: ID!) {\n+              createLlmApplication(teamId: $teamId) {\n+                id\n+              }\n+            }\n+          variables:\n+            teamId: \"{prompts[team_id]}\"\n+          save_state:\n+            llm_application_id: \"createLlmApplication.id\"\n+          display_name: \"Create LLM Application\"\n+\n+      # Step 1.2b — Set application name\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation UpdateLlmApplication($id: ID!, $name: String!) {\n+              updateLlmApplication(input: {id: $id, name: $name}) {\n+                id\n+                name\n+              }\n+            }\n+          variables:\n+            id: \"{state[llm_application_id]}\"\n+            name: \"{prompts[app_name]}\"\n+          display_name: \"Set Application Name\"\n+\n+      # Step 1.3a — Create RAG Config\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmApplicationPlaygroundRagConfig(\n+              $llmApplicationId: ID!\n+              $name: String\n+            ) {\n+              createLlmApplicationPlaygroundRagConfig(input: {\n+                llmApplicationId: $llmApplicationId\n+                name: $name\n+              }) {\n+                id\n+              }\n+            }\n+          variables:\n+            llmApplicationId: \"{state[llm_application_id]}\"\n+            name: \"{prompts[rag_config_name]}\"\n+          save_state:\n+            playground_rag_config_id: \"createLlmApplicationPlaygroundRagConfig.id\"\n+          display_name: \"Create RAG Config\"\n+\n+      # Step 1.3b — Attach model + vector store to RAG Config\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation UpdateLlmApplicationPlaygroundRagConfig(\n+              $id: ID!\n+              $llmModelId: ID\n+              $llmVectorStoreIds: [ID!]\n+            ) {\n+              updateLlmApplicationPlaygroundRagConfig(input: {\n+                id: $id\n+                llmRagConfigInput: {\n+                  llmModelId: $llmModelId\n+                  llmVectorStoreIds: $llmVectorStoreIds\n+                }\n+              }) {\n+                id\n+                llmRagConfig {\n+                  id\n+                }\n+              }\n+            }\n+          variables:\n+            id: \"{state[playground_rag_config_id]}\"\n+            llmModelId: \"{prompts[model_id]}\"\n+            llmVectorStoreIds:\n+              - \"{state[vector_store_id]}\"\n+          save_state:\n+            rag_config_id: \"updateLlmApplicationPlaygroundRagConfig.llmRagConfig.id\"\n+          display_name: \"Attach Model + Vector Store\"\n+\n+      # Step 1.4 — Deploy application\n+      - action: llmlabs-deploy\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          llm_application_id: \"{state[llm_application_id]}\"\n+          rag_config_id: \"{state[rag_config_id]}\"\n+          deployment_name: \"{prompts[deployment_name]}\"\n+\n+      # Step 1.5 — Create API Key\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateTeamApiKey($teamId: ID!, $name: String!) {\n+              createTeamApiKey(input: {teamId: $teamId, name: $name}) {\n+                key\n+              }\n+            }\n+          variables:\n+            teamId: \"{prompts[team_id]}\"\n+            name: \"{prompts[llmlabs_key_name]}\"\n+          save_state:\n+            llmlabs_api_key: \"createTeamApiKey.key\"\n+          display_name: \"Create API Key\"\n+\n+\n+  # ── Phase 1 + Phase 2: full end-to-end setup ─────────────────────────────────\n+  gl-chat-setup:\n+    config: true\n+    actions:\n+      # Steps 1.1–1.5 (same as gl-chat-llmlabs)\n+      - action: datasaur-graphql\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL (e.g. https://app.datasaur.ai)\"\n+          team_id:\n+            text: \"Team ID\"\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          kb_name:\n+            text: \"Knowledge Base name\"\n+          kb_provider:\n+            text: \"Vector Store Provider (DATASAUR or EXTERNAL)\"\n+            default: \"DATASAUR\"\n+          embedding_model_id:\n+            text: \"Embedding Model ID (leave blank if provider is EXTERNAL)\"\n+            default: \"\"\n+          collection_id:\n+            text: \"Collection ID (leave blank if provider is DATASAUR)\"\n+            default: \"\"\n+          app_name:\n+            text: \"Application name\"\n+          rag_config_name:\n+            text: \"RAG Config name\"\n+            default: \"default\"\n+          model_id:\n+            text: \"LLM Model ID\"\n+          deployment_name:\n+            text: \"Deployment name\"\n+            default: \"deployment\"\n+          llmlabs_key_name:\n+            text: \"API Key name (for the deployed application)\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmVectorStore(\n+              $name: String!\n+              $teamId: ID!\n+              $provider: GqlLlmVectorStoreProvider!\n+              $llmEmbeddingModelId: ID\n+              $collectionId: String\n+            ) {\n+              createLlmVectorStore(input: {\n+                name: $name\n+                teamId: $teamId\n+                provider: $provider\n+                llmEmbeddingModelId: $llmEmbeddingModelId\n+                collectionId: $collectionId\n+              }) {\n+                id\n+              }\n+            }\n+          variables:\n+            name: \"{prompts[kb_name]}\"\n+            teamId: \"{prompts[team_id]}\"\n+            provider: \"{prompts[kb_provider]}\"\n+            llmEmbeddingModelId: \"{prompts[embedding_model_id]}\"\n+            collectionId: \"{prompts[collection_id]}\"\n+          save_state:\n+            vector_store_id: \"createLlmVectorStore.id\"\n+          display_name: \"Create Knowledge Base\"\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmApplication($teamId: ID!) {\n+              createLlmApplication(teamId: $teamId) {\n+                id\n+              }\n+            }\n+          variables:\n+            teamId: \"{prompts[team_id]}\"\n+          save_state:\n+            llm_application_id: \"createLlmApplication.id\"\n+          display_name: \"Create LLM Application\"\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation UpdateLlmApplication($id: ID!, $name: String!) {\n+              updateLlmApplication(input: {id: $id, name: $name}) {\n+                id\n+                name\n+              }\n+            }\n+          variables:\n+            id: \"{state[llm_application_id]}\"\n+            name: \"{prompts[app_name]}\"\n+          display_name: \"Set Application Name\"\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmApplicationPlaygroundRagConfig(\n+              $llmApplicationId: ID!\n+              $name: String\n+            ) {\n+              createLlmApplicationPlaygroundRagConfig(input: {\n+                llmApplicationId: $llmApplicationId\n+                name: $name\n+              }) {\n+                id\n+              }\n+            }\n+          variables:\n+            llmApplicationId: \"{state[llm_application_id]}\"\n+            name: \"{prompts[rag_config_name]}\"\n+          save_state:\n+            playground_rag_config_id: \"createLlmApplicationPlaygroundRagConfig.id\"\n+          display_name: \"Create RAG Config\"\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation UpdateLlmApplicationPlaygroundRagConfig(\n+              $id: ID!\n+              $llmModelId: ID\n+              $llmVectorStoreIds: [ID!]\n+            ) {\n+              updateLlmApplicationPlaygroundRagConfig(input: {\n+                id: $id\n+                llmRagConfigInput: {\n+                  llmModelId: $llmModelId\n+                  llmVectorStoreIds: $llmVectorStoreIds\n+                }\n+              }) {\n+                id\n+                llmRagConfig {\n+                  id\n+                }\n+              }\n+            }\n+          variables:\n+            id: \"{state[playground_rag_config_id]}\"\n+            llmModelId: \"{prompts[model_id]}\"\n+            llmVectorStoreIds:\n+              - \"{state[vector_store_id]}\"\n+          save_state:\n+            rag_config_id: \"updateLlmApplicationPlaygroundRagConfig.llmRagConfig.id\"\n+          display_name: \"Attach Model + Vector Store\"\n+      - action: llmlabs-deploy\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          llm_application_id: \"{state[llm_application_id]}\"\n+          rag_config_id: \"{state[rag_config_id]}\"\n+          deployment_name: \"{prompts[deployment_name]}\"\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateTeamApiKey($teamId: ID!, $name: String!) {\n+              createTeamApiKey(input: {teamId: $teamId, name: $name}) {\n+                key\n+              }\n+            }\n+          variables:\n+            teamId: \"{prompts[team_id]}\"\n+            name: \"{prompts[llmlabs_key_name]}\"\n+          save_state:\n+            llmlabs_api_key: \"createTeamApiKey.key\"\n+          display_name: \"Create API Key\"\n+      # Phase 2 — Configure GL Chat\n+      # deployment_url and llmlabs_api_key are read from state by glchat-configure\n+      - action: glchat-configure\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL (e.g. http://localhost:8000)\"\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          glchat_key_name:\n+            text: \"Env var name for LLM Labs API key (e.g. LLMLABS_API_KEY)\"\n+          provider_name:\n+            text: \"Provider internal name (no spaces, e.g. llmlabs-rag)\"\n+          provider_display_name:\n+            text: \"Provider display name\"\n+          model_name:\n+            text: \"Model internal name (no spaces)\"\n+          model_display_name:\n+            text: \"Model display name\"\n+          model_description:\n+            text: \"Model description (leave blank to use display name)\"\n+            default: \"\"\n+          citations:\n+            text: \"Enable citations? (true/false)\"\n+            default: \"true\"\n+          chatbot_id:\n+            text: \"Chatbot ID (unique slug, e.g. llmlabs-rag-app)\"\n+          glchat_app_name:\n+            text: \"GL Chat application name\"\n+          app_description:\n+            text: \"Description\"\n+            default: \"\"\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          glchat_key_name: \"{prompts[glchat_key_name]}\"\n+          provider_name: \"{prompts[provider_name]}\"\n+          provider_display_name: \"{prompts[provider_display_name]}\"\n+          model_name: \"{prompts[model_name]}\"\n+          model_display_name: \"{prompts[model_display_name]}\"\n+          model_description: \"{prompts[model_description]}\"\n+          citations: \"{prompts[citations]}\"\n+          chatbot_id: \"{prompts[chatbot_id]}\"\n+          glchat_app_name: \"{prompts[glchat_app_name]}\"\n+          app_description: \"{prompts[app_description]}\"\n+          # deployment_url and llmlabs_api_key intentionally omitted —\n+          # glchat-configure reads them from state (written by Phase 1 above)\n+\n+\n+  # ── Phase 1 individual steps ──────────────────────────────────────────────────\n+  # Run in order: create-kb → create-app → create-rag-config → deploy → create-api-key\n+  # Each command persists its output to state.yaml; subsequent steps auto-fill from state.\n+\n+  # Step 1.1 — Create Knowledge Base\n+  gl-chat-create-kb:\n+    config: true\n+    actions:\n+      - action: datasaur-graphql\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL (e.g. https://app.datasaur.ai)\"\n+          team_id:\n+            text: \"Team ID\"\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          kb_name:\n+            text: \"Knowledge Base name\"\n+          kb_provider:\n+            text: \"Vector Store Provider (DATASAUR or EXTERNAL)\"\n+            default: \"DATASAUR\"\n+          embedding_model_id:\n+            text: \"Embedding Model ID (leave blank if provider is EXTERNAL)\"\n+            default: \"\"\n+          collection_id:\n+            text: \"Collection ID (leave blank if provider is DATASAUR)\"\n+            default: \"\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmVectorStore(\n+              $name: String!\n+              $teamId: ID!\n+              $provider: GqlLlmVectorStoreProvider!\n+              $llmEmbeddingModelId: ID\n+              $collectionId: String\n+            ) {\n+              createLlmVectorStore(input: {\n+                name: $name\n+                teamId: $teamId\n+                provider: $provider\n+                llmEmbeddingModelId: $llmEmbeddingModelId\n+                collectionId: $collectionId\n+              }) {\n+                id\n+              }\n+            }\n+          variables:\n+            name: \"{prompts[kb_name]}\"\n+            teamId: \"{prompts[team_id]}\"\n+            provider: \"{prompts[kb_provider]}\"\n+            llmEmbeddingModelId: \"{prompts[embedding_model_id]}\"\n+            collectionId: \"{prompts[collection_id]}\"\n+          save_state:\n+            vector_store_id: \"createLlmVectorStore.id\"\n+          display_name: \"Create Knowledge Base\"\n+\n+  # Step 1.2 — Create LLM Application (lazy state chains create → set-name)\n+  gl-chat-create-app:\n+    config: true\n+    actions:\n+      - action: datasaur-graphql\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL\"\n+            default_from_state: api_url\n+          team_id:\n+            text: \"Team ID\"\n+            default_from_state: team_id\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          app_name:\n+            text: \"Application name\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmApplication($teamId: ID!) {\n+              createLlmApplication(teamId: $teamId) {\n+                id\n+              }\n+            }\n+          variables:\n+            teamId: \"{prompts[team_id]}\"\n+          save_state:\n+            llm_application_id: \"createLlmApplication.id\"\n+          display_name: \"Create LLM Application\"\n+      - action: datasaur-graphql\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation UpdateLlmApplication($id: ID!, $name: String!) {\n+              updateLlmApplication(input: {id: $id, name: $name}) {\n+                id\n+                name\n+              }\n+            }\n+          variables:\n+            id: \"{state[llm_application_id]}\"\n+            name: \"{prompts[app_name]}\"\n+          display_name: \"Set Application Name\"\n+\n+  # Step 1.3 — Create RAG Config (lazy state chains create → attach)\n+  gl-chat-create-rag-config:\n+    config: true\n+    actions:\n+      - action: datasaur-graphql\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL\"\n+            default_from_state: api_url\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          llm_application_id:\n+            text: \"LLM Application ID\"\n+            default_from_state: llm_application_id\n+          rag_config_name:\n+            text: \"RAG Config name\"\n+            default: \"default\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateLlmApplicationPlaygroundRagConfig(\n+              $llmApplicationId: ID!\n+              $name: String\n+            ) {\n+              createLlmApplicationPlaygroundRagConfig(input: {\n+                llmApplicationId: $llmApplicationId\n+                name: $name\n+              }) {\n+                id\n+              }\n+            }\n+          variables:\n+            llmApplicationId: \"{prompts[llm_application_id]}\"\n+            name: \"{prompts[rag_config_name]}\"\n+          save_state:\n+            playground_rag_config_id: \"createLlmApplicationPlaygroundRagConfig.id\"\n+          display_name: \"Create RAG Config\"\n+      - action: datasaur-graphql\n+        prompts:\n+          model_id:\n+            text: \"LLM Model ID\"\n+          vector_store_id:\n+            text: \"Vector Store ID\"\n+            default_from_state: vector_store_id\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation UpdateLlmApplicationPlaygroundRagConfig(\n+              $id: ID!\n+              $llmModelId: ID\n+              $llmVectorStoreIds: [ID!]\n+            ) {\n+              updateLlmApplicationPlaygroundRagConfig(input: {\n+                id: $id\n+                llmRagConfigInput: {\n+                  llmModelId: $llmModelId\n+                  llmVectorStoreIds: $llmVectorStoreIds\n+                }\n+              }) {\n+                id\n+                llmRagConfig {\n+                  id\n+                }\n+              }\n+            }\n+          variables:\n+            id: \"{state[playground_rag_config_id]}\"\n+            llmModelId: \"{prompts[model_id]}\"\n+            llmVectorStoreIds:\n+              - \"{prompts[vector_store_id]}\"\n+          save_state:\n+            rag_config_id: \"updateLlmApplicationPlaygroundRagConfig.llmRagConfig.id\"\n+          display_name: \"Attach Model + Vector Store\"\n+\n+  # Step 1.4 — Deploy application\n+  gl-chat-deploy:\n+    config: true\n+    actions:\n+      - action: llmlabs-deploy\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL\"\n+            default_from_state: api_url\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          llm_application_id:\n+            text: \"LLM Application ID\"\n+            default_from_state: llm_application_id\n+          rag_config_id:\n+            text: \"RAG Config ID\"\n+            default_from_state: rag_config_id\n+          deployment_name:\n+            text: \"Deployment name\"\n+            default: \"deployment\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          llm_application_id: \"{prompts[llm_application_id]}\"\n+          rag_config_id: \"{prompts[rag_config_id]}\"\n+          deployment_name: \"{prompts[deployment_name]}\"\n+\n+  # Step 1.5 — Create API Key\n+  gl-chat-create-api-key:\n+    config: true\n+    actions:\n+      - action: datasaur-graphql\n+        prompts:\n+          api_url:\n+            text: \"Datasaur API URL\"\n+            default_from_state: api_url\n+          team_id:\n+            text: \"Team ID\"\n+            default_from_state: team_id\n+          client_id:\n+            text: \"Client ID\"\n+          client_secret:\n+            text: \"Client Secret\"\n+            hide_input: true\n+          llmlabs_key_name:\n+            text: \"API Key name (for the deployed application)\"\n+        args:\n+          api_url: \"{prompts[api_url]}\"\n+          team_id: \"{prompts[team_id]}\"\n+          client_id: \"{prompts[client_id]}\"\n+          client_secret: \"{prompts[client_secret]}\"\n+          mutation: |\n+            mutation CreateTeamApiKey($teamId: ID!, $name: String!) {\n+              createTeamApiKey(input: {teamId: $teamId, name: $name}) {\n+                key\n+              }\n+            }\n+          variables:\n+            teamId: \"{prompts[team_id]}\"\n+            name: \"{prompts[llmlabs_key_name]}\"\n+          save_state:\n+            llmlabs_api_key: \"createTeamApiKey.key\"\n+          display_name: \"Create API Key\"\n+\n+\n+  # ── Phase 2: GL Chat — all steps via orchestrator ─────────────────────────────\n+  gl-chat-configure:\n+    config: true\n+    actions:\n+      - action: glchat-configure\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL (e.g. http://localhost:8000)\"\n+            default_from_state: glchat_url\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          deployment_url:\n+            text: \"LLM Labs deployment URL\"\n+            default_from_state: deployment_url\n+          llmlabs_api_key:\n+            text: \"LLM Labs API key\"\n+            hide_input: true\n+            default_from_state: llmlabs_api_key\n+          glchat_key_name:\n+            text: \"Env var name for LLM Labs API key (e.g. LLMLABS_API_KEY)\"\n+            default_from_state: glchat_key_name\n+          provider_name:\n+            text: \"Provider internal name (no spaces, e.g. llmlabs-rag)\"\n+          provider_display_name:\n+            text: \"Provider display name\"\n+          model_name:\n+            text: \"Model internal name (no spaces)\"\n+          model_display_name:\n+            text: \"Model display name\"\n+          model_description:\n+            text: \"Model description (leave blank to use display name)\"\n+            default: \"\"\n+          citations:\n+            text: \"Enable citations? (true/false)\"\n+            default: \"true\"\n+          chatbot_id:\n+            text: \"Chatbot ID (unique slug, e.g. llmlabs-rag-app)\"\n+          glchat_app_name:\n+            text: \"GL Chat application name\"\n+          app_description:\n+            text: \"Description\"\n+            default: \"\"\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          deployment_url: \"{prompts[deployment_url]}\"\n+          llmlabs_api_key: \"{prompts[llmlabs_api_key]}\"\n+          glchat_key_name: \"{prompts[glchat_key_name]}\"\n+          provider_name: \"{prompts[provider_name]}\"\n+          provider_display_name: \"{prompts[provider_display_name]}\"\n+          model_name: \"{prompts[model_name]}\"\n+          model_display_name: \"{prompts[model_display_name]}\"\n+          model_description: \"{prompts[model_description]}\"\n+          citations: \"{prompts[citations]}\"\n+          chatbot_id: \"{prompts[chatbot_id]}\"\n+          glchat_app_name: \"{prompts[glchat_app_name]}\"\n+          app_description: \"{prompts[app_description]}\"\n+\n+\n+  # ── Phase 2 individual steps ──────────────────────────────────────────────────\n+  # Run in order: create-env → create-provider → create-model → create-preset → create-chatbot\n+\n+  # Step 2.1 — Create env var (store LLM Labs API key)\n+  gl-chat-create-env:\n+    config: true\n+    actions:\n+      - action: glchat-create-env\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL\"\n+            default_from_state: glchat_url\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          glchat_key_name:\n+            text: \"Env var name for LLM Labs API key (e.g. LLMLABS_API_KEY)\"\n+            default_from_state: glchat_key_name\n+          llmlabs_api_key:\n+            text: \"LLM Labs API key value\"\n+            hide_input: true\n+            default_from_state: llmlabs_api_key\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          glchat_key_name: \"{prompts[glchat_key_name]}\"\n+          llmlabs_api_key: \"{prompts[llmlabs_api_key]}\"\n+\n+  # Step 2.2 — Create provider\n+  gl-chat-create-provider:\n+    config: true\n+    actions:\n+      - action: glchat-create-provider\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL\"\n+            default_from_state: glchat_url\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          provider_name:\n+            text: \"Provider internal name (no spaces, e.g. llmlabs-rag)\"\n+          provider_display_name:\n+            text: \"Provider display name\"\n+          glchat_key_name:\n+            text: \"Env var name holding the LLM Labs API key\"\n+            default_from_state: glchat_key_name\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          provider_name: \"{prompts[provider_name]}\"\n+          provider_display_name: \"{prompts[provider_display_name]}\"\n+          glchat_key_name: \"{prompts[glchat_key_name]}\"\n+\n+  # Step 2.3 — Create model\n+  gl-chat-create-model:\n+    config: true\n+    actions:\n+      - action: glchat-create-model\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL\"\n+            default_from_state: glchat_url\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          model_name:\n+            text: \"Model internal name (no spaces)\"\n+          model_display_name:\n+            text: \"Model display name\"\n+          model_description:\n+            text: \"Model description (leave blank to use display name)\"\n+            default: \"\"\n+          deployment_url:\n+            text: \"LLM Labs deployment URL\"\n+            default_from_state: deployment_url\n+          citations:\n+            text: \"Enable citations? (true/false)\"\n+            default: \"true\"\n+          glchat_provider_id:\n+            text: \"GL Chat provider ID\"\n+            default_from_state: glchat_provider_id\n+          glchat_key_name:\n+            text: \"Env var name holding the LLM Labs API key\"\n+            default_from_state: glchat_key_name\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          model_name: \"{prompts[model_name]}\"\n+          model_display_name: \"{prompts[model_display_name]}\"\n+          model_description: \"{prompts[model_description]}\"\n+          deployment_url: \"{prompts[deployment_url]}\"\n+          citations: \"{prompts[citations]}\"\n+          glchat_provider_id: \"{prompts[glchat_provider_id]}\"\n+          glchat_key_name: \"{prompts[glchat_key_name]}\"\n+\n+  # Step 2.4 — Create RAGO preset\n+  gl-chat-create-preset:\n+    config: true\n+    actions:\n+      - action: glchat-create-preset\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL\"\n+            default_from_state: glchat_url\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          glchat_model_id:\n+            text: \"GL Chat model ID\"\n+            default_from_state: glchat_model_id\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          glchat_model_id: \"{prompts[glchat_model_id]}\"\n+\n+  # Step 2.5 — Create GL Chat application (chatbot)\n+  gl-chat-create-chatbot:\n+    config: true\n+    actions:\n+      - action: glchat-create-app\n+        prompts:\n+          glchat_url:\n+            text: \"GL Chat Admin URL\"\n+            default_from_state: glchat_url\n+          username:\n+            text: \"Admin username\"\n+          password:\n+            text: \"Admin password\"\n+            hide_input: true\n+          chatbot_id:\n+            text: \"Chatbot ID (unique slug, e.g. llmlabs-rag-app)\"\n+          glchat_app_name:\n+            text: \"GL Chat application name\"\n+          app_description:\n+            text: \"Description\"\n+            default: \"\"\n+          glchat_preset_id:\n+            text: \"GL Chat preset ID\"\n+            default_from_state: glchat_preset_id\n+          user_id:\n+            text: \"Admin user ID (leave blank to auto-detect)\"\n+            default: \"\"\n+        args:\n+          glchat_url: \"{prompts[glchat_url]}\"\n+          username: \"{prompts[username]}\"\n+          password: \"{prompts[password]}\"\n+          chatbot_id: \"{prompts[chatbot_id]}\"\n+          glchat_app_name: \"{prompts[glchat_app_name]}\"\n+          app_description: \"{prompts[app_description]}\"\n+          glchat_preset_id: \"{prompts[glchat_preset_id]}\"\n+          user_id: \"{prompts[user_id]}\""},{"sha":"c06b7bf9ef627711df26e4c05e37fd7885fb267b","filename":"on-premise/datasaur-cli/manifest.yaml","status":"added","additions":225,"deletions":0,"changes":225,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fmanifest.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fmanifest.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fmanifest.yaml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,225 @@\n+version: \"${DOCKER_TAG}\"\n+\n+# command_modules lets you extend the CLI with external feature packages.\n+# Each entry is a directory that must contain:\n+#   - manifest.yaml        (commands fragment — only `commands:` key is read)\n+#   - actions/__init__.py  (must define get_actions() -> List[Action])\n+#\n+# The CLI merges the module's commands into this manifest and dynamically\n+# loads its Python action classes at startup. No binary rebuild needed.\n+#\n+# Example (uncomment to activate):\n+# command_modules:\n+#   - examples/gl-chat-setup\n+#\n+# See docs/manifest.md § command_modules for full details.\n+\n+operating_systems:\n+  ubuntu: \">=20.04\"\n+  rhel: \">=9\"\n+software_requirements:\n+  docker: \">=28.5.2\"\n+  docker-compose: \">=2.40.3\"\n+services:\n+  - name: backend\n+    image: vulcan-ai/vulcan/backend:6.144.0\n+    file_path: ./images/vulcan-ai-vulcan-backend-6.144.0.tar.gz\n+  - name: frontend\n+    image: vulcan-ai/vulcan/frontend:6.144.0\n+    file_path: ./images/vulcan-ai-vulcan-frontend-6.144.0.tar.gz\n+commands:\n+  hello:\n+    - action: hello-world\n+      options:\n+        name:\n+          required: true\n+          short: n\n+          type: string\n+      prompts:\n+        install_dir:\n+          text: \"Installation directory\"\n+          default: /usr/local/\n+          hide_input: false\n+      args:\n+        name: \"{options[name]}\"\n+        install_dir: \"{prompts[install_dir]}\"\n+        files:\n+          - file_path: install.sh\n+    - action: hello-world\n+      options:\n+        name:\n+          required: true\n+          short: n\n+          type: string\n+        age:\n+          short: a\n+          type: integer\n+      prompts:\n+        install_dir:\n+          text: \"Installation directory\"\n+          default: /usr/local/\n+          hide_input: false\n+      args:\n+        name: \"{options[name]}\"\n+        age: \"{options[age]}\"\n+        biodata: \"{options[name]} - {options[age]}\"\n+        install_dir: \"{prompts[install_dir]}\"\n+        files:\n+          - file_path: install.sh\n+          - file_path: run.sh\n+  install:\n+    - action: load-docker-images\n+  configure:\n+    - action: run-workflow\n+      args:\n+        workflow:\n+          - vector-db\n+        actions:\n+          - name: main-menu\n+            action: switch-input\n+            title: \"Select which service you want to configure:\"\n+            cases:\n+              - name: Database\n+                action: database-menu\n+              - name: \"Vector Database\"\n+                action: vector-db\n+          - name: database-menu\n+            action: switch-input\n+            title: \"Which database service do you want?\"\n+            cases:\n+              - name: \"Managed service (e.g. AWS RDS)\"\n+                action: database.managed-service\n+              - name: \"Self-managed service (e.g. MariaDB as Docker container)\"\n+                action: database.self-managed-service\n+          - name: database.managed-service\n+            action: set-environment-variables\n+            title: \"Database Managed Service\"\n+            prompts:\n+              DATABASE_HOST:\n+                text: \"Database Host\"\n+                required: true\n+              DATABASE_PORT:\n+                text: \"Database Port\"\n+                required: true\n+              DATABASE_USERNAME:\n+                text: \"Database Username\"\n+                required: true\n+              DATABASE_PASSWORD:\n+                text: \"Database Password\"\n+                required: true\n+              DATABASE_NAME:\n+                text: \"Database Name\"\n+                required: true\n+            targets:\n+              - file_path: datasaur.env\n+                values:\n+                  INSTALLATION_PATH: \"prompts[DATABASE_HOST]\"\n+                  DATABASE_HOST: \"prompts[DATABASE_HOST]\"\n+                  DATABASE_PORT: \"prompts[DATABASE_PORT]\"\n+                  DATABASE_USERNAME: \"prompts[DATABASE_USERNAME]\"\n+                  DATABASE_PASSWORD: \"prompts[DATABASE_PASSWORD]\"\n+                  DATABASE_NAME: \"prompts[DATABASE_NAME]\"\n+          - name: database.self-managed-service\n+            action: set-environment-variables\n+            title: \"Database Self-Managed Service\"\n+            prompts:\n+              DATABASE_USERNAME:\n+                text: \"Database Username\"\n+                generate: true\n+                generate_length: 8\n+                min_length: 4\n+                required: true\n+              DATABASE_PASSWORD:\n+                text: \"Database Password\"\n+                generate: true\n+                generate_length: 8\n+                min_length: 4\n+                required: true\n+              DATABASE_NAME:\n+                text: \"Database Name\"\n+                generate: true\n+                generate_length: 4\n+                min_length: 4\n+                required: true\n+            targets:\n+              - file_path: datasaur.env\n+                values:\n+                  DATABASE_HOST: \"localhost\"\n+                  DATABASE_PORT: \"3306\"\n+                  DATABASE_USERNAME: \"prompts[DATABASE_USERNAME]\"\n+                  DATABASE_PASSWORD: \"prompts[DATABASE_PASSWORD]\"\n+                  DATABASE_NAME: \"prompts[DATABASE_NAME]\"\n+          - name: vector-db\n+            action: set-environment-variables\n+            title: \"Vector DB\"\n+            prompts:\n+              OPENSEARCH_USERNAME:\n+                text: \"OpenSearch Username\"\n+                description: \"This is the login credential's username. It can be filled with any string.\"\n+                generate: true\n+                generate_length: 8\n+                required: true\n+              OPENSEARCH_PASSWORD:\n+                text: \"OpenSearch Password\"\n+                description: \"This is the login credential's password. It can be filled with any string.\"\n+                generate: true\n+                generate_length: 8\n+                required: true\n+            targets:\n+              - file_path: vector-db.env\n+                values:\n+                  OPENSEARCH_USERNAME: \"prompts[OPENSEARCH_USERNAME]\"\n+                  OPENSEARCH_PASSWORD: \"prompts[OPENSEARCH_PASSWORD]\"\n+  start:\n+    - action: create-docker-resources\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        networks:\n+          - datasaur\n+        volumes:\n+          - vulcan_db_data\n+    - action: validate-files\n+      args:\n+        files:\n+          - path: folder1/folder\n+            permissions: 0644\n+            owner: \"$(id -u):$(id -g)\"\n+          - path: folder1/file1\n+            permissions: 0644\n+            owner: \"$(id -u):$(id -g)\"\n+          - path: folder/*\n+            permissions: 0644\n+            owner: \"$(id -u):$(id -g)\"\n+    - action: script-runner\n+      options:\n+        name:\n+          required: true\n+          short: n\n+          type: string\n+      prompts:\n+        install_dir:\n+          text: \"Installation directory\"\n+          default: /usr/local/\n+          hide_input: false\n+      args:\n+        scripts:\n+          - name: migrate\n+            file_path: ./migrate.sh\n+            args:\n+              - --name\n+              - \"{options[name]}\"\n+              - --install_dir\n+              - \"{prompts[install_dir]}\"\n+    - action: docker-compose-up\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+  stop:\n+    - action: docker-compose-down\n+      args:\n+        docker_compose_file: docker-compose.yaml\n+        env_files:\n+          - datasaur.env\n+  # gl-chat-* commands ship as an external module under examples/gl-chat-setup/.\n+  # To activate them, uncomment `command_modules` at the top of this file."},{"sha":"5a85e8f542bcf95bf4220fdab1c6e6b39dd1fc48","filename":"on-premise/datasaur-cli/pyproject.toml","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fpyproject.toml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fpyproject.toml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fpyproject.toml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,23 @@\n+[project]\n+name = \"datasaur-cli\"\n+version = \"1.0.0\"\n+description = \"CLI tool for managing Datasaur on-premise installation\"\n+requires-python = \">=3.14.4\"\n+dependencies = [\n+    \"click>=8.3.1\",\n+    \"jsonschema>=4.25.1\",\n+    \"packaging>=25.0\",\n+    \"pydantic>=2.12.5\",\n+    \"pyinstaller>=6.17.0\",\n+    \"python-dotenv>=1.2.1\",\n+    \"PyYAML>=6.0.3\",\n+    \"requests>=2.32.0\",\n+]\n+\n+[tool.uv]\n+package = false\n+\n+[dependency-groups]\n+dev = [\n+    \"pytest>=9.1.1\",\n+]"},{"sha":"b938d962cb1cf68124d3df8646ad450cfa9bdb0d","filename":"on-premise/datasaur-cli/pytest.ini","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fpytest.ini","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fpytest.ini","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fpytest.ini?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,4 @@\n+[pytest]\n+pythonpath = .\n+testpaths = tests\n+addopts = --import-mode=importlib"},{"sha":"7943a525e66911bc10da24eeb9657052adc8fe52","filename":"on-premise/datasaur-cli/src/__init__.py","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2F__init__.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,7 @@\n+\"\"\"Datasaur CLI - Manage your Datasaur on-premise installation.\"\"\"\n+\n+try:\n+    from src._version import __version__\n+except ImportError:\n+    __version__ = \"0.0.0-dev\"\n+"},{"sha":"2b6671c6308d2586b2f5b0cc907d909849ff692e","filename":"on-premise/datasaur-cli/src/action/action.py","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Faction.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Faction.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Faction.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,23 @@\n+from abc import ABC, abstractmethod\n+from typing import Any, Dict, List\n+\n+\n+class Action(ABC):\n+    @abstractmethod\n+    def name(self) -> str:\n+        pass\n+\n+    @abstractmethod\n+    def options(self) -> Dict[str, Any]:\n+        pass\n+\n+    @abstractmethod\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        pass\n+\n+    @abstractmethod\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        pass\n+\n+    def sensitive_args(self) -> List[str]:\n+        return []"},{"sha":"48d5ec8306cbb096116301e1ef5a5d54543ed405","filename":"on-premise/datasaur-cli/src/action/actions_service.py","status":"added","additions":229,"deletions":0,"changes":229,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Factions_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Factions_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Factions_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,229 @@\n+import importlib.util\n+import re\n+import sys\n+import time\n+import traceback\n+from pathlib import Path\n+from typing import Any, Dict, List\n+\n+from src.common import event_log\n+from src.common import logger\n+\n+from src.action.configure.configure_action import ConfigureAction\n+from src.action.hello_world.hello_world_action import HelloWorldAction\n+from src.action.install.load_docker_image_action import LoadDockerImageAction\n+from src.action.run_workflow.run_workflow_action import RunWorkflowAction\n+from src.action.start.create_docker_resources_action import CreateDockerResourcesAction\n+from src.action.start.docker_compose_up_action import DockerComposeUpAction\n+from src.action.start.docker_login_action import DockerLoginAction\n+from src.action.start.docker_logout_action import DockerLogoutAction\n+from src.action.start.docker_stack_deploy_action import DockerStackDeployAction\n+from src.action.start.docker_stack_dump_logs_action import DockerStackDumpLogsAction\n+from src.action.start.docker_stack_rm_all_action import DockerStackRmAllAction\n+from src.action.start.docker_swarm_init_action import DockerSwarmInitAction\n+from src.action.start.docker_swarm_join_action import DockerSwarmJoinAction\n+from src.action.start.docker_swarm_leave_action import DockerSwarmLeaveAction\n+from src.action.start.generate_htpasswd_docker_secret_action import GenerateHtpasswdDockerSecretAction\n+from src.action.start.generate_self_signed_ca_action import GenerateSelfSignedCaAction\n+from src.action.start.generate_self_signed_ssl_certificate_action import (\n+    GenerateSelfSignedSslCertificateAction,\n+)\n+from src.action.start.print_docker_swarm_join_token_action import PrintDockerSwarmJoinTokenAction\n+from src.action.start.prune_stale_docker_secrets_action import PruneStaleDockerSecretsAction\n+from src.action.start.push_docker_images_action import PushDockerImagesAction\n+from src.action.start.remove_docker_registry_cert_action import RemoveDockerRegistryCertAction\n+from src.action.start.script_runner_action import ScriptRunnerAction\n+from src.action.start.set_docker_registry_cert_action import SetDockerRegistryCertAction\n+from src.action.start.validate_docker_images_action import ValidateDockerImagesAction\n+from src.action.start.validate_files_and_directories_action import (\n+    ValidateFilesAndDirectoriesAction,\n+)\n+from src.action.start.docker_compose_stop_services_action import (\n+    DockerComposeStopServicesAction,\n+)\n+from src.action.start.validate_required_env_vars_action import (\n+    ValidateRequiredEnvVarsAction,\n+)\n+from src.action.stop.docker_compose_down_action import DockerComposeDownAction\n+from src.action.stop.docker_stack_rm_action import DockerStackRmAction\n+from src.common.datasaur_graphql_action import DatasaurGraphQLAction\n+from src.common.state_service import StateService\n+\n+\n+class ActionsService:\n+    def __init__(self, command_modules: List[str] = None):\n+        self._register_actions(command_modules or [])\n+\n+    def validate_action_existence(self, action_name: str) -> bool:\n+        return action_name in self.actions\n+\n+    def get_action_options(self) -> Dict[str, Any]:\n+        action_options = {}\n+        for action_name, action in self.actions.items():\n+            action_options[action_name] = action.options()\n+        return action_options\n+\n+    def run(\n+        self,\n+        context: Dict[str, Any],\n+        action_manifests: List[Dict[str, Any]],\n+    ) -> bool:\n+        state_service = StateService()\n+        command_name = context.get(\"command_name\", \"\")\n+        for action_number, action_manifest in enumerate(action_manifests):\n+            state = state_service.get_all()\n+            resolved_args = self._resolve_values(\n+                action_manifest[\"args\"],\n+                context[\"option_values\"],\n+                context[\"prompt_values\"],\n+                state,\n+            )\n+            action_name = action_manifest[\"action\"]\n+            action = self.actions[action_name]\n+            logger.debug(f\"{action_name} args: {event_log.redact_args(resolved_args, action.sensitive_args())!r}\")\n+\n+            start = time.monotonic()\n+            try:\n+                valid = action.validate(resolved_args)\n+            except Exception as e:\n+                self._record_event(command_name, action_number, action_name, action, resolved_args, start, \"error\", e)\n+                logger.error(f\"✗ Unexpected error validating `{action_name}` action: {e}\")\n+                return False\n+\n+            if not valid:\n+                self._record_event(command_name, action_number, action_name, action, resolved_args, start, \"validate_failed\")\n+                return False\n+\n+            context[\"action_number\"] = action_number\n+            logger.trace(f\"context: {context!r}\")\n+\n+            try:\n+                ok = action.run(context, resolved_args)\n+            except Exception as e:\n+                self._record_event(command_name, action_number, action_name, action, resolved_args, start, \"error\", e)\n+                logger.error(f\"✗ Unexpected error in `{action_name}` action: {e}\")\n+                return False\n+\n+            if not ok:\n+                self._record_event(command_name, action_number, action_name, action, resolved_args, start, \"run_failed\")\n+                return False\n+\n+            self._record_event(command_name, action_number, action_name, action, resolved_args, start, \"success\")\n+        return True\n+\n+    def _record_event(\n+        self,\n+        command_name: str,\n+        action_number: int,\n+        action_name: str,\n+        action: object,\n+        args: Dict[str, Any],\n+        start: float,\n+        outcome: str,\n+        exc: Exception = None,\n+    ) -> None:\n+        duration_ms = int((time.monotonic() - start) * 1000)\n+        error = None\n+        if exc is not None:\n+            error = {\"type\": type(exc).__name__, \"message\": str(exc), \"traceback\": traceback.format_exc()}\n+        event_log.record(\n+            command=command_name,\n+            action_number=action_number,\n+            action_name=action_name,\n+            args=args,\n+            sensitive_keys=action.sensitive_args(),\n+            duration_ms=duration_ms,\n+            outcome=outcome,\n+            error=error,\n+        )\n+\n+    def _register_actions(self, command_modules: List[str]):\n+        self.actions = {}\n+        for action in self._get_base_action_instances():\n+            self.actions[action.name()] = action\n+        for module_path in command_modules:\n+            for action in self._load_module_actions(module_path):\n+                self.actions[action.name()] = action\n+\n+        # docker-stack-deploy runs each stack's stack_hooks (pre_deploy/post_deploy)\n+        # by invoking other registered actions by name — it needs a live reference\n+        # to this same ActionsService to do that. docker-stack-rm-all does the\n+        # same to run docker-stack-rm once per discovered stack.\n+        self.actions[\"docker-stack-deploy\"].actions_service = self\n+        self.actions[\"docker-stack-rm-all\"].actions_service = self\n+\n+    def _get_base_action_instances(self) -> List[object]:\n+        return [\n+            DatasaurGraphQLAction(),\n+            ConfigureAction(),\n+            CreateDockerResourcesAction(),\n+            DockerComposeDownAction(),\n+            DockerComposeStopServicesAction(),\n+            DockerComposeUpAction(),\n+            DockerLoginAction(),\n+            DockerLogoutAction(),\n+            DockerStackDeployAction(),\n+            DockerStackDumpLogsAction(),\n+            DockerStackRmAction(),\n+            DockerStackRmAllAction(),\n+            DockerSwarmInitAction(),\n+            DockerSwarmJoinAction(),\n+            DockerSwarmLeaveAction(),\n+            GenerateHtpasswdDockerSecretAction(),\n+            GenerateSelfSignedCaAction(),\n+            GenerateSelfSignedSslCertificateAction(),\n+            HelloWorldAction(),\n+            LoadDockerImageAction(),\n+            PrintDockerSwarmJoinTokenAction(),\n+            PruneStaleDockerSecretsAction(),\n+            PushDockerImagesAction(),\n+            RemoveDockerRegistryCertAction(),\n+            RunWorkflowAction(),\n+            ScriptRunnerAction(),\n+            SetDockerRegistryCertAction(),\n+            ValidateDockerImagesAction(),\n+            ValidateRequiredEnvVarsAction(),\n+            ValidateFilesAndDirectoriesAction(),\n+        ]\n+\n+    def _load_module_actions(self, module_path: str) -> List[object]:\n+        actions_init = Path(module_path).resolve() / \"actions\" / \"__init__.py\"\n+        if not actions_init.exists():\n+            return []\n+        module_name = f\"_datasaur_module_{Path(module_path).name.replace('-', '_')}\"\n+        spec = importlib.util.spec_from_file_location(module_name, actions_init)\n+        mod = importlib.util.module_from_spec(spec)\n+        sys.modules[module_name] = mod\n+        spec.loader.exec_module(mod)\n+        return mod.get_actions() if hasattr(mod, \"get_actions\") else []\n+\n+    def _resolve_values(\n+        self,\n+        obj: Any,\n+        options: Dict[str, Any],\n+        prompts: Dict[str, Any],\n+        state: Dict[str, Any] = None,\n+    ) -> Any:\n+        if isinstance(obj, Dict):\n+            return {\n+                key: self._resolve_values(value, options, prompts, state)\n+                for key, value in obj.items()\n+            }\n+\n+        if isinstance(obj, List):\n+            return [self._resolve_values(item, options, prompts, state) for item in obj]\n+\n+        if isinstance(obj, str):\n+            if not re.search(r'\\{(?:options|prompts|state)\\[', obj):\n+                return obj\n+            try:\n+                resolved_value = obj.format(options=options, prompts=prompts, state=state or {})\n+            except KeyError:\n+                return None\n+            except (ValueError, IndexError):\n+                return obj\n+            if resolved_value == \"None\":\n+                return None\n+            return resolved_value\n+\n+        return obj"},{"sha":"a5a6460c6bb2a521e665ff0de49fea9b69c7ab34","filename":"on-premise/datasaur-cli/src/action/configure/configure_action.py","status":"added","additions":309,"deletions":0,"changes":309,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fconfigure%2Fconfigure_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fconfigure%2Fconfigure_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fconfigure%2Fconfigure_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,309 @@\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional, Set\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInAction,\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+from src.action.run_workflow.builtin_action.set_encryption_config.set_encryption_config_builtin_action import (\n+    SetEncryptionConfigBuiltInAction,\n+)\n+from src.action.run_workflow.builtin_action.set_environment_variables.set_environment_variables_builtin_action import (\n+    SetEnvironmentVariablesBuiltInAction,\n+)\n+from src.action.run_workflow.builtin_action.switch_input.switch_input_builtin_action import (\n+    SwitchInputBuiltInAction,\n+)\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class ConfigureSectionModel(BaseModel):\n+    name: str\n+    title: str\n+    entry_action: str\n+    actions: List[Dict[str, Any]] = []\n+\n+\n+class ConfigureArgsModel(BaseModel):\n+    menu_title: Optional[str] = \"Select which configuration section you want to modify:\"\n+    sections: List[ConfigureSectionModel]\n+\n+\n+class ConfigureAction(Action):\n+    def __init__(self):\n+        self._register_builtin_actions()\n+        self.env_file = EnvFile()\n+\n+    def _register_builtin_actions(self):\n+        self.builtin_actions = {}\n+        for action in self._get_builtin_action_instances():\n+            self.builtin_actions[action.name()] = action\n+\n+    def _get_builtin_action_instances(self) -> List[BuiltInAction]:\n+        return [\n+            SetEncryptionConfigBuiltInAction(),\n+            SetEnvironmentVariablesBuiltInAction(),\n+            SwitchInputBuiltInAction(),\n+        ]\n+\n+    def name(self) -> str:\n+        return \"configure\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating `{self.name()}` action...\")\n+\n+        try:\n+            validated_args = ConfigureArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+\n+        for section in validated_args.sections:\n+            action_map = {manifest[\"name\"]: manifest for manifest in section.actions}\n+\n+            if section.entry_action not in action_map:\n+                logger.error(\n+                    f\"✗ Section '{section.name}' is invalid: entry_action '{section.entry_action}' not found\"\n+                )\n+                return False\n+\n+            for manifest in section.actions:\n+                builtin_action_name = manifest.get(\"action\")\n+                if builtin_action_name not in self.builtin_actions:\n+                    logger.error(\n+                        f\"✗ Section '{section.name}' is invalid: unknown builtin action '{builtin_action_name}'\"\n+                    )\n+                    return False\n+\n+                if builtin_action_name == \"switch-input\":\n+                    for case in manifest.get(\"cases\", []):\n+                        case_action = case.get(\"action\")\n+                        if case_action not in action_map:\n+                            logger.error(\n+                                f\"✗ Section '{section.name}' is invalid: unknown action '{case_action}' in switch cases\"\n+                            )\n+                            return False\n+\n+                next_action = manifest.get(\"next_action\")\n+                if next_action and next_action not in action_map:\n+                    logger.error(\n+                        f\"✗ Section '{section.name}' is invalid: unknown next_action '{next_action}'\"\n+                    )\n+                    return False\n+\n+                if not self.builtin_actions[builtin_action_name].validate(manifest):\n+                    logger.error(\n+                        f\"✗ Section '{section.name}' is invalid: builtin action manifest validation failed\"\n+                    )\n+                    return False\n+\n+        logger.info(\"✓ Action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        menu_title = args.get(\"menu_title\") or \"Select which configuration section you want to modify:\"\n+        sections = args.get(\"sections\", [])\n+\n+        if not sections:\n+            logger.error(\"✗ No configuration sections defined\")\n+            return False\n+\n+        while True:\n+            missing_by_section = self._get_missing_required_values_by_section(sections)\n+\n+            logger.info(menu_title)\n+            for index, section in enumerate(sections):\n+                suffix = \"\"\n+                if missing_by_section.get(section[\"name\"]):\n+                    suffix = \" (missing required value)\"\n+                logger.info(f\"[{index + 1}] {section['title']}{suffix}\")\n+\n+            logger.info(\"[0] Exit\")\n+            choice = click.prompt(\n+                \"Enter choice\", type=click.IntRange(min=0, max=len(sections))\n+            )\n+            logger.info()\n+\n+            if choice == 0:\n+                logger.info(\"✓ Configuration finished\", fg=\"green\")\n+                logger.info()\n+                return True\n+\n+            selected_section = sections[choice - 1]\n+            logger.info(f\"Configuring: {selected_section['title']}\", fg=\"green\")\n+\n+            if not self._run_section(context, selected_section):\n+                return False\n+\n+            logger.info(f\"✓ Section '{selected_section['title']}' updated\", fg=\"green\")\n+            logger.info()\n+\n+    def _run_section(self, context: Dict[str, Any], section: Dict[str, Any]) -> bool:\n+        action_manifests = section.get(\"actions\", [])\n+        if not action_manifests:\n+            logger.error(\"✗ Section does not define any actions\")\n+            return False\n+\n+        action_map = {manifest[\"name\"]: manifest for manifest in action_manifests}\n+        entry_action = section.get(\"entry_action\")\n+\n+        if not entry_action or entry_action not in action_map:\n+            logger.error(\"✗ Invalid section definition\")\n+            return False\n+\n+        return self._run_flow_action(context, action_map, entry_action, set())\n+\n+    def _run_flow_action(\n+        self,\n+        context: Dict[str, Any],\n+        action_map: Dict[str, Dict[str, Any]],\n+        flow_action_name: str,\n+        visited: set,\n+    ) -> bool:\n+        flow_action_manifest = action_map.get(flow_action_name)\n+        if not flow_action_manifest:\n+            logger.error(f\"✗ Flow action '{flow_action_name}' not found\")\n+            return False\n+\n+        builtin_action_name = flow_action_manifest.get(\"action\")\n+        builtin_action = self.builtin_actions.get(builtin_action_name)\n+        if not builtin_action:\n+            logger.error(\n+                f\"✗ Built-in action '{builtin_action_name}' not found\"\n+            )\n+            return False\n+\n+        if flow_action_name in visited:\n+            logger.error(\n+                f\"✗ Possible infinite loop detected. Flow action '{flow_action_name}' has been executed before.\"\n+            )\n+            return False\n+\n+        visited.add(flow_action_name)\n+        result: BuiltInActionResult = builtin_action.run(context, flow_action_manifest)\n+\n+        match result.action:\n+            case BuiltInActionResultAction.DONE:\n+                next_action = flow_action_manifest.get(\"next_action\")\n+                if next_action:\n+                    return self._run_flow_action(context, action_map, next_action, visited)\n+                return True\n+            case BuiltInActionResultAction.EXIT:\n+                return True\n+            case BuiltInActionResultAction.GOTO:\n+                return self._run_flow_action(\n+                    context, action_map, str(result.content), visited\n+                )\n+\n+        return False\n+\n+    def _get_missing_required_values_by_section(\n+        self, sections: List[Dict[str, Any]]\n+    ) -> Dict[str, Set[str]]:\n+        section_missing: Dict[str, Set[str]] = {}\n+\n+        for section in sections:\n+            action_map = {manifest[\"name\"]: manifest for manifest in section.get(\"actions\", [])}\n+            entry_action = section.get(\"entry_action\")\n+            section_missing[section[\"name\"]] = self._get_missing_for_action_flow(\n+                action_map, entry_action\n+            )\n+\n+        return section_missing\n+\n+    def _get_missing_for_action_flow(\n+        self,\n+        action_map: Dict[str, Dict[str, Any]],\n+        action_name: Optional[str],\n+        visited: Optional[Set[str]] = None,\n+    ) -> Set[str]:\n+        if not action_name:\n+            return set()\n+\n+        if visited is None:\n+            visited = set()\n+        if action_name in visited:\n+            return set()\n+\n+        action_manifest = action_map.get(action_name)\n+        if not action_manifest:\n+            return set()\n+\n+        next_visited = set(visited)\n+        next_visited.add(action_name)\n+        builtin_action_name = action_manifest.get(\"action\")\n+\n+        if builtin_action_name == \"set-environment-variables\":\n+            missing = self._get_missing_for_set_env_action(action_manifest)\n+            next_action = action_manifest.get(\"next_action\")\n+            if next_action:\n+                missing.update(\n+                    self._get_missing_for_action_flow(action_map, next_action, next_visited)\n+                )\n+            return missing\n+\n+        if builtin_action_name == \"switch-input\":\n+            branch_missing_sets: List[Set[str]] = []\n+            for case in action_manifest.get(\"cases\", []):\n+                case_action = case.get(\"action\")\n+                branch_missing_sets.append(\n+                    self._get_missing_for_action_flow(action_map, case_action, next_visited)\n+                )\n+\n+            if not branch_missing_sets:\n+                return set()\n+\n+            # Only one case is required. If one branch is fully configured,\n+            # this switch is considered fulfilled.\n+            return min(branch_missing_sets, key=len)\n+\n+        # Unknown/custom built-in in configure flow: no static required check.\n+        return set()\n+\n+    def _get_missing_for_set_env_action(self, action_manifest: Dict[str, Any]) -> Set[str]:\n+        missing: Set[str] = set()\n+        prompts = action_manifest.get(\"prompts\", {})\n+        targets = action_manifest.get(\"targets\", [])\n+\n+        for target in targets:\n+            file_path = target.get(\"file_path\")\n+            if not file_path:\n+                continue\n+\n+            env_values = self._read_env_values(file_path)\n+            for env_var, source in target.get(\"values\", {}).items():\n+                prompt_name = self._extract_prompt_name(str(source))\n+                if not prompt_name:\n+                    continue\n+\n+                prompt_definition = prompts.get(prompt_name, {})\n+                if not prompt_definition.get(\"required\", False):\n+                    continue\n+\n+                current_value = str(env_values.get(env_var) or \"\").strip()\n+                if not current_value:\n+                    missing.add(env_var)\n+\n+        return missing\n+\n+    def _read_env_values(self, file_path: str) -> Dict[str, Any]:\n+        env_values, ok = self.env_file.read(Path(file_path), create_if_not_exists=True)\n+        if not ok or env_values is None:\n+            return {}\n+        return env_values\n+\n+    def _extract_prompt_name(self, source: str) -> Optional[str]:\n+        if not source.startswith(\"prompts[\") or not source.endswith(\"]\"):\n+            return None\n+        return source[8:-1]"},{"sha":"963238c982fc4a445ff6658a45b5a342d4d8b51f","filename":"on-premise/datasaur-cli/src/action/hello_world/hello_world_action.py","status":"added","additions":48,"deletions":0,"changes":48,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fhello_world%2Fhello_world_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fhello_world%2Fhello_world_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fhello_world%2Fhello_world_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,48 @@\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class FileModel(BaseModel):\n+    file_path: str\n+\n+\n+class HelloWorldArgsModel(BaseModel):\n+    name: str\n+    age: Optional[str] = None\n+    files: List[FileModel]\n+\n+\n+class HelloWorldAction(Action):\n+    def name(self) -> str:\n+        return \"hello-world\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating `{self.name()}` action...\")\n+\n+        try:\n+            HelloWorldArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+\n+        logger.info(\"✓ Action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\")\n+\n+        logger.info(f\"Context: {context}\")\n+        logger.info(f\"Args: {args}\")\n+\n+        logger.info(\"✓ Action is success\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"74347233a4cc4ba2594d57137078e719ffd8ff0e","filename":"on-premise/datasaur-cli/src/action/install/load_docker_image_action.py","status":"added","additions":260,"deletions":0,"changes":260,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Finstall%2Fload_docker_image_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Finstall%2Fload_docker_image_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Finstall%2Fload_docker_image_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,260 @@\n+import json\n+import os\n+import re\n+import shutil\n+import subprocess\n+import tarfile\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.directory_validator import DirectoryValidator\n+from src.common.file_validator import FileValidator\n+from src.common.image_digest_validator import ImageDigestValidator\n+from src.common.manifest_file_reader import ManifestFileReader\n+from src.common.docker_compose_env_service import DockerComposeEnvService\n+\n+\n+class LoadDockerImageServiceModel(BaseModel):\n+\tname: str\n+\timage: str\n+\tfile_path: str\n+\n+class LoadDockerImageAction(Action):\n+\tdef __init__(self):\n+\t\tself.compose_env_service = DockerComposeEnvService()\n+\n+\tdef name(self) -> str:\n+\t\treturn \"load-docker-images\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef get_services_from_manifest(self) -> Optional[List[Dict[str, Any]]]:\n+\t\tartifact_directory = Path(\".\")\n+\t\tmanifest, ok = ManifestFileReader().read(artifact_directory)\n+\t\tif not ok or manifest is None:\n+\t\t\treturn None\n+\t\treturn manifest.get(\"services\")\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\tservices = self.get_services_from_manifest()\n+\t\tif not services:\n+\t\t\tlogger.error(\"✗ Failed to read services from manifest\")\n+\t\t\treturn False\n+\n+\t\tfor service_dict in services:\n+\t\t\ttry:\n+\t\t\t\tservice = LoadDockerImageServiceModel.model_validate(service_dict)\n+\t\t\texcept ValidationError as e:\n+\t\t\t\tlogger.error(str(e))\n+\t\t\t\tlogger.error(f\"✗ Service {service_dict.get('name', 'unknown')} is invalid\")\n+\t\t\t\treturn False\n+\n+\t\t\tfile_path = service.file_path\n+\t\t\tif not os.path.exists(file_path):\n+\t\t\t\t# build.sh's --include-*-docker-images false means this service's\n+\t\t\t\t# archive was intentionally left out of this build — not an error.\n+\t\t\t\tlogger.warn(f\"! Skipping {service.name}: image archive not found at {file_path}\")\n+\t\t\t\tcontinue\n+\n+\t\t\tif not FileValidator().validate(file_path):\n+\t\t\t\treturn False\n+\n+\t\t\tdirectory = os.path.dirname(file_path)\n+\t\t\tif not DirectoryValidator().validate(directory):\n+\t\t\t\treturn False\n+\n+\t\t\tif not ImageDigestValidator().validate(file_path):\n+\t\t\t\treturn False\n+\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\t\tresolved_env = self.compose_env_service.build_env()\n+\n+\t\tservices = self.get_services_from_manifest()\n+\t\tif not services:\n+\t\t\tlogger.error(\"✗ Failed to read services from manifest\")\n+\t\t\treturn False\n+\n+\t\tfor service_dict in services:\n+\t\t\ttry:\n+\t\t\t\tservice = LoadDockerImageServiceModel.model_validate(service_dict)\n+\t\t\texcept ValidationError as e:\n+\t\t\t\tlogger.error(str(e))\n+\t\t\t\tlogger.error(f\"✗ Service {service_dict.get('name', 'unknown')} is invalid\")\n+\t\t\t\treturn False\n+\n+\t\t\tfile_path = service.file_path\n+\t\t\tif not os.path.exists(file_path):\n+\t\t\t\tlogger.warn(f\"! Skipping {service.name}: image archive not found at {file_path}\")\n+\t\t\t\tcontinue\n+\n+\t\t\tresolved_image = self._resolve_image_name(service.image, resolved_env)\n+\n+\t\t\tif self._already_loaded(file_path, resolved_image):\n+\t\t\t\tlogger.info(f\"✓ {resolved_image} already loaded, skipping\", fg=\"green\")\n+\t\t\t\tcontinue\n+\n+\t\t\tlogger.info(f\"Loading Docker image from {file_path}...\")\n+\n+\t\t\t# Check if pigz is available\n+\t\t\tpigz_available = shutil.which(\"pigz\") is not None\n+\n+\t\t\ttry:\n+\t\t\t\tif pigz_available:\n+\t\t\t\t\t# Use pigz for parallel decompression if available\n+\t\t\t\t\tpigz_process = self._decompress_with_pigz(file_path)\n+\t\t\t\t\tif not self._load_docker_image(file_path, stdin_pipe=pigz_process.stdout):\n+\t\t\t\t\t\tpigz_process.stderr.close()\n+\t\t\t\t\t\tpigz_process.wait()\n+\t\t\t\t\t\treturn False\n+\n+\t\t\t\t\t# Drain stderr (an unread pipe can fill and stall pigz) and reap the\n+\t\t\t\t\t# process (an un-waited Popen leaves a zombie) once docker load is done.\n+\t\t\t\t\tpigz_stderr = pigz_process.stderr.read()\n+\t\t\t\t\tpigz_process.stderr.close()\n+\t\t\t\t\tpigz_process.wait()\n+\t\t\t\t\tif pigz_process.returncode != 0:\n+\t\t\t\t\t\tlogger.error(f\"✗ pigz failed decompressing {file_path}: {pigz_stderr.decode().strip()}\")\n+\t\t\t\t\t\treturn False\n+\t\t\t\telse:\n+\t\t\t\t\t# Fallback to standard docker load\n+\t\t\t\t\tif not self._load_docker_image(file_path):\n+\t\t\t\t\t\treturn False\n+\n+\t\t\t\tlogger.info(f\"✓ Successfully loaded {resolved_image}\", fg=\"green\")\n+\t\t\texcept Exception as e:\n+\t\t\t\tlogger.error(f\"✗ Error loading Docker image from {file_path}: {str(e)}\")\n+\t\t\t\treturn False\n+\n+\t\tlogger.info(\"✓ All Docker images loaded successfully\", fg=\"green\")\n+\t\tlogger.info()\n+\t\treturn True\n+\n+\tdef _resolve_image_name(self, image: str, env: Dict[str, str]) -> str:\n+\t\tdef replace_var(match: re.Match[str]) -> str:\n+\t\t\tvar_name = match.group(1)\n+\t\t\treturn env.get(var_name, \"\")\n+\n+\t\treturn re.sub(r\"\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}\", replace_var, image)\n+\n+\tdef _already_loaded(self, file_path: str, resolved_image: str) -> bool:\n+\t\texpected_id = self._expected_image_id_from_archive(file_path)\n+\t\tif expected_id is None:\n+\t\t\treturn False\n+\t\tlocal_id = self._local_image_id(resolved_image)\n+\t\treturn local_id is not None and local_id == expected_id\n+\n+\tdef _expected_image_id_from_archive(self, file_path: str) -> Optional[str]:\n+\t\ttry:\n+\t\t\twith tarfile.open(file_path, \"r:*\") as tar:\n+\t\t\t\tnames = set(tar.getnames())\n+\n+\t\t\t\t# Newer (containerd-backed) Docker builds report `docker image inspect`'s\n+\t\t\t\t# .Id as the OCI index digest, not the legacy config-blob digest — and\n+\t\t\t\t# `docker save` from those builds includes an index.json we can read that\n+\t\t\t\t# digest from directly. Older builds have no index.json; fall back to the\n+\t\t\t\t# legacy manifest.json Config-blob-filename form in that case.\n+\t\t\t\tif \"index.json\" in names:\n+\t\t\t\t\tindex_member = tar.extractfile(\"index.json\")\n+\t\t\t\t\tif index_member is None:\n+\t\t\t\t\t\treturn None\n+\t\t\t\t\tindex = json.loads(index_member.read())\n+\t\t\t\t\tmanifests = index.get(\"manifests\") or []\n+\t\t\t\t\tif not manifests:\n+\t\t\t\t\t\treturn None\n+\t\t\t\t\treturn manifests[0].get(\"digest\") or None\n+\n+\t\t\t\tmanifest_member = tar.extractfile(\"manifest.json\")\n+\t\t\t\tif manifest_member is None:\n+\t\t\t\t\treturn None\n+\t\t\t\tmanifest = json.loads(manifest_member.read())\n+\t\texcept Exception:\n+\t\t\treturn None\n+\n+\t\tif not manifest:\n+\t\t\treturn None\n+\t\tconfig_path = manifest[0].get(\"Config\", \"\")\n+\t\tif config_path.startswith(\"blobs/sha256/\"):\n+\t\t\t# Same containerd-backed archive form push_docker_images_action.py\n+\t\t\t# handles: the config blob is addressed directly by digest instead\n+\t\t\t# of a \"<digest>.json\" filename.\n+\t\t\tdigest = config_path[len(\"blobs/sha256/\"):]\n+\t\telif config_path.endswith(\".json\"):\n+\t\t\tdigest = config_path[: -len(\".json\")]\n+\t\telse:\n+\t\t\treturn None\n+\t\treturn f\"sha256:{digest}\" if digest else None\n+\n+\tdef _local_image_id(self, resolved_image: str) -> Optional[str]:\n+\t\tresult = subprocess.run(\n+\t\t\t[\"docker\", \"image\", \"inspect\", resolved_image, \"--format\", \"{{.Id}}\"],\n+\t\t\tcapture_output=True,\n+\t\t\ttext=True,\n+\t\t)\n+\t\tif result.returncode != 0:\n+\t\t\treturn None\n+\t\timage_id = result.stdout.strip()\n+\t\treturn image_id or None\n+\n+\n+\tdef _decompress_with_pigz(self, file_path: str) -> subprocess.Popen:\n+\t\t\"\"\"Decompress a file using pigz and return the process with stdout pipe.\"\"\"\n+\t\treturn subprocess.Popen(\n+\t\t\t[\"pigz\", \"-dc\", file_path],\n+\t\t\tstdout=subprocess.PIPE,\n+\t\t\tstderr=subprocess.PIPE\n+\t\t)\n+\n+\tdef _load_docker_image(self, file_path: str, stdin_pipe=None) -> bool:\n+\t\t\"\"\"\n+\t\tLoad a Docker image from a file or stdin pipe.\n+\n+\t\tArgs:\n+\t\t\tfile_path: Path to the Docker image file (used for error messages)\n+\t\t\tstdin_pipe: Optional stdin pipe to read from (if None, loads from file_path)\n+\n+\t\tReturns:\n+\t\t\tTrue if successful, False otherwise\n+\t\t\"\"\"\n+\t\tif stdin_pipe:\n+\t\t\t# Load from stdin pipe (used with pigz)\n+\t\t\tdocker_process = subprocess.Popen(\n+\t\t\t\t[\"docker\", \"load\"],\n+\t\t\t\tstdin=stdin_pipe,\n+\t\t\t\tstdout=subprocess.PIPE,\n+\t\t\t\tstderr=subprocess.PIPE\n+\t\t\t)\n+\t\t\tstdin_pipe.close()\n+\t\t\tstdout, stderr = docker_process.communicate()\n+\n+\t\t\tif docker_process.returncode != 0:\n+\t\t\t\tlogger.error(f\"✗ Failed to load Docker image from {file_path}: {stderr.decode()}\")\n+\t\t\t\treturn False\n+\n+\t\t\t# Show docker load output\n+\t\t\tif stdout:\n+\t\t\t\tlogger.info(stdout.decode().strip())\n+\t\telse:\n+\t\t\t# Load directly from file\n+\t\t\tresult = subprocess.run(\n+\t\t\t\t[\"docker\", \"load\", \"-i\", file_path],\n+\t\t\t\tcapture_output=True,\n+\t\t\t\ttext=True\n+\t\t\t)\n+\n+\t\t\tif result.returncode != 0:\n+\t\t\t\tlogger.error(f\"✗ Failed to load Docker image from {file_path}: {result.stderr}\")\n+\t\t\t\treturn False\n+\n+\t\t\t# Show docker load output\n+\t\t\tif result.stdout:\n+\t\t\t\tlogger.info(result.stdout.strip())\n+\n+\t\treturn True"},{"sha":"62ce68dd4b06a009df0d876c807641a247e1eaae","filename":"on-premise/datasaur-cli/src/action/run_workflow/builtin_action/builtin_action.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fbuiltin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fbuiltin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fbuiltin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,32 @@\n+from abc import ABC, abstractmethod\n+from dataclasses import dataclass\n+from enum import Enum\n+from typing import Any, Dict, Optional\n+\n+\n+class BuiltInActionResultAction(Enum):\n+    DONE = \"DONE\"\n+    EXIT = \"EXIT\"\n+    GOTO = \"GOTO\"\n+\n+\n+@dataclass\n+class BuiltInActionResult:\n+    action: BuiltInActionResultAction\n+    content: Optional[str] = None\n+\n+\n+class BuiltInAction(ABC):\n+    @abstractmethod\n+    def name(self) -> str:\n+        pass\n+\n+    @abstractmethod\n+    def validate(self, manifest: Dict[str, Any]) -> bool:\n+        pass\n+\n+    @abstractmethod\n+    def run(\n+        self, context: Dict[str, Any], manifest: Dict[str, Any]\n+    ) -> BuiltInActionResult:\n+        pass"},{"sha":"8328622e7e70f1a5417e2ba8ade6a04f78500497","filename":"on-premise/datasaur-cli/src/action/run_workflow/builtin_action/set_encryption_config/set_encryption_config_builtin_action.py","status":"added","additions":100,"deletions":0,"changes":100,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_encryption_config%2Fset_encryption_config_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_encryption_config%2Fset_encryption_config_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_encryption_config%2Fset_encryption_config_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,100 @@\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInAction,\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class SetEncryptionConfigBuiltInActionArgsModel(BaseModel):\n+    target_file_path: str = \"datasaur.env\"\n+    encryption_version_env_var: str = \"ENCRYPTION_VERSION\"\n+    encryption_key_env_var: str = \"ENCRYPTION_KEY\"\n+\n+\n+class SetEncryptionConfigBuiltInAction(BuiltInAction):\n+    def __init__(self):\n+        self.env_file = EnvFile()\n+\n+    def name(self) -> str:\n+        return \"set-encryption-config\"\n+\n+    def validate(self, manifest: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating {manifest['name']} ({self.name()} built-in) action...\")\n+\n+        try:\n+            SetEncryptionConfigBuiltInActionArgsModel.model_validate(manifest)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Built-in action is invalid\")\n+            return False\n+\n+        logger.info(\"✓ Built-in action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(\n+        self, context: Dict[str, Any], manifest: Dict[str, Any]\n+    ) -> BuiltInActionResult:\n+        logger.info(manifest[\"title\"])\n+\n+        target_file_path = manifest.get(\"target_file_path\", \"datasaur.env\")\n+        version_var = manifest.get(\"encryption_version_env_var\", \"ENCRYPTION_VERSION\")\n+        key_var = manifest.get(\"encryption_key_env_var\", \"ENCRYPTION_KEY\")\n+\n+        file_content, ok = self.env_file.read(Path(target_file_path), create_if_not_exists=True)\n+        if not ok or file_content is None:\n+            logger.error(f\"✗ Failed to read {target_file_path}\")\n+            return BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+        current_version = str(file_content.get(version_var) or \"\").strip()\n+        current_key = str(file_content.get(key_var) or \"\").strip()\n+\n+        logger.info(\"[1] Enable encryption\")\n+        logger.info(\"[2] Disable encryption\")\n+        mode = click.prompt(\"Enter choice\", type=click.IntRange(min=1, max=2))\n+        logger.info()\n+\n+        if mode == 1:\n+            new_key = click.prompt(\n+                \"Encryption Key\",\n+                default=current_key if current_key else None,\n+                show_default=bool(current_key),\n+                hide_input=True,\n+                confirmation_prompt=not bool(current_key),\n+            ).strip()\n+\n+            if not new_key:\n+                logger.error(\"✗ Encryption key cannot be empty when enabling encryption\")\n+                return BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+            current_is_enabled = current_version not in (\"\", \"0\")\n+            if current_is_enabled and current_key and current_key != new_key:\n+                logger.error(\n+                    \"✗ Changing encryption key while encryption is already enabled is not allowed\"\n+                )\n+                logger.warn(\n+                    \"  Keep the existing key, or disable encryption first if this is a fresh migration flow\"\n+                )\n+                return BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+            file_content[version_var] = \"1\"\n+            file_content[key_var] = new_key\n+            logger.info(\"✓ Encryption enabled\", fg=\"green\")\n+        else:\n+            file_content[version_var] = \"0\"\n+            logger.info(\"✓ Encryption disabled\", fg=\"green\")\n+\n+        ok = self.env_file.write(Path(target_file_path), file_content)\n+        if not ok:\n+            logger.error(f\"✗ Failed to write {target_file_path}\")\n+            return BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+        logger.info()\n+        return BuiltInActionResult(action=BuiltInActionResultAction.DONE)"},{"sha":"341d9b9c5a73c0388a4f64e1d14ee86506c021d5","filename":"on-premise/datasaur-cli/src/action/run_workflow/builtin_action/set_environment_variables/set_environment_variables_builtin_action.py","status":"added","additions":115,"deletions":0,"changes":115,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fset_environment_variables_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fset_environment_variables_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fset_environment_variables_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,115 @@\n+import re\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInAction,\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+from src.action.run_workflow.builtin_action.set_environment_variables.user_prompts_service import (\n+    UserPromptsService,\n+)\n+from src.action.run_workflow.builtin_action.set_environment_variables.user_prompts_target_writer_service import (\n+    UserPromptsTargetWriterService,\n+)\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+PROMPT_REFERENCE_PATTERN = re.compile(r\"prompts\\[(.*?)\\]\")\n+\n+\n+class PromptPropertiesModel(BaseModel):\n+    text: Optional[str] = None\n+    description: Optional[str] = None\n+    default: Optional[str] = None\n+    generate: Optional[bool] = None\n+    generate_length: Optional[int] = None\n+    required: Optional[bool] = None\n+    allowed_characters: Optional[str] = None\n+    min_length: Optional[int] = None\n+    max_length: Optional[int] = None\n+    hide_input: Optional[bool] = None\n+\n+\n+class TargetModel(BaseModel):\n+    file_path: str\n+    values: Dict[str, Any]\n+\n+\n+class SetEnvironmentVariablesBuiltInActionArgsModel(BaseModel):\n+    prompts: Dict[str, PromptPropertiesModel]\n+    targets: List[TargetModel]\n+    skip_if_set: bool = False\n+\n+\n+class SetEnvironmentVariablesBuiltInAction(BuiltInAction):\n+    def __init__(self):\n+        self.user_prompts_service = UserPromptsService()\n+        self.user_prompts_target_writer_service = UserPromptsTargetWriterService()\n+        self.env_file = EnvFile()\n+\n+    def name(self) -> str:\n+        return \"set-environment-variables\"\n+\n+    def validate(self, manifest: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating {manifest['name']} ({self.name()} built-in) action...\")\n+\n+        try:\n+            SetEnvironmentVariablesBuiltInActionArgsModel.model_validate(manifest)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Built-in action is invalid\")\n+            return False\n+\n+        logger.info(\"✓ Built-in action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(\n+        self, context: Dict[str, Any], manifest: Dict[str, Any]\n+    ) -> BuiltInActionResult:\n+        context[\"builtin_action_name\"] = manifest[\"name\"]\n+\n+        # The target file(s) a prompt writes to are the only source of truth for\n+        # \"what's already set\" — no separate state file. That's what keeps this\n+        # consistent across different commands (e.g. `configure` and\n+        # `init-app-server`) and across reruns from a different working\n+        # directory: whatever's actually in .env right now is what the next\n+        # prompt defaults to.\n+        existing_values = self._read_existing_target_values(manifest[\"targets\"])\n+\n+        prompt_values = self.user_prompts_service.get_prompt_values(\n+            manifest[\"prompts\"], existing_values, skip_if_set=manifest.get(\"skip_if_set\", False)\n+        )\n+\n+        ok = self.user_prompts_target_writer_service.write_target_files(\n+            manifest[\"targets\"], prompt_values\n+        )\n+        if not ok:\n+            logger.error(\"✗ Failed to write target files\")\n+            return BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+        return BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+\n+    def _read_existing_target_values(self, targets: List[Dict[str, Any]]) -> Dict[str, Any]:\n+        existing: Dict[str, Any] = {}\n+        for target in targets:\n+            file_path = Path(target[\"file_path\"])\n+            if not file_path.exists():\n+                continue\n+\n+            file_content, ok = self.env_file.read(file_path)\n+            if not ok or file_content is None:\n+                continue\n+\n+            for env_var, expr in target[\"values\"].items():\n+                match = PROMPT_REFERENCE_PATTERN.fullmatch(expr)\n+                if not match:\n+                    continue\n+                current_value = file_content.get(env_var)\n+                if current_value:\n+                    existing[match.group(1)] = current_value\n+\n+        return existing"},{"sha":"483bea45f2c6e5b2e64dcc70e6267078991dac25","filename":"on-premise/datasaur-cli/src/action/run_workflow/builtin_action/set_environment_variables/user_prompts_service.py","status":"added","additions":118,"deletions":0,"changes":118,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fuser_prompts_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fuser_prompts_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fuser_prompts_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,118 @@\n+import re\n+import secrets\n+import string\n+from typing import Any, Dict, Optional, Tuple\n+\n+import click\n+\n+from src.common import logger\n+\n+GENERATE_RANDOM_STRING_LENGTH = 16\n+\n+\n+class UserPromptsService:\n+    def get_prompt_values(\n+        self, prompts: Dict[str, Any], existing_values: Dict[str, Any], skip_if_set: bool = False\n+    ) -> Dict[str, Any]:\n+        prompt_values = {}\n+\n+        for prompt_name in prompts:\n+            existing_value = existing_values.get(prompt_name)\n+            if skip_if_set and existing_value:\n+                logger.info(f\"✓ {prompt_name} already set, skipping prompt\", fg=\"green\")\n+                prompt_values[prompt_name] = existing_value\n+                continue\n+\n+            prompt_text, kwargs = self._get_click_prompt_params(\n+                prompt_name, prompts[prompt_name], existing_values\n+            )\n+            # Reference: https://click.palletsprojects.com/en/stable/api/#click.prompt\n+            prompt_values[prompt_name] = click.prompt(prompt_text, **kwargs)\n+        logger.info()\n+\n+        return prompt_values\n+\n+    def _get_click_prompt_params(\n+        self, prompt_name: str, prompt_properties: Dict[str, Any], existing_values: Dict[str, Any]\n+    ) -> Tuple[str, Dict[str, Any]]:\n+        prompt_text = prompt_name\n+\n+        kwargs = {}\n+        if \"text\" in prompt_properties:\n+            prompt_text = prompt_properties[\"text\"]\n+        if \"description\" in prompt_properties:\n+            prompt_text = f\"{prompt_text} ({prompt_properties['description']})\"\n+\n+        hide_input = bool(prompt_properties.get(\"hide_input\", False))\n+        kwargs[\"hide_input\"] = hide_input\n+        # Click's show_default prints the actual default value in the prompt\n+        # text regardless of hide_input — without this, a hidden prompt with an\n+        # existing secret as its default (e.g. re-running `configure`) echoes\n+        # that secret in the clear.\n+        if hide_input:\n+            kwargs[\"show_default\"] = False\n+\n+        # Handle default, generate, generate_length, and required\n+        default_value = existing_values.get(prompt_name)\n+        if default_value is not None:\n+            kwargs[\"default\"] = default_value\n+        elif \"default\" in prompt_properties:\n+            kwargs[\"default\"] = prompt_properties[\"default\"]\n+        elif \"generate\" in prompt_properties and prompt_properties[\"generate\"]:\n+            generate_length = prompt_properties.get(\n+                \"generate_length\", GENERATE_RANDOM_STRING_LENGTH\n+            )\n+            kwargs[\"default\"] = self._generate_random_string(generate_length)\n+        elif \"required\" in prompt_properties and not prompt_properties[\"required\"]:\n+            kwargs[\"default\"] = \"\"\n+            kwargs[\"show_default\"] = False\n+\n+        value_proc_kwargs = {}\n+        keys = [\"allowed_characters\", \"min_length\", \"max_length\"]\n+        for key in keys:\n+            if key in prompt_properties:\n+                value_proc_kwargs[key] = prompt_properties[key]\n+        kwargs[\"value_proc\"] = lambda value: self._validate_value(\n+            value, **value_proc_kwargs\n+        )\n+\n+        return prompt_text, kwargs\n+\n+    def _generate_random_string(self, length: int) -> str:\n+        characters = string.ascii_letters + string.digits\n+        return \"\".join(secrets.choice(characters) for _ in range(length))\n+\n+    def _validate_value(\n+        self,\n+        value: str,\n+        allowed_characters: Optional[str] = None,  # alphabet,digit,special\n+        min_length: Optional[int] = None,\n+        max_length: Optional[int] = None,\n+    ):\n+        if \"\\x1b\" in value:\n+            raise click.BadParameter(\"Input contains escape character.\")\n+\n+        if allowed_characters is not None:\n+            allowed_characters = allowed_characters.split(\",\")\n+            patterns_dict = {\n+                \"alphabet\": r\"A-Za-z\",\n+                \"digit\": r\"\\d\",\n+                \"special\": r\"!-/:-@\\[-`{-~\",\n+            }\n+            patterns = []\n+            for key, pattern in patterns_dict.items():\n+                if key in allowed_characters:\n+                    patterns.append(pattern)\n+            if patterns:\n+                if not re.search(f\"[{''.join(patterns)}]\", value):\n+                    raise click.BadParameter(\n+                        f\"Input contains invalid characters. Only the following character types are allowed: {', '.join(sorted(allowed_characters))}\"\n+                    )\n+\n+        value_length = len(value)\n+        if min_length is not None and value_length < min_length:\n+            raise click.BadParameter(f\"Input must be at least {min_length} characters.\")\n+        if max_length is not None and max_length < value_length:\n+            raise click.BadParameter(f\"Input must be at most {max_length} characters.\")\n+\n+        return value"},{"sha":"32c9c93426b910d90002127e9acf0baea0dcac05","filename":"on-premise/datasaur-cli/src/action/run_workflow/builtin_action/set_environment_variables/user_prompts_target_writer_service.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fuser_prompts_target_writer_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fuser_prompts_target_writer_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Fuser_prompts_target_writer_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,32 @@\n+import re\n+from pathlib import Path\n+from typing import Any, Dict, List\n+\n+from src.common.env_file import EnvFile\n+\n+\n+class UserPromptsTargetWriterService:\n+    def __init__(self):\n+        self.env_file = EnvFile()\n+\n+    def write_target_files(\n+        self, target_files: List[Dict[str, Any]], prompt_values: Dict[str, Any]\n+    ) -> bool:\n+        for target_file in target_files:\n+            file_path = Path(target_file[\"file_path\"])\n+            file_content, ok = self.env_file.read(file_path, create_if_not_exists=True)\n+            if not ok:\n+                return False\n+\n+            for key, value in target_file[\"values\"].items():\n+                file_content[key] = re.sub(\n+                    r\"prompts\\[(.*?)\\]\",\n+                    lambda m: prompt_values.get(m.group(1)) or \"\",\n+                    value,\n+                )\n+\n+            ok = self.env_file.write(file_path, file_content)\n+            if not ok:\n+                return False\n+\n+        return True"},{"sha":"79124975c1114d44ed70b2e48b3b8bc18b2c67a5","filename":"on-premise/datasaur-cli/src/action/run_workflow/builtin_action/switch_input/switch_input_builtin_action.py","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fswitch_input%2Fswitch_input_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fswitch_input%2Fswitch_input_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Fbuiltin_action%2Fswitch_input%2Fswitch_input_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,67 @@\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInAction,\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+from src.common import logger\n+\n+\n+class CaseModel(BaseModel):\n+    name: str\n+    action: str\n+\n+\n+class SwitchInputBuiltInActionArgsModel(BaseModel):\n+    cases: List[CaseModel]\n+    allow_exit: Optional[bool] = True\n+\n+\n+class SwitchInputBuiltInAction(BuiltInAction):\n+    def name(self) -> str:\n+        return \"switch-input\"\n+\n+    def validate(self, manifest: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating {manifest['name']} ({self.name()} built-in) action...\")\n+\n+        try:\n+            SwitchInputBuiltInActionArgsModel.model_validate(manifest)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Built-in action is invalid\")\n+            return False\n+\n+        logger.info(\"✓ Built-in action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(\n+        self, context: Dict[str, Any], manifest: Dict[str, Any]\n+    ) -> BuiltInActionResult:\n+        logger.info(manifest[\"title\"])\n+\n+        cases = manifest[\"cases\"]\n+        allow_exit = manifest.get(\"allow_exit\", True)\n+        for index, case in enumerate(cases):\n+            logger.info(f\"[{index + 1}] {case['name']}\")\n+\n+        min_choice = 1\n+        max_choice = len(cases)\n+        if allow_exit:\n+            min_choice = 0\n+            logger.info(\"[0] Back\")\n+\n+        choice = click.prompt(\n+            \"Enter choice\", type=click.IntRange(min=min_choice, max=max_choice)\n+        )\n+        logger.info()\n+\n+        if allow_exit and choice == 0:\n+            return BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+        return BuiltInActionResult(\n+            action=BuiltInActionResultAction.GOTO, content=cases[choice - 1][\"action\"]\n+        )"},{"sha":"18391a7d8f2859152042a22adf2b337da8cd4bfa","filename":"on-premise/datasaur-cli/src/action/run_workflow/run_workflow_action.py","status":"added","additions":196,"deletions":0,"changes":196,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Frun_workflow_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Frun_workflow_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Frun_workflow%2Frun_workflow_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,196 @@\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+from src.action.run_workflow.builtin_action.set_environment_variables.set_environment_variables_builtin_action import (\n+    SetEnvironmentVariablesBuiltInAction,\n+)\n+from src.action.run_workflow.builtin_action.set_encryption_config.set_encryption_config_builtin_action import (\n+    SetEncryptionConfigBuiltInAction,\n+)\n+from src.action.run_workflow.builtin_action.switch_input.switch_input_builtin_action import (\n+    SwitchInputBuiltInAction,\n+)\n+from src.common import logger\n+\n+\n+class ActionModel(BaseModel):\n+    name: str\n+    action: str\n+    title: str\n+\n+\n+class RunWorkflowArgsModel(BaseModel):\n+    workflow: List[str]\n+    actions: List[ActionModel]\n+\n+\n+class RunWorkflowAction(Action):\n+    def __init__(self):\n+        self._register_builtin_actions()\n+\n+    def _register_builtin_actions(self):\n+        self.builtin_actions = {}\n+        for action in self._get_builtin_action_instances():\n+            self.builtin_actions[action.name()] = action\n+\n+    def _get_builtin_action_instances(self) -> List[object]:\n+        return [\n+            SetEnvironmentVariablesBuiltInAction(),\n+            SetEncryptionConfigBuiltInAction(),\n+            SwitchInputBuiltInAction(),\n+        ]\n+\n+    def name(self) -> str:\n+        return \"run-workflow\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {\n+            \"action\": {\n+                \"short\": \"a\",\n+                \"type\": \"string\",\n+            }\n+        }\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating `{self.name()}` action...\")\n+\n+        if not self._validate_args(args):\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+\n+        error_message = self._validate_flow_action_manifests(args)\n+        if error_message:\n+            logger.error(f\"✗ Action is invalid: {error_message}\")\n+            return False\n+\n+        error_message = self._validate_workflow_action_names(args)\n+        if error_message:\n+            logger.error(f\"✗ Action is invalid: {error_message}\")\n+            return False\n+\n+        logger.info(\"✓ Action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        context = self._get_run_flow_action_context(context, args)\n+\n+        # Run a single flow action\n+        action_name = context.get(\"option_values\", {}).get(\"action\")\n+        if action_name:\n+            return self._run_flow_action(context, action_name)\n+\n+        # Otherwise, run the workflow\n+        workflow_action_names = args.get(\"workflow\", [])\n+        for workflow_action_name in workflow_action_names:\n+            if not self._run_flow_action(context, workflow_action_name):\n+                return False\n+\n+        return True\n+\n+    def _get_run_flow_action_context(\n+        self, context: Dict[str, Any], args: Dict[str, Any]\n+    ) -> Dict[str, Any]:\n+        flow_action_manifests = args.get(\"actions\", [])\n+        flow_action_manifests_dict = {}\n+        for manifest in flow_action_manifests:\n+            flow_action_manifests_dict[manifest[\"name\"]] = manifest\n+\n+        visited_flow_actions = set()\n+\n+        context = {\n+            **context,\n+            \"flow_action_manifests\": flow_action_manifests_dict,\n+            \"visited_flow_actions\": visited_flow_actions,\n+        }\n+\n+        return context\n+\n+    def _run_flow_action(self, context: Dict[str, Any], flow_action_name: str) -> bool:\n+        flow_action_manifest = context.get(\"flow_action_manifests\", {}).get(\n+            flow_action_name\n+        )\n+        if not flow_action_manifest:\n+            logger.error(f\"✗ Flow action '{flow_action_name}' not found\")\n+            return False\n+\n+        builtin_action_name = flow_action_manifest.get(\"action\")\n+        builtin_action = self.builtin_actions.get(builtin_action_name)\n+        if not builtin_action:\n+            logger.error(\n+                f\"✗ Built-in action '{builtin_action_name}' not found\"\n+            )\n+            return False\n+\n+        visited_flow_actions = context.get(\"visited_flow_actions\", set())\n+        if flow_action_name in visited_flow_actions:\n+            logger.error(\n+                f\"✗ Possible infinite loop detected. Flow action '{flow_action_name}' has been executed before.\"\n+            )\n+            return False\n+        visited_flow_actions.add(flow_action_name)\n+        context = {**context, \"visited_flow_actions\": visited_flow_actions}\n+\n+        if not builtin_action.validate(flow_action_manifest):\n+            return False\n+\n+        result: BuiltInActionResult = builtin_action.run(context, flow_action_manifest)\n+\n+        match result.action:\n+            case BuiltInActionResultAction.DONE:\n+                return True\n+            case BuiltInActionResultAction.EXIT:\n+                return False\n+            case BuiltInActionResultAction.GOTO:\n+                return self._run_flow_action(context, result.content)\n+\n+    def _validate_args(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            RunWorkflowArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            return False\n+        return True\n+\n+    def _validate_flow_action_manifests(self, args: Dict[str, Any]) -> Optional[str]:\n+        flow_action_manifests = args.get(\"actions\", [])\n+        for index, manifest in enumerate(flow_action_manifests):\n+            if manifest[\"action\"] not in self.builtin_actions:\n+                return f\"Unknown builtin action `{manifest['action']}` in flow actions [{index}]\"\n+\n+        flow_action_manifests_map = {}\n+        for manifest in flow_action_manifests:\n+            flow_action_manifests_map[manifest[\"name\"]] = manifest\n+\n+        for manifest_index, manifest in enumerate(flow_action_manifests):\n+            if manifest[\"action\"] != \"switch-input\":\n+                continue\n+\n+            cases = manifest.get(\"cases\", [])\n+            for case_index, case in enumerate(cases):\n+                action = case[\"action\"]\n+                if action not in flow_action_manifests_map:\n+                    return f\"Unknown flow action `{action}` in flow actions [{manifest_index}] case [{case_index}]\"\n+\n+        return None\n+\n+    def _validate_workflow_action_names(self, args: Dict[str, Any]) -> Optional[str]:\n+        flow_action_manifests_map = {}\n+        flow_action_manifests = args.get(\"actions\", [])\n+        for manifest in flow_action_manifests:\n+            flow_action_manifests_map[manifest[\"name\"]] = manifest\n+\n+        workflow_action_names = args.get(\"workflow\", [])\n+        for index, action_name in enumerate(workflow_action_names):\n+            if action_name not in flow_action_manifests_map:\n+                return (\n+                    f\"Unknown flow action `{action_name}` in workflow actions [{index}]\"\n+                )\n+\n+        return None"},{"sha":"e7c362338e62e9b9ea0b032400bb30c03de7ee84","filename":"on-premise/datasaur-cli/src/action/start/create_docker_resources_action.py","status":"added","additions":197,"deletions":0,"changes":197,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fcreate_docker_resources_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fcreate_docker_resources_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fcreate_docker_resources_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,197 @@\n+import subprocess\n+import os\n+from typing import Any, Dict, List\n+\n+from pydantic import BaseModel, ValidationError, Field\n+import yaml\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class CreateDockerResourcesArgsModel(BaseModel):\n+\tnetworks: List[str] = Field(default_factory=list)\n+\tvolumes: List[str] = Field(default_factory=list)\n+\tdocker_compose_file: str | None = None\n+\n+class CreateDockerResourcesAction(Action):\n+\tdef name(self) -> str:\n+\t\treturn \"create-docker-resources\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\tlogger.info(f\"Validating `{self.name()}` action...\")\n+\n+\t\ttry:\n+\t\t\tvalidated_args = CreateDockerResourcesArgsModel.model_validate(args)\n+\t\texcept ValidationError as e:\n+\t\t\tlogger.error(str(e))\n+\t\t\tlogger.error(\"✗ Action is invalid\")\n+\t\t\treturn False\n+\n+\t\tdocker_compose_file = validated_args.docker_compose_file or self._find_default_docker_compose_file()\n+\t\tif not docker_compose_file:\n+\t\t\tlogger.error(\"✗ Could not find a Docker Compose file. Please provide `docker_compose_file`.\")\n+\t\t\treturn False\n+\n+\t\tif not os.path.exists(docker_compose_file):\n+\t\t\tlogger.error(f\"✗ Docker Compose file does not exist: {docker_compose_file}\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+\t\tnetworks = args.get(\"networks\", [])\n+\t\tvolumes = args.get(\"volumes\", [])\n+\t\tdocker_compose_file = args.get(\"docker_compose_file\") or self._find_default_docker_compose_file()\n+\n+\t\tif not docker_compose_file:\n+\t\t\tlogger.error(\"✗ Could not find a Docker Compose file. Please provide `docker_compose_file`.\")\n+\t\t\treturn False\n+\n+\t\texternal_networks, external_volumes = self._get_external_resources_from_compose(docker_compose_file)\n+\t\tif external_networks is None or external_volumes is None:\n+\t\t\treturn False\n+\n+\t\tresources_created = 0\n+\n+\t\t# Create Docker networks\n+\t\tfor network in networks:\n+\t\t\tif network not in external_networks:\n+\t\t\t\tlogger.warn(f\"Skipping Docker network '{network}' (not marked as external in compose)\")\n+\t\t\t\tcontinue\n+\t\t\tif not self._create_docker_network(network):\n+\t\t\t\treturn False\n+\t\t\tresources_created += 1\n+\n+\t\t# Create Docker volumes\n+\t\tfor volume in volumes:\n+\t\t\tif volume not in external_volumes:\n+\t\t\t\tlogger.warn(f\"Skipping Docker volume '{volume}' (not marked as external in compose)\")\n+\t\t\t\tcontinue\n+\t\t\tif not self._create_docker_volume(volume):\n+\t\t\t\treturn False\n+\t\t\tresources_created += 1\n+\n+\t\tif resources_created == 0:\n+\t\t\tlogger.info(\"✓ No external Docker resources to create\", fg=\"green\")\n+\t\telse:\n+\t\t\tlogger.info(\"✓ External Docker resources created successfully\", fg=\"green\")\n+\t\tlogger.info()\n+\t\treturn True\n+\n+\tdef _find_default_docker_compose_file(self) -> str | None:\n+\t\tfor candidate in [\"docker-compose.yml\", \"docker-compose.yaml\", \"compose.yml\", \"compose.yaml\"]:\n+\t\t\tif os.path.exists(candidate):\n+\t\t\t\treturn candidate\n+\t\treturn None\n+\n+\tdef _get_external_resources_from_compose(self, docker_compose_file: str) -> tuple[set[str], set[str]] | tuple[None, None]:\n+\t\ttry:\n+\t\t\twith open(docker_compose_file, \"r\") as f:\n+\t\t\t\tcompose = yaml.safe_load(f) or {}\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Failed to read Docker Compose file '{docker_compose_file}': {str(e)}\")\n+\t\t\treturn None, None\n+\n+\t\texternal_networks = self._extract_external_resource_names(compose.get(\"networks\", {}))\n+\t\texternal_volumes = self._extract_external_resource_names(compose.get(\"volumes\", {}))\n+\n+\t\treturn external_networks, external_volumes\n+\n+\tdef _extract_external_resource_names(self, resources: Any) -> set[str]:\n+\t\tnames: set[str] = set()\n+\t\tif not isinstance(resources, dict):\n+\t\t\treturn names\n+\n+\t\tfor resource_key, resource_config in resources.items():\n+\t\t\tif isinstance(resource_config, dict):\n+\t\t\t\texternal = resource_config.get(\"external\")\n+\t\t\t\tis_external = external is True or isinstance(external, dict)\n+\t\t\t\tif not is_external:\n+\t\t\t\t\tcontinue\n+\n+\t\t\t\tnames.add(str(resource_key))\n+\n+\t\t\t\tdeclared_name = resource_config.get(\"name\")\n+\t\t\t\tif declared_name:\n+\t\t\t\t\tnames.add(str(declared_name))\n+\n+\t\t\t\tif isinstance(external, dict):\n+\t\t\t\t\texternal_name = external.get(\"name\")\n+\t\t\t\t\tif external_name:\n+\t\t\t\t\t\tnames.add(str(external_name))\n+\n+\t\t\tif resource_config is True:\n+\t\t\t\tnames.add(str(resource_key))\n+\n+\t\treturn names\n+\n+\tdef _create_docker_network(self, network: str) -> bool:\n+\t\t\"\"\"\n+\t\tCreate a single Docker network.\n+\n+\t\tArgs:\n+\t\t\tnetwork: Name of the network to create\n+\n+\t\tReturns:\n+\t\t\tTrue if successful or network already exists, False otherwise\n+\t\t\"\"\"\n+\t\tlogger.info(f\"Creating Docker network: {network}\")\n+\t\ttry:\n+\t\t\tresult = subprocess.run(\n+\t\t\t\t[\"docker\", \"network\", \"create\", network],\n+\t\t\t\tcapture_output=True,\n+\t\t\t\ttext=True\n+\t\t\t)\n+\n+\t\t\tif result.returncode != 0:\n+\t\t\t\t# Check if network already exists\n+\t\t\t\tif \"already exists\" in result.stderr.lower():\n+\t\t\t\t\tlogger.warn(f\"  Network '{network}' already exists, skipping\")\n+\t\t\t\t\treturn True\n+\t\t\t\telse:\n+\t\t\t\t\tlogger.error(f\"✗ Failed to create Docker network '{network}': {result.stderr}\")\n+\t\t\t\t\treturn False\n+\t\t\telse:\n+\t\t\t\tlogger.info(f\"✓ Successfully created network '{network}'\", fg=\"green\")\n+\t\t\t\treturn True\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Error creating Docker network '{network}': {str(e)}\")\n+\t\t\treturn False\n+\n+\tdef _create_docker_volume(self, volume: str) -> bool:\n+\t\t\"\"\"\n+\t\tCreate a single Docker volume.\n+\n+\t\tArgs:\n+\t\t\tvolume: Name of the volume to create\n+\n+\t\tReturns:\n+\t\t\tTrue if successful or volume already exists, False otherwise\n+\t\t\"\"\"\n+\t\tlogger.info(f\"Creating Docker volume: {volume}\")\n+\t\ttry:\n+\t\t\tresult = subprocess.run(\n+\t\t\t\t[\"docker\", \"volume\", \"create\", volume],\n+\t\t\t\tcapture_output=True,\n+\t\t\t\ttext=True\n+\t\t\t)\n+\n+\t\t\tif result.returncode != 0:\n+\t\t\t\t# Check if volume already exists\n+\t\t\t\tif \"already exists\" in result.stderr.lower():\n+\t\t\t\t\tlogger.warn(f\"  Volume '{volume}' already exists, skipping\")\n+\t\t\t\t\treturn True\n+\t\t\t\telse:\n+\t\t\t\t\tlogger.error(f\"✗ Failed to create Docker volume '{volume}': {result.stderr}\")\n+\t\t\t\t\treturn False\n+\t\t\telse:\n+\t\t\t\tlogger.info(f\"✓ Successfully created volume '{volume}'\", fg=\"green\")\n+\t\t\t\treturn True\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Error creating Docker volume '{volume}': {str(e)}\")\n+\t\t\treturn False"},{"sha":"8e7fbdc68327e8edcd4ac62870680d59e9933355","filename":"on-premise/datasaur-cli/src/action/start/docker_compose_stop_services_action.py","status":"added","additions":168,"deletions":0,"changes":168,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_compose_stop_services_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_compose_stop_services_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_compose_stop_services_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,168 @@\n+from pathlib import Path\n+import subprocess\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+from src.common.file_validator import FileValidator\n+\n+\n+class ServiceConditionModel(BaseModel):\n+\tservice: str\n+\tenv_var: str\n+\tstop_when: str\n+\tenv_file: Optional[str] = None\n+\n+\n+class DockerComposeStopServicesArgsModel(BaseModel):\n+\tenv_files: List[str]\n+\tdocker_compose_file: Optional[str] = None\n+\tconditions: List[ServiceConditionModel]\n+\n+\n+class DockerComposeStopServicesAction(Action):\n+\tdef __init__(self):\n+\t\tself.env_file = EnvFile()\n+\n+\tdef name(self) -> str:\n+\t\treturn \"docker-compose-stop-services\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\ttry:\n+\t\t\tvalidated_args = DockerComposeStopServicesArgsModel.model_validate(args)\n+\t\texcept ValidationError as e:\n+\t\t\tlogger.error(str(e))\n+\t\t\tlogger.error(\"✗ Action is invalid\")\n+\t\t\treturn False\n+\n+\t\tdocker_compose_file = validated_args.docker_compose_file\n+\t\tif docker_compose_file and not FileValidator().validate(docker_compose_file, check_permissions=False):\n+\t\t\treturn False\n+\n+\t\tfor env_file in validated_args.env_files:\n+\t\t\tif not FileValidator().validate(env_file, check_permissions=False):\n+\t\t\t\treturn False\n+\n+\t\t# Validate condition-specific env files\n+\t\tfor condition in validated_args.conditions:\n+\t\t\tif condition.env_file and not FileValidator().validate(condition.env_file, check_permissions=False):\n+\t\t\t\treturn False\n+\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+\t\tdocker_compose_file = args.get(\"docker_compose_file\")\n+\t\tenv_files = args.get(\"env_files\", [])\n+\t\tconditions = args.get(\"conditions\", [])\n+\n+\t\tif not conditions:\n+\t\t\tlogger.info(\"✓ No conditions specified, nothing to stop\", fg=\"green\")\n+\t\t\tlogger.info()\n+\t\t\treturn True\n+\n+\t\t# Load environment variables from all env files\n+\t\tenv_vars = self._load_env_files(env_files)\n+\t\tif env_vars is None:\n+\t\t\treturn False\n+\n+\t\t# Determine which services to stop based on conditions\n+\t\tservices_to_stop = []\n+\t\tfor condition in conditions:\n+\t\t\tservice = condition.get(\"service\")\n+\t\t\tenv_var = condition.get(\"env_var\")\n+\t\t\tstop_when = condition.get(\"stop_when\")\n+\t\t\tcondition_env_file = condition.get(\"env_file\")\n+\n+\t\t\t# If condition has its own env file, load it\n+\t\t\tcondition_env_vars = env_vars.copy()\n+\t\t\tif condition_env_file:\n+\t\t\t\tcondition_specific_vars = self._load_env_files([condition_env_file])\n+\t\t\t\tif condition_specific_vars is None:\n+\t\t\t\t\treturn False\n+\t\t\t\tcondition_env_vars.update(condition_specific_vars)\n+\n+\t\t\t# Get the value of the environment variable\n+\t\t\tenv_value = condition_env_vars.get(env_var, \"\")\n+\n+\t\t\tlogger.info(f\"  Checking condition: {env_var}={env_value} (stop when: {stop_when})\")\n+\n+\t\t\tif env_value.lower() == stop_when.lower():\n+\t\t\t\tservices_to_stop.append(service)\n+\t\t\t\tlogger.warn(f\"    -> Will stop service: {service}\")\n+\t\t\telse:\n+\t\t\t\tlogger.info(f\"    -> Service {service} will remain running\")\n+\n+\t\tif not services_to_stop:\n+\t\t\tlogger.info(\"✓ No services need to be stopped based on conditions\", fg=\"green\")\n+\t\t\tlogger.info()\n+\t\t\treturn True\n+\n+\t\t# Build and execute docker compose stop command\n+\t\tcommand = [\"docker\", \"compose\"]\n+\t\tcondition_env_files = [condition.get(\"env_file\") for condition in conditions if condition.get(\"env_file\")]\n+\t\tall_env_files = list(dict.fromkeys(env_files + condition_env_files))\n+\n+\t\tfor env_file in all_env_files:\n+\t\t\tcommand.extend([\"--env-file\", env_file])\n+\n+\t\tif docker_compose_file:\n+\t\t\tcommand.extend([\"-f\", docker_compose_file])\n+\n+\t\tcommand.append(\"stop\")\n+\t\tcommand.extend(services_to_stop)\n+\n+\t\ttry:\n+\t\t\tlogger.info(f\"Executing: {' '.join(command)}\")\n+\t\t\tresult = subprocess.run(\n+\t\t\t\tcommand,\n+\t\t\t\tcapture_output=True,\n+\t\t\t\ttext=True\n+\t\t\t)\n+\n+\t\t\tif result.returncode != 0:\n+\t\t\t\tif result.stdout:\n+\t\t\t\t\tlogger.info(f\"  Output: {result.stdout.rstrip()}\")\n+\t\t\t\tlogger.error(f\"✗ Failed to stop services: {result.stderr}\")\n+\t\t\t\treturn False\n+\t\t\telse:\n+\t\t\t\tif result.stdout:\n+\t\t\t\t\tlogger.info(f\"  Output: {result.stdout.rstrip()}\")\n+\t\t\t\tlogger.info(f\"✓ Successfully stopped services: {', '.join(services_to_stop)}\", fg=\"green\")\n+\t\t\t\tlogger.info()\n+\t\t\t\treturn True\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Error stopping services: {str(e)}\")\n+\t\t\treturn False\n+\n+\tdef _load_env_files(self, env_files: List[str]) -> Optional[Dict[str, str]]:\n+\t\t\"\"\"\n+\t\tLoad environment variables from multiple env files.\n+\n+\t\tArgs:\n+\t\t\tenv_files: List of paths to env files\n+\n+\t\tReturns:\n+\t\t\tDictionary of environment variable names to values\n+\t\t\"\"\"\n+\t\tenv_vars = {}\n+\n+\t\tfor env_file in env_files:\n+\t\t\tfile_content, ok = self.env_file.read(Path(env_file), create_if_not_exists=False)\n+\t\t\tif not ok:\n+\t\t\t\tlogger.error(f\"✗ Expected env file missing or unreadable: {env_file}\")\n+\t\t\t\treturn None\n+\t\t\tif file_content is None:\n+\t\t\t\tlogger.error(f\"✗ Expected env file missing or unreadable: {env_file}\")\n+\t\t\t\treturn None\n+\n+\t\t\tenv_vars.update({k: (v or \"\") for k, v in file_content.items()})\n+\n+\t\treturn env_vars"},{"sha":"fed90b5ee571c61cfaaac62df74bcffd38a9b3ce","filename":"on-premise/datasaur-cli/src/action/start/docker_compose_up_action.py","status":"added","additions":83,"deletions":0,"changes":83,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_compose_up_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_compose_up_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_compose_up_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,83 @@\n+import subprocess\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.docker_compose_env_service import DockerComposeEnvService\n+from src.common.file_validator import FileValidator\n+\n+\n+class DockerComposeUpArgsModel(BaseModel):\n+\tenv_files: List[str]\n+\tdocker_compose_file: Optional[str] = None\n+\n+class DockerComposeUpAction(Action):\n+\tdef __init__(self):\n+\t\tself.compose_env_service = DockerComposeEnvService()\n+\n+\tdef name(self) -> str:\n+\t\treturn \"docker-compose-up\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\ttry:\n+\t\t\tvalidated_args = DockerComposeUpArgsModel.model_validate(args)\n+\t\texcept ValidationError as e:\n+\t\t\tlogger.error(str(e))\n+\t\t\tlogger.error(\"✗ Action is invalid\")\n+\t\t\treturn False\n+\n+\t\tdocker_compose_file = validated_args.docker_compose_file\n+\t\tif docker_compose_file and not FileValidator().validate(docker_compose_file, check_permissions=False):\n+\t\t\treturn False\n+\n+\t\tfor env_file in validated_args.env_files:\n+\t\t\tif not FileValidator().validate(env_file, check_permissions=False):\n+\t\t\t\treturn False\n+\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+\t\tdocker_compose_file = args.get(\"docker_compose_file\")\n+\t\tenv_files = args.get(\"env_files\", [])\n+\n+\t\tcommand = [\"docker\", \"compose\"]\n+\n+\t\tfor env_file in env_files:\n+\t\t\tcommand.extend([\"--env-file\", env_file])\n+\n+\t\tif docker_compose_file:\n+\t\t\tcommand.extend([\"-f\", docker_compose_file])\n+\n+\t\tcommand.extend([\"up\", \"-d\"])\n+\t\tcompose_env = self.compose_env_service.build_env()\n+\n+\t\ttry:\n+\t\t\tlogger.info(f\"Executing: {' '.join(command)}\")\n+\t\t\tresult = subprocess.run(\n+\t\t\t\tcommand,\n+\t\t\t\tenv=compose_env,\n+\t\t\t\tcapture_output=True,\n+\t\t\t\ttext=True\n+\t\t\t)\n+\n+\t\t\tif result.returncode != 0:\n+\t\t\t\tif result.stdout:\n+\t\t\t\t\tlogger.info(f\"  Output: {result.stdout.rstrip()}\")\n+\t\t\t\tlogger.error(f\"✗ Failed to run docker compose: {result.stderr}\")\n+\t\t\t\treturn False\n+\t\t\telse:\n+\t\t\t\tif result.stdout:\n+\t\t\t\t\tlogger.info(f\"  Output: {result.stdout.rstrip()}\")\n+\t\t\t\tlogger.info(\"✓ Docker compose started successfully\", fg=\"green\")\n+\t\t\t\tlogger.info()\n+\t\t\t\treturn True\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Error running docker compose: {str(e)}\")\n+\t\t\treturn False"},{"sha":"3d301b39dcbe3d73a9670431c038031750ea90ea","filename":"on-premise/datasaur-cli/src/action/start/docker_login_action.py","status":"added","additions":93,"deletions":0,"changes":93,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_login_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_login_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_login_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,93 @@\n+import subprocess\n+import time\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+MAX_ATTEMPTS = 5\n+RETRY_DELAY_SECONDS = 5\n+\n+\n+class DockerLoginArgsModel(BaseModel):\n+    env_file: str\n+    username_var: str\n+    password_var: str\n+    domain_var: str\n+\n+\n+class DockerLoginAction(Action):\n+    def name(self) -> str:\n+        return \"docker-login\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerLoginArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file = Path(args[\"env_file\"])\n+        username_var = args[\"username_var\"]\n+        password_var = args[\"password_var\"]\n+        domain_var = args[\"domain_var\"]\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        username = str(env_values.get(username_var) or \"\").strip()\n+        password = str(env_values.get(password_var) or \"\").strip()\n+        domain = str(env_values.get(domain_var) or \"\").strip()\n+        missing = [\n+            name\n+            for name, value in [(username_var, username), (password_var, password), (domain_var, domain)]\n+            if not value\n+        ]\n+        if missing:\n+            logger.error(f\"✗ Missing required values in {env_file}: {', '.join(missing)}\")\n+            return False\n+\n+        # A registry sitting behind a just-deployed Traefik route may not be reachable\n+        # yet — Traefik's swarm provider discovers new services on a polling interval,\n+        # and its own container needs a moment to boot before that first poll even runs.\n+        # Retry a few times with a short delay rather than failing on the first attempt.\n+        for attempt in range(1, MAX_ATTEMPTS + 1):\n+            try:\n+                result = subprocess.run(\n+                    [\"docker\", \"login\", \"-u\", username, \"--password-stdin\", domain],\n+                    input=password,\n+                    capture_output=True,\n+                    text=True,\n+                )\n+            except Exception as e:\n+                logger.error(f\"✗ Error logging in to registry '{domain}': {str(e)}\")\n+                return False\n+\n+            if result.returncode == 0:\n+                logger.info(f\"✓ Logged in to registry '{domain}'\", fg=\"green\")\n+                logger.info()\n+                return True\n+\n+            if attempt < MAX_ATTEMPTS:\n+                logger.warn(\n+                    f\"! Login to '{domain}' failed (attempt {attempt}/{MAX_ATTEMPTS}), \"\n+                    f\"retrying in {RETRY_DELAY_SECONDS}s: {result.stderr.strip()}\"\n+                )\n+                time.sleep(RETRY_DELAY_SECONDS)\n+\n+        logger.error(f\"✗ Failed to log in to registry '{domain}' after {MAX_ATTEMPTS} attempts: {result.stderr}\")\n+        return False"},{"sha":"e6c2a10b9dfd28843c4b1b99e1b773b3319751df","filename":"on-premise/datasaur-cli/src/action/start/docker_logout_action.py","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_logout_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_logout_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_logout_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,63 @@\n+import subprocess\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class DockerLogoutArgsModel(BaseModel):\n+    env_file: str\n+    domain_var: str\n+\n+\n+class DockerLogoutAction(Action):\n+    def name(self) -> str:\n+        return \"docker-logout\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerLogoutArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file = Path(args[\"env_file\"])\n+        domain_var = args[\"domain_var\"]\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        domain = str(env_values.get(domain_var) or \"\").strip()\n+        if not domain:\n+            logger.error(f\"✗ Missing required value in {env_file}: {domain_var}\")\n+            return False\n+\n+        try:\n+            result = subprocess.run([\"docker\", \"logout\", domain], capture_output=True, text=True)\n+        except Exception as e:\n+            logger.error(f\"✗ Error logging out of registry '{domain}': {str(e)}\")\n+            return False\n+\n+        if result.returncode != 0:\n+            logger.error(f\"✗ Failed to log out of registry '{domain}': {result.stderr}\")\n+            return False\n+\n+        if result.stdout:\n+            logger.info(f\"  Output: {result.stdout.rstrip()}\")\n+        logger.info(f\"✓ Logged out of registry '{domain}'\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"0235b484d035431af03aebf831e6e65e0441f9be","filename":"on-premise/datasaur-cli/src/action/start/docker_stack_deploy_action.py","status":"added","additions":183,"deletions":0,"changes":183,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_deploy_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_deploy_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_deploy_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,183 @@\n+import os\n+import re\n+import subprocess\n+import time\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional, Tuple\n+\n+from dotenv import dotenv_values\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.file_validator import FileValidator\n+from src.common.manifest_file_reader import ManifestFileReader\n+\n+ROOT_ENV_FILENAME = \".env\"\n+MANIFEST_FILENAME = \"manifest.yaml\"\n+MAX_ATTEMPTS = 5\n+RETRY_DELAY_SECONDS = 5\n+# Bare form only (\"$VAR\", not \"${VAR}\") — python-dotenv's own interpolation\n+# already resolves \"${VAR}\" against os.environ before this code ever sees the\n+# value, so the brace form isn't available for our own root-.env resolution.\n+ROOT_ENV_REF_PATTERN = re.compile(r\"^\\$([A-Za-z_][A-Za-z0-9_]*)$\")\n+\n+\n+class DockerStackDeployArgsModel(BaseModel):\n+    stack: str\n+\n+\n+class DockerStackDeployAction(Action):\n+    def __init__(self):\n+        # Injected by ActionsService._register_actions() after construction. None\n+        # only in isolated unit tests that don't exercise stack_hooks.\n+        self.actions_service: Optional[Any] = None\n+\n+    def name(self) -> str:\n+        return \"docker-stack-deploy\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            validated_args = DockerStackDeployArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+\n+        stack_file = os.path.join(validated_args.stack, \"stack.yaml\")\n+        return FileValidator().validate(stack_file, check_permissions=False)\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        stack = args[\"stack\"]\n+\n+        pre_deploy, post_deploy = self._stack_hooks(stack)\n+        if not self._run_hook_actions(context, pre_deploy, \"pre_deploy\"):\n+            return False\n+\n+        stack_file = os.path.join(stack, \"stack.yaml\")\n+        env_file = os.path.join(stack, \".env\")\n+\n+        stack_env = dotenv_values(env_file) if os.path.exists(env_file) else {}\n+        resolved_env, ok = self._resolve_stack_env(stack_env)\n+        if not ok:\n+            return False\n+\n+        # --with-registry-auth propagates this node's registry credentials into\n+        # the task spec so worker nodes can pull from an authenticated registry —\n+        # without it, Swarm's implicit per-task pull ignores every node's own\n+        # `docker login` and fails (masked as a generic \"No such image\" error).\n+        command = [\"docker\", \"stack\", \"deploy\", \"--with-registry-auth\", \"-c\", stack_file, stack]\n+        deploy_env = os.environ.copy()\n+        deploy_env.update(resolved_env)\n+\n+        logger.info(f\"Executing: {' '.join(command)}\")\n+\n+        # A network this stack owns can still be tearing down in the background\n+        # right after `docker stack rm` returns (e.g. a `restart` that just removed\n+        # this same stack) — Swarm reports the removal as done before the network\n+        # is actually gone, so an immediate redeploy can hit \"network X not found\".\n+        # Retry a few times with a short delay rather than failing on the first attempt.\n+        for attempt in range(1, MAX_ATTEMPTS + 1):\n+            try:\n+                result = subprocess.run(command, env=deploy_env, capture_output=True, text=True)\n+            except Exception as e:\n+                logger.error(f\"✗ Error deploying stack '{stack}': {str(e)}\")\n+                return False\n+\n+            if result.returncode == 0:\n+                if result.stdout:\n+                    logger.info(f\"  Output: {result.stdout.rstrip()}\")\n+                logger.info(f\"✓ Stack '{stack}' deployed successfully\", fg=\"green\")\n+                logger.info()\n+                return self._run_hook_actions(context, post_deploy, \"post_deploy\")\n+\n+            if not self._is_transient_network_error(result.stderr):\n+                logger.error(f\"✗ Failed to deploy stack '{stack}': {result.stderr}\")\n+                return False\n+\n+            if attempt < MAX_ATTEMPTS:\n+                logger.warn(\n+                    f\"! Failed to deploy stack '{stack}' (attempt {attempt}/{MAX_ATTEMPTS}), \"\n+                    f\"retrying in {RETRY_DELAY_SECONDS}s: {result.stderr.strip()}\"\n+                )\n+                time.sleep(RETRY_DELAY_SECONDS)\n+\n+        logger.error(f\"✗ Failed to deploy stack '{stack}' after {MAX_ATTEMPTS} attempts: {result.stderr}\")\n+        return False\n+\n+    def _stack_hooks(self, stack: str) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:\n+        # Cheap existence check first: most unit-test fixtures (and any bare\n+        # `stack.yaml`-only directory) ship no manifest.yaml at all, and\n+        # ManifestFileReader().read() logs an \"✗ Failed to read manifest file\"\n+        # error on a missing file — noise we don't want for what is, for\n+        # stack_hooks, a perfectly normal \"nothing declared\" case.\n+        if not Path(MANIFEST_FILENAME).exists():\n+            return [], []\n+\n+        manifest, ok = ManifestFileReader().read(Path(\".\"))\n+        if not ok or manifest is None:\n+            return [], []\n+\n+        hooks = (manifest.get(\"stack_hooks\") or {}).get(stack) or {}\n+        return hooks.get(\"pre_deploy\") or [], hooks.get(\"post_deploy\") or []\n+\n+    def _run_hook_actions(\n+        self, context: Dict[str, Any], hook_actions: List[Dict[str, Any]], hook_name: str\n+    ) -> bool:\n+        if not hook_actions:\n+            return True\n+\n+        if self.actions_service is None:\n+            logger.error(f\"✗ Cannot run '{hook_name}' hook actions: no actions_service configured\")\n+            return False\n+\n+        # Mirror ClickCommandsService's own `command_action.get(\"args\") or {}`\n+        # normalization — a hook action manifest entry with no `args:` block at\n+        # all must not KeyError inside ActionsService.run()'s arg resolution.\n+        normalized = [\n+            {\"action\": hook_action[\"action\"], \"args\": hook_action.get(\"args\") or {}}\n+            for hook_action in hook_actions\n+        ]\n+        return self.actions_service.run(context, normalized)\n+\n+    def _is_transient_network_error(self, stderr: str) -> bool:\n+        # Only retry the specific race this loop exists for — a network this stack\n+        # owns still tearing down from a just-completed `docker stack rm`. Any other\n+        # failure (bad stack.yaml, missing env var, unpullable image, ...) is a real\n+        # error and should surface immediately instead of being retried 5x/~8s.\n+        lowered = stderr.lower()\n+        return \"network\" in lowered and (\"not found\" in lowered or \"not exist\" in lowered)\n+\n+    def _resolve_stack_env(self, stack_env: Dict[str, Any]) -> Tuple[Dict[str, str], bool]:\n+        resolved: Dict[str, str] = {}\n+        root_env = None\n+\n+        for key, value in stack_env.items():\n+            if value is None:\n+                continue\n+\n+            ref_match = ROOT_ENV_REF_PATTERN.match(value)\n+            if ref_match:\n+                if root_env is None:\n+                    root_env = dotenv_values(ROOT_ENV_FILENAME) if os.path.exists(ROOT_ENV_FILENAME) else {}\n+                var_name = ref_match.group(1)\n+                if not root_env.get(var_name):\n+                    logger.error(\n+                        f\"✗ '{key}={value}' references '{var_name}', which is missing from root {ROOT_ENV_FILENAME}\"\n+                    )\n+                    return {}, False\n+                resolved[key] = root_env[var_name]\n+            elif value.startswith(\"$$\"):\n+                # Escape hatch for a literal value that happens to start with \"$\"\n+                # (e.g. a generated secret) — \"$$foo\" resolves to the literal \"$foo\"\n+                # instead of being mistaken for a root-env reference.\n+                resolved[key] = value[1:]\n+            else:\n+                resolved[key] = value\n+\n+        return resolved, True"},{"sha":"dba0067f8a9de47e999b6d8fbf22e640aa5239cb","filename":"on-premise/datasaur-cli/src/action/start/docker_stack_dump_logs_action.py","status":"added","additions":74,"deletions":0,"changes":74,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_dump_logs_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_dump_logs_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_dump_logs_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,74 @@\n+import subprocess\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class DockerStackDumpLogsArgsModel(BaseModel):\n+    stack: str\n+\n+\n+class DockerStackDumpLogsAction(Action):\n+    def name(self) -> str:\n+        return \"docker-stack-dump-logs\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerStackDumpLogsArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        stack = args[\"stack\"]\n+        services = self._list_services(stack)\n+        if services is None:\n+            return False\n+\n+        if not services:\n+            logger.warn(f\"No services found for stack '{stack}'\")\n+            logger.info()\n+            return True\n+\n+        for service in services:\n+            logger.info(f\"--- logs: {service} ---\", fg=\"cyan\")\n+            try:\n+                result = subprocess.run([\"docker\", \"service\", \"logs\", service], capture_output=True, text=True)\n+            except Exception as e:\n+                logger.error(f\"✗ Error fetching logs for '{service}': {str(e)}\")\n+                return False\n+            if result.returncode != 0:\n+                logger.error(f\"✗ Failed to fetch logs for '{service}': {result.stderr}\")\n+                return False\n+            if result.stdout:\n+                logger.info(result.stdout.rstrip())\n+            if result.stderr:\n+                logger.info(result.stderr.rstrip())\n+\n+        logger.info()\n+        return True\n+\n+    def _list_services(self, stack: str) -> Optional[List[str]]:\n+        try:\n+            result = subprocess.run(\n+                [\"docker\", \"stack\", \"services\", \"--format\", \"{{.Name}}\", stack],\n+                capture_output=True,\n+                text=True,\n+            )\n+        except Exception as e:\n+            logger.error(f\"✗ Error listing services for stack '{stack}': {str(e)}\")\n+            return None\n+        if result.returncode != 0:\n+            logger.error(f\"✗ Failed to list services for stack '{stack}': {result.stderr}\")\n+            return None\n+        return [name for name in result.stdout.strip().splitlines() if name]"},{"sha":"bd7e48f47f3ca49edb3edb1f6be4e0c5dfd7cc35","filename":"on-premise/datasaur-cli/src/action/start/docker_stack_rm_all_action.py","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_rm_all_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_rm_all_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_stack_rm_all_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,57 @@\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.manifest_file_reader import ManifestFileReader\n+from src.common.stack_discovery import discover_stacks, order_stacks\n+\n+MANIFEST_FILENAME = \"manifest.yaml\"\n+\n+\n+class DockerStackRmAllAction(Action):\n+    def __init__(self):\n+        # Injected by ActionsService._register_actions() after construction,\n+        # same pattern as DockerStackDeployAction's own stack_hooks delegation.\n+        self.actions_service: Optional[Any] = None\n+\n+    def name(self) -> str:\n+        return \"docker-stack-rm-all\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        if self.actions_service is None:\n+            logger.error(\"✗ Cannot remove stacks: no actions_service configured\")\n+            return False\n+\n+        discovered = discover_stacks(Path(\".\"))\n+        if not discovered:\n+            logger.info(\"✓ No stacks found, nothing to remove\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        stack_order = self._stack_order()\n+        up_order = order_stacks(discovered, stack_order) if stack_order else discovered\n+        down_order = list(reversed(up_order)) if stack_order else discovered\n+\n+        for stack in down_order:\n+            if not self.actions_service.run(context, [{\"action\": \"docker-stack-rm\", \"args\": {\"stack\": stack}}]):\n+                return False\n+\n+        return True\n+\n+    def _stack_order(self) -> List[str]:\n+        if not Path(MANIFEST_FILENAME).exists():\n+            return []\n+        manifest, ok = ManifestFileReader().read(Path(\".\"))\n+        if not ok or manifest is None:\n+            return []\n+        return manifest.get(\"stack_order\") or []"},{"sha":"2d2a3f70ce50cc5d1c3d0909b748c257f6f309e8","filename":"on-premise/datasaur-cli/src/action/start/docker_swarm_init_action.py","status":"added","additions":74,"deletions":0,"changes":74,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_init_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_init_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_init_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,74 @@\n+import subprocess\n+from typing import Any, Dict, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class DockerSwarmInitArgsModel(BaseModel):\n+\tadvertise_addr: Optional[str] = None\n+\n+\n+class DockerSwarmInitAction(Action):\n+    def name(self) -> str:\n+        return \"docker-swarm-init\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerSwarmInitArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        if self._is_swarm_active():\n+            logger.info(\"✓ Node is already part of a Swarm, skipping `docker swarm init`\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        command = [\"docker\", \"swarm\", \"init\"]\n+        advertise_addr = args.get(\"advertise_addr\")\n+        if advertise_addr:\n+            command.extend([\"--advertise-addr\", advertise_addr])\n+\n+        try:\n+            logger.info(f\"Executing: {' '.join(command)}\")\n+            result = subprocess.run(command, capture_output=True, text=True)\n+\n+            if result.returncode != 0:\n+                logger.error(f\"✗ Failed to initialize Docker Swarm: {result.stderr}\")\n+                return False\n+\n+            # Deliberately not logging result.stdout here — `docker swarm init`'s own\n+            # output includes a raw `docker swarm join --token ... <addr>` line, which\n+            # is confusing this early (no workers exist yet) and in the wrong shape for\n+            # `init-llm-server`/`init-ingestion-server`'s separate prompts anyway.\n+            # `print-docker-swarm-join-token` (run at the end of `init-app-server`) is\n+            # the one place this token is meant to be shown to the operator.\n+            logger.info(\"✓ Docker Swarm initialized successfully\", fg=\"green\")\n+            logger.info()\n+            return True\n+        except Exception as e:\n+            logger.error(f\"✗ Error initializing Docker Swarm: {str(e)}\")\n+            return False\n+\n+    def _is_swarm_active(self) -> bool:\n+        try:\n+            result = subprocess.run(\n+                [\"docker\", \"info\", \"-f\", \"{{.Swarm.LocalNodeState}}\"],\n+                capture_output=True,\n+                text=True,\n+            )\n+            return result.returncode == 0 and result.stdout.strip() == \"active\"\n+        except Exception as e:\n+            logger.error(f\"✗ Error checking Docker Swarm status: {str(e)}\")\n+            return False"},{"sha":"9b40f7147b7446cfeb341df5e1bd7dc34e94d5e8","filename":"on-premise/datasaur-cli/src/action/start/docker_swarm_join_action.py","status":"added","additions":86,"deletions":0,"changes":86,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_join_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_join_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_join_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,86 @@\n+import subprocess\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class DockerSwarmJoinArgsModel(BaseModel):\n+    env_file: str\n+    manager_address_var: str\n+    worker_join_token_var: str\n+\n+\n+class DockerSwarmJoinAction(Action):\n+    def name(self) -> str:\n+        return \"docker-swarm-join\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerSwarmJoinArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        if self._is_swarm_active():\n+            logger.info(\"✓ Node is already part of a Swarm, skipping `docker swarm join`\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        env_file = Path(args[\"env_file\"])\n+        manager_address_var = args[\"manager_address_var\"]\n+        worker_join_token_var = args[\"worker_join_token_var\"]\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        manager_addr = str(env_values.get(manager_address_var) or \"\").strip()\n+        join_token = str(env_values.get(worker_join_token_var) or \"\").strip()\n+        missing = [\n+            name\n+            for name, value in [(manager_address_var, manager_addr), (worker_join_token_var, join_token)]\n+            if not value\n+        ]\n+        if missing:\n+            logger.error(f\"✗ Missing required values in {env_file}: {', '.join(missing)}\")\n+            return False\n+\n+        command = [\"docker\", \"swarm\", \"join\", \"--token\", join_token, manager_addr]\n+\n+        try:\n+            result = subprocess.run(command, capture_output=True, text=True)\n+\n+            if result.returncode != 0:\n+                logger.error(f\"✗ Failed to join Docker Swarm: {result.stderr}\")\n+                return False\n+\n+            if result.stdout:\n+                logger.info(f\"  Output: {result.stdout.rstrip()}\")\n+            logger.info(\"✓ Joined Docker Swarm successfully\", fg=\"green\")\n+            logger.info()\n+            return True\n+        except Exception as e:\n+            logger.error(f\"✗ Error joining Docker Swarm: {str(e)}\")\n+            return False\n+\n+    def _is_swarm_active(self) -> bool:\n+        result = subprocess.run(\n+            [\"docker\", \"info\", \"-f\", \"{{.Swarm.LocalNodeState}}\"],\n+            capture_output=True,\n+            text=True,\n+        )\n+        return result.returncode == 0 and result.stdout.strip() == \"active\""},{"sha":"ff074758c6f37fea3c417c358da23ceb32edb1c0","filename":"on-premise/datasaur-cli/src/action/start/docker_swarm_leave_action.py","status":"added","additions":81,"deletions":0,"changes":81,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_leave_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_leave_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fdocker_swarm_leave_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,81 @@\n+import subprocess\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class DockerSwarmLeaveArgsModel(BaseModel):\n+    force: bool = False\n+\n+\n+class DockerSwarmLeaveAction(Action):\n+    def name(self) -> str:\n+        return \"docker-swarm-leave\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerSwarmLeaveArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        force = bool(args.get(\"force\", False))\n+\n+        if not self._is_swarm_active():\n+            logger.info(\"✓ Node is not part of a Swarm, skipping `docker swarm leave`\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        if self._is_manager() and not force:\n+            logger.error(\n+                \"✗ This node is a Swarm manager; `docker-swarm-leave` is for worker nodes only. \"\n+                \"Leaving would require --force and can break quorum/destroy the Swarm.\"\n+            )\n+            return False\n+\n+        command = [\"docker\", \"swarm\", \"leave\"]\n+        if force:\n+            command.append(\"--force\")\n+\n+        try:\n+            result = subprocess.run(command, capture_output=True, text=True)\n+\n+            if result.returncode != 0:\n+                logger.error(f\"✗ Failed to leave Docker Swarm: {result.stderr}\")\n+                return False\n+\n+            if result.stdout:\n+                logger.info(f\"  Output: {result.stdout.rstrip()}\")\n+            logger.info(\"✓ Left Docker Swarm successfully\", fg=\"green\")\n+            logger.info()\n+            return True\n+        except Exception as e:\n+            logger.error(f\"✗ Error leaving Docker Swarm: {str(e)}\")\n+            return False\n+\n+    def _is_swarm_active(self) -> bool:\n+        result = subprocess.run(\n+            [\"docker\", \"info\", \"-f\", \"{{.Swarm.LocalNodeState}}\"],\n+            capture_output=True,\n+            text=True,\n+        )\n+        return result.returncode == 0 and result.stdout.strip() == \"active\"\n+\n+    def _is_manager(self) -> bool:\n+        result = subprocess.run(\n+            [\"docker\", \"info\", \"-f\", \"{{.Swarm.ControlAvailable}}\"],\n+            capture_output=True,\n+            text=True,\n+        )\n+        return result.returncode == 0 and result.stdout.strip() == \"true\""},{"sha":"37f5fd4b28dd6d862b4ede04613f6bf9b0857ae5","filename":"on-premise/datasaur-cli/src/action/start/generate_htpasswd_docker_secret_action.py","status":"added","additions":131,"deletions":0,"changes":131,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_htpasswd_docker_secret_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_htpasswd_docker_secret_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_htpasswd_docker_secret_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,131 @@\n+import hashlib\n+import subprocess\n+from pathlib import Path\n+from typing import Any, Dict, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class GenerateHtpasswdDockerSecretArgsModel(BaseModel):\n+    source_env_file: str\n+    username_var: str\n+    password_var: str\n+    secret_name_prefix: str\n+    target_env_file: str\n+    secret_name_var: str\n+    htpasswd_image: str = \"httpd:alpine\"\n+\n+\n+class GenerateHtpasswdDockerSecretAction(Action):\n+    def name(self) -> str:\n+        return \"generate-htpasswd-docker-secret\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            GenerateHtpasswdDockerSecretArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        source_env_file = Path(args[\"source_env_file\"])\n+        username_var = args[\"username_var\"]\n+        password_var = args[\"password_var\"]\n+        secret_name_prefix = args[\"secret_name_prefix\"]\n+        target_env_file = Path(args[\"target_env_file\"])\n+        secret_name_var = args[\"secret_name_var\"]\n+        htpasswd_image = args.get(\"htpasswd_image\") or \"httpd:alpine\"\n+\n+        source_env, ok = EnvFile().read(source_env_file)\n+        if not ok or source_env is None:\n+            logger.error(f\"✗ Failed to read {source_env_file}\")\n+            return False\n+\n+        username = str(source_env.get(username_var) or \"\").strip()\n+        password = str(source_env.get(password_var) or \"\").strip()\n+        missing = [name for name, value in [(username_var, username), (password_var, password)] if not value]\n+        if missing:\n+            logger.error(f\"✗ Missing required values in {source_env_file}: {', '.join(missing)}\")\n+            return False\n+\n+        secret_hash = hashlib.sha256(f\"{username}:{password}\".encode()).hexdigest()[:8]\n+        secret_name = f\"{secret_name_prefix}_{secret_hash}\"\n+\n+        if not self._update_target_env(target_env_file, secret_name_var, secret_name):\n+            return False\n+\n+        if self._secret_exists(secret_name):\n+            logger.info(f\"✓ Secret '{secret_name}' already exists, skipping creation\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        htpasswd_line = self._generate_htpasswd_line(htpasswd_image, username, password)\n+        if htpasswd_line is None:\n+            return False\n+\n+        if not self._create_secret(secret_name, htpasswd_line):\n+            return False\n+\n+        logger.info(f\"✓ Created secret '{secret_name}'\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def _update_target_env(self, target_env_file: Path, secret_name_var: str, secret_name: str) -> bool:\n+        target_env, ok = EnvFile().read(target_env_file)\n+        if not ok or target_env is None:\n+            logger.error(f\"✗ Failed to read {target_env_file}\")\n+            return False\n+\n+        target_env[secret_name_var] = secret_name\n+        return EnvFile().write(target_env_file, target_env)\n+\n+    def _secret_exists(self, secret_name: str) -> bool:\n+        result = subprocess.run([\"docker\", \"secret\", \"inspect\", secret_name], capture_output=True, text=True)\n+        return result.returncode == 0\n+\n+    def _generate_htpasswd_line(self, htpasswd_image: str, username: str, password: str) -> Optional[str]:\n+        try:\n+            # -i reads the password from stdin instead of argv, so it never shows up\n+            # in `ps`/`/proc/<pid>/cmdline`/`docker inspect` while the container runs.\n+            result = subprocess.run(\n+                [\"docker\", \"run\", \"--rm\", \"-i\", htpasswd_image, \"htpasswd\", \"-nBi\", username],\n+                input=password,\n+                capture_output=True,\n+                text=True,\n+            )\n+        except Exception as e:\n+            logger.error(f\"✗ Error generating htpasswd entry: {str(e)}\")\n+            return None\n+\n+        if result.returncode != 0:\n+            logger.error(f\"✗ Failed to generate htpasswd entry: {result.stderr}\")\n+            return None\n+        return result.stdout\n+\n+    def _create_secret(self, secret_name: str, htpasswd_line: str) -> bool:\n+        try:\n+            result = subprocess.run(\n+                [\"docker\", \"secret\", \"create\", secret_name, \"-\"],\n+                input=htpasswd_line,\n+                capture_output=True,\n+                text=True,\n+            )\n+        except Exception as e:\n+            logger.error(f\"✗ Error creating secret '{secret_name}': {str(e)}\")\n+            return False\n+\n+        if result.returncode != 0:\n+            logger.error(f\"✗ Failed to create secret '{secret_name}': {result.stderr}\")\n+            return False\n+        return True"},{"sha":"dabe8f3c6f9905a4b72db73608ef310453efc23e","filename":"on-premise/datasaur-cli/src/action/start/generate_self_signed_ca_action.py","status":"added","additions":69,"deletions":0,"changes":69,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_self_signed_ca_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_self_signed_ca_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_self_signed_ca_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,69 @@\n+import os\n+import subprocess\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class GenerateSelfSignedCaArgsModel(BaseModel):\n+    ssl_dir: str\n+    cert_filename: str\n+    key_filename: str\n+\n+\n+class GenerateSelfSignedCaAction(Action):\n+    def name(self) -> str:\n+        return \"generate-self-signed-ca\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            GenerateSelfSignedCaArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        ssl_dir = Path(args[\"ssl_dir\"])\n+        cert_filename = args[\"cert_filename\"]\n+        key_filename = args[\"key_filename\"]\n+\n+        cert_path = ssl_dir / cert_filename\n+        key_path = ssl_dir / key_filename\n+        if cert_path.exists() and key_path.exists():\n+            logger.info(f\"✓ '{cert_path}'/'{key_path}' already exist, skipping generation\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        ssl_dir.mkdir(parents=True, exist_ok=True)\n+        command = [\n+            \"openssl\", \"req\", \"-x509\", \"-newkey\", \"rsa:4096\", \"-nodes\", \"-days\", \"3650\",\n+            \"-keyout\", str(key_path), \"-out\", str(cert_path),\n+            \"-subj\", \"/CN=WPS Self-Signed CA\",\n+            \"-addext\", \"basicConstraints=critical,CA:TRUE\",\n+        ]\n+\n+        try:\n+            result = subprocess.run(command, capture_output=True, text=True)\n+        except Exception as e:\n+            logger.error(f\"✗ Error generating self-signed CA: {str(e)}\")\n+            return False\n+\n+        if result.returncode != 0:\n+            logger.error(f\"✗ Failed to generate self-signed CA: {result.stderr}\")\n+            return False\n+\n+        os.chmod(key_path, 0o600)\n+        logger.info(f\"✓ Generated self-signed CA at '{cert_path}'/'{key_path}'\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"f17991505b10ac8322416e7887451b00d0843e5c","filename":"on-premise/datasaur-cli/src/action/start/generate_self_signed_ssl_certificate_action.py","status":"added","additions":112,"deletions":0,"changes":112,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_self_signed_ssl_certificate_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_self_signed_ssl_certificate_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fgenerate_self_signed_ssl_certificate_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,112 @@\n+import os\n+import subprocess\n+import tempfile\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class GenerateSelfSignedSslCertificateArgsModel(BaseModel):\n+    env_file: str\n+    domain_var: str\n+    ssl_dir: str\n+    cert_filename: str\n+    key_filename: str\n+    ca_cert_filename: str\n+    ca_key_filename: str\n+\n+\n+class GenerateSelfSignedSslCertificateAction(Action):\n+    def name(self) -> str:\n+        return \"generate-self-signed-ssl-certificate\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            GenerateSelfSignedSslCertificateArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file = Path(args[\"env_file\"])\n+        domain_var = args[\"domain_var\"]\n+        ssl_dir = Path(args[\"ssl_dir\"])\n+        cert_filename = args[\"cert_filename\"]\n+        key_filename = args[\"key_filename\"]\n+        ca_cert_path = ssl_dir / args[\"ca_cert_filename\"]\n+        ca_key_path = ssl_dir / args[\"ca_key_filename\"]\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        domain = str(env_values.get(domain_var) or \"\").strip()\n+        if not domain:\n+            logger.error(f\"✗ Missing required value in {env_file}: {domain_var}\")\n+            return False\n+\n+        cert_path = ssl_dir / cert_filename\n+        key_path = ssl_dir / key_filename\n+        if cert_path.exists() and key_path.exists():\n+            logger.info(f\"✓ '{cert_path}'/'{key_path}' already exist, skipping generation\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        if not ca_cert_path.exists() or not ca_key_path.exists():\n+            logger.error(\n+                f\"✗ CA cert/key not found at '{ca_cert_path}'/'{ca_key_path}' — run generate-self-signed-ca first\"\n+            )\n+            return False\n+\n+        ssl_dir.mkdir(parents=True, exist_ok=True)\n+\n+        with tempfile.TemporaryDirectory() as tmp_dir:\n+            csr_path = Path(tmp_dir) / \"leaf.csr\"\n+            extfile_path = Path(tmp_dir) / \"leaf.ext\"\n+            extfile_path.write_text(f\"subjectAltName=DNS:{domain}\\n\")\n+\n+            csr_command = [\n+                \"openssl\", \"req\", \"-new\", \"-newkey\", \"rsa:4096\", \"-nodes\",\n+                \"-keyout\", str(key_path), \"-out\", str(csr_path),\n+                \"-subj\", f\"/CN={domain}\",\n+            ]\n+            try:\n+                csr_result = subprocess.run(csr_command, capture_output=True, text=True)\n+            except Exception as e:\n+                logger.error(f\"✗ Error generating certificate signing request: {str(e)}\")\n+                return False\n+            if csr_result.returncode != 0:\n+                logger.error(f\"✗ Failed to generate certificate signing request: {csr_result.stderr}\")\n+                return False\n+\n+            sign_command = [\n+                \"openssl\", \"x509\", \"-req\", \"-in\", str(csr_path),\n+                \"-CA\", str(ca_cert_path), \"-CAkey\", str(ca_key_path), \"-CAcreateserial\",\n+                \"-out\", str(cert_path), \"-days\", \"3650\", \"-extfile\", str(extfile_path),\n+            ]\n+            try:\n+                sign_result = subprocess.run(sign_command, capture_output=True, text=True)\n+            except Exception as e:\n+                logger.error(f\"✗ Error signing certificate: {str(e)}\")\n+                return False\n+            if sign_result.returncode != 0:\n+                logger.error(f\"✗ Failed to sign certificate: {sign_result.stderr}\")\n+                return False\n+\n+        os.chmod(key_path, 0o600)\n+        logger.info(f\"✓ Generated CA-signed certificate for '{domain}' at '{cert_path}'/'{key_path}'\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"bc05d7dc950eb9802a832b200e9f722f7c3396bf","filename":"on-premise/datasaur-cli/src/action/start/print_docker_swarm_join_token_action.py","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fprint_docker_swarm_join_token_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fprint_docker_swarm_join_token_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fprint_docker_swarm_join_token_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,63 @@\n+import re\n+import subprocess\n+from typing import Any, Dict, Optional, Tuple\n+\n+from src.action.action import Action\n+from src.common import logger\n+\n+# Matches the line `docker swarm join --token <TOKEN> <ADDR>` that\n+# `docker swarm join-token worker` prints, regardless of surrounding\n+# whitespace/hint text.\n+JOIN_COMMAND_PATTERN = re.compile(r\"docker swarm join --token (\\S+) (\\S+)\")\n+\n+\n+class PrintDockerSwarmJoinTokenAction(Action):\n+    def name(self) -> str:\n+        return \"print-docker-swarm-join-token\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        try:\n+            result = subprocess.run([\"docker\", \"swarm\", \"join-token\", \"worker\"], capture_output=True, text=True)\n+        except Exception as e:\n+            logger.error(f\"✗ Error printing Swarm join token: {str(e)}\")\n+            return False\n+\n+        if result.returncode != 0:\n+            logger.error(f\"✗ Failed to print Swarm join token: {result.stderr}\")\n+            return False\n+\n+        parsed = self._parse_join_command(result.stdout)\n+        if parsed is None:\n+            # Docker's output didn't match the expected shape (unexpected Docker\n+            # version/locale) — fall back to printing it verbatim rather than\n+            # failing an otherwise-successful command.\n+            logger.info(result.stdout)\n+            return True\n+\n+        join_token, manager_addr = parsed\n+        logger.info(\"✓ Worker join token generated\", fg=\"green\")\n+        logger.info()\n+        logger.info(f\"  Manager address: {manager_addr}\")\n+        logger.info(f\"  Worker join token: {join_token}\")\n+        logger.info()\n+        logger.info(\n+            \"On each worker, run `./datasaur-cli init-llm-server` / `init-ingestion-server` and paste \"\n+            \"these two values separately when prompted — not the full `docker swarm join ...` line above.\"\n+        )\n+        return True\n+\n+    def _parse_join_command(self, stdout: str) -> Optional[Tuple[str, str]]:\n+        match = JOIN_COMMAND_PATTERN.search(stdout)\n+        if match is None:\n+            return None\n+        join_token, manager_addr = match.group(1), match.group(2)\n+        return join_token, manager_addr"},{"sha":"b1681328dbd13700338ba408240dd1d56430f241","filename":"on-premise/datasaur-cli/src/action/start/prune_stale_docker_secrets_action.py","status":"added","additions":109,"deletions":0,"changes":109,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fprune_stale_docker_secrets_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fprune_stale_docker_secrets_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fprune_stale_docker_secrets_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,109 @@\n+import json\n+import subprocess\n+import time\n+from typing import Any, Dict, List, Optional, Set\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+MAX_ATTEMPTS = 5\n+RETRY_DELAY_SECONDS = 5\n+\n+\n+class PruneStaleDockerSecretsArgsModel(BaseModel):\n+    secret_name_prefix: str\n+    service_name: str\n+\n+\n+class PruneStaleDockerSecretsAction(Action):\n+    def name(self) -> str:\n+        return \"prune-stale-docker-secrets\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            PruneStaleDockerSecretsArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        secret_name_prefix = args[\"secret_name_prefix\"]\n+        service_name = args[\"service_name\"]\n+\n+        all_secrets = self._list_secrets(secret_name_prefix)\n+        referenced = self._referenced_secret_names(service_name)\n+        if referenced is None:\n+            logger.warn(f\"! Could not inspect '{service_name}' service, skipping prune\")\n+            logger.info()\n+            return True\n+\n+        stale = [name for name in all_secrets if name not in referenced]\n+        if not stale:\n+            logger.info(f\"✓ No stale '{secret_name_prefix}_*' secrets to remove\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        for name in stale:\n+            if not self._remove_secret(name):\n+                return False\n+            logger.info(f\"✓ Removed stale secret '{name}'\", fg=\"green\")\n+\n+        logger.info()\n+        return True\n+\n+    def _remove_secret(self, name: str) -> bool:\n+        # A secret just swapped out by a preceding docker-stack-deploy can still be\n+        # reported as in-use for a moment while the rolling update converges —\n+        # retry rather than failing right after an otherwise-successful rotation.\n+        result = None\n+        for attempt in range(1, MAX_ATTEMPTS + 1):\n+            result = subprocess.run([\"docker\", \"secret\", \"rm\", name], capture_output=True, text=True)\n+            if result.returncode == 0:\n+                return True\n+\n+            if attempt < MAX_ATTEMPTS:\n+                logger.warn(\n+                    f\"! Failed to remove secret '{name}' (attempt {attempt}/{MAX_ATTEMPTS}), \"\n+                    f\"retrying in {RETRY_DELAY_SECONDS}s: {result.stderr.strip()}\"\n+                )\n+                time.sleep(RETRY_DELAY_SECONDS)\n+\n+        logger.error(f\"✗ Failed to remove secret '{name}' after {MAX_ATTEMPTS} attempts: {result.stderr}\")\n+        return False\n+\n+    def _list_secrets(self, secret_name_prefix: str) -> List[str]:\n+        result = subprocess.run(\n+            [\"docker\", \"secret\", \"ls\", \"--filter\", f\"name={secret_name_prefix}_\", \"--format\", \"{{.Name}}\"],\n+            capture_output=True,\n+            text=True,\n+        )\n+        return [name for name in result.stdout.strip().splitlines() if name]\n+\n+    def _referenced_secret_names(self, service_name: str) -> Optional[Set[str]]:\n+        result = subprocess.run(\n+            [\n+                \"docker\", \"service\", \"inspect\", service_name,\n+                \"--format\", \"{{json .Spec.TaskTemplate.ContainerSpec.Secrets}}\",\n+            ],\n+            capture_output=True,\n+            text=True,\n+        )\n+        if result.returncode != 0:\n+            return None\n+        try:\n+            entries = json.loads(result.stdout.strip() or \"[]\")\n+        except ValueError:\n+            # An empty set here would make every listed secret look \"stale\" —\n+            # including the one the running service actually mounts. Match the\n+            # non-zero-exit branch above and skip the prune instead.\n+            return None\n+        return {entry[\"SecretName\"] for entry in entries if \"SecretName\" in entry}"},{"sha":"f1e35e5f12e4e0b788f1507400a8cdcd7ec7b0c2","filename":"on-premise/datasaur-cli/src/action/start/push_docker_images_action.py","status":"added","additions":180,"deletions":0,"changes":180,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fpush_docker_images_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fpush_docker_images_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fpush_docker_images_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,180 @@\n+import json\n+import re\n+import subprocess\n+import tarfile\n+from pathlib import Path\n+from typing import Any, Dict, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.docker_compose_env_service import DockerComposeEnvService\n+from src.common.env_file import EnvFile\n+from src.common.manifest_file_reader import ManifestFileReader\n+\n+\n+class PushDockerImagesArgsModel(BaseModel):\n+    env_file: str\n+    domain_var: str\n+\n+\n+class PushDockerImagesServiceModel(BaseModel):\n+    name: str\n+    image: str\n+    file_path: str\n+\n+\n+class PushDockerImagesAction(Action):\n+    def __init__(self):\n+        self.compose_env_service = DockerComposeEnvService()\n+\n+    def name(self) -> str:\n+        return \"push-docker-images\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            PushDockerImagesArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file = Path(args[\"env_file\"])\n+        domain_var = args[\"domain_var\"]\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        domain = str(env_values.get(domain_var) or \"\").strip()\n+        if not domain:\n+            logger.error(f\"✗ Missing required value in {env_file}: {domain_var}\")\n+            return False\n+\n+        manifest, ok = ManifestFileReader().read(Path(\".\"))\n+        if not ok or manifest is None:\n+            logger.error(\"✗ Failed to read services from manifest\")\n+            return False\n+\n+        services = manifest.get(\"services\")\n+        if not services:\n+            logger.error(\"✗ Failed to read services from manifest\")\n+            return False\n+\n+        resolved_env = self.compose_env_service.build_env()\n+\n+        for service_dict in services:\n+            try:\n+                service = PushDockerImagesServiceModel.model_validate(service_dict)\n+            except ValidationError as e:\n+                logger.error(str(e))\n+                logger.error(f\"✗ Service {service_dict.get('name', 'unknown')} is invalid\")\n+                return False\n+\n+            if not Path(service.file_path).exists():\n+                # build.sh's --include-*-docker-images false means this service's\n+                # archive was intentionally left out of this build — not an error.\n+                logger.warn(f\"! Skipping {service.name}: image archive not found at {service.file_path}\")\n+                continue\n+\n+            local_ref = self._resolve_image_name(service.image, resolved_env)\n+            registry_ref = f\"{domain}/{local_ref}\"\n+\n+            if self._already_pushed(service.file_path, registry_ref):\n+                logger.info(f\"✓ {registry_ref} already up to date, skipping\", fg=\"green\")\n+                continue\n+\n+            if not self._tag_and_push(local_ref, registry_ref):\n+                return False\n+\n+        logger.info(\"✓ All Docker images pushed successfully\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def _resolve_image_name(self, image: str, env: Dict[str, str]) -> str:\n+        def replace_var(match: \"re.Match[str]\") -> str:\n+            return env.get(match.group(1), \"\")\n+\n+        return re.sub(r\"\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}\", replace_var, image)\n+\n+    def _already_pushed(self, file_path: str, registry_ref: str) -> bool:\n+        # Compare config-blob digests on both sides — not `docker image inspect`'s\n+        # .Id, which under the containerd image store reports the OCI *index*\n+        # digest (varies with how many platforms were pulled locally) rather than\n+        # the single-platform manifest's config digest actually held by the\n+        # registry. The config digest is the one invariant that survives both\n+        # index-wrapping (local, multi-arch pull) and single-manifest (remote,\n+        # single-arch push) representations of the same image content.\n+        expected_digest = self._expected_config_digest_from_archive(file_path)\n+        if expected_digest is None:\n+            return False\n+        remote_digest = self._remote_config_digest(registry_ref)\n+        return remote_digest is not None and remote_digest == expected_digest\n+\n+    def _expected_config_digest_from_archive(self, file_path: str) -> Optional[str]:\n+        try:\n+            with tarfile.open(file_path, \"r:*\") as tar:\n+                manifest_member = tar.extractfile(\"manifest.json\")\n+                if manifest_member is None:\n+                    return None\n+                manifest = json.loads(manifest_member.read())\n+        except Exception:\n+            return None\n+\n+        if not manifest:\n+            return None\n+        config_path = manifest[0].get(\"Config\", \"\")\n+        if config_path.startswith(\"blobs/sha256/\"):\n+            # Newer (containerd-backed) `docker save` archives address the config\n+            # blob directly by digest instead of a \"<digest>.json\" filename.\n+            digest = config_path[len(\"blobs/sha256/\"):]\n+        elif config_path.endswith(\".json\"):\n+            digest = config_path[: -len(\".json\")]\n+        else:\n+            return None\n+        return f\"sha256:{digest}\" if digest else None\n+\n+    def _remote_config_digest(self, registry_ref: str) -> Optional[str]:\n+        result = subprocess.run(\n+            [\"docker\", \"manifest\", \"inspect\", registry_ref], capture_output=True, text=True\n+        )\n+        if result.returncode != 0:\n+            return None\n+        try:\n+            manifest = json.loads(result.stdout)\n+        except ValueError:\n+            return None\n+\n+        digest = manifest.get(\"config\", {}).get(\"digest\")\n+        if digest is None and manifest.get(\"manifests\"):\n+            # A multi-platform manifest list/index has no top-level config digest —\n+            # this isn't \"not yet pushed\", it's a registry/format mismatch this\n+            # single-platform compare doesn't handle. Say so instead of silently\n+            # treating it as unpushed.\n+            logger.warn(\n+                f\"! '{registry_ref}' is a multi-platform manifest list; cannot compare its digest, will re-push\"\n+            )\n+        return digest\n+\n+    def _tag_and_push(self, local_ref: str, registry_ref: str) -> bool:\n+        tag_result = subprocess.run([\"docker\", \"tag\", local_ref, registry_ref], capture_output=True, text=True)\n+        if tag_result.returncode != 0:\n+            logger.error(f\"✗ Failed to tag '{local_ref}' as '{registry_ref}': {tag_result.stderr}\")\n+            return False\n+\n+        push_result = subprocess.run([\"docker\", \"push\", registry_ref], capture_output=True, text=True)\n+        if push_result.returncode != 0:\n+            logger.error(f\"✗ Failed to push '{registry_ref}': {push_result.stderr}\")\n+            return False\n+\n+        logger.info(f\"✓ Pushed '{registry_ref}'\", fg=\"green\")\n+        return True"},{"sha":"af23cd6dc85cd6f59fc99e3179c09bcc7a5a9eff","filename":"on-premise/datasaur-cli/src/action/start/remove_docker_registry_cert_action.py","status":"added","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fremove_docker_registry_cert_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fremove_docker_registry_cert_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fremove_docker_registry_cert_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,65 @@\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+CERTS_D_PATH = \"/etc/docker/certs.d\"\n+\n+\n+class RemoveDockerRegistryCertArgsModel(BaseModel):\n+    env_file: str\n+    domain_var: str\n+\n+\n+class RemoveDockerRegistryCertAction(Action):\n+    def name(self) -> str:\n+        return \"remove-docker-registry-cert\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            RemoveDockerRegistryCertArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file = Path(args[\"env_file\"])\n+        domain_var = args[\"domain_var\"]\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        domain = str(env_values.get(domain_var) or \"\").strip()\n+        if not domain:\n+            logger.error(f\"✗ Missing required value in {env_file}: {domain_var}\")\n+            return False\n+\n+        target_path = Path(CERTS_D_PATH) / domain / \"ca.crt\"\n+\n+        if not target_path.exists():\n+            logger.info(f\"✓ '{target_path}' not installed, skipping\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        try:\n+            target_path.unlink()\n+        except Exception as e:\n+            logger.error(f\"✗ Failed to remove {target_path}: {str(e)}\")\n+            return False\n+\n+        logger.info(f\"✓ Removed trusted CA cert for '{domain}' at '{target_path}'\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"a0a19c4ee153d1dc71fb94ab1cc76a140593f5b0","filename":"on-premise/datasaur-cli/src/action/start/script_runner_action.py","status":"added","additions":117,"deletions":0,"changes":117,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fscript_runner_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fscript_runner_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fscript_runner_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,117 @@\n+import os\n+import shutil\n+import subprocess\n+from typing import Any, Dict, List\n+\n+from pydantic import BaseModel, Field, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+\n+class ScriptRunnerScriptModel(BaseModel):\n+\tname: str\n+\tfile_path: str\n+\targs: List[str] = Field(default_factory=list)\n+\n+class ScriptRunnerArgsModel(BaseModel):\n+\tscripts: List[ScriptRunnerScriptModel]\n+\n+class ScriptRunnerAction(Action):\n+\tdef name(self) -> str:\n+\t\treturn \"script-runner\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\ttry:\n+\t\t\tScriptRunnerArgsModel.model_validate(args)\n+\t\texcept ValidationError as e:\n+\t\t\tlogger.error(str(e))\n+\t\t\tlogger.error(\"✗ Action is invalid\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+\t\tscripts = args.get(\"scripts\", [])\n+\t\tif not scripts:\n+\t\t\tlogger.error(\"✗ No scripts specified for execution\")\n+\t\t\treturn False\n+\n+\t\tfor script in scripts:\n+\t\t\tscript_name = script.get(\"name\", \"unknown\")\n+\t\t\tfile_path = script.get(\"file_path\", \"\")\n+\t\t\tscript_args = script.get(\"args\", [])\n+\n+\t\t\tif not file_path:\n+\t\t\t\tlogger.error(f\"✗ Script '{script_name}' has no file_path specified\")\n+\t\t\t\treturn False\n+\n+\t\t\t# Resolve relative paths\n+\t\t\tif not os.path.isabs(file_path):\n+\t\t\t\tfile_path = os.path.abspath(file_path)\n+\n+\t\t\t# Check if script file exists\n+\t\t\tif not os.path.exists(file_path):\n+\t\t\t\tlogger.error(f\"✗ Script file '{file_path}' does not exist for script '{script_name}'\")\n+\t\t\t\treturn False\n+\n+\t\t\tif not os.path.isfile(file_path):\n+\t\t\t\tlogger.error(f\"✗ Script path '{file_path}' is not a file for script '{script_name}'\")\n+\t\t\t\treturn False\n+\n+\t\t\tlogger.info(f\"Executing script '{script_name}': {file_path}\")\n+\n+\t\t\t# Build command list: [script_path] + script_args\n+\t\t\tcommand = [file_path] + script_args\n+\n+\t\t\ttry:\n+\t\t\t\t# Execute script - use bash/sh if not executable, or execute directly\n+\t\t\t\t# Check if file is executable\n+\t\t\t\tis_executable = os.access(file_path, os.X_OK)\n+\n+\t\t\t\tif not is_executable:\n+\t\t\t\t\t# If not executable, try to run with bash or sh\n+\t\t\t\t\t# First try bash, then sh\n+\t\t\t\t\tshell_path = shutil.which('bash') or shutil.which('sh')\n+\t\t\t\t\tif shell_path:\n+\t\t\t\t\t\tcommand = [shell_path, file_path] + script_args\n+\t\t\t\t\telse:\n+\t\t\t\t\t\t# If no shell found, try to execute anyway - some systems may still allow it\n+\t\t\t\t\t\tlogger.warn(f\"  Warning: Script '{file_path}' is not executable and no shell found, attempting direct execution\")\n+\n+\t\t\t\tprocess = subprocess.Popen(\n+\t\t\t\t\tcommand,\n+\t\t\t\t\tstdout=subprocess.PIPE,\n+\t\t\t\t\tstderr=subprocess.STDOUT,\n+\t\t\t\t\ttext=True,\n+\t\t\t\t\tbufsize=1,\n+\t\t\t\t)\n+\n+\t\t\t\tcaptured_output: list[str] = []\n+\t\t\t\tif process.stdout is not None:\n+\t\t\t\t\tfor line in process.stdout:\n+\t\t\t\t\t\tline = line.rstrip(\"\\n\")\n+\t\t\t\t\t\tcaptured_output.append(line)\n+\t\t\t\t\t\tlogger.info(f\"  {line}\")\n+\n+\t\t\t\treturn_code = process.wait()\n+\n+\t\t\t\tif return_code != 0:\n+\t\t\t\t\tlogger.error(f\"✗ Script '{script_name}' failed with return code {return_code}\")\n+\t\t\t\t\tif not captured_output:\n+\t\t\t\t\t\tlogger.warn(\"  No output captured from script\")\n+\t\t\t\t\treturn False\n+\t\t\t\telse:\n+\t\t\t\t\tlogger.info(f\"✓ Successfully executed script '{script_name}'\", fg=\"green\")\n+\n+\t\t\texcept Exception as e:\n+\t\t\t\tlogger.error(f\"✗ Error executing script '{script_name}': {str(e)}\")\n+\t\t\t\treturn False\n+\n+\t\tlogger.info(\"✓ All scripts executed successfully\", fg=\"green\")\n+\t\tlogger.info()\n+\t\treturn True"},{"sha":"6f935bf75dc6c789d27da69a79aa86151738a637","filename":"on-premise/datasaur-cli/src/action/start/set_docker_registry_cert_action.py","status":"added","additions":75,"deletions":0,"changes":75,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fset_docker_registry_cert_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fset_docker_registry_cert_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fset_docker_registry_cert_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,75 @@\n+import filecmp\n+import shutil\n+from pathlib import Path\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+CERTS_D_PATH = \"/etc/docker/certs.d\"\n+\n+\n+class SetDockerRegistryCertArgsModel(BaseModel):\n+    env_file: str\n+    domain_var: str\n+    ca_cert_file: str\n+\n+\n+class SetDockerRegistryCertAction(Action):\n+    def name(self) -> str:\n+        return \"set-docker-registry-cert\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            SetDockerRegistryCertArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file = Path(args[\"env_file\"])\n+        domain_var = args[\"domain_var\"]\n+        ca_cert_file = Path(args[\"ca_cert_file\"])\n+\n+        env_values, ok = EnvFile().read(env_file)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file}\")\n+            return False\n+\n+        domain = str(env_values.get(domain_var) or \"\").strip()\n+        if not domain:\n+            logger.error(f\"✗ Missing required value in {env_file}: {domain_var}\")\n+            return False\n+\n+        if not ca_cert_file.exists():\n+            logger.error(f\"✗ CA cert file not found: {ca_cert_file}\")\n+            return False\n+\n+        target_dir = Path(CERTS_D_PATH) / domain\n+        target_path = target_dir / \"ca.crt\"\n+\n+        if target_path.exists() and filecmp.cmp(ca_cert_file, target_path, shallow=False):\n+            logger.info(f\"✓ '{target_path}' already trusts '{ca_cert_file}', skipping\", fg=\"green\")\n+            logger.info()\n+            return True\n+\n+        try:\n+            target_dir.mkdir(parents=True, exist_ok=True)\n+            shutil.copyfile(ca_cert_file, target_path)\n+        except Exception as e:\n+            logger.error(f\"✗ Failed to install CA cert at {target_path}: {str(e)}\")\n+            return False\n+\n+        logger.info(f\"✓ Installed '{ca_cert_file}' as trusted CA for '{domain}' at '{target_path}'\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"e767b8bc333ff927b8e00d015ded836fa63df8df","filename":"on-premise/datasaur-cli/src/action/start/validate_docker_images_action.py","status":"added","additions":96,"deletions":0,"changes":96,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_docker_images_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_docker_images_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_docker_images_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,96 @@\n+import re\n+import subprocess\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.docker_compose_env_service import DockerComposeEnvService\n+from src.common.manifest_file_reader import ManifestFileReader\n+\n+\n+class ValidateDockerImagesServiceModel(BaseModel):\n+    name: str\n+    image: str\n+\n+\n+class ValidateDockerImagesAction(Action):\n+    def __init__(self):\n+        self.compose_env_service = DockerComposeEnvService()\n+\n+    def name(self) -> str:\n+        return \"validate-docker-images\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        services = self._get_services_from_manifest()\n+        if not services:\n+            logger.error(\"✗ Failed to read services from manifest\")\n+            return False\n+\n+        env = self.compose_env_service.build_env()\n+        missing_images: List[str] = []\n+\n+        for service_dict in services:\n+            service = ValidateDockerImagesServiceModel.model_validate(service_dict)\n+            resolved_image = self._resolve_image_name(service.image, env)\n+            image_candidates = self._image_candidates(resolved_image, env)\n+            if not any(self._docker_image_exists(candidate) for candidate in image_candidates):\n+                missing_images.append(resolved_image)\n+\n+        if missing_images:\n+            logger.error(\"✗ Missing required Docker images:\")\n+            for image in missing_images:\n+                logger.info(f\"  - {image}\")\n+            logger.warn(\"Run `datasaur-cli install` first.\")\n+            return False\n+\n+        logger.info(\"✓ All required Docker images are available\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def _get_services_from_manifest(self) -> Optional[List[Dict[str, Any]]]:\n+        artifact_directory = Path(\".\")\n+        manifest, ok = ManifestFileReader().read(artifact_directory)\n+        if not ok or manifest is None:\n+            return None\n+        return manifest.get(\"services\")\n+\n+    def _resolve_image_name(self, image: str, env: Dict[str, str]) -> str:\n+        def replace_var(match: re.Match[str]) -> str:\n+            var_name = match.group(1)\n+            return env.get(var_name, \"\")\n+\n+        return re.sub(r\"\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}\", replace_var, image)\n+\n+    def _docker_image_exists(self, image: str) -> bool:\n+        result = subprocess.run(\n+            [\"docker\", \"image\", \"inspect\", image],\n+            capture_output=True,\n+            text=True,\n+        )\n+        return result.returncode == 0\n+\n+    def _image_candidates(self, image: str, env: Dict[str, str]) -> List[str]:\n+        candidates = [image]\n+\n+        # Some tarballs are saved using CI_REGISTRY-prefixed tags while the manifest\n+        # service image omits that prefix.\n+        if \"/\" in image:\n+            first_part = image.split(\"/\", 1)[0]\n+            has_registry = \".\" in first_part or \":\" in first_part or first_part == \"localhost\"\n+            if not has_registry:\n+                ci_registry = env.get(\"CI_REGISTRY\", \"\")\n+                if ci_registry:\n+                    candidates.append(f\"{ci_registry}/{image}\")\n+\n+        return candidates"},{"sha":"8d16480ea7dd9dd2a1ef460bd8ed992f0c0e5fec","filename":"on-premise/datasaur-cli/src/action/start/validate_files_and_directories_action.py","status":"added","additions":148,"deletions":0,"changes":148,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_files_and_directories_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_files_and_directories_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_files_and_directories_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,148 @@\n+import glob\n+import os\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.validators.file_owner_validator import FileOwnerValidator\n+from src.common.validators.file_permission_validator import FilePermissionValidator\n+\n+\n+class ValidateFilesAndDirectoriesFileModel(BaseModel):\n+\tpath: str\n+\tpermissions: str\n+\towner: Optional[str] = None\n+\n+class ValidateFilesAndDirectoriesArgsModel(BaseModel):\n+\tfiles: List[ValidateFilesAndDirectoriesFileModel]\n+\n+class ValidateFilesAndDirectoriesAction(Action):\n+\tdef name(self) -> str:\n+\t\treturn \"validate-files\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\tlogger.info(f\"Validating `{self.name()}` action...\")\n+\n+\t\ttry:\n+\t\t\tValidateFilesAndDirectoriesArgsModel.model_validate(args)\n+\t\texcept ValidationError as e:\n+\t\t\tlogger.error(str(e))\n+\t\t\tlogger.error(\"✗ Action is invalid\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\")\n+\n+\t\tfiles = args.get(\"files\", [])\n+\t\tif not files:\n+\t\t\tlogger.error(\"✗ No files specified for validation\")\n+\t\t\treturn False\n+\n+\t\t# Build precedence map: files covered by specific (non-wildcard) entries\n+\t\tprecedence_map = self._build_precedence_map(files)\n+\n+\t\tall_valid = True\n+\t\tfor index, file_entry in enumerate(files):\n+\t\t\tpath = file_entry.get(\"path\", \"\")\n+\t\t\texpected_permissions = file_entry.get(\"permissions\", \"\")\n+\t\t\texpected_owner = file_entry.get(\"owner\")\n+\n+\t\t\t# Get files that should be excluded from wildcard validation\n+\t\t\t# (files covered by specific entries that come after this index)\n+\t\t\texcluded_files = self._get_excluded_files_for_index(files, index, precedence_map)\n+\n+\t\t\tif not self._validate_path(path, expected_permissions, expected_owner, excluded_files):\n+\t\t\t\tall_valid = False\n+\n+\t\tif all_valid:\n+\t\t\tlogger.info(\"✓ All files and directories validated successfully\", fg=\"green\")\n+\t\telse:\n+\t\t\tlogger.error(\"✗ Validation failed for one or more paths\")\n+\n+\t\treturn all_valid\n+\n+\tdef _validate_path(self, path: str, expected_permissions: str, expected_owner: Optional[str], excluded_files: Optional[set] = None) -> bool:\n+\t\t\"\"\"Validate a single path (file, directory, or wildcard pattern).\"\"\"\n+\t\t# Check if path contains wildcards\n+\t\tif '*' in path or '?' in path:\n+\t\t\treturn self._validate_wildcard_path(path, expected_permissions, expected_owner, excluded_files or set())\n+\t\telse:\n+\t\t\treturn self._validate_single_path(path, expected_permissions, expected_owner)\n+\n+\tdef _validate_wildcard_path(self, pattern: str, expected_permissions: str, expected_owner: Optional[str], excluded_files: set) -> bool:\n+\t\t\"\"\"Validate paths matching a wildcard pattern, excluding files covered by later specific entries.\"\"\"\n+\t\tmatched_paths = glob.glob(pattern, recursive=True)\n+\n+\t\tif not matched_paths:\n+\t\t\tlogger.error(f\"✗ No paths found matching pattern: {pattern}\")\n+\t\t\treturn False\n+\n+\t\t# Filter out files that are covered by later specific entries (precedence rule)\n+\t\t# Normalize paths for comparison (same normalization used in precedence map)\n+\t\tfiltered_paths = [p for p in matched_paths if os.path.normpath(p) not in excluded_files]\n+\n+\t\tif not filtered_paths:\n+\t\t\t# All matched paths are excluded (covered by later specific entries)\n+\t\t\t# This is valid - the wildcard pattern doesn't need to validate these files\n+\t\t\treturn True\n+\n+\t\tall_valid = True\n+\t\tfor matched_path in filtered_paths:\n+\t\t\tif not self._validate_single_path(matched_path, expected_permissions, expected_owner):\n+\t\t\t\tall_valid = False\n+\n+\t\treturn all_valid\n+\n+\tdef _validate_single_path(self, path: str, expected_permissions: str, expected_owner: Optional[str]) -> bool:\n+\t\t\"\"\"Validate a single file or directory path.\"\"\"\n+\t\t# Check if path exists\n+\t\tif not os.path.exists(path):\n+\t\t\tlogger.error(f\"✗ Path does not exist: {path}\")\n+\t\t\treturn False\n+\n+\t\t# Validate permissions\n+\t\tif not FilePermissionValidator.validate(path, expected_permissions):\n+\t\t\treturn False\n+\n+\t\t# Validate owner (if specified)\n+\t\tif expected_owner and not FileOwnerValidator.validate(path, expected_owner):\n+\t\t\treturn False\n+\n+\t\treturn True\n+\n+\tdef _build_precedence_map(self, files: List[Dict[str, Any]]) -> Dict[str, int]:\n+\t\t\"\"\"Build a map of file paths to their entry indices for specific (non-wildcard) entries.\n+\n+\t\tReturns a dictionary mapping file paths to their entry indices.\n+\t\tOnly includes entries that are specific (not wildcard patterns).\n+\t\t\"\"\"\n+\t\tprecedence_map = {}\n+\t\tfor index, file_entry in enumerate(files):\n+\t\t\tpath = file_entry.get(\"path\", \"\")\n+\t\t\t# Only include specific (non-wildcard) entries\n+\t\t\tif '*' not in path and '?' not in path:\n+\t\t\t\t# Normalize path to handle relative paths consistently\n+\t\t\t\tnormalized_path = os.path.normpath(path)\n+\t\t\t\tprecedence_map[normalized_path] = index\n+\t\treturn precedence_map\n+\n+\tdef _get_excluded_files_for_index(self, files: List[Dict[str, Any]], current_index: int, precedence_map: Dict[str, int]) -> set:\n+\t\t\"\"\"Get the set of files that should be excluded from wildcard validation at the current index.\n+\n+\t\tReturns files that are covered by specific entries that come AFTER the current index.\n+\t\tThis implements the precedence rule: later specific entries override earlier wildcard matches.\n+\t\t\"\"\"\n+\t\texcluded_files = set()\n+\n+\t\t# Exclude files from specific entries (non-wildcard) that come after current index\n+\t\tfor path, entry_index in precedence_map.items():\n+\t\t\tif entry_index > current_index:\n+\t\t\t\texcluded_files.add(path)\n+\n+\t\treturn excluded_files"},{"sha":"d0309b660dcd988463a3441a3cbe1dad75c87c8e","filename":"on-premise/datasaur-cli/src/action/start/validate_required_env_vars_action.py","status":"added","additions":117,"deletions":0,"changes":117,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_required_env_vars_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_required_env_vars_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstart%2Fvalidate_required_env_vars_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,117 @@\n+from pathlib import Path\n+from typing import Any, Dict, List, Set\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.env_file import EnvFile\n+\n+\n+class ValidateRequiredEnvVarsArgsModel(BaseModel):\n+    env_file: str = \"datasaur.env\"\n+\n+\n+class ValidateRequiredEnvVarsAction(Action):\n+    def __init__(self):\n+        self.env_file = EnvFile()\n+\n+    def name(self) -> str:\n+        return \"validate-required-env-vars\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            ValidateRequiredEnvVarsArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        env_file_path = args.get(\"env_file\", \"datasaur.env\")\n+        env_values, ok = self.env_file.read(Path(env_file_path), create_if_not_exists=False)\n+        if not ok or env_values is None:\n+            logger.error(f\"✗ Failed to read {env_file_path}\")\n+            logger.warn(\"Run `datasaur-cli configure` first.\")\n+            return False\n+\n+        missing: Set[str] = set()\n+        for var in self._required_variables(env_values):\n+            if not str(env_values.get(var) or \"\").strip():\n+                missing.add(var)\n+\n+        has_database_host_mismatch = False\n+        if str(env_values.get(\"ENABLE_LOCAL_MARIADB\") or \"true\").strip().lower() == \"true\":\n+            database_host = str(env_values.get(\"DATABASE_HOST\") or \"\").strip()\n+            if database_host and database_host != \"mariadb\":\n+                has_database_host_mismatch = True\n+\n+        if missing or has_database_host_mismatch:\n+            logger.warn(\"! You have not run ./datasaur-cli configure, the application may not start properly\")\n+\n+            if missing:\n+                logger.warn(\"  Missing likely-required values:\")\n+                for var in sorted(missing):\n+                    logger.info(f\"    - {var}\")\n+\n+            if has_database_host_mismatch:\n+                logger.warn(\"  ENABLE_LOCAL_MARIADB=true but DATABASE_HOST is not 'mariadb'\")\n+\n+            logger.info()\n+            return False\n+\n+        logger.info(\"✓ Required configuration values are present\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def _required_variables(self, env_values: Dict[str, Any]) -> List[str]:\n+        required = [\n+            \"HOST\",\n+            \"PUBLIC_URL\",\n+            \"DATABASE_HOST\",\n+            \"DATABASE_PORT\",\n+            \"DATABASE_USERNAME\",\n+            \"DATABASE_PASSWORD\",\n+            \"DATABASE_NAME\",\n+            \"RABBITMQ_USERNAME\",\n+            \"RABBITMQ_PASSWORD\",\n+            \"ENCRYPTION_VERSION\",\n+            \"OBJECT_STORAGE_PRIMARY_CLIENT_NAME\",\n+            \"OBJECT_STORAGE_PRIVATE_CLIENT_NAME\",\n+            \"OBJECT_STORAGE_PRIMARY_BUCKET_NAME\",\n+            \"OBJECT_STORAGE_PRIVATE_BUCKET_NAME\",\n+            \"OBJECT_STORAGE_PRIVATE_SIGNATURE_SALT\",\n+        ]\n+\n+        if str(env_values.get(\"ENCRYPTION_VERSION\") or \"0\").strip() != \"0\":\n+            required.append(\"ENCRYPTION_KEY\")\n+\n+        storage_provider = str(env_values.get(\"OBJECT_STORAGE_PRIMARY_CLIENT_NAME\") or \"\").strip()\n+        if storage_provider == \"AWS_S3\":\n+            required.extend(\n+                [\n+                    \"OBJECT_STORAGE_PRIMARY_ACCESS_KEY\",\n+                    \"OBJECT_STORAGE_PRIMARY_SECRET_KEY\",\n+                    \"OBJECT_STORAGE_PRIVATE_ACCESS_KEY\",\n+                    \"OBJECT_STORAGE_PRIVATE_SECRET_KEY\",\n+                    \"OBJECT_STORAGE_PRIMARY_REGION\",\n+                    \"OBJECT_STORAGE_PRIVATE_REGION\",\n+                ]\n+            )\n+        elif storage_provider == \"AZURE_BLOB_STORAGE\":\n+            required.extend(\n+                [\n+                    \"OBJECT_STORAGE_PRIMARY_ACCESS_KEY\",\n+                    \"OBJECT_STORAGE_PRIMARY_SECRET_KEY\",\n+                    \"OBJECT_STORAGE_PRIVATE_ACCESS_KEY\",\n+                    \"OBJECT_STORAGE_PRIVATE_SECRET_KEY\",\n+                ]\n+            )\n+\n+        return required"},{"sha":"59ff200ea1fc136bb3f2f3fa2697f4f759b1a6e3","filename":"on-premise/datasaur-cli/src/action/stop/docker_compose_down_action.py","status":"added","additions":83,"deletions":0,"changes":83,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstop%2Fdocker_compose_down_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstop%2Fdocker_compose_down_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstop%2Fdocker_compose_down_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,83 @@\n+import subprocess\n+from typing import Any, Dict, List, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.docker_compose_env_service import DockerComposeEnvService\n+from src.common.file_validator import FileValidator\n+\n+\n+class DockerComposeDownArgsModel(BaseModel):\n+\tenv_files: List[str]\n+\tdocker_compose_file: Optional[str] = None\n+\n+class DockerComposeDownAction(Action):\n+\tdef __init__(self):\n+\t\tself.compose_env_service = DockerComposeEnvService()\n+\n+\tdef name(self) -> str:\n+\t\treturn \"docker-compose-down\"\n+\n+\tdef options(self) -> Dict[str, Any]:\n+\t\treturn {}\n+\n+\tdef validate(self, args: Dict[str, Any]) -> bool:\n+\t\ttry:\n+\t\t\tvalidated_args = DockerComposeDownArgsModel.model_validate(args)\n+\t\texcept ValidationError as e:\n+\t\t\tlogger.error(str(e))\n+\t\t\tlogger.error(\"✗ Action is invalid\")\n+\t\t\treturn False\n+\n+\t\tdocker_compose_file = validated_args.docker_compose_file\n+\t\tif docker_compose_file and not FileValidator().validate(docker_compose_file, check_permissions=False):\n+\t\t\treturn False\n+\n+\t\tfor env_file in validated_args.env_files:\n+\t\t\tif not FileValidator().validate(env_file, check_permissions=False):\n+\t\t\t\treturn False\n+\n+\t\treturn True\n+\n+\tdef run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+\t\tcontext[\"action_name\"] = self.name()\n+\t\tlogger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+\t\tdocker_compose_file = args.get(\"docker_compose_file\")\n+\t\tenv_files = args.get(\"env_files\", [])\n+\n+\t\tcommand = [\"docker\", \"compose\"]\n+\n+\t\tfor env_file in env_files:\n+\t\t\tcommand.extend([\"--env-file\", env_file])\n+\n+\t\tif docker_compose_file:\n+\t\t\tcommand.extend([\"-f\", docker_compose_file])\n+\n+\t\tcommand.append(\"down\")\n+\t\tcompose_env = self.compose_env_service.build_env()\n+\n+\t\ttry:\n+\t\t\tlogger.info(f\"Executing: {' '.join(command)}\")\n+\t\t\tresult = subprocess.run(\n+\t\t\t\tcommand,\n+\t\t\t\tenv=compose_env,\n+\t\t\t\tcapture_output=True,\n+\t\t\t\ttext=True\n+\t\t\t)\n+\n+\t\t\tif result.returncode != 0:\n+\t\t\t\tif result.stdout:\n+\t\t\t\t\tlogger.info(f\"  Output: {result.stdout.rstrip()}\")\n+\t\t\t\tlogger.error(f\"✗ Failed to stop docker compose: {result.stderr}\")\n+\t\t\t\treturn False\n+\t\t\telse:\n+\t\t\t\tif result.stdout:\n+\t\t\t\t\tlogger.info(f\"  Output: {result.stdout.rstrip()}\")\n+\t\t\t\tlogger.info(\"✓ Docker compose stopped successfully\", fg=\"green\")\n+\t\t\t\tlogger.info()\n+\t\t\t\treturn True\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Error stopping docker compose: {str(e)}\")\n+\t\t\treturn False"},{"sha":"4b015b3e85ee5f10e5b9533a8e4b19902572807a","filename":"on-premise/datasaur-cli/src/action/stop/docker_stack_rm_action.py","status":"added","additions":79,"deletions":0,"changes":79,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstop%2Fdocker_stack_rm_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstop%2Fdocker_stack_rm_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Faction%2Fstop%2Fdocker_stack_rm_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,79 @@\n+import re\n+import subprocess\n+from typing import Any, Dict\n+\n+from pydantic import BaseModel, ValidationError\n+from src.action.action import Action\n+from src.common import logger\n+\n+_RESOURCE_FAILURE_MARKER_RE = re.compile(\n+    r\"failed to remove (?:network|secret|config|service|volume) \\S+:\",\n+    re.IGNORECASE,\n+)\n+_RESOURCE_FAILURE_NOT_FOUND_RE = re.compile(\n+    r\"failed to remove (?:network|secret|config|service|volume) \\S+:.*?not found\",\n+    re.IGNORECASE | re.DOTALL,\n+)\n+\n+\n+class DockerStackRmArgsModel(BaseModel):\n+    stack: str\n+\n+\n+class DockerStackRmAction(Action):\n+    def name(self) -> str:\n+        return \"docker-stack-rm\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        try:\n+            DockerStackRmArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        logger.info(f\"Running `{self.name()}` action...\", fg=\"green\")\n+\n+        stack = args[\"stack\"]\n+        command = [\"docker\", \"stack\", \"rm\", stack]\n+\n+        try:\n+            logger.info(f\"Executing: {' '.join(command)}\")\n+            result = subprocess.run(command, capture_output=True, text=True)\n+\n+            if result.returncode != 0:\n+                if \"nothing found in stack\" in result.stderr.lower():\n+                    logger.info(f\"✓ Stack '{stack}' was already absent, nothing to remove\", fg=\"green\")\n+                    logger.info()\n+                    return True\n+                if self._is_partial_removal_race(result.stderr):\n+                    logger.info(f\"✓ Stack '{stack}' removed (some resources were already gone)\", fg=\"green\")\n+                    logger.info()\n+                    return True\n+                logger.error(f\"✗ Failed to remove stack '{stack}': {result.stderr}\")\n+                return False\n+\n+            if result.stdout:\n+                logger.info(f\"  Output: {result.stdout.rstrip()}\")\n+            logger.info(f\"✓ Stack '{stack}' removed successfully\", fg=\"green\")\n+            logger.info()\n+            return True\n+        except Exception as e:\n+            logger.error(f\"✗ Error removing stack '{stack}': {str(e)}\")\n+            return False\n+\n+    @staticmethod\n+    def _is_partial_removal_race(stderr: str) -> bool:\n+        if \"failed to remove some resources from stack\" not in stderr.lower():\n+            return False\n+        markers = _RESOURCE_FAILURE_MARKER_RE.findall(stderr)\n+        if not markers:\n+            return False\n+        not_found = _RESOURCE_FAILURE_NOT_FOUND_RE.findall(stderr)\n+        return len(not_found) == len(markers)"},{"sha":"5398fcdb5a3cddb31e8146fd7e0862a6c800cb97","filename":"on-premise/datasaur-cli/src/command/cli.py","status":"added","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fcli.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fcli.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fcli.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,16 @@\n+import click\n+\n+from src import __version__\n+from src.common import logger\n+\n+\n+@click.group()\n+@click.option(\n+    \"-v\",\n+    \"--verbose\",\n+    count=True,\n+    help=\"Increase verbosity (-v for debug detail, -vv for trace detail).\",\n+)\n+@click.version_option(version=__version__, prog_name=\"datasaur-cli\")\n+def cli(verbose: int):\n+    logger.set_verbosity(verbose)"},{"sha":"c1488f0e169d4580a612919faff7d0f1e34c3f2d","filename":"on-premise/datasaur-cli/src/command/click_commands_service.py","status":"added","additions":280,"deletions":0,"changes":280,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fclick_commands_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fclick_commands_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fclick_commands_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,280 @@\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+from pydantic import BaseModel, ValidationError\n+from src.action.actions_service import ActionsService\n+from src.command.cli import cli\n+from src.common import logger\n+from src.common.helper import unique_list\n+from src.common.yaml_file import YamlFile\n+from src.option.click_options import click_options\n+from src.prompt.user_prompts_service import UserPromptsService\n+\n+\n+class CommandActionModel(BaseModel):\n+    action: str\n+    options: Optional[Dict[str, Any]] = None\n+    prompts: Optional[Dict[str, Any]] = None\n+    args: Optional[Dict[str, Any]] = None\n+\n+\n+class ClickCommandsService:\n+    def __init__(self):\n+        self.user_prompts_service = UserPromptsService()\n+\n+    def register(self, commands: Dict[str, Any], command_modules=None) -> bool:\n+        self.actions_service = ActionsService(command_modules=command_modules or [])\n+\n+        if not self._validate_commands(commands):\n+            return False\n+\n+        click_commands = self._parse_commands(commands)\n+\n+        if not self._register_commands(click_commands):\n+            return False\n+\n+        return True\n+\n+    def _validate_commands(self, commands: Dict[str, Any]) -> bool:\n+        logger.info(\"Validating commands...\")\n+\n+        for command_name, command_definition in commands.items():\n+            if isinstance(command_definition, dict) and \"actions\" in command_definition:\n+                if not self._validate_action_list(command_name, command_definition[\"actions\"]):\n+                    return False\n+            elif isinstance(command_definition, list):\n+                if not self._validate_action_list(command_name, command_definition):\n+                    return False\n+            elif isinstance(command_definition, dict):\n+                # No \"actions\" key — a nested group; each key is its own subcommand.\n+                for subcommand_name, subcommand_actions in command_definition.items():\n+                    full_name = f\"{command_name} {subcommand_name}\"\n+                    if not self._validate_action_list(full_name, subcommand_actions):\n+                        return False\n+            else:\n+                logger.error(\n+                    f\"✗ {command_name} command is invalid: Command must contain list of actions\"\n+                )\n+                return False\n+\n+        logger.info(\"✓ Commands are valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def _validate_action_list(self, command_name: str, command_actions: Any) -> bool:\n+        if not isinstance(command_actions, List):\n+            logger.error(\n+                f\"✗ {command_name} command is invalid: Command must contain list of actions\"\n+            )\n+            return False\n+\n+        for index, command_action in enumerate(command_actions):\n+            try:\n+                CommandActionModel.model_validate(command_action)\n+            except ValidationError as e:\n+                logger.error(str(e))\n+                logger.error(\n+                    f\"✗ {command_name} command's action in index {index} is invalid\"\n+                )\n+                return False\n+\n+            action = command_action.get(\"action\")\n+            if not self.actions_service.validate_action_existence(action):\n+                logger.error(\n+                    f\"✗ {command_name} command's action in index {index} is invalid: Unknown action: {action}\"\n+                )\n+                return False\n+\n+        return True\n+\n+    def _parse_commands(self, commands: Dict[str, Any]) -> Dict[str, Any]:\n+        \"\"\"\n+        Parse the commands from manifest.yaml into click format.\n+\n+        Returns: click_commands\n+        \"\"\"\n+        logger.info(\"Parsing commands...\")\n+        click_commands = []\n+        action_options = self.actions_service.get_action_options()\n+\n+        for command_name, command_definition in commands.items():\n+            if isinstance(command_definition, list):\n+                command_actions = command_definition\n+                config = False\n+            elif \"actions\" in command_definition:\n+                command_actions = command_definition[\"actions\"]\n+                config = command_definition.get(\"config\", False)\n+            else:\n+                # No \"actions\" key — a nested group; each key becomes a subcommand.\n+                # Nested subcommands don't support options:/prompts:/--config —\n+                # nothing under manager:/worker: needs them.\n+                click_commands.append(\n+                    {\n+                        \"name\": command_name,\n+                        \"group\": True,\n+                        \"subcommands\": [\n+                            {\"name\": sub_name, \"actions\": self._parse_command_actions(sub_actions)}\n+                            for sub_name, sub_actions in command_definition.items()\n+                        ],\n+                    }\n+                )\n+                continue\n+\n+            parsed_options = self._parse_command_options(command_actions, action_options)\n+            parsed_prompts = self._parse_command_prompts(command_actions)\n+            parsed_actions = self._parse_command_actions(command_actions)\n+            click_commands.append(\n+                {\n+                    \"name\": command_name,\n+                    \"group\": False,\n+                    \"options\": unique_list(parsed_options, \"name\"),\n+                    \"prompts\": unique_list(parsed_prompts, \"name\"),\n+                    \"actions\": parsed_actions,\n+                    \"config\": config,\n+                }\n+            )\n+\n+        logger.info(\"✓ Commands are parsed\", fg=\"green\")\n+        logger.info()\n+        return click_commands\n+\n+    # Reference: options_from_db.py\n+    def _parse_command_options(\n+        self,\n+        command_actions: List[Dict[str, Any]],\n+        action_options: Dict[str, Any],\n+    ) -> List[Dict[str, Any]]:\n+        parsed_options = []\n+\n+        for command_action in command_actions:\n+            action_name = command_action.get(\"action\", \"\")\n+            options1 = action_options.get(action_name, {}) if action_name else {}\n+            options2 = command_action.get(\"options\", {})\n+            options = {**options1, **options2}\n+\n+            for option_name, option_attributes in options.items():\n+                click_option = {\"name\": option_name, \"long\": option_name}\n+                keys = [\"short\", \"long\", \"type\", \"required\"]\n+                for key in keys:\n+                    if key in option_attributes:\n+                        click_option[key] = option_attributes[key]\n+                parsed_options.append(click_option)\n+\n+        return parsed_options\n+\n+    # Reference: https://click.palletsprojects.com/en/stable/api/#click.prompt\n+    def _parse_command_prompts(\n+        self, command_actions: List[Dict[str, Any]]\n+    ) -> List[Dict[str, Any]]:\n+        parsed_prompts = []\n+\n+        for command_action in command_actions:\n+            prompts = command_action.get(\"prompts\")\n+            if not prompts:\n+                continue\n+\n+            for prompt_name, prompt_attributes in prompts.items():\n+                click_prompt = {\n+                    \"name\": prompt_name,\n+                    \"text\": prompt_attributes[\"text\"],\n+                    \"default\": None,\n+                    \"hide_input\": False,\n+                }\n+                if \"default\" in prompt_attributes:\n+                    click_prompt[\"default\"] = prompt_attributes[\"default\"]\n+                if \"hide_input\" in prompt_attributes:\n+                    click_prompt[\"hide_input\"] = prompt_attributes[\"hide_input\"]\n+                if \"default_from_state\" in prompt_attributes:\n+                    click_prompt[\"default_from_state\"] = prompt_attributes[\"default_from_state\"]\n+                parsed_prompts.append(click_prompt)\n+\n+        return parsed_prompts\n+\n+    def _parse_command_actions(\n+        self, command_actions: List[Dict[str, Any]]\n+    ) -> List[Dict[str, Any]]:\n+        parsed_actions = []\n+\n+        for command_action in command_actions:\n+            parsed_action = {\n+                \"action\": command_action[\"action\"],\n+                \"args\": command_action.get(\"args\") or {},\n+            }\n+            parsed_actions.append(parsed_action)\n+\n+        return parsed_actions\n+\n+    def _register_commands(self, click_commands: List[Dict[str, Any]]) -> bool:\n+        \"\"\"\n+        Register the commands into click.\n+\n+        Returns: ok\n+        \"\"\"\n+        logger.info(\"Registering commands...\")\n+\n+        for click_command in click_commands:\n+            if click_command.get(\"group\"):\n+                self._register_group_command(click_command)\n+            else:\n+                self._register_flat_command(click_command)\n+\n+        logger.info(\"✓ Commands are registered\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def _register_flat_command(self, cmd: Dict[str, Any]) -> None:\n+        # Capture cmd by value using default parameter to avoid closure issue\n+        def make_command(cmd=cmd):\n+            def command(**option_values):\n+                config_values = {}\n+                config_file = option_values.pop(\"config_file\", None)\n+                if config_file:\n+                    config_values, ok = YamlFile().read(Path(config_file))\n+                    if not ok:\n+                        return\n+                prompt_values = self.user_prompts_service.get(\n+                    cmd[\"prompts\"], config_values=config_values\n+                )\n+                context = {\n+                    \"command_name\": cmd[\"name\"],\n+                    \"option_values\": option_values,\n+                    \"prompt_values\": prompt_values,\n+                }\n+                self.actions_service.run(context, cmd[\"actions\"])\n+\n+            # Apply decorators programmatically (inner-most first)\n+            command = click_options(cmd[\"options\"])(command)\n+            if cmd.get(\"config\"):\n+                command = click.option(\n+                    \"--config\",\n+                    \"config_file\",\n+                    type=click.Path(exists=True, readable=True),\n+                    default=None,\n+                    help=\"Path to a YAML config file. Keys matching prompt names are used directly, skipping interactive input.\",\n+                )(command)\n+            command = cli.command(name=cmd[\"name\"])(command)\n+            return command\n+\n+        make_command()\n+\n+    def _register_group_command(self, cmd: Dict[str, Any]) -> None:\n+        group = click.Group(name=cmd[\"name\"])\n+\n+        for subcommand in cmd[\"subcommands\"]:\n+            def make_subcommand(group_name=cmd[\"name\"], sub=subcommand):\n+                @click.command(name=sub[\"name\"])\n+                def subcommand_fn():\n+                    context = {\n+                        \"command_name\": f\"{group_name} {sub['name']}\",\n+                        \"option_values\": {},\n+                        \"prompt_values\": {},\n+                    }\n+                    if not self.actions_service.run(context, sub[\"actions\"]):\n+                        raise SystemExit(1)\n+\n+                return subcommand_fn\n+\n+            group.add_command(make_subcommand())\n+\n+        cli.add_command(group, name=cmd[\"name\"])"},{"sha":"0c0fff85a48ecce9fed5111e947c5013eeb419a1","filename":"on-premise/datasaur-cli/src/command/stack_commands_service.py","status":"added","additions":105,"deletions":0,"changes":105,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fstack_commands_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fstack_commands_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommand%2Fstack_commands_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,105 @@\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+from src.action.actions_service import ActionsService\n+from src.common import logger\n+from src.common.stack_discovery import discover_stacks, order_stacks\n+\n+VERBS = [\"up\", \"down\", \"restart\", \"dump-logs\", \"upgrade\"]\n+\n+\n+class StackCommandsService:\n+    def discover_stacks(self, root: Path) -> List[str]:\n+        return discover_stacks(root)\n+\n+    def order_stacks(self, discovered: List[str], stack_order: List[str]) -> List[str]:\n+        return order_stacks(discovered, stack_order)\n+\n+    def register(\n+        self,\n+        cli: click.Group,\n+        actions_service: ActionsService,\n+        root: Path,\n+        stack_order: Optional[List[str]] = None,\n+    ) -> None:\n+        discovered = self.discover_stacks(root)\n+        # Without an explicit order, keep discovery order for both directions —\n+        # unrelated to any real dependency, so reversing it wouldn't be any more\n+        # correct.\n+        up_order = self.order_stacks(discovered, stack_order) if stack_order else discovered\n+        down_order = list(reversed(up_order)) if stack_order else discovered\n+\n+        for verb in VERBS:\n+            cli.add_command(\n+                self._make_all_stacks_command(verb, up_order, down_order, actions_service), name=verb\n+            )\n+\n+        for stack in discovered:\n+            stack_group = click.Group(name=stack)\n+            for verb in VERBS:\n+                stack_group.add_command(self._make_single_stack_command(verb, stack, actions_service), name=verb)\n+            cli.add_command(stack_group, name=stack)\n+\n+    def _actions_for(self, verb: str, stack: str) -> List[Dict[str, Any]]:\n+        if verb == \"up\":\n+            return [{\"action\": \"docker-stack-deploy\", \"args\": {\"stack\": stack}}]\n+        if verb == \"down\":\n+            return [{\"action\": \"docker-stack-rm\", \"args\": {\"stack\": stack}}]\n+        if verb == \"restart\":\n+            return [\n+                {\"action\": \"docker-stack-rm\", \"args\": {\"stack\": stack}},\n+                {\"action\": \"docker-stack-deploy\", \"args\": {\"stack\": stack}},\n+            ]\n+        if verb == \"dump-logs\":\n+            return [{\"action\": \"docker-stack-dump-logs\", \"args\": {\"stack\": stack}}]\n+        if verb == \"upgrade\":\n+            return [\n+                {\"action\": \"load-docker-images\", \"args\": {}},\n+                {\"action\": \"docker-stack-deploy\", \"args\": {\"stack\": stack}},\n+            ]\n+        raise ValueError(f\"Unknown verb: {verb}\")\n+\n+    def _make_single_stack_command(self, verb: str, stack: str, actions_service: ActionsService) -> click.Command:\n+        actions = self._actions_for(verb, stack)\n+\n+        @click.command(name=verb)\n+        def command():\n+            context = {\"command_name\": f\"{stack} {verb}\", \"option_values\": {}, \"prompt_values\": {}}\n+            if not actions_service.run(context, actions):\n+                raise SystemExit(1)\n+\n+        return command\n+\n+    def _make_all_stacks_command(\n+        self, verb: str, up_order: List[str], down_order: List[str], actions_service: ActionsService\n+    ) -> click.Command:\n+        @click.command(name=verb)\n+        def command():\n+            if not up_order:\n+                logger.warn(\"No stacks found\")\n+                return\n+\n+            if verb == \"restart\":\n+                # Down every stack (in down order) before bringing any of them\n+                # back up, rather than restarting each stack one at a time —\n+                # otherwise a stack could come back up while another one it\n+                # depends on is still mid-teardown.\n+                self._run_ordered(down_order, \"down\", actions_service)\n+                self._run_ordered(up_order, \"up\", actions_service)\n+                return\n+\n+            ordered = down_order if verb == \"down\" else up_order\n+            self._run_ordered(ordered, verb, actions_service)\n+\n+        return command\n+\n+    def _run_ordered(self, ordered_stacks: List[str], verb: str, actions_service: ActionsService) -> None:\n+        for stack in ordered_stacks:\n+            if not self._run_stack_verb(verb, stack, actions_service):\n+                raise SystemExit(1)\n+\n+    def _run_stack_verb(self, verb: str, stack: str, actions_service: ActionsService) -> bool:\n+        actions = self._actions_for(verb, stack)\n+        context = {\"command_name\": f\"{verb} ({stack})\", \"option_values\": {}, \"prompt_values\": {}}\n+        return actions_service.run(context, actions)"},{"sha":"38f97be063ceda281b3d6d5ca5adf4733982b365","filename":"on-premise/datasaur-cli/src/common/datasaur_graphql_action.py","status":"added","additions":87,"deletions":0,"changes":87,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdatasaur_graphql_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdatasaur_graphql_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdatasaur_graphql_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,87 @@\n+from typing import Any, Dict, Optional\n+\n+from pydantic import BaseModel, ValidationError\n+\n+from src.action.action import Action\n+from src.common import logger\n+from src.common.helper import redact_if_sensitive\n+from src.common.request_client import get_access_token, graphql\n+from src.common.state_service import StateService\n+\n+_token_cache: Dict[str, str] = {}\n+\n+\n+class DatasaurGraphQLArgsModel(BaseModel):\n+    api_url: str\n+    client_id: str\n+    client_secret: str\n+    mutation: str\n+    variables: Optional[Dict[str, Any]] = None\n+    save_state: Optional[Dict[str, str]] = None\n+    display_name: Optional[str] = None\n+\n+\n+def _extract(data: Any, path: str) -> Any:\n+    \"\"\"Traverse nested dict by dotted path, e.g. 'createFoo.id'.\"\"\"\n+    for key in path.split(\".\"):\n+        if not isinstance(data, dict):\n+            return None\n+        data = data.get(key)\n+    return data\n+\n+\n+class DatasaurGraphQLAction(Action):\n+    def name(self) -> str:\n+        return \"datasaur-graphql\"\n+\n+    def options(self) -> Dict[str, Any]:\n+        return {}\n+\n+    def validate(self, args: Dict[str, Any]) -> bool:\n+        logger.info(f\"Validating `{self.name()}` action...\")\n+        try:\n+            DatasaurGraphQLArgsModel.model_validate(args)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Action is invalid\")\n+            return False\n+        logger.info(\"✓ Action is valid\", fg=\"green\")\n+        logger.info()\n+        return True\n+\n+    def run(self, context: Dict[str, Any], args: Dict[str, Any]) -> bool:\n+        context[\"action_name\"] = self.name()\n+        label = args.get(\"display_name\") or self.name()\n+        logger.info(f\"Running `{label}`...\")\n+\n+        cache_key = args[\"client_id\"]\n+        token = _token_cache.get(cache_key)\n+        if not token:\n+            token = get_access_token(args[\"api_url\"], args[\"client_id\"], args[\"client_secret\"])\n+            if token is None:\n+                return False\n+            _token_cache[cache_key] = token\n+\n+        data = graphql(\n+            url=f\"{args['api_url']}/graphql\",\n+            token=token,\n+            query=args[\"mutation\"],\n+            variables=args.get(\"variables\") or {},\n+        )\n+        if data is None:\n+            return False\n+\n+        state_service = StateService()\n+        for key, path in (args.get(\"save_state\") or {}).items():\n+            value = _extract(data, path)\n+            state_service.set(key, value)\n+            logger.info(f\"  Saved {key} = {redact_if_sensitive(key, value)}\")\n+\n+        # Auto-save connection info for use in subsequent individual step commands\n+        for key in (\"api_url\", \"team_id\"):\n+            if args.get(key) is not None:\n+                state_service.set(key, args[key])\n+\n+        logger.info(f\"✓ {label} complete\", fg=\"green\")\n+        logger.info()\n+        return True"},{"sha":"0f99f9e43a04a312e90d57239f01ca359b58ab14","filename":"on-premise/datasaur-cli/src/common/directory_validator.py","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdirectory_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdirectory_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdirectory_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,37 @@\n+import os\n+import stat\n+\n+from src.common import logger\n+\n+\n+class DirectoryValidator:\n+\tdef validate(self, directory: str) -> bool:\n+\t\tif not self.directory_exists_validator(directory):\n+\t\t\treturn False\n+\t\tif not self.directory_is_a_directory_validator(directory):\n+\t\t\treturn False\n+\t\tif not self.directory_has_correct_permissions_validator(directory):\n+\t\t\treturn False\n+\t\treturn True\n+\n+\n+\tdef directory_exists_validator(self, directory: str) -> bool:\n+\t\tif not os.path.exists(directory):\n+\t\t\tlogger.error(f\"✗ Directory {directory} does not exist\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef directory_is_a_directory_validator(self, directory: str) -> bool:\n+\t\tif not os.path.isdir(directory):\n+\t\t\tlogger.error(f\"✗ {directory} is not a directory\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef directory_has_correct_permissions_validator(self, directory: str) -> bool:\n+\t\tdir_stat = os.stat(directory)\n+\t\tdir_mode = stat.filemode(dir_stat.st_mode)\n+\t\tdir_permissions = dir_stat.st_mode & 0o7777\n+\t\tif dir_permissions != 0o755 and dir_permissions != 0o775:\n+\t\t\tlogger.error(f\"✗ Directory {directory} has incorrect permissions. Expected: 0755 (rwxr-xr-x), Got: {oct(dir_permissions)} ({dir_mode})\")\n+\t\t\treturn False\n+\t\treturn True"},{"sha":"b69cc3929aaa12ba0c3ef5e6c92b9c553d8abb7f","filename":"on-premise/datasaur-cli/src/common/docker_compose_env_service.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdocker_compose_env_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdocker_compose_env_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fdocker_compose_env_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,32 @@\n+import os\n+from pathlib import Path\n+from typing import Dict, Optional\n+\n+\n+DEFAULT_CI_REGISTRY = \"682361690817.dkr.ecr.us-east-1.amazonaws.com\"\n+\n+\n+class DockerComposeEnvService:\n+    def build_env(self) -> Dict[str, str]:\n+        env = os.environ.copy()\n+\n+        if not env.get(\"DOCKER_TAG\"):\n+            docker_tag = self._read_version_file()\n+            if docker_tag:\n+                env[\"DOCKER_TAG\"] = docker_tag\n+\n+        if not env.get(\"CI_REGISTRY\"):\n+            env[\"CI_REGISTRY\"] = DEFAULT_CI_REGISTRY\n+\n+        return env\n+\n+    def _read_version_file(self) -> Optional[str]:\n+        version_file = Path(\"version\")\n+        if not version_file.exists():\n+            return None\n+\n+        try:\n+            version = version_file.read_text().strip()\n+            return version or None\n+        except Exception:\n+            return None"},{"sha":"3ba1b3c3722d6743d8394c07ad804bb859742c37","filename":"on-premise/datasaur-cli/src/common/env_file.py","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fenv_file.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fenv_file.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fenv_file.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,55 @@\n+import os\n+from pathlib import Path\n+from typing import Any, Dict, Optional, Tuple\n+\n+from dotenv import dotenv_values\n+\n+from src.common import logger\n+\n+\n+class EnvFile:\n+    def read(\n+        self, file_path: Path, create_if_not_exists: bool = False\n+    ) -> Tuple[Optional[Dict[str, Any]], bool]:\n+        \"\"\"\n+        Read an env file.\n+\n+        Returns: (file_content, ok)\n+        \"\"\"\n+        if not file_path.exists():\n+            if not create_if_not_exists:\n+                logger.info(f\"{file_path.name} not found\")\n+                return None, False\n+\n+            file_path.parent.mkdir(parents=True, exist_ok=True)\n+            file_path.touch()\n+\n+        # interpolate=False: these files are read back verbatim by our own code\n+        # (e.g. docker_stack_deploy_action's $VAR resolution) — dotenv's built-in\n+        # \"${VAR}\" interpolation against os.environ would otherwise silently\n+        # rewrite a value before we ever see it.\n+        env = dotenv_values(file_path, interpolate=False)\n+        return dict(env), True\n+\n+    def write(self, file_path: Path, file_content: Dict[str, Any]) -> bool:\n+        \"\"\"\n+        Write an env file.\n+\n+        Returns: ok\n+        \"\"\"\n+        try:\n+            with open(file_path, \"w\") as f:\n+                for k, v in file_content.items():\n+                    # Double-quoted so a value containing '#', whitespace, or a\n+                    # leading/trailing character dotenv would otherwise trim can't\n+                    # corrupt the file or be misparsed on the next read.\n+                    escaped = str(v).replace(\"\\\\\", \"\\\\\\\\\").replace('\"', '\\\\\"')\n+                    f.write(f'{k}=\"{escaped}\"\\n')\n+            # .env files here routinely hold plaintext registry/service credentials —\n+            # keep them readable only by the owner, not world-readable at default umask.\n+            os.chmod(file_path, 0o600)\n+        except Exception as e:\n+            logger.info(f\"Error while writing {file_path.name}: {str(e)}\")\n+            return False\n+\n+        return True"},{"sha":"caa6afdb42f1336e45291b1428e2c78de271564d","filename":"on-premise/datasaur-cli/src/common/event_log.py","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fevent_log.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fevent_log.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fevent_log.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,43 @@\n+import json\n+from datetime import datetime, timezone\n+from pathlib import Path\n+from typing import Any, Dict, List, Optional\n+\n+from src.common.helper import redact_if_sensitive\n+\n+LOG_FILE_NAME = \"datasaur-cli.log\"\n+\n+\n+def record(\n+    command: str,\n+    action_number: int,\n+    action_name: str,\n+    args: Dict[str, Any],\n+    sensitive_keys: List[str],\n+    duration_ms: int,\n+    outcome: str,\n+    error: Optional[Dict[str, str]] = None,\n+) -> None:\n+    event = {\n+        \"ts\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n+        \"command\": command,\n+        \"action_number\": action_number,\n+        \"action\": action_name,\n+        \"args\": redact_args(args, sensitive_keys),\n+        \"duration_ms\": duration_ms,\n+        \"outcome\": outcome,\n+        \"error\": error,\n+    }\n+    log_path = Path.cwd() / LOG_FILE_NAME\n+    with open(log_path, \"a\") as f:\n+        f.write(json.dumps(event) + \"\\n\")\n+\n+\n+def redact_args(args: Dict[str, Any], sensitive_keys: List[str]) -> Dict[str, Any]:\n+    redacted = {}\n+    for key, value in args.items():\n+        if key in sensitive_keys or redact_if_sensitive(key, value) == \"***\":\n+            redacted[key] = \"***\"\n+        else:\n+            redacted[key] = value\n+    return redacted"},{"sha":"bfe89bd5f0cebddca4234550d4532ebcf5e21a6a","filename":"on-premise/datasaur-cli/src/common/file_validator.py","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Ffile_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Ffile_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Ffile_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,36 @@\n+import os\n+import stat\n+\n+from src.common import logger\n+\n+\n+class FileValidator:\n+\tdef validate(self, file_path: str, check_permissions: bool = True) -> bool:\n+\t\tif not self.file_exists_validator(file_path):\n+\t\t\treturn False\n+\t\tif not self.file_is_a_file_validator(file_path):\n+\t\t\treturn False\n+\t\tif check_permissions and not self.file_has_correct_permissions_validator(file_path):\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef file_exists_validator(self, file_path: str) -> bool:\n+\t\tif not os.path.exists(file_path):\n+\t\t\tlogger.error(f\"✗ File {file_path} does not exist\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef file_is_a_file_validator(self, file_path: str) -> bool:\n+\t\tif not os.path.isfile(file_path):\n+\t\t\tlogger.error(f\"✗ {file_path} is not a file\")\n+\t\t\treturn False\n+\t\treturn True\n+\n+\tdef file_has_correct_permissions_validator(self, file_path: str) -> bool:\n+\t\tfile_stat = os.stat(file_path)\n+\t\tfile_mode = stat.filemode(file_stat.st_mode)\n+\t\tfile_permissions = file_stat.st_mode & 0o7777\n+\t\tif file_permissions != 0o644 and file_permissions != 0o664:\n+\t\t\tlogger.error(f\"✗ File {file_path} has incorrect permissions. Expected: 0644 (rw-r--r--), Got: {oct(file_permissions)} ({file_mode})\")\n+\t\t\treturn False\n+\t\treturn True"},{"sha":"3f2585e9d3c3e6a6dd5a99abbb295a85d2779440","filename":"on-premise/datasaur-cli/src/common/helper.py","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fhelper.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fhelper.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fhelper.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,20 @@\n+from typing import Any, Dict, List\n+\n+_SENSITIVE_KEY_PARTS = (\"secret\", \"key\", \"password\", \"token\", \"credential\")\n+\n+\n+def redact_if_sensitive(key: str, value: Any) -> str:\n+    if any(part in key.lower() for part in _SENSITIVE_KEY_PARTS):\n+        return \"***\"\n+    return str(value)\n+\n+\n+def unique_list(item_list: List[Dict[str, Any]], key: str) -> List[Dict[str, Any]]:\n+    unique_item_list = []\n+    seen = set()\n+\n+    for item in item_list:\n+        if item[key] not in seen and not seen.add(item[key]):\n+            unique_item_list.append(item)\n+\n+    return unique_item_list"},{"sha":"82ac0125ac44aa264ef66781cb1e79de1241391f","filename":"on-premise/datasaur-cli/src/common/image_digest_validator.py","status":"added","additions":31,"deletions":0,"changes":31,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fimage_digest_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fimage_digest_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fimage_digest_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,31 @@\n+import os\n+from hashlib import sha256\n+\n+from src.common import logger\n+\n+\n+class ImageDigestValidator:\n+\tdef validate(self, file_path: str) -> bool:\n+\t\tsha256_file_path = f\"{file_path}.sha256\"\n+\n+\t\tif not os.path.exists(sha256_file_path):\n+\t\t\treturn True\n+\n+\t\ttry:\n+\t\t\twith open(sha256_file_path, 'r') as f:\n+\t\t\t\texpected_digest = f.read().strip()\n+\t\texcept Exception as e:\n+\t\t\tlogger.error(f\"✗ Failed to read SHA256 file {sha256_file_path}: {str(e)}\")\n+\t\t\treturn False\n+\n+\t\texpected_digest_hex = expected_digest.replace(\"sha256:\", \"\") if expected_digest.startswith(\"sha256:\") else expected_digest\n+\t\texpected_digest_hex = expected_digest_hex.strip()\n+\n+\t\twith open(file_path, 'rb') as f:\n+\t\t\tfile_hash = sha256(f.read()).hexdigest()\n+\n+\t\tif file_hash != expected_digest_hex:\n+\t\t\tlogger.error(f\"✗ Digest of {file_path} does not match the digest in {sha256_file_path}. Expected: {expected_digest_hex}, Got: {file_hash}\")\n+\t\t\treturn False\n+\n+\t\treturn True"},{"sha":"bdcf9d027f1537d4bb6e640f77ac50e7bf69215b","filename":"on-premise/datasaur-cli/src/common/logger.py","status":"added","additions":50,"deletions":0,"changes":50,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Flogger.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Flogger.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Flogger.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,50 @@\n+import click\n+\n+TRACE = 5\n+DEBUG = 10\n+INFO = 20\n+WARN = 30\n+ERROR = 40\n+\n+_threshold = INFO\n+\n+\n+def set_verbosity(count: int) -> None:\n+    global _threshold\n+    if count >= 2:\n+        _threshold = TRACE\n+    elif count == 1:\n+        _threshold = DEBUG\n+    else:\n+        _threshold = INFO\n+\n+\n+def _emit(level: int, message: str, prefix: str = \"\", **style_kwargs) -> None:\n+    if level < _threshold:\n+        return\n+    text = f\"{prefix}{message}\" if prefix else message\n+    if style_kwargs:\n+        text = click.style(text, **style_kwargs)\n+    click.echo(text)\n+\n+\n+def error(message: str = \"\", **style_kwargs) -> None:\n+    style_kwargs.setdefault(\"fg\", \"red\")\n+    _emit(ERROR, message, **style_kwargs)\n+\n+\n+def warn(message: str = \"\", **style_kwargs) -> None:\n+    style_kwargs.setdefault(\"fg\", \"yellow\")\n+    _emit(WARN, message, **style_kwargs)\n+\n+\n+def info(message: str = \"\", **style_kwargs) -> None:\n+    _emit(INFO, message, **style_kwargs)\n+\n+\n+def debug(message: str = \"\", **style_kwargs) -> None:\n+    _emit(DEBUG, message, prefix=\"[DEBUG] \", **style_kwargs)\n+\n+\n+def trace(message: str = \"\", **style_kwargs) -> None:\n+    _emit(TRACE, message, prefix=\"[TRACE] \", **style_kwargs)"},{"sha":"bb8eb10e9e94c710b4799febcd25e6182b9650de","filename":"on-premise/datasaur-cli/src/common/manifest_file_reader.py","status":"added","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fmanifest_file_reader.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fmanifest_file_reader.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fmanifest_file_reader.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,65 @@\n+from pathlib import Path\n+import re\n+from typing import Any, Dict, Optional, Tuple\n+\n+from pydantic import BaseModel, ValidationError\n+from src.common import logger\n+from src.common.docker_compose_env_service import DockerComposeEnvService\n+from src.common.yaml_file import YamlFile\n+\n+\n+class ManifestFileModel(BaseModel):\n+    version: str\n+\n+\n+class ManifestFileReader:\n+    def __init__(self):\n+        self.compose_env_service = DockerComposeEnvService()\n+\n+    def read(self, artifact_directory_path: Path) -> Tuple[Optional[Dict], bool]:\n+        \"\"\"\n+        Read a manifest.yaml file.\n+\n+        Returns: (manifest, ok)\n+        \"\"\"\n+        logger.info(\"Reading manifest file...\")\n+\n+        manifest_file_name = \"manifest.yaml\"\n+        file_content, ok = YamlFile().read(artifact_directory_path / manifest_file_name)\n+        if not ok or file_content is None:\n+            logger.error(\"✗ Failed to read manifest file\")\n+            return None, False\n+\n+        try:\n+            ManifestFileModel.model_validate(file_content)\n+        except ValidationError as e:\n+            logger.error(str(e))\n+            logger.error(\"✗ Manifest file is invalid\")\n+            return None, False\n+\n+        for module_path in file_content.get(\"command_modules\", []):\n+            module_manifest, ok = YamlFile().read(\n+                artifact_directory_path / module_path / \"manifest.yaml\"\n+            )\n+            if not ok:\n+                continue\n+            module_commands = module_manifest.get(\"commands\", {})\n+            file_content.setdefault(\"commands\", {}).update(module_commands)\n+\n+        version = file_content.get(\"version\")\n+        version = self._resolve_variables(version)\n+        logger.info(f\"✓ Manifest version: {version}\", fg=\"green\")\n+        logger.info()\n+        return file_content, True\n+\n+    def _resolve_variables(self, value: Any) -> str:\n+        if not isinstance(value, str):\n+            return str(value)\n+\n+        env = self.compose_env_service.build_env()\n+\n+        def replace_var(match: re.Match[str]) -> str:\n+            var_name = match.group(1)\n+            return env.get(var_name, \"\")\n+\n+        return re.sub(r\"\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}\", replace_var, value)"},{"sha":"c232b2176ed2ed8eb33a698166c5c0df7becf6fb","filename":"on-premise/datasaur-cli/src/common/operating_systems_validator.py","status":"renamed","additions":43,"deletions":25,"changes":68,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Foperating_systems_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Foperating_systems_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Foperating_systems_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -1,11 +1,15 @@\n-from datasaur_cli.commands.common.version_constraint_parser import VersionConstraintParser\n-from typing import Any, Callable, Dict, Optional, Tuple\n-import click\n import platform\n import re\n+from typing import Any, Callable, Dict, Optional, Tuple\n+\n+from src.common import logger\n+from src.common.version_constraint_parser import (\n+    VersionConstraintParser,\n+)\n \n-class OperatingSystemsHandler:\n-    def handle(self, docker_manifest: Dict[str, Any]) -> bool:\n+\n+class OperatingSystemsValidator:\n+    def validate(self, docker_manifest: Dict[str, Any]) -> bool:\n         \"\"\"\n         Check if the operating system meets the version requirement.\n \n@@ -15,11 +19,11 @@ def handle(self, docker_manifest: Dict[str, Any]) -> bool:\n         Returns:\n             bool: True if requirement is met, False otherwise\n         \"\"\"\n-        operating_systems = docker_manifest.get('operating_systems', {})\n+        operating_systems = docker_manifest.get(\"operating_systems\", {})\n         if not operating_systems:\n-          return True\n+            return True\n \n-        click.echo(\"Checking operating system requirement...\")\n+        logger.info(\"Checking operating system requirement...\")\n \n         os_checkers = [self._check_rhel, self._check_ubuntu]\n         error_messages = []\n@@ -31,12 +35,12 @@ def handle(self, docker_manifest: Dict[str, Any]) -> bool:\n \n         if all(error_message is not None for error_message in error_messages):\n             for error_message in error_messages:\n-                click.echo(click.style(f\"  ✗ {error_message}\", fg='red'))\n-            click.echo(click.style(\"✗ Operating system requirement not met\", fg='red'))\n+                logger.error(f\"  ✗ {error_message}\")\n+            logger.error(\"✗ Operating system requirement not met\")\n             return False\n \n-        click.echo(click.style(\"✓ Operating system requirement is met\", fg='green'))\n-        click.echo()\n+        logger.info(\"✓ Operating system requirement is met\", fg=\"green\")\n+        logger.info()\n         return True\n \n     def _check_rhel(self, operating_systems: Dict) -> Tuple[bool, Optional[str]]:\n@@ -46,9 +50,10 @@ def _check_rhel(self, operating_systems: Dict) -> Tuple[bool, Optional[str]]:\n         Returns: (is_checked, error_message)\n         \"\"\"\n         return self._check_linux(\n-            'RHEL',\n-            operating_systems.get('rhel'),\n-            lambda os_release: 'Red Hat Enterprise Linux' in os_release or 'RHEL' in os_release\n+            \"RHEL\",\n+            operating_systems.get(\"rhel\"),\n+            lambda os_release: \"Red Hat Enterprise Linux\" in os_release\n+            or \"RHEL\" in os_release,\n         )\n \n     def _check_ubuntu(self, operating_systems: Dict) -> Tuple[bool, Optional[str]]:\n@@ -58,13 +63,17 @@ def _check_ubuntu(self, operating_systems: Dict) -> Tuple[bool, Optional[str]]:\n         Returns: (is_checked, error_message)\n         \"\"\"\n         return self._check_linux(\n-            'Ubuntu',\n-            operating_systems.get('ubuntu'),\n-            lambda os_release: 'Ubuntu' in os_release\n+            \"Ubuntu\",\n+            operating_systems.get(\"ubuntu\"),\n+            lambda os_release: \"Ubuntu\" in os_release,\n         )\n \n-    def _check_linux(self, os_name: str, version_constraint: Optional[str],\n-                    validator: Callable[[str], bool]) -> Tuple[bool, Optional[str]]:\n+    def _check_linux(\n+        self,\n+        os_name: str,\n+        version_constraint: Optional[str],\n+        validator: Callable[[str], bool],\n+    ) -> Tuple[bool, Optional[str]]:\n         \"\"\"\n         Check if the Linux operating system meets the version requirement.\n \n@@ -79,16 +88,21 @@ def _check_linux(self, os_name: str, version_constraint: Optional[str],\n         if not version_constraint:\n             return False, None\n \n-        if platform.system() != 'Linux':\n-            return True, f\"{os_name} requires Linux, but {platform.system()} was detected\"\n+        if platform.system() != \"Linux\":\n+            return (\n+                True,\n+                f\"{os_name} requires Linux, but {platform.system()} was detected\",\n+            )\n \n         try:\n-            with open('/etc/os-release', 'r') as f:\n+            with open(\"/etc/os-release\", \"r\") as f:\n                 os_release = f.read()\n         except FileNotFoundError as e:\n             return True, f\"{os_name}: Could not determine OS version: {str(e)}\"\n \n-        version_match = re.search(r'VERSION_ID=[\\\"\\']?([^\\\"\\']+)[\\\"\\']?', os_release, re.MULTILINE)\n+        version_match = re.search(\n+            r\"VERSION_ID=[\\\"\\']?([^\\\"\\']+)[\\\"\\']?\", os_release, re.MULTILINE\n+        )\n         if not validator(os_release) or not version_match:\n             return True, f\"{os_name} {version_constraint} is required\"\n \n@@ -97,6 +111,10 @@ def _check_linux(self, os_name: str, version_constraint: Optional[str],\n             installed_version, version_constraint\n         )\n         if not is_satisfied:\n-            return True, f\"{os_name} version {installed_version} does not satisfy any of: \" + \" OR \".join(error_messages)\n+            return (\n+                True,\n+                f\"{os_name} version {installed_version} does not satisfy any of: \"\n+                + \" OR \".join(error_messages),\n+            )\n \n         return True, None","previous_filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/operating_systems_handler.py"},{"sha":"34ce94f0a1fb17bb76f115a72190f4cef3e9e7a1","filename":"on-premise/datasaur-cli/src/common/request_client.py","status":"added","additions":144,"deletions":0,"changes":144,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Frequest_client.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Frequest_client.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Frequest_client.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,144 @@\n+import os\n+from typing import Any, Dict, Optional\n+\n+import requests\n+import urllib3\n+\n+from src.common import logger\n+\n+_SSL_VERIFY = os.environ.get(\"DATASAUR_CLI_SSL_VERIFY\", \"true\").lower() != \"false\"\n+\n+if not _SSL_VERIFY:\n+    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n+\n+\n+def get_access_token(api_url: str, client_id: str, client_secret: str) -> Optional[str]:\n+    \"\"\"Obtain a Bearer token via OAuth 2.0 client-credentials flow.\"\"\"\n+    endpoint = f\"{api_url}/api/oauth/token\"\n+    try:\n+        response = requests.post(\n+            endpoint,\n+            data={\n+                \"client_id\": client_id,\n+                \"client_secret\": client_secret,\n+                \"grant_type\": \"client_credentials\",\n+            },\n+            headers={\"Content-Type\": \"application/x-www-form-urlencoded\"},\n+            timeout=30,\n+            verify=_SSL_VERIFY,\n+        )\n+    except requests.RequestException as e:\n+        logger.error(f\"✗ Failed to get access token: {e}\")\n+        return None\n+\n+    if response.status_code != 200:\n+        logger.error(\n+            f\"✗ Failed to get access token for client {client_id}: HTTP {response.status_code}: {response.text}\"\n+        )\n+        return None\n+\n+    token = response.json().get(\"access_token\")\n+    logger.info(f\"✓ Access token obtained for client {client_id}\", fg=\"green\")\n+    return token\n+\n+\n+def graphql(\n+    url: str,\n+    token: str,\n+    query: str,\n+    variables: Optional[Dict[str, Any]] = None,\n+) -> Optional[Dict[str, Any]]:\n+    \"\"\"\n+    Execute a GraphQL mutation/query. Returns the response `data` dict on\n+    success, or None on HTTP / GraphQL error (error already printed).\n+    None-valued variables are stripped before sending.\n+    \"\"\"\n+    filtered = {k: v for k, v in (variables or {}).items() if v is not None}\n+    try:\n+        response = requests.post(\n+            url,\n+            json={\"query\": query, \"variables\": filtered},\n+            headers={\"Authorization\": f\"Bearer {token}\"},\n+            timeout=30,\n+            verify=_SSL_VERIFY,\n+        )\n+    except requests.RequestException as e:\n+        logger.error(f\"✗ Request failed: {e}\")\n+        return None\n+\n+    if response.status_code != 200:\n+        logger.error(f\"✗ HTTP {response.status_code}: {response.text}\")\n+        return None\n+\n+    body = response.json()\n+    if \"errors\" in body:\n+        logger.error(f\"✗ GraphQL errors: {body['errors']}\")\n+        return None\n+\n+    return body.get(\"data\")\n+\n+\n+def http_get(base_url: str, token: str, path: str) -> Optional[Any]:\n+    url = f\"{base_url}{path}\"\n+    try:\n+        response = requests.get(\n+            url,\n+            headers={\"Authorization\": f\"Bearer {token}\"},\n+            timeout=30,\n+            verify=_SSL_VERIFY,\n+        )\n+    except requests.RequestException as e:\n+        logger.error(f\"✗ GET {path} failed: {e}\")\n+        return None\n+\n+    if response.status_code not in (200, 201):\n+        logger.error(\n+            f\"✗ GET {path} → HTTP {response.status_code}: {response.text}\"\n+        )\n+        return None\n+\n+    try:\n+        return response.json()\n+    except ValueError:\n+        return {}\n+\n+\n+def http_post(\n+    base_url: str,\n+    token: str,\n+    path: str,\n+    body: Dict[str, Any],\n+    form: bool = False,\n+) -> Optional[Any]:\n+    url = f\"{base_url}{path}\"\n+    if form:\n+        # Convert booleans to lowercase strings for form encoding\n+        payload = {\n+            k: str(v).lower() if isinstance(v, bool) else v\n+            for k, v in body.items()\n+        }\n+        kwargs = {\"data\": payload, \"headers\": {\"Authorization\": f\"Bearer {token}\"}}\n+    else:\n+        kwargs = {\n+            \"json\": body,\n+            \"headers\": {\n+                \"Authorization\": f\"Bearer {token}\",\n+                \"Content-Type\": \"application/json\",\n+            },\n+        }\n+    try:\n+        response = requests.post(url, timeout=30, verify=_SSL_VERIFY, **kwargs)\n+    except requests.RequestException as e:\n+        logger.error(f\"✗ POST {path} failed: {e}\")\n+        return None\n+\n+    if response.status_code not in (200, 201):\n+        logger.error(\n+            f\"✗ POST {path} → HTTP {response.status_code}: {response.text}\"\n+        )\n+        return None\n+\n+    try:\n+        return response.json()\n+    except ValueError:\n+        return {}"},{"sha":"b5a8fcf35fc1253f85c4da92e13ff86c6ad00a0f","filename":"on-premise/datasaur-cli/src/common/software_requirements_validator.py","status":"added","additions":193,"deletions":0,"changes":193,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fsoftware_requirements_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fsoftware_requirements_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fsoftware_requirements_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,193 @@\n+import re\n+import subprocess\n+from typing import Any, Dict, Optional\n+\n+from src.common import logger\n+from src.common.version_constraint_parser import (\n+    VersionConstraintParser,\n+)\n+\n+\n+class SoftwareRequirementsValidator:\n+    def validate(self, docker_manifest: Dict[str, Any]) -> bool:\n+        software_requirements = docker_manifest.get(\"software_requirements\")\n+        if not software_requirements:\n+            return True\n+\n+        checkers = [self._check_docker_version, self._check_docker_compose_version]\n+        for checker in checkers:\n+            if not checker(software_requirements):\n+                return False\n+\n+        return True\n+\n+    def _check_docker_version(self, software_requirements: Dict) -> bool:\n+        version_constraint = software_requirements.get(\"docker\")\n+        if version_constraint is None:\n+            return True\n+\n+        logger.info(\"Checking Docker version...\")\n+        try:\n+            result = subprocess.run(\n+                [\"docker\", \"version\", \"-f\", \"{{.Server.Version}}\"],\n+                capture_output=True,\n+                text=True,\n+                timeout=10,\n+            )\n+            if result.returncode != 0:\n+                logger.error(\n+                    \"✗ Docker is not installed or not running. Please make sure Docker is installed and running.\"\n+                )\n+                return False\n+\n+            current_version = result.stdout.strip()\n+            if not current_version:\n+                logger.error(\"✗ Could not determine Docker version\")\n+                return False\n+\n+            is_satisfied, error_messages = (\n+                VersionConstraintParser().is_version_satisfied(\n+                    current_version, version_constraint\n+                )\n+            )\n+            if not is_satisfied:\n+                logger.error(\n+                    f\"✗ Docker {current_version} does not satisfy any of: \"\n+                    + \" OR \".join(error_messages)\n+                )\n+                return False\n+        except FileNotFoundError:\n+            logger.error(\n+                \"✗ Docker command not found. Please make sure Docker is installed.\"\n+            )\n+            return False\n+        except subprocess.TimeoutExpired:\n+            logger.error(\"✗ Docker version check timed out\")\n+            return False\n+        except Exception as e:\n+            logger.error(f\"✗ Error while checking Docker version: {str(e)}\")\n+            return False\n+\n+        logger.info(\n+            f\"✓ Docker {current_version} is supported (constraint: {version_constraint})\",\n+            fg=\"green\",\n+        )\n+        logger.info()\n+        return True\n+\n+    def _check_docker_compose_version(self, software_requirements: Dict) -> bool:\n+        version_constraint = software_requirements.get(\"docker-compose\")\n+        if version_constraint is None:\n+            return True\n+\n+        logger.info(\"Checking Docker Compose version...\")\n+        try:\n+            result = subprocess.run(\n+                [\"docker\", \"compose\", \"version\", \"--short\"],\n+                capture_output=True,\n+                text=True,\n+                timeout=10,\n+            )\n+\n+            if result.returncode == 0:\n+                version_output = result.stdout.strip().lstrip(\"v\")\n+\n+                # Extract version number (handle formats like \"2.39.1\" or \"2-desktop\")\n+                version_match = re.search(r\"^(\\d+\\.\\d+\\.\\d+)\", version_output)\n+                if version_match:\n+                    return self._is_docker_compose_version_satisfied(\n+                        version_match.group(1), version_constraint\n+                    )\n+\n+                # Handle non-standard formats like \"2-desktop\" or \"2.39-desktop\" - extract major.minor\n+                version_match = re.search(r\"^(\\d+)\\.(\\d+)\", version_output)\n+                if version_match:\n+                    major = int(version_match.group(1))\n+                    minor = int(version_match.group(2))\n+                    return self._is_docker_compose_version_satisfied(\n+                        f\"{major}.{minor}\", version_constraint\n+                    )\n+\n+                # Handle formats like \"2-desktop\" (only major version)\n+                version_match = re.search(r\"^(\\d+)\", version_output)\n+                if version_match:\n+                    major = int(version_match.group(1))\n+                    return self._is_docker_compose_version_satisfied(\n+                        f\"{major}\", version_constraint\n+                    )\n+\n+            # Fallback: try docker compose version (full output)\n+            result = subprocess.run(\n+                [\"docker\", \"compose\", \"version\"],\n+                capture_output=True,\n+                text=True,\n+                timeout=10,\n+            )\n+            if result.returncode != 0:\n+                logger.error(\"✗ Docker Compose plugin is not installed\")\n+                return False\n+\n+            # Parse version from output like \"Docker Compose version v2.38.2\" or \"Docker Compose version v2-desktop\"\n+            version_output = result.stdout.strip()\n+\n+            # Try to find standard version format first\n+            version_match = re.search(r\"v?(\\d+\\.\\d+\\.\\d+)\", version_output)\n+            if version_match:\n+                return self._is_docker_compose_version_satisfied(\n+                    version_match.group(1), version_constraint\n+                )\n+\n+            # Try to extract major.minor from non-standard formats\n+            version_match = re.search(r\"v?(\\d+)\\.(\\d+)\", version_output)\n+            if version_match:\n+                major = int(version_match.group(1))\n+                minor = int(version_match.group(2))\n+                return self._is_docker_compose_version_satisfied(\n+                    f\"{major}.{minor}\", version_constraint\n+                )\n+\n+            logger.error(\n+                f\"✗ Could not parse Docker Compose version from: {version_output}\"\n+            )\n+            return False\n+        except FileNotFoundError:\n+            logger.error(\n+                \"✗ Docker Compose command not found. Please make sure Docker Compose plugin is installed.\"\n+            )\n+            return False\n+        except subprocess.TimeoutExpired:\n+            logger.error(\"✗ Docker Compose version check timed out\")\n+            return False\n+        except Exception as e:\n+            logger.error(f\"✗ Error while checking Docker Compose version: {str(e)}\")\n+            return False\n+\n+    def _is_docker_compose_version_satisfied(\n+        self, current_version: str, version_constraint: str\n+    ) -> Optional[bool]:\n+        \"\"\"\n+        Check if the operating system meets the version requirement.\n+\n+        Args:\n+            current_version: The current version of Docker Compose\n+            version_constraint: The version constraint string\n+\n+        Returns:\n+            is_satisfied: True if the version constraint is satisfied, False otherwise\n+        \"\"\"\n+        is_satisfied, error_messages = VersionConstraintParser().is_version_satisfied(\n+            current_version, version_constraint\n+        )\n+        if not is_satisfied:\n+            logger.error(\n+                f\"✗ Docker Compose {current_version} does not satisfy any of: \"\n+                + \" OR \".join(error_messages)\n+            )\n+            return False\n+\n+        logger.info(\n+            f\"✓ Docker Compose {current_version} is supported (constraint: {version_constraint})\",\n+            fg=\"green\",\n+        )\n+        logger.info()\n+        return True"},{"sha":"dd4bf381ad3cf5c731e63307523c041812279f47","filename":"on-premise/datasaur-cli/src/common/stack_discovery.py","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fstack_discovery.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fstack_discovery.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fstack_discovery.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,21 @@\n+from pathlib import Path\n+from typing import List\n+\n+\n+def discover_stacks(root: Path) -> List[str]:\n+    if not root.is_dir():\n+        return []\n+    return sorted(\n+        child.name\n+        for child in root.iterdir()\n+        if child.is_dir() and (child / \"stack.yaml\").is_file()\n+    )\n+\n+\n+def order_stacks(discovered: List[str], stack_order: List[str]) -> List[str]:\n+    # Explicit order wins for the stacks it names; anything discovered but\n+    # not (yet) listed — e.g. a newly added stack — falls in afterwards in\n+    # discovery (alphabetical) order rather than being dropped.\n+    ordered = [stack for stack in stack_order if stack in discovered]\n+    remaining = [stack for stack in discovered if stack not in stack_order]\n+    return ordered + remaining"},{"sha":"609908bde9d1c86a037dbf327cd784cda5d398ec","filename":"on-premise/datasaur-cli/src/common/state_service.py","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fstate_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fstate_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fstate_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,67 @@\n+from datetime import datetime\n+from pathlib import Path\n+from typing import Any, Dict, Optional, Tuple\n+\n+from src.common.yaml_file import YamlFile\n+\n+STATE_KEY_SEPARATOR = \"—\"\n+\n+\n+class StateService:\n+    def __init__(self):\n+        self.file_path = Path(\"state.yaml\")\n+        self.yaml_file = YamlFile()\n+\n+    def get(self, key: str) -> Tuple[Optional[Dict[str, Any]], bool]:\n+        file_content, ok = self._read_file()\n+        if not ok:\n+            return None, False\n+\n+        subkeys = key.split(STATE_KEY_SEPARATOR)\n+        for subkey in subkeys:\n+            file_content = file_content.get(subkey, {})\n+\n+        return file_content, True\n+\n+    def set(self, key: str, value: Dict[str, Any]) -> bool:\n+        file_content, ok = self._read_file()\n+        if not ok:\n+            return False\n+\n+        # Start with a copy of the current state or a new dict if None\n+        new_state = dict(file_content or {})\n+\n+        # Handle nested keys\n+        if STATE_KEY_SEPARATOR in key:\n+            keys = key.split(STATE_KEY_SEPARATOR)\n+            current = new_state\n+\n+            # Traverse the nested structure, creating nested dicts as needed\n+            for k in keys[:-1]:\n+                current = current.setdefault(k, {})\n+\n+            # Set the final value\n+            current[keys[-1]] = value\n+        else:\n+            # Handle top-level key\n+            new_state[key] = value\n+\n+        # Add/update last_updated_at and sort keys\n+        sorted_state = {\n+            \"last_updated_at\": datetime.now().isoformat(),\n+            **dict(sorted(new_state.items())),\n+        }\n+\n+        return self.yaml_file.write(self.file_path, sorted_state)\n+\n+    def get_all(self) -> Dict[str, Any]:\n+        content, ok = self._read_file()\n+        return content or {}\n+\n+    def _read_file(self) -> Tuple[Optional[Dict[str, Any]], bool]:\n+        file_content, ok = self.yaml_file.read(\n+            self.file_path, create_if_not_exists=True\n+        )\n+        if not ok:\n+            return None, False\n+        return file_content, True"},{"sha":"004a93e15fdca1651cda1b50aa4bfefe81d2f589","filename":"on-premise/datasaur-cli/src/common/validators/file_owner_validator.py","status":"added","additions":142,"deletions":0,"changes":142,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fvalidators%2Ffile_owner_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fvalidators%2Ffile_owner_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fvalidators%2Ffile_owner_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,142 @@\n+import grp\n+import os\n+import pwd\n+from typing import Optional, Tuple\n+\n+from src.common import logger\n+\n+\n+class FileOwnerValidator:\n+\t\"\"\"Validator for file and directory ownership.\"\"\"\n+\n+\t@staticmethod\n+\tdef validate(path: str, expected_owner: str) -> bool:\n+\t\t\"\"\"\n+\t\tValidate file/directory owner.\n+\n+\t\tArgs:\n+\t\t\tpath: Path to the file or directory\n+\t\t\texpected_owner: Expected owner in format \"UID:GID\", \"user:group\", or \"$(id -u):$(id -g)\"\n+\n+\t\tReturns:\n+\t\t\tTrue if owner matches, False otherwise\n+\t\t\"\"\"\n+\t\t# Handle shell command substitution patterns like \"$(id -u):$(id -g)\"\n+\t\tif \"$(\" in expected_owner and \")\" in expected_owner:\n+\t\t\treturn FileOwnerValidator._validate_shell_pattern(path, expected_owner)\n+\t\telse:\n+\t\t\treturn FileOwnerValidator._validate_explicit_owner(path, expected_owner)\n+\n+\t@staticmethod\n+\tdef _validate_shell_pattern(path: str, expected_owner: str) -> bool:\n+\t\t\"\"\"Validate owner using shell command pattern (e.g., $(id -u):$(id -g)).\"\"\"\n+\t\ttry:\n+\t\t\tcurrent_uid = os.getuid()\n+\t\t\tcurrent_gid = os.getgid()\n+\t\t\tpath_stat = os.stat(path)\n+\t\t\tactual_uid = path_stat.st_uid\n+\t\t\tactual_gid = path_stat.st_gid\n+\n+\t\t\t# Only support the common pattern \"$(id -u):$(id -g)\"\n+\t\t\tif \"$(id -u)\" in expected_owner and \"$(id -g)\" in expected_owner:\n+\t\t\t\tif actual_uid != current_uid or actual_gid != current_gid:\n+\t\t\t\t\tFileOwnerValidator._print_owner_mismatch(\n+\t\t\t\t\t\tpath, current_uid, current_gid, actual_uid, actual_gid\n+\t\t\t\t\t)\n+\t\t\t\t\treturn False\n+\t\t\telse:\n+\t\t\t\tlogger.error(\n+\t\t\t\t\tf\"✗ Unsupported shell pattern: {expected_owner}. Only '$(id -u):$(id -g)' is supported\"\n+\t\t\t\t)\n+\t\t\t\treturn False\n+\n+\t\t\treturn True\n+\t\texcept (OSError, KeyError) as e:\n+\t\t\tlogger.error(f\"✗ Failed to validate owner for {path}: {e}\")\n+\t\t\treturn False\n+\n+\t@staticmethod\n+\tdef _validate_explicit_owner(path: str, expected_owner: str) -> bool:\n+\t\t\"\"\"Validate owner using explicit format (UID:GID or user:group).\"\"\"\n+\t\tif ':' not in expected_owner:\n+\t\t\tlogger.error(\n+\t\t\t\tf\"✗ Invalid owner format: {expected_owner}. Expected format: UID:GID or user:group\"\n+\t\t\t)\n+\t\t\treturn False\n+\n+\t\ttry:\n+\t\t\towner_parts = expected_owner.split(':', 1)\n+\t\t\texpected_user_str = owner_parts[0]\n+\t\t\texpected_group_str = owner_parts[1]\n+\n+\t\t\t# Parse expected UID and GID\n+\t\t\texpected_uid, expected_gid = FileOwnerValidator._parse_owner(expected_user_str, expected_group_str)\n+\t\t\tif expected_uid is None or expected_gid is None:\n+\t\t\t\treturn False\n+\n+\t\t\t# Get actual owner\n+\t\t\tpath_stat = os.stat(path)\n+\t\t\tactual_uid = path_stat.st_uid\n+\t\t\tactual_gid = path_stat.st_gid\n+\n+\t\t\tif actual_uid != expected_uid or actual_gid != expected_gid:\n+\t\t\t\tFileOwnerValidator._print_owner_mismatch(\n+\t\t\t\t\tpath, expected_uid, expected_gid, actual_uid, actual_gid\n+\t\t\t\t)\n+\t\t\t\treturn False\n+\n+\t\t\treturn True\n+\t\texcept (OSError, KeyError) as e:\n+\t\t\tlogger.error(f\"✗ Failed to validate owner for {path}: {e}\")\n+\t\t\treturn False\n+\n+\t@staticmethod\n+\tdef _parse_owner(user_str: str, group_str: str) -> Tuple[Optional[int], Optional[int]]:\n+\t\t\"\"\"\n+\t\tParse user and group strings into UID and GID.\n+\n+\t\tReturns:\n+\t\t\tTuple of (UID, GID) or (None, None) if parsing fails\n+\t\t\"\"\"\n+\t\t# Try to parse as UID:GID first\n+\t\ttry:\n+\t\t\texpected_uid = int(user_str)\n+\t\t\texpected_gid = int(group_str)\n+\t\t\treturn expected_uid, expected_gid\n+\t\texcept ValueError:\n+\t\t\t# Parse as username:groupname\n+\t\t\ttry:\n+\t\t\t\texpected_uid = pwd.getpwnam(user_str).pw_uid\n+\t\t\t\texpected_gid = grp.getgrnam(group_str).gr_gid\n+\t\t\t\treturn expected_uid, expected_gid\n+\t\t\texcept KeyError as e:\n+\t\t\t\tlogger.error(f\"✗ Invalid owner format: {user_str}:{group_str}. {e}\")\n+\t\t\t\treturn None, None\n+\n+\t@staticmethod\n+\tdef _print_owner_mismatch(\n+\t\tpath: str,\n+\t\texpected_uid: int,\n+\t\texpected_gid: int,\n+\t\tactual_uid: int,\n+\t\tactual_gid: int\n+\t) -> None:\n+\t\t\"\"\"Print a formatted error message for owner mismatch.\"\"\"\n+\t\ttry:\n+\t\t\tactual_user = pwd.getpwuid(actual_uid).pw_name\n+\t\t\tactual_group = grp.getgrgid(actual_gid).gr_name\n+\t\t\texpected_user = pwd.getpwuid(expected_uid).pw_name\n+\t\t\texpected_group = grp.getgrgid(expected_gid).gr_name\n+\t\t\tlogger.error(\n+\t\t\t\tf\"✗ Path {path} has incorrect owner. \"\n+\t\t\t\tf\"Expected: {expected_uid}:{expected_gid} ({expected_user}:{expected_group}), \"\n+\t\t\t\tf\"Got: {actual_uid}:{actual_gid} ({actual_user}:{actual_group})\"\n+\t\t\t)\n+\t\texcept (KeyError, OSError):\n+\t\t\t# Fallback if we can't resolve names\n+\t\t\tlogger.error(\n+\t\t\t\tf\"✗ Path {path} has incorrect owner. \"\n+\t\t\t\tf\"Expected: {expected_uid}:{expected_gid}, \"\n+\t\t\t\tf\"Got: {actual_uid}:{actual_gid}\"\n+\t\t\t)\n+"},{"sha":"3fd6036456423a41e25925938ecc1d179381c857","filename":"on-premise/datasaur-cli/src/common/validators/file_permission_validator.py","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fvalidators%2Ffile_permission_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fvalidators%2Ffile_permission_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fvalidators%2Ffile_permission_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,55 @@\n+import os\n+import re\n+import stat\n+from typing import Optional\n+\n+from src.common import logger\n+\n+\n+class FilePermissionValidator:\n+\t\"\"\"Validator for file and directory permissions.\"\"\"\n+\n+\t@staticmethod\n+\tdef validate(path: str, expected_permissions: str) -> bool:\n+\t\t\"\"\"\n+\t\tValidate file/directory permissions.\n+\n+\t\tArgs:\n+\t\t\tpath: Path to the file or directory\n+\t\t\texpected_permissions: Expected permissions in octal format (e.g., \"0644\")\n+\n+\t\tReturns:\n+\t\t\tTrue if permissions match, False otherwise\n+\t\t\"\"\"\n+\t\t# Validate permissions format (should be like \"0644\" or \"0755\")\n+\t\tif not re.match(r'^0[0-7]{3}$', expected_permissions):\n+\t\t\tlogger.error(\n+\t\t\t\tf\"✗ Invalid permissions format: {expected_permissions}. Expected format: 0XXX (e.g., 0644)\"\n+\t\t\t)\n+\t\t\treturn False\n+\n+\t\ttry:\n+\t\t\texpected_perm_octal = int(expected_permissions, 8)\n+\t\texcept ValueError:\n+\t\t\tlogger.error(f\"✗ Invalid permissions value: {expected_permissions}\")\n+\t\t\treturn False\n+\n+\t\t# Get actual permissions\n+\t\ttry:\n+\t\t\tpath_stat = os.stat(path)\n+\t\t\tactual_permissions = path_stat.st_mode & 0o7777\n+\t\texcept OSError as e:\n+\t\t\tlogger.error(f\"✗ Failed to stat {path}: {e}\")\n+\t\t\treturn False\n+\n+\t\tif actual_permissions != expected_perm_octal:\n+\t\t\tactual_mode = stat.filemode(path_stat.st_mode)\n+\t\t\tlogger.error(\n+\t\t\t\tf\"✗ Path {path} has incorrect permissions. Expected: {expected_permissions} \"\n+\t\t\t\tf\"({stat.filemode(stat.S_IFREG | expected_perm_octal)}), \"\n+\t\t\t\tf\"Got: {oct(actual_permissions)} ({actual_mode})\"\n+\t\t\t)\n+\t\t\treturn False\n+\n+\t\treturn True\n+"},{"sha":"15f12f5457a76f89b085e0728489602777f584fd","filename":"on-premise/datasaur-cli/src/common/version_constraint_parser.py","status":"renamed","additions":26,"deletions":14,"changes":40,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fversion_constraint_parser.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fversion_constraint_parser.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fversion_constraint_parser.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -1,6 +1,10 @@\n-from typing import List, Tuple, Dict\n+from typing import Dict, List, Tuple\n+\n from packaging import version\n \n+VersionConstraint = Tuple[str, str]  # (operator, version)\n+ConstraintGroup = List[VersionConstraint]\n+\n class VersionConstraintParser:\n     \"\"\"Helper class for parsing and validating version constraints.\n \n@@ -13,8 +17,7 @@ class VersionConstraintParser:\n     - Multiple constraints: >=1.0.0 <2.0.0, ^1.0.0 || ^2.0.0\n     \"\"\"\n \n-    VersionConstraint = Tuple[str, str]  # (operator, version)\n-    ConstraintGroup = List[VersionConstraint]\n+\n \n     def is_version_satisfied(self, installed_version: str, constraint: str) -> Tuple[bool, List[str]]:\n         \"\"\"Check if the installed version satisfies the given constraint.\n@@ -40,6 +43,11 @@ def is_version_satisfied(self, installed_version: str, constraint: str) -> Tuple\n \n         constraint_groups = self._parse_constraint(constraint)\n \n+        if not constraint_groups:\n+            # e.g. a bare \"*\" wildcard parses to zero groups, meaning any\n+            # version is acceptable.\n+            return True, []\n+\n         for group in constraint_groups:\n             group_satisfied = all(\n                 self._evaluate_constraint(installed_version, op, required_version)\n@@ -50,8 +58,10 @@ def is_version_satisfied(self, installed_version: str, constraint: str) -> Tuple\n                 return True, []\n \n         # If we get here, no groups were satisfied\n-        error_msg = self._format_error_message(constraint_groups[0])\n-        return False, [f\"not ({error_msg})\"]\n+        error_messages = [\n+            f\"not ({self._format_error_message(group)})\" for group in constraint_groups\n+        ]\n+        return False, error_messages\n \n     @staticmethod\n     def _compare_versions(v1: str, v2: str) -> int:\n@@ -151,10 +161,16 @@ def _parse_constraint(self, constraint: str) -> List[ConstraintGroup]:\n         result: List[ConstraintGroup] = []\n \n         for group in or_groups:\n-            constraints: ConstraintGroup = []\n-            # Split on spaces to handle multiple constraints in a group\n-            for part in group.split():\n-                constraints.extend(self._parse_single_constraint(part))\n+            if ' - ' in group:\n+                # Hyphen ranges (e.g. \"1.2.3 - 2.3.4\") must be parsed as a\n+                # whole before space-splitting, since splitting on spaces\n+                # first would break the range apart into unrelated tokens.\n+                constraints = self._parse_hyphen_range(group)\n+            else:\n+                constraints = []\n+                # Split on spaces to handle multiple constraints in a group\n+                for part in group.split():\n+                    constraints.extend(self._parse_single_constraint(part))\n \n             if constraints:\n                 result.append(constraints)\n@@ -188,10 +204,6 @@ def _parse_single_constraint(self, part: str) -> List[VersionConstraint]:\n         if '*' in part or any(x in part.lower() for x in ('x', 'x.x', 'x.x.x')):\n             return self._parse_wildcard_constraint(part)\n \n-        # Handle hyphen ranges\n-        if ' - ' in part:\n-            return self._parse_hyphen_range(part)\n-\n         # Handle exact version (no operator)\n         if part[0] not in ('>', '<', '=', '!', '~', '^', 'v'):\n             return [('=', part)]\n@@ -322,7 +334,7 @@ def _parse_tilde_range(self, version: str) -> List[Tuple[str, str]]:\n                 ]\n             else:\n                 major, minor = version_parts[0], version_parts[1]\n-                patch = version_parts[2] if len(version_parts) > 2 else '0'\n+                _patch = version_parts[2] if len(version_parts) > 2 else '0'\n                 return [\n                     ('>=', version),\n                     ('<', f\"{major}.{int(minor) + 1}.0\" if minor.isdigit() else f\"{major}.x\")","previous_filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/version_constraint_parser.py"},{"sha":"bd935b5e2bce259182c3aaa674963c1d4165c6ec","filename":"on-premise/datasaur-cli/src/common/yaml_file.py","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fyaml_file.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fyaml_file.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fcommon%2Fyaml_file.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,53 @@\n+from pathlib import Path\n+from typing import Any, Dict, Optional, Tuple\n+\n+import yaml\n+\n+from src.common import logger\n+\n+\n+class YamlFile:\n+    def read(\n+        self, file_path: Path, create_if_not_exists: bool = False\n+    ) -> Tuple[Optional[Dict[str, Any]], bool]:\n+        \"\"\"\n+        Read a yaml file.\n+\n+        Returns: (file_content, ok)\n+        \"\"\"\n+        if not file_path.exists():\n+            if not create_if_not_exists:\n+                logger.info(f\"{file_path.name} not found\")\n+                return None, False\n+\n+            file_path.parent.mkdir(parents=True, exist_ok=True)\n+            file_path.touch()\n+\n+        try:\n+            with open(file_path, \"r\") as f:\n+                file_content = yaml.safe_load(f)\n+                if file_content is None:\n+                    file_content = {}\n+        except yaml.YAMLError as e:\n+            logger.info(f\"Error while reading {file_path.name}: YAML error: {str(e)}\")\n+            return None, False\n+        except Exception as e:\n+            logger.info(f\"Error while reading {file_path.name}: {str(e)}\")\n+            return None, False\n+\n+        return file_content, True\n+\n+    def write(self, file_path: Path, file_content: Dict[str, Any]) -> bool:\n+        \"\"\"\n+        Write a yaml file.\n+\n+        Returns: ok\n+        \"\"\"\n+        try:\n+            with open(file_path, \"w\") as file:\n+                yaml.dump(file_content, file, sort_keys=False)\n+        except Exception as e:\n+            logger.info(f\"Error while writing {file_path.name}: {str(e)}\")\n+            return False\n+\n+        return True"},{"sha":"5e30b1c538daff22be298538a26e36ad33c91aa3","filename":"on-premise/datasaur-cli/src/constants.py","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fconstants.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fconstants.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fconstants.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1 @@\n+DEFAULT_ARTIFACT_DIRECTORY = '.'"},{"sha":"98473e9c8179c740fd61efd8d9e38b152c40c53c","filename":"on-premise/datasaur-cli/src/main.py","status":"added","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fmain.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fmain.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fmain.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,38 @@\n+import sys\n+from pathlib import Path\n+\n+from src.command.cli import cli\n+from src.command.click_commands_service import ClickCommandsService\n+from src.command.stack_commands_service import StackCommandsService\n+from src.common import logger\n+from src.common.manifest_file_reader import ManifestFileReader\n+from src.common.operating_systems_validator import OperatingSystemsValidator\n+from src.common.software_requirements_validator import SoftwareRequirementsValidator\n+\n+if __name__ == \"__main__\":\n+    artifact_directory = Path(\".\")\n+\n+    manifest, ok = ManifestFileReader().read(artifact_directory)\n+    if not ok:\n+        sys.exit(1)\n+\n+    if not OperatingSystemsValidator().validate(manifest):\n+        sys.exit(1)\n+\n+    if not SoftwareRequirementsValidator().validate(manifest):\n+        sys.exit(1)\n+\n+    commands = manifest.get(\"commands\")\n+    if not commands:\n+        logger.error(\"✗ Failed to read `commands` from manifest\")\n+        sys.exit(1)\n+\n+    command_modules = manifest.get(\"command_modules\", [])\n+    click_commands_service = ClickCommandsService()\n+    if not click_commands_service.register(commands, command_modules=command_modules):\n+        sys.exit(1)\n+\n+    stack_order = manifest.get(\"stack_order\", [])\n+    StackCommandsService().register(cli, click_commands_service.actions_service, artifact_directory, stack_order)\n+\n+    cli()"},{"sha":"e98ceb26edf7fceb284e4ba545a471a702535360","filename":"on-premise/datasaur-cli/src/option/click_option_consume_all_options.py","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Foption%2Fclick_option_consume_all_options.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Foption%2Fclick_option_consume_all_options.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Foption%2Fclick_option_consume_all_options.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,43 @@\n+import click\n+\n+\n+class ClickOptionConsumeAllOptions(click.Option):\n+    def __init__(self, *args, **kwargs):\n+        self.save_other_options = kwargs.pop(\"save_other_options\", True)\n+        nargs = kwargs.pop(\"nargs\", -1)\n+        assert nargs == -1, \"nargs, if set, must be -1 not {}\".format(nargs)\n+        super(ClickOptionConsumeAllOptions, self).__init__(*args, **kwargs)\n+        self._previous_parser_process = None\n+        self._consume_all_parser = None\n+\n+    def add_to_parser(self, parser, ctx):\n+        def parser_process(value, state):\n+            # method to hook to the parser.process\n+            done = False\n+            value = [value]\n+            if self.save_other_options:\n+                # grab everything up to the next option\n+                while state.rargs and not done:\n+                    for prefix in self._consume_all_parser.prefixes:\n+                        if state.rargs[0].startswith(prefix):\n+                            done = True\n+                    if not done:\n+                        value.append(state.rargs.pop(0))\n+            else:\n+                # grab everything remaining\n+                value += state.rargs\n+                state.rargs[:] = []\n+            value = tuple(value)\n+\n+            # call the actual process\n+            self._previous_parser_process(value, state)\n+\n+        retval = super(ClickOptionConsumeAllOptions, self).add_to_parser(parser, ctx)\n+        for name in self.opts:\n+            our_parser = parser._long_opt.get(name) or parser._short_opt.get(name)\n+            if our_parser:\n+                self._consume_all_parser = our_parser\n+                self._previous_parser_process = our_parser.process\n+                our_parser.process = parser_process\n+                break\n+        return retval"},{"sha":"6e8929f58465891234ec9114b20a0cd7abe10a7d","filename":"on-premise/datasaur-cli/src/option/click_options.py","status":"added","additions":41,"deletions":0,"changes":41,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Foption%2Fclick_options.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Foption%2Fclick_options.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Foption%2Fclick_options.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,41 @@\n+from typing import Any, Dict, List\n+\n+import click\n+from src.option.click_option_consume_all_options import ClickOptionConsumeAllOptions\n+\n+\n+def click_options(options: List[Dict[str, Any]]):\n+    map_to_types = dict(\n+        array=str,\n+        integer=int,\n+        number=float,\n+        string=str,\n+    )\n+\n+    def decorator(f):\n+        for option in reversed(options):\n+            param_declarations = []\n+\n+            if \"short\" in option:\n+                param_declarations.append(\"-\" + option[\"short\"])\n+\n+            if \"long\" in option:\n+                param_declarations.append(\"--\" + option[\"long\"])\n+\n+            param_declarations.append(option[\"name\"])\n+\n+            default_type = option.get(\"type\", \"string\")\n+            attributes = {\"type\": map_to_types.get(default_type, default_type)}\n+\n+            if \"required\" in option:\n+                attributes[\"required\"] = option[\"required\"]\n+\n+            if default_type == \"array\":\n+                attributes[\"cls\"] = ClickOptionConsumeAllOptions\n+                attributes[\"nargs\"] = -1\n+\n+            click.option(*param_declarations, **attributes)(f)\n+\n+        return f\n+\n+    return decorator"},{"sha":"b2e58fb9c72607e6f9b2629e6082065731647248","filename":"on-premise/datasaur-cli/src/prompt/user_prompts_service.py","status":"added","additions":52,"deletions":0,"changes":52,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fprompt%2Fuser_prompts_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Fsrc%2Fprompt%2Fuser_prompts_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Fsrc%2Fprompt%2Fuser_prompts_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,52 @@\n+from typing import Any, Dict, List, Optional\n+\n+import click\n+\n+from src.common import logger\n+from src.common.state_service import StateService\n+\n+\n+class UserPromptsService:\n+    def __init__(self):\n+        self.state_service = StateService()\n+\n+    def get(\n+        self,\n+        prompts: List[Dict[str, Any]],\n+        config_values: Optional[Dict[str, Any]] = None,\n+    ) -> Dict[str, Any]:\n+        prompt_values = {}\n+        if len(prompts) == 0:\n+            return prompt_values\n+\n+        config = config_values or {}\n+\n+        for prompt in prompts:\n+            name = prompt[\"name\"]\n+            if name in config:\n+                value = str(config[name]) if config[name] is not None else \"\"\n+                display = \"****\" if prompt[\"hide_input\"] else value\n+                logger.info(f\"{prompt['text']}: {display}\")\n+                prompt_values[name] = value\n+            else:\n+                default = self._resolve_default(prompt)\n+                # Reference: https://click.palletsprojects.com/en/stable/api/#click.prompt\n+                prompt_values[name] = click.prompt(\n+                    prompt[\"text\"],\n+                    default=default,\n+                    hide_input=prompt[\"hide_input\"],\n+                )\n+\n+        logger.info()\n+        return prompt_values\n+\n+    def _resolve_default(self, prompt: Dict[str, Any]) -> Optional[Any]:\n+        state_key = prompt.get(\"default_from_state\")\n+        if state_key:\n+            value, ok = self.state_service.get(state_key)\n+            # StateService.get() returns ({}, True) for a key that was\n+            # never set (never (None, False)), so {} is the sentinel for\n+            # \"not actually found\" here, not None.\n+            if ok and value not in (None, {}):\n+                return value\n+        return prompt[\"default\"]"},{"sha":"750fabc52075b6eaaf8f3cc258cd0de48e818a99","filename":"on-premise/datasaur-cli/tests/action/configure/test_configure_action.py","status":"added","additions":434,"deletions":0,"changes":434,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fconfigure%2Ftest_configure_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fconfigure%2Ftest_configure_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fconfigure%2Ftest_configure_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,434 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.configure.configure_action import ConfigureAction\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+\n+\n+def _fake_builtin_action(validate_result=True, run_result=None):\n+    action = MagicMock()\n+    action.validate.return_value = validate_result\n+    if run_result is not None:\n+        action.run.return_value = run_result\n+    return action\n+\n+\n+VALID_ARGS = {\n+    \"sections\": [\n+        {\n+            \"name\": \"db\",\n+            \"title\": \"Database\",\n+            \"entry_action\": \"set-env\",\n+            \"actions\": [\n+                {\n+                    \"name\": \"set-env\",\n+                    \"action\": \"set-environment-variables\",\n+                    \"prompts\": {},\n+                    \"targets\": [],\n+                }\n+            ],\n+        }\n+    ]\n+}\n+\n+\n+# --- validate() ---\n+\n+\n+def test_validate_returns_false_for_invalid_model():\n+    assert ConfigureAction().validate({}) is False\n+\n+\n+def test_validate_returns_false_when_entry_action_not_in_action_map():\n+    args = {\n+        \"sections\": [\n+            {\n+                \"name\": \"db\",\n+                \"title\": \"Database\",\n+                \"entry_action\": \"missing-entry\",\n+                \"actions\": [{\"name\": \"set-env\", \"action\": \"set-environment-variables\"}],\n+            }\n+        ]\n+    }\n+\n+    assert ConfigureAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_for_unknown_builtin_action():\n+    args = {\n+        \"sections\": [\n+            {\n+                \"name\": \"db\",\n+                \"title\": \"Database\",\n+                \"entry_action\": \"set-env\",\n+                \"actions\": [{\"name\": \"set-env\", \"action\": \"no-such-builtin\"}],\n+            }\n+        ]\n+    }\n+\n+    assert ConfigureAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_for_unknown_switch_case_action():\n+    args = {\n+        \"sections\": [\n+            {\n+                \"name\": \"db\",\n+                \"title\": \"Database\",\n+                \"entry_action\": \"switch\",\n+                \"actions\": [\n+                    {\n+                        \"name\": \"switch\",\n+                        \"action\": \"switch-input\",\n+                        \"cases\": [{\"action\": \"missing-case-action\"}],\n+                    }\n+                ],\n+            }\n+        ]\n+    }\n+\n+    assert ConfigureAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_for_unknown_next_action():\n+    args = {\n+        \"sections\": [\n+            {\n+                \"name\": \"db\",\n+                \"title\": \"Database\",\n+                \"entry_action\": \"set-env\",\n+                \"actions\": [\n+                    {\n+                        \"name\": \"set-env\",\n+                        \"action\": \"set-environment-variables\",\n+                        \"next_action\": \"missing-next\",\n+                    }\n+                ],\n+            }\n+        ]\n+    }\n+\n+    assert ConfigureAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_when_builtin_action_validate_fails():\n+    action = ConfigureAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(validate_result=False)\n+\n+    assert action.validate(dict(VALID_ARGS)) is False\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    assert ConfigureAction().validate(dict(VALID_ARGS)) is True\n+\n+\n+# --- run() ---\n+\n+\n+def test_run_returns_false_when_no_sections():\n+    assert ConfigureAction().run({}, {\"sections\": []}) is False\n+\n+\n+@patch(\"src.action.configure.configure_action.click.prompt\", return_value=0)\n+def test_run_exits_immediately_on_choice_zero(mock_prompt):\n+    action = ConfigureAction()\n+    with patch.object(action, \"_run_section\") as mock_run_section:\n+        result = action.run({}, dict(VALID_ARGS))\n+\n+    assert result is True\n+    mock_run_section.assert_not_called()\n+\n+\n+@patch(\"src.action.configure.configure_action.click.prompt\", side_effect=[1, 0])\n+def test_run_runs_selected_section_then_exits(mock_prompt):\n+    action = ConfigureAction()\n+    with patch.object(action, \"_run_section\", return_value=True) as mock_run_section:\n+        result = action.run({}, dict(VALID_ARGS))\n+\n+    assert result is True\n+    mock_run_section.assert_called_once()\n+    assert mock_prompt.call_count == 2\n+\n+\n+@patch(\"src.action.configure.configure_action.click.prompt\", return_value=1)\n+def test_run_returns_false_when_run_section_fails(mock_prompt):\n+    action = ConfigureAction()\n+    with patch.object(action, \"_run_section\", return_value=False):\n+        result = action.run({}, dict(VALID_ARGS))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.configure.configure_action.click.prompt\", return_value=0)\n+def test_run_shows_missing_required_value_suffix(mock_prompt, monkeypatch, tmp_path, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    args = {\n+        \"sections\": [\n+            {\n+                \"name\": \"db\",\n+                \"title\": \"Database\",\n+                \"entry_action\": \"set-env\",\n+                \"actions\": [\n+                    {\n+                        \"name\": \"set-env\",\n+                        \"action\": \"set-environment-variables\",\n+                        \"prompts\": {\"host\": {\"required\": True}},\n+                        \"targets\": [\n+                            {\n+                                \"file_path\": str(tmp_path / \"datasaur.env\"),\n+                                \"values\": {\"HOST\": \"prompts[host]\"},\n+                            }\n+                        ],\n+                    }\n+                ],\n+            }\n+        ]\n+    }\n+\n+    ConfigureAction().run({}, args)\n+\n+    captured = capsys.readouterr()\n+    assert \"(missing required value)\" in captured.out\n+\n+\n+# --- _run_section() ---\n+\n+\n+def test_run_section_returns_false_when_no_actions():\n+    section = {\"name\": \"db\", \"actions\": []}\n+\n+    assert ConfigureAction()._run_section({}, section) is False\n+\n+\n+def test_run_section_returns_false_for_invalid_entry_action():\n+    section = {\n+        \"name\": \"db\",\n+        \"entry_action\": \"missing\",\n+        \"actions\": [{\"name\": \"set-env\", \"action\": \"set-environment-variables\"}],\n+    }\n+\n+    assert ConfigureAction()._run_section({}, section) is False\n+\n+\n+def test_run_section_delegates_to_run_flow_action():\n+    action = ConfigureAction()\n+    section = {\n+        \"name\": \"db\",\n+        \"entry_action\": \"set-env\",\n+        \"actions\": [{\"name\": \"set-env\", \"action\": \"set-environment-variables\"}],\n+    }\n+\n+    with patch.object(action, \"_run_flow_action\", return_value=True) as mock_flow:\n+        result = action._run_section({}, section)\n+\n+    assert result is True\n+    mock_flow.assert_called_once_with({}, {\"set-env\": section[\"actions\"][0]}, \"set-env\", set())\n+\n+\n+# --- _run_flow_action() ---\n+\n+\n+def test_run_flow_action_returns_false_when_action_not_found():\n+    action = ConfigureAction()\n+\n+    assert action._run_flow_action({}, {}, \"missing\", set()) is False\n+\n+\n+def test_run_flow_action_returns_false_when_builtin_action_not_registered():\n+    action = ConfigureAction()\n+    action_map = {\"step1\": {\"action\": \"no-such-builtin\"}}\n+\n+    assert action._run_flow_action({}, action_map, \"step1\", set()) is False\n+\n+\n+def test_run_flow_action_returns_false_on_infinite_loop():\n+    action = ConfigureAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action()\n+    action_map = {\"step1\": {\"action\": \"set-environment-variables\"}}\n+\n+    assert action._run_flow_action({}, action_map, \"step1\", {\"step1\"}) is False\n+\n+\n+def test_run_flow_action_done_without_next_action_returns_true():\n+    action = ConfigureAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+    )\n+    action_map = {\"step1\": {\"action\": \"set-environment-variables\"}}\n+\n+    assert action._run_flow_action({}, action_map, \"step1\", set()) is True\n+\n+\n+def test_run_flow_action_done_with_next_action_recurses():\n+    action = ConfigureAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+    )\n+    action_map = {\n+        \"step1\": {\"action\": \"set-environment-variables\", \"next_action\": \"step2\"},\n+        \"step2\": {\"action\": \"set-environment-variables\"},\n+    }\n+\n+    assert action._run_flow_action({}, action_map, \"step1\", set()) is True\n+\n+\n+def test_run_flow_action_exit_returns_true():\n+    action = ConfigureAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+    )\n+    action_map = {\"step1\": {\"action\": \"set-environment-variables\"}}\n+\n+    assert action._run_flow_action({}, action_map, \"step1\", set()) is True\n+\n+\n+def test_run_flow_action_goto_jumps_to_target_action():\n+    action = ConfigureAction()\n+    action.builtin_actions[\"switch-input\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.GOTO, content=\"step2\")\n+    )\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+    )\n+    action_map = {\n+        \"step1\": {\"action\": \"switch-input\"},\n+        \"step2\": {\"action\": \"set-environment-variables\"},\n+    }\n+\n+    assert action._run_flow_action({}, action_map, \"step1\", set()) is True\n+\n+\n+# --- _extract_prompt_name() ---\n+\n+\n+def test_extract_prompt_name_parses_valid_reference():\n+    assert ConfigureAction()._extract_prompt_name(\"prompts[host]\") == \"host\"\n+\n+\n+def test_extract_prompt_name_returns_none_for_invalid_reference():\n+    assert ConfigureAction()._extract_prompt_name(\"not-a-prompt-ref\") is None\n+\n+\n+# --- _read_env_values() ---\n+\n+\n+def test_read_env_values_returns_dict_for_existing_file(monkeypatch, tmp_path):\n+    env_path = tmp_path / \"datasaur.env\"\n+    env_path.write_text(\"HOST=example.com\\n\")\n+\n+    values = ConfigureAction()._read_env_values(str(env_path))\n+\n+    assert values == {\"HOST\": \"example.com\"}\n+\n+\n+def test_read_env_values_creates_and_returns_empty_dict_when_missing(tmp_path):\n+    env_path = tmp_path / \"nested\" / \"datasaur.env\"\n+\n+    values = ConfigureAction()._read_env_values(str(env_path))\n+\n+    assert values == {}\n+    assert env_path.exists()\n+\n+\n+# --- _get_missing_for_set_env_action() ---\n+\n+\n+def test_get_missing_for_set_env_action_flags_missing_required_value(tmp_path):\n+    env_path = tmp_path / \"datasaur.env\"\n+    env_path.write_text(\"\")\n+    manifest = {\n+        \"prompts\": {\"host\": {\"required\": True}},\n+        \"targets\": [{\"file_path\": str(env_path), \"values\": {\"HOST\": \"prompts[host]\"}}],\n+    }\n+\n+    missing = ConfigureAction()._get_missing_for_set_env_action(manifest)\n+\n+    assert missing == {\"HOST\"}\n+\n+\n+def test_get_missing_for_set_env_action_does_not_flag_present_value(tmp_path):\n+    env_path = tmp_path / \"datasaur.env\"\n+    env_path.write_text(\"HOST=example.com\\n\")\n+    manifest = {\n+        \"prompts\": {\"host\": {\"required\": True}},\n+        \"targets\": [{\"file_path\": str(env_path), \"values\": {\"HOST\": \"prompts[host]\"}}],\n+    }\n+\n+    missing = ConfigureAction()._get_missing_for_set_env_action(manifest)\n+\n+    assert missing == set()\n+\n+\n+def test_get_missing_for_set_env_action_ignores_non_required_prompt(tmp_path):\n+    env_path = tmp_path / \"datasaur.env\"\n+    env_path.write_text(\"\")\n+    manifest = {\n+        \"prompts\": {\"host\": {\"required\": False}},\n+        \"targets\": [{\"file_path\": str(env_path), \"values\": {\"HOST\": \"prompts[host]\"}}],\n+    }\n+\n+    missing = ConfigureAction()._get_missing_for_set_env_action(manifest)\n+\n+    assert missing == set()\n+\n+\n+# --- _get_missing_for_action_flow() ---\n+\n+\n+def test_get_missing_for_action_flow_returns_empty_set_for_no_action_name():\n+    assert ConfigureAction()._get_missing_for_action_flow({}, None) == set()\n+\n+\n+def test_get_missing_for_action_flow_returns_empty_set_for_unknown_action():\n+    assert ConfigureAction()._get_missing_for_action_flow({}, \"missing\") == set()\n+\n+\n+def test_get_missing_for_action_flow_combines_set_env_and_next_action(tmp_path):\n+    env_path = tmp_path / \"datasaur.env\"\n+    env_path.write_text(\"\")\n+    action_map = {\n+        \"step1\": {\n+            \"action\": \"set-environment-variables\",\n+            \"prompts\": {\"a\": {\"required\": True}},\n+            \"targets\": [{\"file_path\": str(env_path), \"values\": {\"A\": \"prompts[a]\"}}],\n+            \"next_action\": \"step2\",\n+        },\n+        \"step2\": {\n+            \"action\": \"set-environment-variables\",\n+            \"prompts\": {\"b\": {\"required\": True}},\n+            \"targets\": [{\"file_path\": str(env_path), \"values\": {\"B\": \"prompts[b]\"}}],\n+        },\n+    }\n+\n+    missing = ConfigureAction()._get_missing_for_action_flow(action_map, \"step1\")\n+\n+    assert missing == {\"A\", \"B\"}\n+\n+\n+def test_get_missing_for_action_flow_switch_input_picks_branch_with_fewest_missing(tmp_path):\n+    env_path = tmp_path / \"datasaur.env\"\n+    env_path.write_text(\"B=set\\n\")\n+    action_map = {\n+        \"switch\": {\n+            \"action\": \"switch-input\",\n+            \"cases\": [{\"action\": \"branch-a\"}, {\"action\": \"branch-b\"}],\n+        },\n+        \"branch-a\": {\n+            \"action\": \"set-environment-variables\",\n+            \"prompts\": {\"a\": {\"required\": True}},\n+            \"targets\": [{\"file_path\": str(env_path), \"values\": {\"A\": \"prompts[a]\"}}],\n+        },\n+        \"branch-b\": {\n+            \"action\": \"set-environment-variables\",\n+            \"prompts\": {\"b\": {\"required\": True}},\n+            \"targets\": [{\"file_path\": str(env_path), \"values\": {\"B\": \"prompts[b]\"}}],\n+        },\n+    }\n+\n+    missing = ConfigureAction()._get_missing_for_action_flow(action_map, \"switch\")\n+\n+    # branch-b's \"B\" is already set in the env file, so it has 0 missing —\n+    # the switch is satisfied by that branch even though branch-a has 1.\n+    assert missing == set()"},{"sha":"3629afd0ec493188d3e58581592d27fd44dd9e9e","filename":"on-premise/datasaur-cli/tests/action/hello_world/test_hello_world_action.py","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fhello_world%2Ftest_hello_world_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fhello_world%2Ftest_hello_world_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fhello_world%2Ftest_hello_world_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,37 @@\n+from src.action.hello_world.hello_world_action import HelloWorldAction\n+\n+VALID_ARGS = {\"name\": \"Alice\", \"age\": \"30\", \"files\": [{\"file_path\": \"a.txt\"}]}\n+\n+\n+def test_name():\n+    assert HelloWorldAction().name() == \"hello-world\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert HelloWorldAction().options() == {}\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    assert HelloWorldAction().validate(dict(VALID_ARGS)) is True\n+\n+\n+def test_validate_returns_false_when_required_field_missing():\n+    args = dict(VALID_ARGS)\n+    del args[\"name\"]\n+\n+    assert HelloWorldAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_when_files_entry_invalid():\n+    args = dict(VALID_ARGS, files=[{\"not_file_path\": \"a.txt\"}])\n+\n+    assert HelloWorldAction().validate(args) is False\n+\n+\n+def test_run_returns_true_and_sets_action_name_in_context():\n+    context = {}\n+\n+    result = HelloWorldAction().run(context, dict(VALID_ARGS))\n+\n+    assert result is True\n+    assert context[\"action_name\"] == \"hello-world\""},{"sha":"8589cf41e6c991bef70a6566c790b2546c4c6d21","filename":"on-premise/datasaur-cli/tests/action/install/test_load_docker_image_action.py","status":"added","additions":417,"deletions":0,"changes":417,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Finstall%2Ftest_load_docker_image_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Finstall%2Ftest_load_docker_image_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Finstall%2Ftest_load_docker_image_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,417 @@\n+import json\n+import tarfile\n+from pathlib import Path\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.install.load_docker_image_action import LoadDockerImageAction\n+\n+VALID_SERVICE = {\"name\": \"app\", \"image\": \"myimage:latest\", \"file_path\": \"/tmp/app.tar\"}\n+\n+MANIFEST_PATCH = \"src.action.install.load_docker_image_action.ManifestFileReader\"\n+FILE_VALIDATOR_PATCH = \"src.action.install.load_docker_image_action.FileValidator\"\n+DIR_VALIDATOR_PATCH = \"src.action.install.load_docker_image_action.DirectoryValidator\"\n+IMAGE_DIGEST_VALIDATOR_PATCH = \"src.action.install.load_docker_image_action.ImageDigestValidator\"\n+\n+\n+def test_name():\n+    assert LoadDockerImageAction().name() == \"load-docker-images\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert LoadDockerImageAction().options() == {}\n+\n+\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_false_when_manifest_read_fails(mock_reader_cls):\n+    mock_reader_cls.return_value.read.return_value = (None, False)\n+\n+    assert LoadDockerImageAction().validate({}) is False\n+\n+\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_false_when_no_services_in_manifest(mock_reader_cls):\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": []}, True)\n+\n+    assert LoadDockerImageAction().validate({}) is False\n+\n+\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_false_when_service_model_invalid(mock_reader_cls):\n+    mock_reader_cls.return_value.read.return_value = (\n+        {\"services\": [{\"name\": \"app\"}]},  # missing image/file_path\n+        True,\n+    )\n+\n+    assert LoadDockerImageAction().validate({}) is False\n+\n+\n+@patch(IMAGE_DIGEST_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(DIR_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(FILE_VALIDATOR_PATCH + \".validate\", return_value=False)\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_false_when_file_validator_fails(\n+    mock_reader_cls, mock_file_validate, mock_dir_validate, mock_digest_validate, tmp_path\n+):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+\n+    assert LoadDockerImageAction().validate({}) is False\n+\n+\n+@patch(IMAGE_DIGEST_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(DIR_VALIDATOR_PATCH + \".validate\", return_value=False)\n+@patch(FILE_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_false_when_directory_validator_fails(\n+    mock_reader_cls, mock_file_validate, mock_dir_validate, mock_digest_validate, tmp_path\n+):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+\n+    assert LoadDockerImageAction().validate({}) is False\n+\n+\n+@patch(IMAGE_DIGEST_VALIDATOR_PATCH + \".validate\", return_value=False)\n+@patch(DIR_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(FILE_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_false_when_image_digest_validator_fails(\n+    mock_reader_cls, mock_file_validate, mock_dir_validate, mock_digest_validate, tmp_path\n+):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+\n+    assert LoadDockerImageAction().validate({}) is False\n+\n+\n+@patch(IMAGE_DIGEST_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(DIR_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(FILE_VALIDATOR_PATCH + \".validate\", return_value=True)\n+@patch(MANIFEST_PATCH)\n+def test_validate_returns_true_when_all_validators_pass(\n+    mock_reader_cls, mock_file_validate, mock_dir_validate, mock_digest_validate, tmp_path\n+):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+\n+    assert LoadDockerImageAction().validate({}) is True\n+\n+\n+@patch(IMAGE_DIGEST_VALIDATOR_PATCH + \".validate\")\n+@patch(DIR_VALIDATOR_PATCH + \".validate\")\n+@patch(FILE_VALIDATOR_PATCH + \".validate\")\n+@patch(MANIFEST_PATCH)\n+def test_validate_skips_service_when_archive_file_missing(\n+    mock_reader_cls, mock_file_validate, mock_dir_validate, mock_digest_validate, tmp_path\n+):\n+    # Build.sh's --include-*-docker-images false means a declared service's archive\n+    # intentionally isn't bundled — that's not a validation error, just a skip.\n+    missing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"missing.tar.gz\"))\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [missing_service]}, True)\n+\n+    assert LoadDockerImageAction().validate({}) is True\n+    mock_file_validate.assert_not_called()\n+    mock_dir_validate.assert_not_called()\n+    mock_digest_validate.assert_not_called()\n+\n+\n+@patch(MANIFEST_PATCH)\n+def test_run_returns_false_when_manifest_read_fails(mock_reader_cls):\n+    mock_reader_cls.return_value.read.return_value = (None, False)\n+\n+    assert LoadDockerImageAction().run({}, {}) is False\n+\n+\n+@patch(MANIFEST_PATCH)\n+def test_run_returns_false_when_service_model_invalid(mock_reader_cls):\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [{\"name\": \"app\"}]}, True)\n+\n+    assert LoadDockerImageAction().run({}, {}) is False\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.Popen\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=\"/usr/bin/pigz\")\n+@patch(MANIFEST_PATCH)\n+def test_run_uses_pigz_pipeline_when_available(mock_reader_cls, mock_which, mock_popen, tmp_path):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+    pigz_process = MagicMock()\n+    pigz_process.returncode = 0\n+    pigz_process.stderr.read.return_value = b\"\"\n+    docker_process = MagicMock()\n+    docker_process.returncode = 0\n+    docker_process.communicate.return_value = (b\"loaded\\n\", b\"\")\n+    mock_popen.side_effect = [pigz_process, docker_process]\n+    context = {}\n+\n+    result = LoadDockerImageAction().run(context, {})\n+\n+    assert result is True\n+    assert context[\"action_name\"] == \"load-docker-images\"\n+    assert mock_popen.call_count == 2\n+    docker_call_kwargs = mock_popen.call_args_list[1].kwargs\n+    assert docker_call_kwargs[\"stdin\"] is pigz_process.stdout\n+    pigz_process.wait.assert_called_once()\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.Popen\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=\"/usr/bin/pigz\")\n+@patch(MANIFEST_PATCH)\n+def test_run_returns_false_when_pigz_fails(mock_reader_cls, mock_which, mock_popen, tmp_path):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+    pigz_process = MagicMock()\n+    pigz_process.returncode = 1\n+    pigz_process.stderr.read.return_value = b\"pigz: unexpected end of file\"\n+    docker_process = MagicMock()\n+    docker_process.returncode = 0\n+    docker_process.communicate.return_value = (b\"loaded\\n\", b\"\")\n+    mock_popen.side_effect = [pigz_process, docker_process]\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is False\n+    pigz_process.wait.assert_called_once()\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_uses_direct_docker_load_when_pigz_unavailable(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    archive_path = str(tmp_path / \"app.tar\")\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    existing_service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"loaded\", stderr=\"\")\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"load\", \"-i\", archive_path]\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_returns_false_when_docker_load_fails(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"boom\")\n+\n+    assert LoadDockerImageAction().run({}, {}) is False\n+\n+\n+@patch(\n+    \"src.action.install.load_docker_image_action.subprocess.run\",\n+    side_effect=OSError(\"boom\"),\n+)\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_returns_false_when_loading_raises_exception(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    existing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+\n+    assert LoadDockerImageAction().run({}, {}) is False\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_stops_at_first_failing_service(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    first_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"app.tar\"))\n+    (tmp_path / \"app.tar\").write_bytes(b\"\")\n+    second_service = dict(VALID_SERVICE, name=\"app2\", file_path=str(tmp_path / \"app2.tar\"))\n+    (tmp_path / \"app2.tar\").write_bytes(b\"\")\n+    mock_reader_cls.return_value.read.return_value = (\n+        {\"services\": [first_service, second_service]},\n+        True,\n+    )\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"boom\")\n+\n+    assert LoadDockerImageAction().run({}, {}) is False\n+    mock_run.assert_called_once()\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_service_when_archive_file_missing(mock_reader_cls, mock_run, tmp_path):\n+    missing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"missing.tar.gz\"))\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [missing_service]}, True)\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_not_called()\n+\n+\n+def test_resolve_image_name_substitutes_known_env_var():\n+    resolved = LoadDockerImageAction()._resolve_image_name(\"myimage:${TAG}\", {\"TAG\": \"1.2.3\"})\n+\n+    assert resolved == \"myimage:1.2.3\"\n+\n+\n+def test_resolve_image_name_substitutes_empty_string_for_unknown_var():\n+    resolved = LoadDockerImageAction()._resolve_image_name(\"myimage:${TAG}\", {})\n+\n+    assert resolved == \"myimage:\"\n+\n+\n+def _make_archive(tmp_path: Path, config_hash: str = \"a\" * 64) -> str:\n+    archive_path = tmp_path / \"app.tar.gz\"\n+    manifest_path = tmp_path / \"manifest.json\"\n+    manifest_path.write_text(\n+        json.dumps([{\"Config\": f\"{config_hash}.json\", \"RepoTags\": [\"myimage:latest\"], \"Layers\": []}])\n+    )\n+    with tarfile.open(archive_path, \"w:gz\") as tar:\n+        tar.add(manifest_path, arcname=\"manifest.json\")\n+    return str(archive_path)\n+\n+\n+def _make_oci_archive(tmp_path: Path, index_digest: str = \"a\" * 64) -> str:\n+    # Newer (containerd-backed) `docker save` archives ship an index.json whose\n+    # manifests[0].digest is what `docker image inspect`'s .Id reports — a different\n+    # value than the legacy manifest.json's Config-blob-filename digest.\n+    archive_path = tmp_path / \"app.tar.gz\"\n+    index_path = tmp_path / \"index.json\"\n+    index_path.write_text(\n+        json.dumps({\"schemaVersion\": 2, \"manifests\": [{\"digest\": f\"sha256:{index_digest}\"}]})\n+    )\n+    manifest_path = tmp_path / \"manifest.json\"\n+    manifest_path.write_text(\n+        json.dumps([{\"Config\": \"blobs/sha256/\" + (\"c\" * 64), \"RepoTags\": [\"myimage:latest\"], \"Layers\": []}])\n+    )\n+    with tarfile.open(archive_path, \"w:gz\") as tar:\n+        tar.add(index_path, arcname=\"index.json\")\n+        tar.add(manifest_path, arcname=\"manifest.json\")\n+    return str(archive_path)\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_load_when_local_image_id_matches_archive_digest(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.return_value = MagicMock(returncode=0, stdout=f\"sha256:{'a' * 64}\\n\", stderr=\"\")\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"image\", \"inspect\", \"myimage:latest\", \"--format\", \"{{.Id}}\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_loads_when_local_image_id_does_not_match(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    archive_path = _make_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=f\"sha256:{'b' * 64}\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"Loaded image\", stderr=\"\"),\n+    ]\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+    assert mock_run.call_args_list[1].args[0] == [\"docker\", \"load\", \"-i\", archive_path]\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_load_using_oci_index_json_digest(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_oci_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.return_value = MagicMock(returncode=0, stdout=f\"sha256:{'a' * 64}\\n\", stderr=\"\")\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"image\", \"inspect\", \"myimage:latest\", \"--format\", \"{{.Id}}\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_loads_when_local_tag_does_not_exist(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    archive_path = _make_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"no such image\"),\n+        MagicMock(returncode=0, stdout=\"Loaded image\", stderr=\"\"),\n+    ]\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+\n+\n+def _make_blobs_form_archive_without_index(tmp_path: Path, config_hash: str = \"a\" * 64) -> str:\n+    # Containerd-backed archive with no index.json, whose manifest.json Config\n+    # addresses the blob directly by digest rather than a \"<digest>.json\" name.\n+    archive_path = tmp_path / \"app.tar.gz\"\n+    manifest_path = tmp_path / \"manifest.json\"\n+    manifest_path.write_text(\n+        json.dumps([{\"Config\": f\"blobs/sha256/{config_hash}\", \"RepoTags\": [\"myimage:latest\"], \"Layers\": []}])\n+    )\n+    with tarfile.open(archive_path, \"w:gz\") as tar:\n+        tar.add(manifest_path, arcname=\"manifest.json\")\n+    return str(archive_path)\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_load_using_blobs_form_config_digest_without_index_json(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_blobs_form_archive_without_index(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.return_value = MagicMock(returncode=0, stdout=f\"sha256:{'a' * 64}\\n\", stderr=\"\")\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"image\", \"inspect\", \"myimage:latest\", \"--format\", \"{{.Id}}\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.install.load_docker_image_action.subprocess.run\")\n+@patch(\"src.action.install.load_docker_image_action.shutil.which\", return_value=None)\n+@patch(MANIFEST_PATCH)\n+def test_run_loads_when_archive_has_no_manifest_json(mock_reader_cls, mock_which, mock_run, tmp_path):\n+    # A real file that exists but isn't a valid tar — tarfile.open raises, treated as\n+    # \"can't determine\", distinct from the file being missing entirely (which skips).\n+    archive_path = str(tmp_path / \"app.tar\")\n+    (tmp_path / \"app.tar\").write_text(\"not a tar archive\")\n+    existing_service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [existing_service]}, True)\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Loaded image\", stderr=\"\")\n+\n+    result = LoadDockerImageAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with([\"docker\", \"load\", \"-i\", archive_path], capture_output=True, text=True)"},{"sha":"b054690a5cf29e5d3536ce219f22090c1108d757","filename":"on-premise/datasaur-cli/tests/action/run_workflow/builtin_action/set_encryption_config/test_set_encryption_config_builtin_action.py","status":"added","additions":109,"deletions":0,"changes":109,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_encryption_config%2Ftest_set_encryption_config_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_encryption_config%2Ftest_set_encryption_config_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_encryption_config%2Ftest_set_encryption_config_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,109 @@\n+from unittest.mock import patch\n+\n+from src.action.run_workflow.builtin_action.builtin_action import BuiltInActionResultAction\n+from src.action.run_workflow.builtin_action.set_encryption_config.set_encryption_config_builtin_action import (\n+    SetEncryptionConfigBuiltInAction,\n+)\n+\n+PROMPT_PATCH = \"src.action.run_workflow.builtin_action.set_encryption_config.set_encryption_config_builtin_action.click.prompt\"\n+\n+\n+def test_name():\n+    assert SetEncryptionConfigBuiltInAction().name() == \"set-encryption-config\"\n+\n+\n+def test_validate_returns_false_for_invalid_manifest():\n+    # Every model field has a default, so validity hinges on type-checking\n+    # whatever IS provided — a non-string target_file_path fails coercion.\n+    manifest = {\"name\": \"enc\", \"target_file_path\": {\"not\": \"a string\"}}\n+\n+    assert SetEncryptionConfigBuiltInAction().validate(manifest) is False\n+\n+\n+def test_validate_returns_true_for_valid_manifest():\n+    assert SetEncryptionConfigBuiltInAction().validate({\"name\": \"enc\"}) is True\n+\n+\n+@patch(PROMPT_PATCH, return_value=2)\n+def test_run_disables_encryption(mock_prompt, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.DONE\n+    content = (tmp_path / \"datasaur.env\").read_text()\n+    assert 'ENCRYPTION_VERSION=\"0\"' in content\n+\n+\n+@patch(PROMPT_PATCH, side_effect=[1, \"new-secret-key\"])\n+def test_run_enables_encryption_with_new_key(mock_prompt, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.DONE\n+    content = (tmp_path / \"datasaur.env\").read_text()\n+    assert 'ENCRYPTION_VERSION=\"1\"' in content\n+    assert 'ENCRYPTION_KEY=\"new-secret-key\"' in content\n+\n+\n+@patch(PROMPT_PATCH, side_effect=[1, \"   \"])\n+def test_run_exits_when_new_key_is_empty(mock_prompt, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.EXIT\n+\n+\n+@patch(PROMPT_PATCH, side_effect=[1, \"different-key\"])\n+def test_run_exits_when_changing_key_while_already_enabled(mock_prompt, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"datasaur.env\").write_text(\"ENCRYPTION_VERSION=1\\nENCRYPTION_KEY=original-key\\n\")\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.EXIT\n+    content = (tmp_path / \"datasaur.env\").read_text()\n+    assert \"original-key\" in content\n+\n+\n+@patch(PROMPT_PATCH, side_effect=[1, \"original-key\"])\n+def test_run_allows_reentering_the_same_key_while_already_enabled(mock_prompt, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"datasaur.env\").write_text(\"ENCRYPTION_VERSION=1\\nENCRYPTION_KEY=original-key\\n\")\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.DONE\n+\n+\n+@patch(\n+    \"src.action.run_workflow.builtin_action.set_encryption_config.set_encryption_config_builtin_action.EnvFile\"\n+)\n+def test_run_exits_when_env_file_read_fails(mock_env_file_cls):\n+    mock_env_file_cls.return_value.read.return_value = (None, False)\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.EXIT\n+\n+\n+@patch(PROMPT_PATCH, return_value=2)\n+@patch(\n+    \"src.action.run_workflow.builtin_action.set_encryption_config.set_encryption_config_builtin_action.EnvFile\"\n+)\n+def test_run_exits_when_env_file_write_fails(mock_env_file_cls, mock_prompt):\n+    mock_env_file_cls.return_value.read.return_value = ({}, True)\n+    mock_env_file_cls.return_value.write.return_value = False\n+    manifest = {\"name\": \"enc\", \"title\": \"Encryption\"}\n+\n+    result = SetEncryptionConfigBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.EXIT"},{"sha":"a88d342168f8be654a8f087d5e929673f153c070","filename":"on-premise/datasaur-cli/tests/action/run_workflow/builtin_action/set_environment_variables/test_set_environment_variables_builtin_action.py","status":"added","additions":180,"deletions":0,"changes":180,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_set_environment_variables_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_set_environment_variables_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_set_environment_variables_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,180 @@\n+from src.action.run_workflow.builtin_action.builtin_action import BuiltInActionResultAction\n+from src.action.run_workflow.builtin_action.set_environment_variables.set_environment_variables_builtin_action import (\n+    PromptPropertiesModel,\n+    SetEnvironmentVariablesBuiltInAction,\n+    SetEnvironmentVariablesBuiltInActionArgsModel,\n+)\n+\n+VALID_MANIFEST = {\"name\": \"set-env\", \"prompts\": {}, \"targets\": []}\n+\n+\n+def test_name():\n+    assert SetEnvironmentVariablesBuiltInAction().name() == \"set-environment-variables\"\n+\n+\n+def test_validate_returns_false_for_invalid_manifest():\n+    assert SetEnvironmentVariablesBuiltInAction().validate({\"name\": \"set-env\"}) is False\n+\n+\n+def test_validate_returns_true_for_valid_manifest():\n+    assert SetEnvironmentVariablesBuiltInAction().validate(dict(VALID_MANIFEST)) is True\n+\n+\n+def test_run_happy_path_returns_done_and_sets_builtin_action_name():\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_service.get_prompt_values = lambda prompts, existing_values, skip_if_set=False: {\"host\": \"example.com\"}\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: True\n+    context = {}\n+\n+    result = action.run(context, dict(VALID_MANIFEST))\n+\n+    assert result.action == BuiltInActionResultAction.DONE\n+    assert context[\"builtin_action_name\"] == \"set-env\"\n+\n+\n+def test_run_exits_when_writing_target_files_fails():\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_service.get_prompt_values = lambda prompts, existing_values, skip_if_set=False: {}\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: False\n+\n+    result = action.run({}, dict(VALID_MANIFEST))\n+\n+    assert result.action == BuiltInActionResultAction.EXIT\n+\n+\n+def test_run_populates_prompt_defaults_from_the_target_file_only(tmp_path):\n+    # The whole point: .env is the *only* source of \"what's already set\" — no\n+    # separate state file, so this is consistent regardless of which command\n+    # (configure, init-app-server, ...) or working directory ran last.\n+    env_file = tmp_path / \".env\"\n+    env_file.write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    manifest = {\n+        \"name\": \"registry\",\n+        \"prompts\": {\"REGISTRY_DOMAIN\": {\"text\": \"Registry domain\"}},\n+        \"targets\": [{\"file_path\": str(env_file), \"values\": {\"REGISTRY_DOMAIN\": \"prompts[REGISTRY_DOMAIN]\"}}],\n+    }\n+\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: True\n+\n+    captured_existing_values = {}\n+\n+    def fake_get_prompt_values(prompts, existing_values, skip_if_set=False):\n+        captured_existing_values.update(existing_values)\n+        return {}\n+\n+    action.user_prompts_service.get_prompt_values = fake_get_prompt_values\n+\n+    action.run({}, manifest)\n+\n+    assert captured_existing_values == {\"REGISTRY_DOMAIN\": \"registry.app-server.com\"}\n+\n+\n+def test_run_passes_no_default_when_target_file_has_no_value_yet(tmp_path):\n+    env_file = tmp_path / \".env\"\n+    env_file.write_text(\"SOME_OTHER_VAR=1\\n\")\n+    manifest = {\n+        \"name\": \"registry\",\n+        \"prompts\": {\"REGISTRY_DOMAIN\": {\"text\": \"Registry domain\"}},\n+        \"targets\": [{\"file_path\": str(env_file), \"values\": {\"REGISTRY_DOMAIN\": \"prompts[REGISTRY_DOMAIN]\"}}],\n+    }\n+\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: True\n+\n+    captured_existing_values = {}\n+\n+    def fake_get_prompt_values(prompts, existing_values, skip_if_set=False):\n+        captured_existing_values.update(existing_values)\n+        return {}\n+\n+    action.user_prompts_service.get_prompt_values = fake_get_prompt_values\n+\n+    action.run({}, manifest)\n+\n+    assert captured_existing_values == {}\n+\n+\n+def test_run_works_when_target_file_does_not_exist_yet(tmp_path):\n+    manifest = {\n+        \"name\": \"registry\",\n+        \"prompts\": {\"REGISTRY_DOMAIN\": {\"text\": \"Registry domain\"}},\n+        \"targets\": [\n+            {\"file_path\": str(tmp_path / \".env\"), \"values\": {\"REGISTRY_DOMAIN\": \"prompts[REGISTRY_DOMAIN]\"}}\n+        ],\n+    }\n+\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: True\n+\n+    captured_existing_values = {}\n+\n+    def fake_get_prompt_values(prompts, existing_values, skip_if_set=False):\n+        captured_existing_values.update(existing_values)\n+        return {}\n+\n+    action.user_prompts_service.get_prompt_values = fake_get_prompt_values\n+\n+    result = action.run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.DONE\n+    assert captured_existing_values == {}\n+\n+\n+def test_prompt_properties_model_retains_hide_input():\n+    m = PromptPropertiesModel.model_validate({\"hide_input\": True})\n+\n+    assert m.hide_input is True\n+\n+\n+def test_prompt_properties_model_hide_input_defaults_to_none():\n+    m = PromptPropertiesModel.model_validate({})\n+\n+    assert m.hide_input is None\n+\n+\n+def test_args_model_skip_if_set_defaults_to_false():\n+    m = SetEnvironmentVariablesBuiltInActionArgsModel.model_validate({\"prompts\": {}, \"targets\": []})\n+\n+    assert m.skip_if_set is False\n+\n+\n+def test_args_model_accepts_skip_if_set_true():\n+    m = SetEnvironmentVariablesBuiltInActionArgsModel.model_validate(\n+        {\"prompts\": {}, \"targets\": [], \"skip_if_set\": True}\n+    )\n+\n+    assert m.skip_if_set is True\n+\n+\n+def test_run_passes_skip_if_set_flag_through_to_get_prompt_values():\n+    manifest = {**VALID_MANIFEST, \"skip_if_set\": True}\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: True\n+    captured = {}\n+\n+    def fake_get_prompt_values(prompts, existing_values, skip_if_set=False):\n+        captured[\"skip_if_set\"] = skip_if_set\n+        return {}\n+\n+    action.user_prompts_service.get_prompt_values = fake_get_prompt_values\n+\n+    action.run({}, manifest)\n+\n+    assert captured[\"skip_if_set\"] is True\n+\n+\n+def test_run_defaults_skip_if_set_to_false_when_absent():\n+    action = SetEnvironmentVariablesBuiltInAction()\n+    action.user_prompts_target_writer_service.write_target_files = lambda targets, values: True\n+    captured = {}\n+\n+    def fake_get_prompt_values(prompts, existing_values, skip_if_set=False):\n+        captured[\"skip_if_set\"] = skip_if_set\n+        return {}\n+\n+    action.user_prompts_service.get_prompt_values = fake_get_prompt_values\n+\n+    action.run({}, dict(VALID_MANIFEST))\n+\n+    assert captured[\"skip_if_set\"] is False"},{"sha":"bb7a2284c45d45e1bf0806c7cfcb9fd56b142c49","filename":"on-premise/datasaur-cli/tests/action/run_workflow/builtin_action/set_environment_variables/test_user_prompts_service.py","status":"added","additions":255,"deletions":0,"changes":255,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_user_prompts_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_user_prompts_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_user_prompts_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,255 @@\n+from unittest.mock import patch\n+\n+import click\n+import pytest\n+\n+from src.action.run_workflow.builtin_action.set_environment_variables.user_prompts_service import (\n+    GENERATE_RANDOM_STRING_LENGTH,\n+    UserPromptsService,\n+)\n+\n+PROMPT_PATCH = \"src.action.run_workflow.builtin_action.set_environment_variables.user_prompts_service.click.prompt\"\n+\n+\n+# --- get_prompt_values() ---\n+\n+\n+@patch(PROMPT_PATCH, side_effect=[\"alice\", \"30\"])\n+def test_get_prompt_values_collects_each_prompt_result(mock_prompt):\n+    prompts = {\"name\": {}, \"age\": {}}\n+\n+    values = UserPromptsService().get_prompt_values(prompts, {})\n+\n+    assert values == {\"name\": \"alice\", \"age\": \"30\"}\n+\n+\n+@patch(PROMPT_PATCH, return_value=\"answer\")\n+def test_get_prompt_values_returns_empty_dict_for_no_prompts(mock_prompt):\n+    values = UserPromptsService().get_prompt_values({}, {})\n+\n+    assert values == {}\n+    mock_prompt.assert_not_called()\n+\n+\n+# --- _get_click_prompt_params() ---\n+\n+\n+def test_get_click_prompt_params_uses_prompt_name_as_default_text():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\"host\", {}, {})\n+\n+    assert text == \"host\"\n+\n+\n+def test_get_click_prompt_params_uses_text_property_when_given():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"host\", {\"text\": \"Hostname\"}, {}\n+    )\n+\n+    assert text == \"Hostname\"\n+\n+\n+def test_get_click_prompt_params_appends_description():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"host\", {\"text\": \"Hostname\", \"description\": \"the server host\"}, {}\n+    )\n+\n+    assert text == \"Hostname (the server host)\"\n+\n+\n+def test_get_click_prompt_params_existing_value_takes_priority_over_default():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"host\", {\"default\": \"fallback\"}, {\"host\": \"from-env-file\"}\n+    )\n+\n+    assert kwargs[\"default\"] == \"from-env-file\"\n+\n+\n+def test_get_click_prompt_params_uses_explicit_default_when_no_existing_value():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"host\", {\"default\": \"fallback\"}, {}\n+    )\n+\n+    assert kwargs[\"default\"] == \"fallback\"\n+\n+\n+def test_get_click_prompt_params_generates_random_default_of_requested_length():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"secret\", {\"generate\": True, \"generate_length\": 24}, {}\n+    )\n+\n+    assert len(kwargs[\"default\"]) == 24\n+\n+\n+def test_get_click_prompt_params_generate_defaults_to_standard_length():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"secret\", {\"generate\": True}, {}\n+    )\n+\n+    assert len(kwargs[\"default\"]) == GENERATE_RANDOM_STRING_LENGTH\n+\n+\n+def test_get_click_prompt_params_not_required_defaults_to_empty_and_hides_default():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"host\", {\"required\": False}, {}\n+    )\n+\n+    assert kwargs[\"default\"] == \"\"\n+    assert kwargs[\"show_default\"] is False\n+\n+\n+def test_get_click_prompt_params_no_default_source_omits_default_key():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\"host\", {}, {})\n+\n+    assert \"default\" not in kwargs\n+\n+\n+def test_get_click_prompt_params_always_includes_value_proc():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\"host\", {}, {})\n+\n+    assert callable(kwargs[\"value_proc\"])\n+    assert kwargs[\"value_proc\"](\"plain-value\") == \"plain-value\"\n+\n+\n+def test_get_click_prompt_params_hide_input_true_when_declared():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"password\", {\"hide_input\": True}, {}\n+    )\n+\n+    assert kwargs[\"hide_input\"] is True\n+\n+\n+def test_get_click_prompt_params_hide_input_defaults_to_false():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\"password\", {}, {})\n+\n+    assert kwargs[\"hide_input\"] is False\n+\n+\n+def test_get_click_prompt_params_hide_input_with_existing_default_hides_default_display():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"password\", {\"hide_input\": True}, {\"password\": \"current-secret-value\"}\n+    )\n+\n+    assert kwargs[\"default\"] == \"current-secret-value\"\n+    assert kwargs[\"show_default\"] is False\n+\n+\n+def test_get_click_prompt_params_hide_input_false_with_existing_default_still_shows_default():\n+    text, kwargs = UserPromptsService()._get_click_prompt_params(\n+        \"host\", {\"hide_input\": False}, {\"host\": \"current-value\"}\n+    )\n+\n+    assert kwargs[\"default\"] == \"current-value\"\n+    assert \"show_default\" not in kwargs\n+\n+\n+# --- _generate_random_string() ---\n+\n+\n+def test_generate_random_string_returns_requested_length():\n+    result = UserPromptsService()._generate_random_string(32)\n+\n+    assert len(result) == 32\n+    assert all(c.isalnum() for c in result)\n+\n+\n+# --- _validate_value() ---\n+\n+\n+def test_validate_value_rejects_escape_character():\n+    with pytest.raises(click.BadParameter):\n+        UserPromptsService()._validate_value(\"abc\\x1bdef\")\n+\n+\n+def test_validate_value_passes_through_with_no_constraints():\n+    assert UserPromptsService()._validate_value(\"anything goes\") == \"anything goes\"\n+\n+\n+def test_validate_value_allowed_characters_digit_rejects_non_digit_value():\n+    with pytest.raises(click.BadParameter):\n+        UserPromptsService()._validate_value(\"abcdef\", allowed_characters=\"digit\")\n+\n+\n+def test_validate_value_allowed_characters_digit_accepts_value_with_a_digit():\n+    assert UserPromptsService()._validate_value(\"abc123\", allowed_characters=\"digit\") == \"abc123\"\n+\n+\n+def test_validate_value_allowed_characters_alphabet_digit_accepts_alnum():\n+    assert (\n+        UserPromptsService()._validate_value(\"abc123\", allowed_characters=\"alphabet,digit\")\n+        == \"abc123\"\n+    )\n+\n+\n+def test_validate_value_allowed_characters_special_rejects_value_with_no_special_char():\n+    with pytest.raises(click.BadParameter):\n+        UserPromptsService()._validate_value(\"abc123\", allowed_characters=\"special\")\n+\n+\n+def test_validate_value_allowed_characters_special_accepts_value_with_a_special_char():\n+    assert UserPromptsService()._validate_value(\"abc123!\", allowed_characters=\"special\") == \"abc123!\"\n+\n+\n+def test_validate_value_min_length_violation_raises():\n+    with pytest.raises(click.BadParameter):\n+        UserPromptsService()._validate_value(\"ab\", min_length=3)\n+\n+\n+def test_validate_value_max_length_violation_raises():\n+    with pytest.raises(click.BadParameter):\n+        UserPromptsService()._validate_value(\"abcdef\", max_length=3)\n+\n+\n+def test_validate_value_within_length_bounds_passes():\n+    assert UserPromptsService()._validate_value(\"abc\", min_length=1, max_length=5) == \"abc\"\n+\n+\n+# --- get_prompt_values() skip_if_set ---\n+\n+\n+@patch(PROMPT_PATCH)\n+def test_get_prompt_values_skips_prompt_when_skip_if_set_and_value_already_exists(mock_prompt):\n+    values = UserPromptsService().get_prompt_values(\n+        {\"REGISTRY_DOMAIN\": {\"text\": \"Domain\"}},\n+        {\"REGISTRY_DOMAIN\": \"registry.app-server.com\"},\n+        skip_if_set=True,\n+    )\n+\n+    assert values == {\"REGISTRY_DOMAIN\": \"registry.app-server.com\"}\n+    mock_prompt.assert_not_called()\n+\n+\n+@patch(PROMPT_PATCH, return_value=\"typed-value\")\n+def test_get_prompt_values_still_prompts_when_skip_if_set_true_but_no_existing_value(mock_prompt):\n+    values = UserPromptsService().get_prompt_values(\n+        {\"REGISTRY_DOMAIN\": {\"text\": \"Domain\"}}, {}, skip_if_set=True\n+    )\n+\n+    assert values == {\"REGISTRY_DOMAIN\": \"typed-value\"}\n+    mock_prompt.assert_called_once()\n+\n+\n+@patch(PROMPT_PATCH, return_value=\"typed-value\")\n+def test_get_prompt_values_prompts_even_with_existing_value_when_skip_if_set_false(mock_prompt):\n+    values = UserPromptsService().get_prompt_values(\n+        {\"REGISTRY_DOMAIN\": {\"text\": \"Domain\"}},\n+        {\"REGISTRY_DOMAIN\": \"registry.app-server.com\"},\n+        skip_if_set=False,\n+    )\n+\n+    assert values == {\"REGISTRY_DOMAIN\": \"typed-value\"}\n+    mock_prompt.assert_called_once()\n+\n+\n+@patch(PROMPT_PATCH, return_value=\"typed-username\")\n+def test_get_prompt_values_skip_if_set_only_skips_fields_that_already_have_a_value(mock_prompt):\n+    values = UserPromptsService().get_prompt_values(\n+        {\"REGISTRY_DOMAIN\": {\"text\": \"Domain\"}, \"REGISTRY_USERNAME\": {\"text\": \"Username\"}},\n+        {\"REGISTRY_DOMAIN\": \"registry.app-server.com\"},\n+        skip_if_set=True,\n+    )\n+\n+    assert values == {\n+        \"REGISTRY_DOMAIN\": \"registry.app-server.com\",\n+        \"REGISTRY_USERNAME\": \"typed-username\",\n+    }\n+    mock_prompt.assert_called_once()"},{"sha":"dd74265abc6fe99718a7d9ffdd24af797a6b045a","filename":"on-premise/datasaur-cli/tests/action/run_workflow/builtin_action/set_environment_variables/test_user_prompts_target_writer_service.py","status":"added","additions":72,"deletions":0,"changes":72,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_user_prompts_target_writer_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_user_prompts_target_writer_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fset_environment_variables%2Ftest_user_prompts_target_writer_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,72 @@\n+from src.action.run_workflow.builtin_action.set_environment_variables.user_prompts_target_writer_service import (\n+    UserPromptsTargetWriterService,\n+)\n+\n+\n+def test_write_target_files_substitutes_prompt_placeholder(tmp_path):\n+    target_file = tmp_path / \"datasaur.env\"\n+    targets = [{\"file_path\": str(target_file), \"values\": {\"HOST\": \"prompts[host]\"}}]\n+\n+    ok = UserPromptsTargetWriterService().write_target_files(targets, {\"host\": \"example.com\"})\n+\n+    assert ok is True\n+    assert target_file.read_text() == 'HOST=\"example.com\"\\n'\n+\n+\n+def test_write_target_files_substitutes_missing_prompt_with_empty_string(tmp_path):\n+    target_file = tmp_path / \"datasaur.env\"\n+    targets = [{\"file_path\": str(target_file), \"values\": {\"HOST\": \"prompts[missing]\"}}]\n+\n+    ok = UserPromptsTargetWriterService().write_target_files(targets, {})\n+\n+    assert ok is True\n+    assert target_file.read_text() == 'HOST=\"\"\\n'\n+\n+\n+def test_write_target_files_leaves_literal_value_unchanged(tmp_path):\n+    target_file = tmp_path / \"datasaur.env\"\n+    targets = [{\"file_path\": str(target_file), \"values\": {\"MODE\": \"production\"}}]\n+\n+    ok = UserPromptsTargetWriterService().write_target_files(targets, {})\n+\n+    assert ok is True\n+    assert target_file.read_text() == 'MODE=\"production\"\\n'\n+\n+\n+def test_write_target_files_substitutes_placeholder_embedded_in_larger_string(tmp_path):\n+    target_file = tmp_path / \"datasaur.env\"\n+    targets = [{\"file_path\": str(target_file), \"values\": {\"URL\": \"https://prompts[host]/api\"}}]\n+\n+    ok = UserPromptsTargetWriterService().write_target_files(targets, {\"host\": \"example.com\"})\n+\n+    assert ok is True\n+    assert target_file.read_text() == 'URL=\"https://example.com/api\"\\n'\n+\n+\n+def test_write_target_files_writes_multiple_targets(tmp_path):\n+    file_a = tmp_path / \"a.env\"\n+    file_b = tmp_path / \"b.env\"\n+    targets = [\n+        {\"file_path\": str(file_a), \"values\": {\"HOST\": \"prompts[host]\"}},\n+        {\"file_path\": str(file_b), \"values\": {\"PORT\": \"prompts[port]\"}},\n+    ]\n+\n+    ok = UserPromptsTargetWriterService().write_target_files(\n+        targets, {\"host\": \"example.com\", \"port\": \"8080\"}\n+    )\n+\n+    assert ok is True\n+    assert file_a.read_text() == 'HOST=\"example.com\"\\n'\n+    assert file_b.read_text() == 'PORT=\"8080\"\\n'\n+\n+\n+def test_write_target_files_returns_false_when_read_fails(tmp_path):\n+    # A directory at the target path makes EnvFile.read() fail rather than\n+    # silently creating a file there.\n+    target_dir = tmp_path / \"datasaur.env\"\n+    target_dir.mkdir()\n+    targets = [{\"file_path\": str(target_dir), \"values\": {\"HOST\": \"prompts[host]\"}}]\n+\n+    ok = UserPromptsTargetWriterService().write_target_files(targets, {\"host\": \"example.com\"})\n+\n+    assert ok is False"},{"sha":"575b87e11c1fe195ebea72ecd8f688aff470ccdd","filename":"on-premise/datasaur-cli/tests/action/run_workflow/builtin_action/switch_input/test_switch_input_builtin_action.py","status":"added","additions":74,"deletions":0,"changes":74,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fswitch_input%2Ftest_switch_input_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fswitch_input%2Ftest_switch_input_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Fswitch_input%2Ftest_switch_input_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,74 @@\n+from unittest.mock import patch\n+\n+from src.action.run_workflow.builtin_action.builtin_action import BuiltInActionResultAction\n+from src.action.run_workflow.builtin_action.switch_input.switch_input_builtin_action import (\n+    SwitchInputBuiltInAction,\n+)\n+\n+\n+def test_name():\n+    assert SwitchInputBuiltInAction().name() == \"switch-input\"\n+\n+\n+def test_validate_returns_false_for_invalid_manifest():\n+    assert SwitchInputBuiltInAction().validate({\"name\": \"switch\"}) is False\n+\n+\n+def test_validate_returns_true_for_valid_manifest():\n+    manifest = {\"name\": \"switch\", \"cases\": [{\"name\": \"A\", \"action\": \"step-a\"}]}\n+\n+    assert SwitchInputBuiltInAction().validate(manifest) is True\n+\n+\n+@patch(\n+    \"src.action.run_workflow.builtin_action.switch_input.switch_input_builtin_action.click.prompt\",\n+    return_value=1,\n+)\n+def test_run_goto_selected_case(mock_prompt):\n+    manifest = {\n+        \"name\": \"switch\",\n+        \"title\": \"Pick one\",\n+        \"cases\": [{\"name\": \"A\", \"action\": \"step-a\"}, {\"name\": \"B\", \"action\": \"step-b\"}],\n+    }\n+\n+    result = SwitchInputBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.GOTO\n+    assert result.content == \"step-a\"\n+\n+\n+@patch(\n+    \"src.action.run_workflow.builtin_action.switch_input.switch_input_builtin_action.click.prompt\",\n+    return_value=0,\n+)\n+def test_run_exits_when_choice_zero_and_allow_exit(mock_prompt):\n+    manifest = {\n+        \"name\": \"switch\",\n+        \"title\": \"Pick one\",\n+        \"cases\": [{\"name\": \"A\", \"action\": \"step-a\"}],\n+    }\n+\n+    result = SwitchInputBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.EXIT\n+\n+\n+@patch(\n+    \"src.action.run_workflow.builtin_action.switch_input.switch_input_builtin_action.click.prompt\",\n+    return_value=1,\n+)\n+def test_run_does_not_offer_back_option_when_allow_exit_false(mock_prompt, capsys):\n+    manifest = {\n+        \"name\": \"switch\",\n+        \"title\": \"Pick one\",\n+        \"cases\": [{\"name\": \"A\", \"action\": \"step-a\"}],\n+        \"allow_exit\": False,\n+    }\n+\n+    result = SwitchInputBuiltInAction().run({}, manifest)\n+\n+    assert result.action == BuiltInActionResultAction.GOTO\n+    captured = capsys.readouterr()\n+    assert \"[0] Back\" not in captured.out\n+    call_kwargs = mock_prompt.call_args.kwargs\n+    assert call_kwargs[\"type\"].min == 1"},{"sha":"86b253018e60eb6535a1841914e54c34790efc43","filename":"on-premise/datasaur-cli/tests/action/run_workflow/builtin_action/test_builtin_action.py","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Ftest_builtin_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Ftest_builtin_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Fbuiltin_action%2Ftest_builtin_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,63 @@\n+import pytest\n+\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInAction,\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+\n+\n+def test_builtin_action_cannot_be_instantiated_directly():\n+    with pytest.raises(TypeError):\n+        BuiltInAction()\n+\n+\n+def test_concrete_subclass_implementing_all_methods_can_be_instantiated():\n+    class ConcreteBuiltInAction(BuiltInAction):\n+        def name(self):\n+            return \"concrete\"\n+\n+        def validate(self, manifest):\n+            return True\n+\n+        def run(self, context, manifest):\n+            return BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+\n+    action = ConcreteBuiltInAction()\n+\n+    assert action.name() == \"concrete\"\n+    assert action.validate({}) is True\n+    result = action.run({}, {})\n+    assert result.action == BuiltInActionResultAction.DONE\n+\n+\n+def test_subclass_missing_a_method_cannot_be_instantiated():\n+    class IncompleteBuiltInAction(BuiltInAction):\n+        def name(self):\n+            return \"incomplete\"\n+\n+        def validate(self, manifest):\n+            return True\n+\n+        # run() intentionally not implemented\n+\n+    with pytest.raises(TypeError):\n+        IncompleteBuiltInAction()\n+\n+\n+def test_builtin_action_result_defaults_content_to_none():\n+    result = BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+\n+    assert result.content is None\n+\n+\n+def test_builtin_action_result_accepts_explicit_content():\n+    result = BuiltInActionResult(action=BuiltInActionResultAction.GOTO, content=\"next-step\")\n+\n+    assert result.content == \"next-step\"\n+\n+\n+def test_builtin_action_result_action_enum_has_expected_members():\n+    assert BuiltInActionResultAction.DONE.value == \"DONE\"\n+    assert BuiltInActionResultAction.EXIT.value == \"EXIT\"\n+    assert BuiltInActionResultAction.GOTO.value == \"GOTO\""},{"sha":"de9ae3b556d2ffbd6e53adffbb86c461b8a2dcdd","filename":"on-premise/datasaur-cli/tests/action/run_workflow/test_run_workflow_action.py","status":"added","additions":195,"deletions":0,"changes":195,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Ftest_run_workflow_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Ftest_run_workflow_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Frun_workflow%2Ftest_run_workflow_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,195 @@\n+from unittest.mock import MagicMock\n+\n+from src.action.run_workflow.builtin_action.builtin_action import (\n+    BuiltInActionResult,\n+    BuiltInActionResultAction,\n+)\n+from src.action.run_workflow.run_workflow_action import RunWorkflowAction\n+\n+\n+def _fake_builtin_action(run_result=None):\n+    action = MagicMock()\n+    action.validate.return_value = True\n+    if run_result is not None:\n+        action.run.return_value = run_result\n+    return action\n+\n+\n+VALID_ARGS = {\n+    \"workflow\": [\"step1\"],\n+    \"actions\": [{\"name\": \"step1\", \"action\": \"set-environment-variables\", \"title\": \"Step 1\"}],\n+}\n+\n+\n+# --- validate() ---\n+\n+\n+def test_name():\n+    assert RunWorkflowAction().name() == \"run-workflow\"\n+\n+\n+def test_options_returns_action_option():\n+    assert RunWorkflowAction().options() == {\"action\": {\"short\": \"a\", \"type\": \"string\"}}\n+\n+\n+def test_validate_returns_false_for_invalid_model():\n+    assert RunWorkflowAction().validate({}) is False\n+\n+\n+def test_validate_returns_false_for_unknown_builtin_action():\n+    args = {\n+        \"workflow\": [],\n+        \"actions\": [{\"name\": \"step1\", \"action\": \"no-such-builtin\", \"title\": \"Step 1\"}],\n+    }\n+\n+    assert RunWorkflowAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_for_unknown_switch_case_action():\n+    args = {\n+        \"workflow\": [],\n+        \"actions\": [\n+            {\n+                \"name\": \"switch\",\n+                \"action\": \"switch-input\",\n+                \"title\": \"Switch\",\n+                \"cases\": [{\"name\": \"A\", \"action\": \"missing-step\"}],\n+            }\n+        ],\n+    }\n+\n+    assert RunWorkflowAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_for_unknown_workflow_action_name():\n+    args = {\n+        \"workflow\": [\"missing-step\"],\n+        \"actions\": [{\"name\": \"step1\", \"action\": \"set-environment-variables\", \"title\": \"Step 1\"}],\n+    }\n+\n+    assert RunWorkflowAction().validate(args) is False\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    assert RunWorkflowAction().validate(dict(VALID_ARGS)) is True\n+\n+\n+# --- run() ---\n+\n+\n+def test_run_executes_single_flow_action_when_option_specified():\n+    action = RunWorkflowAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+    )\n+    context = {\"option_values\": {\"action\": \"step1\"}}\n+\n+    result = action.run(context, dict(VALID_ARGS))\n+\n+    assert result is True\n+\n+\n+def test_run_executes_workflow_in_order_and_stops_at_first_failure():\n+    action = RunWorkflowAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.EXIT)\n+    )\n+    args = {\n+        \"workflow\": [\"step1\", \"step2\"],\n+        \"actions\": [\n+            {\"name\": \"step1\", \"action\": \"set-environment-variables\", \"title\": \"Step 1\"},\n+            {\"name\": \"step2\", \"action\": \"set-environment-variables\", \"title\": \"Step 2\"},\n+        ],\n+    }\n+    context = {\"option_values\": {}}\n+\n+    result = action.run(context, args)\n+\n+    assert result is False\n+    action.builtin_actions[\"set-environment-variables\"].run.assert_called_once()\n+\n+\n+def test_run_workflow_all_steps_succeed():\n+    action = RunWorkflowAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+    )\n+    args = {\n+        \"workflow\": [\"step1\", \"step2\"],\n+        \"actions\": [\n+            {\"name\": \"step1\", \"action\": \"set-environment-variables\", \"title\": \"Step 1\"},\n+            {\"name\": \"step2\", \"action\": \"set-environment-variables\", \"title\": \"Step 2\"},\n+        ],\n+    }\n+    context = {\"option_values\": {}}\n+\n+    result = action.run(context, args)\n+\n+    assert result is True\n+    assert action.builtin_actions[\"set-environment-variables\"].run.call_count == 2\n+\n+\n+# --- _run_flow_action() ---\n+\n+\n+def test_run_flow_action_returns_false_when_flow_action_not_found():\n+    action = RunWorkflowAction()\n+    context = {\"flow_action_manifests\": {}, \"visited_flow_actions\": set()}\n+\n+    assert action._run_flow_action(context, \"missing\") is False\n+\n+\n+def test_run_flow_action_returns_false_when_builtin_action_not_registered():\n+    action = RunWorkflowAction()\n+    context = {\n+        \"flow_action_manifests\": {\"step1\": {\"action\": \"no-such-builtin\"}},\n+        \"visited_flow_actions\": set(),\n+    }\n+\n+    assert action._run_flow_action(context, \"step1\") is False\n+\n+\n+def test_run_flow_action_returns_false_on_infinite_loop():\n+    action = RunWorkflowAction()\n+    action.builtin_actions[\"set-environment-variables\"] = _fake_builtin_action()\n+    context = {\n+        \"flow_action_manifests\": {\"step1\": {\"action\": \"set-environment-variables\"}},\n+        \"visited_flow_actions\": {\"step1\"},\n+    }\n+\n+    assert action._run_flow_action(context, \"step1\") is False\n+\n+\n+def test_run_flow_action_returns_false_when_builtin_validate_fails():\n+    action = RunWorkflowAction()\n+    fake_action = _fake_builtin_action()\n+    fake_action.validate.return_value = False\n+    action.builtin_actions[\"set-environment-variables\"] = fake_action\n+    context = {\n+        \"flow_action_manifests\": {\"step1\": {\"action\": \"set-environment-variables\"}},\n+        \"visited_flow_actions\": set(),\n+    }\n+\n+    assert action._run_flow_action(context, \"step1\") is False\n+    fake_action.run.assert_not_called()\n+\n+\n+def test_run_flow_action_goto_recurses_to_target_action():\n+    action = RunWorkflowAction()\n+    switch_action = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.GOTO, content=\"step2\")\n+    )\n+    step2_action = _fake_builtin_action(\n+        run_result=BuiltInActionResult(action=BuiltInActionResultAction.DONE)\n+    )\n+    action.builtin_actions[\"switch-input\"] = switch_action\n+    action.builtin_actions[\"set-environment-variables\"] = step2_action\n+    context = {\n+        \"flow_action_manifests\": {\n+            \"step1\": {\"action\": \"switch-input\"},\n+            \"step2\": {\"action\": \"set-environment-variables\"},\n+        },\n+        \"visited_flow_actions\": set(),\n+    }\n+\n+    assert action._run_flow_action(context, \"step1\") is True"},{"sha":"ab535bb8b11504aefef7a7842252ccf519702215","filename":"on-premise/datasaur-cli/tests/action/start/test_create_docker_resources_action.py","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_create_docker_resources_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_create_docker_resources_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_create_docker_resources_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,5 @@\n+from src.action.start.create_docker_resources_action import CreateDockerResourcesAction\n+\n+\n+def test_name():\n+    assert CreateDockerResourcesAction().name() == \"create-docker-resources\""},{"sha":"1656ab1d1b00dc825b6723a7445876db1729c87b","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_compose_stop_services_action.py","status":"added","additions":157,"deletions":0,"changes":157,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_compose_stop_services_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_compose_stop_services_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_compose_stop_services_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,157 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_compose_stop_services_action import (\n+    DockerComposeStopServicesAction,\n+)\n+\n+BASE_CONDITION = {\"service\": \"svc\", \"env_var\": \"STOP_SVC\", \"stop_when\": \"true\"}\n+\n+\n+def test_name():\n+    assert DockerComposeStopServicesAction().name() == \"docker-compose-stop-services\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert DockerComposeStopServicesAction().options() == {}\n+\n+\n+def test_validate_returns_false_for_invalid_args():\n+    assert DockerComposeStopServicesAction().validate({}) is False\n+\n+\n+def test_validate_returns_false_when_condition_env_file_missing(tmp_path):\n+    args = {\n+        \"env_files\": [],\n+        \"conditions\": [dict(BASE_CONDITION, env_file=str(tmp_path / \"missing.env\"))],\n+    }\n+\n+    assert DockerComposeStopServicesAction().validate(args) is False\n+\n+\n+def test_validate_returns_true_for_valid_args(tmp_path):\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"FOO=bar\")\n+    args = {\n+        \"env_files\": [str(env_file)],\n+        \"conditions\": [BASE_CONDITION],\n+    }\n+\n+    assert DockerComposeStopServicesAction().validate(args) is True\n+\n+\n+def test_run_returns_true_immediately_when_no_conditions():\n+    result = DockerComposeStopServicesAction().run({}, {\"env_files\": [], \"conditions\": []})\n+\n+    assert result is True\n+\n+\n+def test_run_returns_false_when_env_file_missing(tmp_path):\n+    args = {\"env_files\": [str(tmp_path / \"missing.env\")], \"conditions\": [BASE_CONDITION]}\n+\n+    assert DockerComposeStopServicesAction().run({}, args) is False\n+\n+\n+@patch(\"src.action.start.docker_compose_stop_services_action.subprocess.run\")\n+def test_run_leaves_service_running_when_condition_not_met(mock_run, tmp_path):\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"STOP_SVC=false\")\n+    args = {\"env_files\": [str(env_file)], \"conditions\": [BASE_CONDITION]}\n+\n+    result = DockerComposeStopServicesAction().run({}, args)\n+\n+    assert result is True\n+    mock_run.assert_not_called()\n+\n+\n+@patch(\"src.action.start.docker_compose_stop_services_action.subprocess.run\")\n+def test_run_stops_service_when_condition_met(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"STOP_SVC=true\")\n+    args = {\"env_files\": [str(env_file)], \"conditions\": [BASE_CONDITION]}\n+\n+    result = DockerComposeStopServicesAction().run({}, args)\n+\n+    assert result is True\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"compose\", \"--env-file\", str(env_file), \"stop\", \"svc\"]\n+\n+\n+@patch(\"src.action.start.docker_compose_stop_services_action.subprocess.run\")\n+def test_run_uses_condition_specific_env_file_override(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+    main_env_file = tmp_path / \"a.env\"\n+    main_env_file.write_text(\"STOP_SVC=false\")\n+    condition_env_file = tmp_path / \"b.env\"\n+    condition_env_file.write_text(\"STOP_SVC=true\")\n+    args = {\n+        \"env_files\": [str(main_env_file)],\n+        \"conditions\": [dict(BASE_CONDITION, env_file=str(condition_env_file))],\n+    }\n+\n+    result = DockerComposeStopServicesAction().run({}, args)\n+\n+    assert result is True\n+    called_command = mock_run.call_args.args[0]\n+    assert \"svc\" in called_command\n+\n+\n+def test_run_returns_false_when_condition_env_file_missing(tmp_path):\n+    main_env_file = tmp_path / \"a.env\"\n+    main_env_file.write_text(\"STOP_SVC=true\")\n+    args = {\n+        \"env_files\": [str(main_env_file)],\n+        \"conditions\": [dict(BASE_CONDITION, env_file=str(tmp_path / \"missing.env\"))],\n+    }\n+\n+    assert DockerComposeStopServicesAction().run({}, args) is False\n+\n+\n+@patch(\"src.action.start.docker_compose_stop_services_action.subprocess.run\")\n+def test_run_returns_false_when_stop_command_fails(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"boom\")\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"STOP_SVC=true\")\n+    args = {\"env_files\": [str(env_file)], \"conditions\": [BASE_CONDITION]}\n+\n+    assert DockerComposeStopServicesAction().run({}, args) is False\n+\n+\n+@patch(\"src.action.start.docker_compose_stop_services_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, tmp_path, capsys):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Container svc  Stopped\\n\", stderr=\"\")\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"STOP_SVC=true\")\n+    args = {\"env_files\": [str(env_file)], \"conditions\": [BASE_CONDITION]}\n+\n+    DockerComposeStopServicesAction().run({}, args)\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Successfully stopped services: svc\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.start.docker_compose_stop_services_action.subprocess.run\")\n+def test_run_logs_output_before_failure_verdict(mock_run, tmp_path, capsys):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"some partial output\\n\", stderr=\"boom\")\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"STOP_SVC=true\")\n+    args = {\"env_files\": [str(env_file)], \"conditions\": [BASE_CONDITION]}\n+\n+    DockerComposeStopServicesAction().run({}, args)\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✗ Failed to stop services\")\n+    assert \"\\n\\n✗\" not in out\n+\n+\n+@patch(\n+    \"src.action.start.docker_compose_stop_services_action.subprocess.run\",\n+    side_effect=OSError(\"boom\"),\n+)\n+def test_run_returns_false_on_exception(mock_run, tmp_path):\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"STOP_SVC=true\")\n+    args = {\"env_files\": [str(env_file)], \"conditions\": [BASE_CONDITION]}\n+\n+    assert DockerComposeStopServicesAction().run({}, args) is False"},{"sha":"9dc948d5fa2855c0d3d8abb8fc1f1e8957b308ee","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_compose_up_action.py","status":"added","additions":94,"deletions":0,"changes":94,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_compose_up_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_compose_up_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_compose_up_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,94 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_compose_up_action import DockerComposeUpAction\n+\n+\n+def test_name():\n+    assert DockerComposeUpAction().name() == \"docker-compose-up\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert DockerComposeUpAction().options() == {}\n+\n+\n+def test_validate_returns_false_for_invalid_args():\n+    assert DockerComposeUpAction().validate({}) is False\n+\n+\n+def test_validate_returns_false_when_docker_compose_file_missing(tmp_path):\n+    args = {\"env_files\": [], \"docker_compose_file\": str(tmp_path / \"missing.yaml\")}\n+\n+    assert DockerComposeUpAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_when_env_file_missing(tmp_path):\n+    args = {\"env_files\": [str(tmp_path / \"missing.env\")]}\n+\n+    assert DockerComposeUpAction().validate(args) is False\n+\n+\n+def test_validate_returns_true_when_all_files_present(tmp_path):\n+    compose_file = tmp_path / \"docker-compose.yaml\"\n+    compose_file.write_text(\"services: {}\")\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"FOO=bar\")\n+    args = {\"env_files\": [str(env_file)], \"docker_compose_file\": str(compose_file)}\n+\n+    assert DockerComposeUpAction().validate(args) is True\n+\n+\n+@patch(\"src.action.start.docker_compose_up_action.subprocess.run\")\n+def test_run_returns_true_on_success(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+    context = {}\n+\n+    result = DockerComposeUpAction().run(context, {\"env_files\": [\"a.env\"]})\n+\n+    assert result is True\n+    assert context[\"action_name\"] == \"docker-compose-up\"\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"compose\", \"--env-file\", \"a.env\", \"up\", \"-d\"]\n+\n+\n+@patch(\"src.action.start.docker_compose_up_action.subprocess.run\")\n+def test_run_returns_false_when_command_fails(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"boom\")\n+\n+    assert DockerComposeUpAction().run({}, {\"env_files\": []}) is False\n+\n+\n+@patch(\"src.action.start.docker_compose_up_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, capsys):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Container app  Started\\n\", stderr=\"\")\n+\n+    DockerComposeUpAction().run({}, {\"env_files\": []})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Docker compose started successfully\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.start.docker_compose_up_action.subprocess.run\")\n+def test_run_logs_output_before_failure_verdict(mock_run, capsys):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"some partial output\\n\", stderr=\"boom\")\n+\n+    DockerComposeUpAction().run({}, {\"env_files\": []})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✗ Failed to run docker compose\")\n+    assert \"\\n\\n✗\" not in out\n+\n+\n+@patch(\"src.action.start.docker_compose_up_action.subprocess.run\", side_effect=OSError(\"boom\"))\n+def test_run_returns_false_on_exception(mock_run):\n+    assert DockerComposeUpAction().run({}, {\"env_files\": []}) is False\n+\n+\n+@patch(\"src.action.start.docker_compose_up_action.subprocess.run\")\n+def test_run_includes_docker_compose_file_flag_when_given(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    DockerComposeUpAction().run({}, {\"env_files\": [], \"docker_compose_file\": \"custom.yaml\"})\n+\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"compose\", \"-f\", \"custom.yaml\", \"up\", \"-d\"]"},{"sha":"904ce2aac05da0c92f391a76af11e5df7850d7a5","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_login_action.py","status":"added","additions":130,"deletions":0,"changes":130,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_login_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_login_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_login_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,130 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_login_action import DockerLoginAction\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"env_file\": str(tmp_path / \".env\"),\n+        \"username_var\": \"REGISTRY_USERNAME\",\n+        \"password_var\": \"REGISTRY_PASSWORD\",\n+        \"domain_var\": \"REGISTRY_DOMAIN\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert DockerLoginAction().name() == \"docker-login\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert DockerLoginAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert DockerLoginAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_env_file_missing(tmp_path):\n+    result = DockerLoginAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_a_required_value_is_blank(tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\nREGISTRY_DOMAIN=\\n\"\n+    )\n+\n+    result = DockerLoginAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_login_action.subprocess.run\")\n+def test_run_logs_in_with_password_via_stdin(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\nREGISTRY_DOMAIN=registry.app-server.com\\n\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Login Succeeded\\n\", stderr=\"\")\n+\n+    result = DockerLoginAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    login_call = mock_run.call_args\n+    assert login_call.args[0] == [\n+        \"docker\", \"login\", \"-u\", \"registry\", \"--password-stdin\", \"registry.app-server.com\",\n+    ]\n+    assert login_call.kwargs[\"input\"] == \"secret\"\n+\n+\n+@patch(\"src.action.start.docker_login_action.subprocess.run\")\n+def test_run_uses_a_different_env_file_and_var_names(mock_run, tmp_path):\n+    (tmp_path / \"other.env\").write_text(\n+        \"OTHER_USERNAME=other-user\\nOTHER_PASSWORD=other-secret\\nOTHER_DOMAIN=other.app-server.com\\n\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Login Succeeded\\n\", stderr=\"\")\n+\n+    result = DockerLoginAction().run(\n+        {},\n+        {\n+            \"env_file\": str(tmp_path / \"other.env\"),\n+            \"username_var\": \"OTHER_USERNAME\",\n+            \"password_var\": \"OTHER_PASSWORD\",\n+            \"domain_var\": \"OTHER_DOMAIN\",\n+        },\n+    )\n+\n+    assert result is True\n+    login_call = mock_run.call_args\n+    assert login_call.args[0] == [\n+        \"docker\", \"login\", \"-u\", \"other-user\", \"--password-stdin\", \"other.app-server.com\",\n+    ]\n+    assert login_call.kwargs[\"input\"] == \"other-secret\"\n+\n+\n+@patch(\"src.action.start.docker_login_action.time.sleep\")\n+@patch(\"src.action.start.docker_login_action.subprocess.run\")\n+def test_run_returns_false_when_login_fails_after_all_retries(mock_run, mock_sleep, tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=wrong\\nREGISTRY_DOMAIN=registry.app-server.com\\n\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"unauthorized\")\n+\n+    result = DockerLoginAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+    assert mock_run.call_count == 5\n+    assert mock_sleep.call_count == 4\n+\n+\n+@patch(\"src.action.start.docker_login_action.time.sleep\")\n+@patch(\"src.action.start.docker_login_action.subprocess.run\")\n+def test_run_retries_and_succeeds_after_a_transient_failure(mock_run, mock_sleep, tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\nREGISTRY_DOMAIN=registry.app-server.com\\n\"\n+    )\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"dial tcp: connection refused\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"dial tcp: connection refused\"),\n+        MagicMock(returncode=0, stdout=\"Login Succeeded\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerLoginAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert mock_run.call_count == 3\n+    assert mock_sleep.call_count == 2\n+\n+\n+@patch(\"src.action.start.docker_login_action.subprocess.run\")\n+def test_run_returns_false_when_subprocess_raises(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\nREGISTRY_DOMAIN=registry.app-server.com\\n\"\n+    )\n+    mock_run.side_effect = FileNotFoundError(\"docker: command not found\")\n+\n+    result = DockerLoginAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"069fa2ce6dd43919a82855a77b4cef9d8e87a2e8","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_logout_action.py","status":"added","additions":83,"deletions":0,"changes":83,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_logout_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_logout_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_logout_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,83 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_logout_action import DockerLogoutAction\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"env_file\": str(tmp_path / \".env\"),\n+        \"domain_var\": \"REGISTRY_DOMAIN\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert DockerLogoutAction().name() == \"docker-logout\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert DockerLogoutAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert DockerLogoutAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_env_file_missing(tmp_path):\n+    result = DockerLogoutAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_domain_blank(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=\\n\")\n+\n+    result = DockerLogoutAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_logout_action.subprocess.run\")\n+def test_run_logs_out_of_the_registry(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Removing login credentials for registry.app-server.com\\n\", stderr=\"\")\n+\n+    result = DockerLogoutAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"logout\", \"registry.app-server.com\"], capture_output=True, text=True\n+    )\n+\n+\n+@patch(\"src.action.start.docker_logout_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, tmp_path, capsys):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Removing login credentials for registry.app-server.com\\n\", stderr=\"\")\n+\n+    DockerLogoutAction().run({}, make_args(tmp_path))\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Logged out of registry 'registry.app-server.com'\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.start.docker_logout_action.subprocess.run\")\n+def test_run_returns_false_when_logout_fails(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"unknown error\")\n+\n+    result = DockerLogoutAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_logout_action.subprocess.run\")\n+def test_run_returns_false_when_subprocess_raises(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    mock_run.side_effect = FileNotFoundError(\"docker: command not found\")\n+\n+    result = DockerLogoutAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"93d36775efcddac8436cfa03b9c14721a402ae3b","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_stack_deploy_action.py","status":"added","additions":427,"deletions":0,"changes":427,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_deploy_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_deploy_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_deploy_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,427 @@\n+import os\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_stack_deploy_action import DockerStackDeployAction\n+\n+\n+def test_name():\n+    assert DockerStackDeployAction().name() == \"docker-stack-deploy\"\n+\n+\n+def test_validate_fails_when_stack_yaml_missing(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    result = DockerStackDeployAction().validate({\"stack\": \"proxy\"})\n+    assert result is False\n+\n+\n+def test_validate_fails_when_stack_arg_missing():\n+    result = DockerStackDeployAction().validate({})\n+    assert result is False\n+\n+\n+def test_validate_succeeds_when_stack_yaml_present(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    result = DockerStackDeployAction().validate({\"stack\": \"proxy\"})\n+\n+    assert result is True\n+\n+\n+@patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\")\n+def test_run_deploys_stack(mock_run, tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Creating service proxy_traefik\\n\", stderr=\"\")\n+\n+    result = DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    called_args, called_kwargs = mock_run.call_args\n+    assert called_args[0] == [\n+        \"docker\", \"stack\", \"deploy\", \"--with-registry-auth\", \"-c\", os.path.join(\"proxy\", \"stack.yaml\"), \"proxy\",\n+    ]\n+    assert called_kwargs[\"capture_output\"] is True\n+\n+\n+@patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\")\n+def test_run_merges_stack_env_file_into_subprocess_env(mock_run, tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"proxy\" / \".env\").write_text(\"TRAEFIK_VERSION=v3.1.2\\n\")\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    called_env = mock_run.call_args.kwargs[\"env\"]\n+    assert called_env[\"TRAEFIK_VERSION\"] == \"v3.1.2\"\n+\n+\n+@patch(\"src.action.start.docker_stack_deploy_action.time.sleep\")\n+@patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\")\n+def test_run_returns_false_on_deploy_failure_after_all_retries(mock_run, mock_sleep, tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"network proxy not found\")\n+\n+    result = DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is False\n+    assert mock_run.call_count == 5\n+    assert mock_sleep.call_count == 4\n+\n+\n+@patch(\"src.action.start.docker_stack_deploy_action.time.sleep\")\n+@patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\")\n+def test_run_fails_immediately_on_non_transient_error(mock_run, mock_sleep, tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"invalid compose file\")\n+\n+    result = DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is False\n+    assert mock_run.call_count == 1\n+    assert mock_sleep.call_count == 0\n+\n+\n+@patch(\"src.action.start.docker_stack_deploy_action.time.sleep\")\n+@patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\")\n+def test_run_retries_and_succeeds_after_a_transient_failure(mock_run, mock_sleep, tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"network proxy not found\"),\n+        MagicMock(returncode=0, stdout=\"Creating service proxy_traefik\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+    assert mock_sleep.call_count == 1\n+\n+\n+@patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, tmp_path, monkeypatch, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Creating service proxy_traefik\\n\", stderr=\"\")\n+\n+    DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Stack 'proxy' deployed successfully\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+def test_run_resolves_dollar_reference_against_root_env(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\nREGISTRY_DOMAIN=$REGISTRY_DOMAIN\\n\")\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+        DockerStackDeployAction().run({}, {\"stack\": \"registry\"})\n+\n+    called_env = mock_run.call_args.kwargs[\"env\"]\n+    assert called_env[\"REGISTRY_DOMAIN\"] == \"registry.app-server.com\"\n+    assert called_env[\"REGISTRY_VERSION\"] == \"2.8.3\"\n+\n+\n+def test_run_fails_loudly_when_referenced_var_missing_from_root_env(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"hello\").mkdir()\n+    (tmp_path / \"hello\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"hello\" / \".env\").write_text(\"ALPINE_VERSION=3.20\\nREGISTRY_DOMAIN=$REGISTRY_DOMAIN\\n\")\n+    (tmp_path / \".env\").write_text(\"SOMETHING_ELSE=1\\n\")\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        result = DockerStackDeployAction().run({}, {\"stack\": \"hello\"})\n+\n+    assert result is False\n+    mock_run.assert_not_called()\n+\n+\n+def test_run_leaves_non_dollar_values_as_literals(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"proxy\" / \".env\").write_text(\"TRAEFIK_VERSION=v3.1.2\\n\")\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+        result = DockerStackDeployAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    called_env = mock_run.call_args.kwargs[\"env\"]\n+    assert called_env[\"TRAEFIK_VERSION\"] == \"v3.1.2\"\n+\n+\n+def test_run_unescapes_double_dollar_literal_starting_with_dollar(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_PASSWORD=$$w0rdpass\\n\")\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+        result = DockerStackDeployAction().run({}, {\"stack\": \"registry\"})\n+\n+    assert result is True\n+    called_env = mock_run.call_args.kwargs[\"env\"]\n+    assert called_env[\"REGISTRY_PASSWORD\"] == \"$w0rdpass\"\n+\n+\n+def _write_manifest_with_stack_hooks(tmp_path, stack_hooks_yaml):\n+    (tmp_path / \"manifest.yaml\").write_text(\n+        \"version: \\\"1.0.0\\\"\\n\" + stack_hooks_yaml\n+    )\n+\n+\n+def test_run_executes_pre_deploy_hook_actions_before_docker_stack_deploy(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    pre_deploy:\\n\"\n+        \"      - action: generate-htpasswd-docker-secret\\n\"\n+        \"        args:\\n\"\n+        \"          source_env_file: .env\\n\",\n+    )\n+\n+    call_order = []\n+    fake_actions_service = MagicMock()\n+\n+    def fake_run(context, actions):\n+        call_order.append((\"hook\", actions))\n+        return True\n+\n+    fake_actions_service.run.side_effect = fake_run\n+\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    def fake_subprocess_run(*args, **kwargs):\n+        call_order.append((\"deploy\", None))\n+        return MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\", side_effect=fake_subprocess_run):\n+        result = action.run({}, {\"stack\": \"registry\"})\n+\n+    assert result is True\n+    assert [kind for kind, _ in call_order] == [\"hook\", \"deploy\"]\n+    assert call_order[0][1] == [\n+        {\"action\": \"generate-htpasswd-docker-secret\", \"args\": {\"source_env_file\": \".env\"}}\n+    ]\n+\n+\n+def test_run_executes_post_deploy_hook_actions_after_successful_deploy(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    post_deploy:\\n\"\n+        \"      - action: prune-stale-docker-secrets\\n\"\n+        \"        args:\\n\"\n+        \"          secret_name_prefix: registry_htpasswd\\n\"\n+        \"          service_name: registry_registry\\n\",\n+    )\n+\n+    call_order = []\n+    fake_actions_service = MagicMock()\n+\n+    def fake_run(context, actions):\n+        call_order.append((\"hook\", actions))\n+        return True\n+\n+    fake_actions_service.run.side_effect = fake_run\n+\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    def fake_subprocess_run(*args, **kwargs):\n+        call_order.append((\"deploy\", None))\n+        return MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\", side_effect=fake_subprocess_run):\n+        result = action.run({}, {\"stack\": \"registry\"})\n+\n+    assert result is True\n+    assert [kind for kind, _ in call_order] == [\"deploy\", \"hook\"]\n+    assert call_order[1][1] == [\n+        {\n+            \"action\": \"prune-stale-docker-secrets\",\n+            \"args\": {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry_registry\"},\n+        }\n+    ]\n+\n+\n+def test_run_skips_post_deploy_hook_actions_when_deploy_fails_non_transiently(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    pre_deploy:\\n\"\n+        \"      - action: generate-htpasswd-docker-secret\\n\"\n+        \"        args: {}\\n\"\n+        \"    post_deploy:\\n\"\n+        \"      - action: prune-stale-docker-secrets\\n\"\n+        \"        args: {}\\n\",\n+    )\n+\n+    fake_actions_service = MagicMock()\n+    fake_actions_service.run.return_value = True\n+\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"invalid compose file\")\n+        result = action.run({}, {\"stack\": \"registry\"})\n+\n+    assert result is False\n+    # pre_deploy ran once (before the failed deploy attempt); post_deploy never ran.\n+    assert fake_actions_service.run.call_count == 1\n+    assert fake_actions_service.run.call_args.args[1][0][\"action\"] == \"generate-htpasswd-docker-secret\"\n+\n+\n+def test_run_returns_false_and_skips_deploy_when_pre_deploy_hook_fails(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    pre_deploy:\\n\"\n+        \"      - action: generate-htpasswd-docker-secret\\n\"\n+        \"        args: {}\\n\",\n+    )\n+\n+    fake_actions_service = MagicMock()\n+    fake_actions_service.run.return_value = False\n+\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        result = action.run({}, {\"stack\": \"registry\"})\n+\n+    assert result is False\n+    mock_run.assert_not_called()\n+\n+\n+def test_run_reports_error_when_hooks_declared_but_actions_service_not_configured(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    pre_deploy:\\n\"\n+        \"      - action: generate-htpasswd-docker-secret\\n\"\n+        \"        args: {}\\n\",\n+    )\n+\n+    action = DockerStackDeployAction()  # actions_service left as the __init__ default (None)\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        result = action.run({}, {\"stack\": \"registry\"})\n+\n+    assert result is False\n+    mock_run.assert_not_called()\n+\n+\n+def test_run_hook_action_missing_args_key_defaults_to_empty_dict(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    pre_deploy:\\n\"\n+        \"      - action: some-action-with-no-args\\n\",\n+    )\n+\n+    fake_actions_service = MagicMock()\n+    fake_actions_service.run.return_value = True\n+\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+        action.run({}, {\"stack\": \"registry\"})\n+\n+    fake_actions_service.run.assert_called_once_with(\n+        {\"action_name\": \"docker-stack-deploy\"},\n+        [{\"action\": \"some-action-with-no-args\", \"args\": {}}],\n+    )\n+\n+\n+def test_run_stack_with_no_stack_hooks_entry_never_calls_actions_service(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    for name in [\"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    # stack_hooks exists in the manifest, but only for \"registry\" — \"proxy\" must not\n+    # pick up \"registry\"'s hooks, and must not trigger any actions_service call.\n+    _write_manifest_with_stack_hooks(\n+        tmp_path,\n+        \"stack_hooks:\\n\"\n+        \"  registry:\\n\"\n+        \"    pre_deploy:\\n\"\n+        \"      - action: generate-htpasswd-docker-secret\\n\"\n+        \"        args: {}\\n\",\n+    )\n+\n+    fake_actions_service = MagicMock()\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+        result = action.run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    fake_actions_service.run.assert_not_called()\n+\n+\n+def test_run_with_no_manifest_file_at_all_never_calls_actions_service(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    # No manifest.yaml written at all — must behave exactly like every pre-existing\n+    # test in this file, none of which ship a manifest.yaml fixture either.\n+\n+    fake_actions_service = MagicMock()\n+    action = DockerStackDeployAction()\n+    action.actions_service = fake_actions_service\n+\n+    with patch(\"src.action.start.docker_stack_deploy_action.subprocess.run\") as mock_run:\n+        mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+        result = action.run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    fake_actions_service.run.assert_not_called()"},{"sha":"2ea21a7410817685bd2db94a12aeac7c774e5c55","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_stack_dump_logs_action.py","status":"added","additions":81,"deletions":0,"changes":81,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_dump_logs_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_dump_logs_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_dump_logs_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,81 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_stack_dump_logs_action import DockerStackDumpLogsAction\n+\n+\n+def test_name():\n+    assert DockerStackDumpLogsAction().name() == \"docker-stack-dump-logs\"\n+\n+\n+def test_validate_fails_when_stack_arg_missing():\n+    assert DockerStackDumpLogsAction().validate({}) is False\n+\n+\n+@patch(\"src.action.start.docker_stack_dump_logs_action.subprocess.run\")\n+def test_run_dumps_logs_for_each_service(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"proxy_traefik\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"log line 1\\nlog line 2\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerStackDumpLogsAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    assert mock_run.call_args_list[0].args[0] == [\n+        \"docker\", \"stack\", \"services\", \"--format\", \"{{.Name}}\", \"proxy\",\n+    ]\n+    assert mock_run.call_args_list[1].args[0] == [\"docker\", \"service\", \"logs\", \"proxy_traefik\"]\n+\n+\n+@patch(\"src.action.start.docker_stack_dump_logs_action.subprocess.run\")\n+def test_run_does_not_leave_a_blank_line_between_services(mock_run, capsys):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"svc1\\nsvc2\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"log line 1\\nlog line 2\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"log line A\\n\", stderr=\"\"),\n+    ]\n+\n+    DockerStackDumpLogsAction().run({}, {\"stack\": \"proxy\"})\n+\n+    out = capsys.readouterr().out\n+    assert \"\\n\\n--- logs: svc2 ---\" not in out\n+\n+\n+@patch(\"src.action.start.docker_stack_dump_logs_action.subprocess.run\")\n+def test_run_handles_stack_with_no_services(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    result = DockerStackDumpLogsAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    assert mock_run.call_count == 1\n+\n+\n+@patch(\"src.action.start.docker_stack_dump_logs_action.subprocess.run\")\n+def test_run_returns_false_when_listing_services_fails(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"no such stack: proxy\")\n+\n+    result = DockerStackDumpLogsAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_stack_dump_logs_action.subprocess.run\")\n+def test_run_returns_false_when_a_service_log_fetch_fails(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"proxy_traefik\\n\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"service not found\"),\n+    ]\n+\n+    result = DockerStackDumpLogsAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_stack_dump_logs_action.subprocess.run\")\n+def test_run_returns_false_when_subprocess_raises_exception(mock_run):\n+    mock_run.side_effect = FileNotFoundError(\"docker: command not found\")\n+\n+    result = DockerStackDumpLogsAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is False"},{"sha":"97e7c087cf54ca66ea13563d3e7bddc6a0fcafb4","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_stack_rm_all_action.py","status":"added","additions":98,"deletions":0,"changes":98,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_rm_all_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_rm_all_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_stack_rm_all_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,98 @@\n+from unittest.mock import MagicMock\n+\n+from src.action.start.docker_stack_rm_all_action import DockerStackRmAllAction\n+\n+\n+def test_name():\n+    assert DockerStackRmAllAction().name() == \"docker-stack-rm-all\"\n+\n+\n+def test_run_fails_when_actions_service_not_configured(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+\n+    result = DockerStackRmAllAction().run({}, {})\n+\n+    assert result is False\n+\n+\n+def test_run_is_a_noop_success_when_no_stacks_discovered(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    action = DockerStackRmAllAction()\n+    action.actions_service = MagicMock()\n+\n+    result = action.run({}, {})\n+\n+    assert result is True\n+    action.actions_service.run.assert_not_called()\n+\n+\n+def test_run_removes_discovered_stacks_in_reverse_of_stack_order(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    for name in [\"hello\", \"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"manifest.yaml\").write_text(\n+        \"version: '1'\\nstack_order:\\n  - proxy\\n  - registry\\n  - hello\\ncommands: {}\\n\"\n+    )\n+\n+    action = DockerStackRmAllAction()\n+    action.actions_service = MagicMock()\n+    action.actions_service.run.return_value = True\n+\n+    result = action.run({}, {})\n+\n+    assert result is True\n+    removed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in action.actions_service.run.call_args_list]\n+    assert removed_stacks == [\"hello\", \"registry\", \"proxy\"]\n+\n+\n+def test_run_appends_a_stack_not_in_stack_order(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    for name in [\"proxy\", \"new-stack\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"manifest.yaml\").write_text(\"version: '1'\\nstack_order:\\n  - proxy\\ncommands: {}\\n\")\n+\n+    action = DockerStackRmAllAction()\n+    action.actions_service = MagicMock()\n+    action.actions_service.run.return_value = True\n+\n+    action.run({}, {})\n+\n+    removed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in action.actions_service.run.call_args_list]\n+    # reversed([\"proxy\", \"new-stack\"]) — new-stack appended after proxy in up-order,\n+    # so it's removed first in down-order.\n+    assert removed_stacks == [\"new-stack\", \"proxy\"]\n+\n+\n+def test_run_falls_back_to_discovery_order_without_a_manifest(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    for name in [\"a\", \"b\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    # No manifest.yaml at all.\n+\n+    action = DockerStackRmAllAction()\n+    action.actions_service = MagicMock()\n+    action.actions_service.run.return_value = True\n+\n+    action.run({}, {})\n+\n+    removed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in action.actions_service.run.call_args_list]\n+    assert removed_stacks == [\"a\", \"b\"]\n+\n+\n+def test_run_stops_at_first_removal_failure(tmp_path, monkeypatch):\n+    monkeypatch.chdir(tmp_path)\n+    for name in [\"a\", \"b\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    action = DockerStackRmAllAction()\n+    action.actions_service = MagicMock()\n+    action.actions_service.run.side_effect = [False]\n+\n+    result = action.run({}, {})\n+\n+    assert result is False\n+    assert action.actions_service.run.call_count == 1"},{"sha":"4ecf2b1ddaf5e9a2d7a84071cd7146856fd3c671","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_swarm_init_action.py","status":"added","additions":99,"deletions":0,"changes":99,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_init_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_init_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_init_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,99 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_swarm_init_action import DockerSwarmInitAction\n+\n+\n+def test_name():\n+    assert DockerSwarmInitAction().name() == \"docker-swarm-init\"\n+\n+\n+@patch(\"src.action.start.docker_swarm_init_action.subprocess.run\")\n+def test_run_skips_when_already_swarm_member(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\")\n+\n+    result = DockerSwarmInitAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"info\", \"-f\", \"{{.Swarm.LocalNodeState}}\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.start.docker_swarm_init_action.subprocess.run\")\n+def test_run_initializes_swarm_when_not_a_member(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"Swarm initialized\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerSwarmInitAction().run({}, {})\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+    assert mock_run.call_args_list[1].args[0] == [\"docker\", \"swarm\", \"init\"]\n+\n+\n+@patch(\"src.action.start.docker_swarm_init_action.subprocess.run\")\n+def test_run_passes_advertise_addr_when_given(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"Swarm initialized\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerSwarmInitAction().run({}, {\"advertise_addr\": \"10.0.0.5\"})\n+\n+    assert result is True\n+    assert mock_run.call_args_list[1].args[0] == [\n+        \"docker\", \"swarm\", \"init\", \"--advertise-addr\", \"10.0.0.5\",\n+    ]\n+\n+\n+@patch(\"src.action.start.docker_swarm_init_action.subprocess.run\")\n+def test_run_returns_false_on_init_failure(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"connection refused\"),\n+    ]\n+\n+    result = DockerSwarmInitAction().run({}, {})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_swarm_init_action.subprocess.run\")\n+def test_run_handles_docker_not_found(mock_run):\n+    mock_run.side_effect = FileNotFoundError(\"docker: command not found\")\n+\n+    result = DockerSwarmInitAction().run({}, {})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_swarm_init_action.logger\")\n+@patch(\"src.action.start.docker_swarm_init_action.subprocess.run\")\n+def test_run_never_logs_the_raw_join_command(mock_run, mock_logger):\n+    # `docker swarm init`'s own stdout includes a raw `docker swarm join --token ...\n+    # <addr>` line — confusing this early (no workers yet) and in the wrong shape\n+    # for init-llm-server/init-ingestion-server's separate prompts. Only\n+    # print-docker-swarm-join-token should ever surface this token to the operator.\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(\n+            returncode=0,\n+            stdout=(\n+                \"Swarm initialized: current node (abc123) is now a manager.\\n\\n\"\n+                \"To add a worker to this swarm, run the following command:\\n\\n\"\n+                \"    docker swarm join --token SWMTKN-1-secrettoken 10.0.0.1:2377\\n\"\n+            ),\n+            stderr=\"\",\n+        ),\n+    ]\n+\n+    result = DockerSwarmInitAction().run({}, {})\n+\n+    assert result is True\n+    logged_text = \" \".join(str(call) for call in mock_logger.info.call_args_list)\n+    assert \"SWMTKN\" not in logged_text\n+    assert \"docker swarm join\" not in logged_text"},{"sha":"e05796d4f13d60e0d9af573351a5410d0524a840","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_swarm_join_action.py","status":"added","additions":103,"deletions":0,"changes":103,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_join_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_join_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_join_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,103 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_swarm_join_action import DockerSwarmJoinAction\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"env_file\": str(tmp_path / \".env\"),\n+        \"manager_address_var\": \"DOCKER_SWARM_MANAGER_ADDRESS\",\n+        \"worker_join_token_var\": \"DOCKER_SWARM_WORKER_JOIN_TOKEN\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert DockerSwarmJoinAction().name() == \"docker-swarm-join\"\n+\n+\n+@patch(\"src.action.start.docker_swarm_join_action.subprocess.run\")\n+def test_run_skips_when_already_swarm_member(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\")\n+\n+    result = DockerSwarmJoinAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"info\", \"-f\", \"{{.Swarm.LocalNodeState}}\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.start.docker_swarm_join_action.subprocess.run\")\n+def test_run_fails_when_env_file_missing(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\")\n+\n+    result = DockerSwarmJoinAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_swarm_join_action.subprocess.run\")\n+def test_run_fails_when_a_required_value_is_blank(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\")\n+    (tmp_path / \".env\").write_text(\n+        \"DOCKER_SWARM_MANAGER_ADDRESS=10.0.0.1:2377\\nDOCKER_SWARM_WORKER_JOIN_TOKEN=\\n\"\n+    )\n+\n+    result = DockerSwarmJoinAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_swarm_join_action.subprocess.run\")\n+def test_run_joins_swarm_when_not_a_member(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"DOCKER_SWARM_MANAGER_ADDRESS=10.0.0.1:2377\\nDOCKER_SWARM_WORKER_JOIN_TOKEN=SWMTKN-1-abc\\n\"\n+    )\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"This node joined a swarm as a worker.\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerSwarmJoinAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+    assert mock_run.call_args_list[1].args[0] == [\n+        \"docker\", \"swarm\", \"join\", \"--token\", \"SWMTKN-1-abc\", \"10.0.0.1:2377\",\n+    ]\n+\n+\n+@patch(\"src.action.start.docker_swarm_join_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, tmp_path, capsys):\n+    (tmp_path / \".env\").write_text(\n+        \"DOCKER_SWARM_MANAGER_ADDRESS=10.0.0.1:2377\\nDOCKER_SWARM_WORKER_JOIN_TOKEN=SWMTKN-1-abc\\n\"\n+    )\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"This node joined a swarm as a worker.\\n\", stderr=\"\"),\n+    ]\n+\n+    DockerSwarmJoinAction().run({}, make_args(tmp_path))\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Joined Docker Swarm successfully\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.start.docker_swarm_join_action.subprocess.run\")\n+def test_run_returns_false_on_join_failure(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\n+        \"DOCKER_SWARM_MANAGER_ADDRESS=10.0.0.1:2377\\nDOCKER_SWARM_WORKER_JOIN_TOKEN=SWMTKN-1-abc\\n\"\n+    )\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"connection refused\"),\n+    ]\n+\n+    result = DockerSwarmJoinAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"d1f1856b8fe3b515252ca0b297a94cb89aa409c2","filename":"on-premise/datasaur-cli/tests/action/start/test_docker_swarm_leave_action.py","status":"added","additions":98,"deletions":0,"changes":98,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_leave_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_leave_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_docker_swarm_leave_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,98 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.docker_swarm_leave_action import DockerSwarmLeaveAction\n+\n+\n+def test_name():\n+    assert DockerSwarmLeaveAction().name() == \"docker-swarm-leave\"\n+\n+\n+@patch(\"src.action.start.docker_swarm_leave_action.subprocess.run\")\n+def test_run_skips_when_not_a_swarm_member(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"inactive\\n\", stderr=\"\")\n+\n+    result = DockerSwarmLeaveAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"info\", \"-f\", \"{{.Swarm.LocalNodeState}}\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.start.docker_swarm_leave_action.subprocess.run\")\n+def test_run_leaves_swarm_when_a_member(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"false\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"Node left the swarm.\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerSwarmLeaveAction().run({}, {})\n+\n+    assert result is True\n+    assert mock_run.call_args_list[2].args[0] == [\"docker\", \"swarm\", \"leave\"]\n+\n+\n+@patch(\"src.action.start.docker_swarm_leave_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, capsys):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"false\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"Node left the swarm.\\n\", stderr=\"\"),\n+    ]\n+\n+    DockerSwarmLeaveAction().run({}, {})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Left Docker Swarm successfully\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.start.docker_swarm_leave_action.subprocess.run\")\n+def test_run_returns_false_on_leave_failure(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"false\\n\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"an unexpected error occurred\"),\n+    ]\n+\n+    result = DockerSwarmLeaveAction().run({}, {})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.docker_swarm_leave_action.subprocess.run\")\n+def test_run_refuses_to_leave_when_node_is_a_manager(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"true\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerSwarmLeaveAction().run({}, {})\n+\n+    assert result is False\n+    assert mock_run.call_count == 2\n+\n+\n+def test_validate_succeeds_with_no_args():\n+    assert DockerSwarmLeaveAction().validate({}) is True\n+\n+\n+def test_validate_succeeds_with_force_true():\n+    assert DockerSwarmLeaveAction().validate({\"force\": True}) is True\n+\n+\n+@patch(\"src.action.start.docker_swarm_leave_action.subprocess.run\")\n+def test_run_force_leaves_even_when_node_is_a_manager(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"active\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"true\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"Node left the swarm.\\n\", stderr=\"\"),\n+    ]\n+\n+    result = DockerSwarmLeaveAction().run({}, {\"force\": True})\n+\n+    assert result is True\n+    assert mock_run.call_args_list[2].args[0] == [\"docker\", \"swarm\", \"leave\", \"--force\"]"},{"sha":"9c9c6c9136d1abc67b1767b6ca6ad1597b0e454d","filename":"on-premise/datasaur-cli/tests/action/start/test_generate_htpasswd_docker_secret_action.py","status":"added","additions":153,"deletions":0,"changes":153,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_htpasswd_docker_secret_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_htpasswd_docker_secret_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_htpasswd_docker_secret_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,153 @@\n+import hashlib\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.generate_htpasswd_docker_secret_action import GenerateHtpasswdDockerSecretAction\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"source_env_file\": str(tmp_path / \".env\"),\n+        \"username_var\": \"REGISTRY_USERNAME\",\n+        \"password_var\": \"REGISTRY_PASSWORD\",\n+        \"secret_name_prefix\": \"registry_htpasswd\",\n+        \"target_env_file\": str(tmp_path / \"registry\" / \".env\"),\n+        \"secret_name_var\": \"REGISTRY_HTPASSWD_SECRET_NAME\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert GenerateHtpasswdDockerSecretAction().name() == \"generate-htpasswd-docker-secret\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert GenerateHtpasswdDockerSecretAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert GenerateHtpasswdDockerSecretAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_source_env_file_missing(tmp_path):\n+    result = GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_a_required_value_is_blank(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=\\n\")\n+\n+    result = GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_htpasswd_docker_secret_action.subprocess.run\")\n+def test_run_writes_secret_name_preserving_existing_target_env(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"no such secret\"),\n+        MagicMock(returncode=0, stdout=\"registry:$2y$05$abcdefghij\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    target_env = (tmp_path / \"registry\" / \".env\").read_text()\n+    assert 'REGISTRY_VERSION=\"2.8.3\"' in target_env\n+    assert 'REGISTRY_HTPASSWD_SECRET_NAME=\"registry_htpasswd_' in target_env\n+\n+\n+@patch(\"src.action.start.generate_htpasswd_docker_secret_action.subprocess.run\")\n+def test_run_computes_secret_name_from_username_password_hash(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"registry:$2y$05$abcdefghij\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    expected_hash = hashlib.sha256(b\"registry:secret\").hexdigest()[:8]\n+    target_env = (tmp_path / \"registry\" / \".env\").read_text()\n+    assert f'REGISTRY_HTPASSWD_SECRET_NAME=\"registry_htpasswd_{expected_hash}\"' in target_env\n+    inspect_call = mock_run.call_args_list[0]\n+    assert inspect_call.args[0] == [\"docker\", \"secret\", \"inspect\", f\"registry_htpasswd_{expected_hash}\"]\n+\n+\n+@patch(\"src.action.start.generate_htpasswd_docker_secret_action.subprocess.run\")\n+def test_run_skips_secret_creation_when_already_exists(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\n\")\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    result = GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert mock_run.call_count == 1\n+\n+\n+@patch(\"src.action.start.generate_htpasswd_docker_secret_action.subprocess.run\")\n+def test_run_pipes_htpasswd_output_into_secret_create_via_stdin_using_custom_image(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"registry:$2y$05$abcdefghij\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = GenerateHtpasswdDockerSecretAction().run(\n+        {}, make_args(tmp_path, htpasswd_image=\"custom/htpasswd:latest\")\n+    )\n+\n+    assert result is True\n+    htpasswd_call = mock_run.call_args_list[1]\n+    assert htpasswd_call.args[0] == [\n+        \"docker\", \"run\", \"--rm\", \"-i\", \"custom/htpasswd:latest\", \"htpasswd\", \"-nBi\", \"registry\",\n+    ]\n+    assert htpasswd_call.kwargs[\"input\"] == \"secret\"\n+    create_call = mock_run.call_args_list[2]\n+    assert create_call.args[0][:3] == [\"docker\", \"secret\", \"create\"]\n+    assert create_call.args[0][-1] == \"-\"\n+    assert create_call.kwargs[\"input\"] == \"registry:$2y$05$abcdefghij\\n\"\n+\n+\n+@patch(\"src.action.start.generate_htpasswd_docker_secret_action.subprocess.run\")\n+def test_run_returns_false_when_htpasswd_generation_fails(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"docker: command failed\"),\n+    ]\n+\n+    result = GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_htpasswd_docker_secret_action.subprocess.run\")\n+def test_run_returns_false_when_secret_create_fails(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_USERNAME=registry\\nREGISTRY_PASSWORD=secret\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \".env\").write_text(\"REGISTRY_VERSION=2.8.3\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"registry:$2y$05$abcdefghij\\n\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"permission denied\"),\n+    ]\n+\n+    result = GenerateHtpasswdDockerSecretAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"7db7a3bce5a6819bf0b5dd4ba6153497b6bd475d","filename":"on-premise/datasaur-cli/tests/action/start/test_generate_self_signed_ca_action.py","status":"added","additions":78,"deletions":0,"changes":78,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_self_signed_ca_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_self_signed_ca_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_self_signed_ca_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,78 @@\n+from pathlib import Path\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.generate_self_signed_ca_action import GenerateSelfSignedCaAction\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"ssl_dir\": str(tmp_path / \".ssl\"),\n+        \"cert_filename\": \"ca.crt\",\n+        \"key_filename\": \"ca.key\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert GenerateSelfSignedCaAction().name() == \"generate-self-signed-ca\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert GenerateSelfSignedCaAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert GenerateSelfSignedCaAction().validate(make_args(tmp_path)) is True\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ca_action.subprocess.run\")\n+def test_run_skips_when_cert_and_key_already_exist(mock_run, tmp_path):\n+    ssl_dir = tmp_path / \".ssl\"\n+    ssl_dir.mkdir()\n+    (ssl_dir / \"ca.crt\").write_text(\"existing ca cert\")\n+    (ssl_dir / \"ca.key\").write_text(\"existing ca key\")\n+\n+    result = GenerateSelfSignedCaAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_not_called()\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ca_action.subprocess.run\")\n+def test_run_generates_ca_with_fixed_subject(mock_run, tmp_path):\n+    def fake_openssl(command, **kwargs):\n+        key_path = Path(command[command.index(\"-keyout\") + 1])\n+        cert_path = Path(command[command.index(\"-out\") + 1])\n+        key_path.write_text(\"fake ca key\")\n+        cert_path.write_text(\"fake ca cert\")\n+        return MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    mock_run.side_effect = fake_openssl\n+\n+    result = GenerateSelfSignedCaAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert (tmp_path / \".ssl\" / \"ca.crt\").read_text() == \"fake ca cert\"\n+    assert (tmp_path / \".ssl\" / \"ca.key\").read_text() == \"fake ca key\"\n+    called_args = mock_run.call_args.args[0]\n+    assert called_args[:2] == [\"openssl\", \"req\"]\n+    assert called_args[called_args.index(\"-subj\") + 1] == \"/CN=WPS Self-Signed CA\"\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ca_action.subprocess.run\")\n+def test_run_returns_false_when_openssl_fails(mock_run, tmp_path):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"error generating key\")\n+\n+    result = GenerateSelfSignedCaAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ca_action.subprocess.run\")\n+def test_run_returns_false_when_subprocess_raises(mock_run, tmp_path):\n+    mock_run.side_effect = FileNotFoundError(\"openssl: command not found\")\n+\n+    result = GenerateSelfSignedCaAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"a1f26c8b74d153f588b7fe11da5a57bc25551f0f","filename":"on-premise/datasaur-cli/tests/action/start/test_generate_self_signed_ssl_certificate_action.py","status":"added","additions":187,"deletions":0,"changes":187,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_self_signed_ssl_certificate_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_self_signed_ssl_certificate_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_generate_self_signed_ssl_certificate_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,187 @@\n+from pathlib import Path\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.generate_self_signed_ssl_certificate_action import (\n+    GenerateSelfSignedSslCertificateAction,\n+)\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"env_file\": str(tmp_path / \".env\"),\n+        \"domain_var\": \"REGISTRY_DOMAIN\",\n+        \"ssl_dir\": str(tmp_path / \".ssl\"),\n+        \"cert_filename\": \"registry.crt\",\n+        \"key_filename\": \"registry.key\",\n+        \"ca_cert_filename\": \"ca.crt\",\n+        \"ca_key_filename\": \"ca.key\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def make_ca(tmp_path):\n+    ssl_dir = tmp_path / \".ssl\"\n+    ssl_dir.mkdir(parents=True, exist_ok=True)\n+    (ssl_dir / \"ca.crt\").write_text(\"fake ca cert\")\n+    (ssl_dir / \"ca.key\").write_text(\"fake ca key\")\n+    return ssl_dir\n+\n+\n+def _fake_openssl(command, **kwargs):\n+    if command[1] == \"req\":\n+        key_path = Path(command[command.index(\"-keyout\") + 1])\n+        csr_path = Path(command[command.index(\"-out\") + 1])\n+        key_path.write_text(\"fake key\")\n+        csr_path.write_text(\"fake csr\")\n+    else:\n+        cert_path = Path(command[command.index(\"-out\") + 1])\n+        cert_path.write_text(\"fake cert\")\n+    return MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+\n+def test_name():\n+    assert GenerateSelfSignedSslCertificateAction().name() == \"generate-self-signed-ssl-certificate\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert GenerateSelfSignedSslCertificateAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert GenerateSelfSignedSslCertificateAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_env_file_missing(tmp_path):\n+    make_ca(tmp_path)\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_domain_blank(tmp_path):\n+    make_ca(tmp_path)\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=\\n\")\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ssl_certificate_action.subprocess.run\")\n+def test_run_skips_when_cert_and_key_already_exist(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    ssl_dir = make_ca(tmp_path)\n+    (ssl_dir / \"registry.crt\").write_text(\"existing cert\")\n+    (ssl_dir / \"registry.key\").write_text(\"existing key\")\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_not_called()\n+\n+\n+def test_run_fails_when_ca_cert_or_key_missing(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ssl_certificate_action.subprocess.run\")\n+def test_run_generates_cert_signed_by_ca_with_domain_in_subject_and_san(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    ssl_dir = make_ca(tmp_path)\n+    extfile_contents = []\n+\n+    def fake_openssl_capturing_extfile(command, **kwargs):\n+        if command[1] == \"x509\":\n+            extfile_path = Path(command[command.index(\"-extfile\") + 1])\n+            extfile_contents.append(extfile_path.read_text())\n+        return _fake_openssl(command, **kwargs)\n+\n+    mock_run.side_effect = fake_openssl_capturing_extfile\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert (ssl_dir / \"registry.crt\").read_text() == \"fake cert\"\n+    assert (ssl_dir / \"registry.key\").read_text() == \"fake key\"\n+\n+    csr_call, sign_call = mock_run.call_args_list\n+\n+    csr_args = csr_call.args[0]\n+    assert csr_args[:2] == [\"openssl\", \"req\"]\n+    assert csr_args[csr_args.index(\"-subj\") + 1] == \"/CN=registry.app-server.com\"\n+\n+    sign_args = sign_call.args[0]\n+    assert sign_args[:2] == [\"openssl\", \"x509\"]\n+    assert sign_args[sign_args.index(\"-CA\") + 1] == str(ssl_dir / \"ca.crt\")\n+    assert sign_args[sign_args.index(\"-CAkey\") + 1] == str(ssl_dir / \"ca.key\")\n+    assert \"-CAcreateserial\" in sign_args\n+    assert extfile_contents == [\"subjectAltName=DNS:registry.app-server.com\\n\"]\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ssl_certificate_action.subprocess.run\")\n+def test_run_uses_a_different_domain_var_and_filenames(mock_run, tmp_path):\n+    (tmp_path / \"other.env\").write_text(\"OTHER_DOMAIN=other.app-server.com\\n\")\n+    ssl_dir = make_ca(tmp_path)\n+    mock_run.side_effect = _fake_openssl\n+\n+    result = GenerateSelfSignedSslCertificateAction().run(\n+        {},\n+        make_args(\n+            tmp_path,\n+            env_file=str(tmp_path / \"other.env\"),\n+            domain_var=\"OTHER_DOMAIN\",\n+            cert_filename=\"other.crt\",\n+            key_filename=\"other.key\",\n+        ),\n+    )\n+\n+    assert result is True\n+    assert (ssl_dir / \"other.crt\").exists()\n+    assert (ssl_dir / \"other.key\").exists()\n+    csr_args = mock_run.call_args_list[0].args[0]\n+    assert csr_args[csr_args.index(\"-subj\") + 1] == \"/CN=other.app-server.com\"\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ssl_certificate_action.subprocess.run\")\n+def test_run_returns_false_when_csr_generation_fails(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    make_ca(tmp_path)\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"error generating key\")\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ssl_certificate_action.subprocess.run\")\n+def test_run_returns_false_when_signing_fails(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    make_ca(tmp_path)\n+\n+    def fake_openssl_sign_fails(command, **kwargs):\n+        if command[1] == \"req\":\n+            return _fake_openssl(command, **kwargs)\n+        return MagicMock(returncode=1, stdout=\"\", stderr=\"error signing certificate\")\n+\n+    mock_run.side_effect = fake_openssl_sign_fails\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.generate_self_signed_ssl_certificate_action.subprocess.run\")\n+def test_run_returns_false_when_subprocess_raises(mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    make_ca(tmp_path)\n+    mock_run.side_effect = FileNotFoundError(\"openssl: command not found\")\n+\n+    result = GenerateSelfSignedSslCertificateAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"85621b3bc772e841e4a70879a6ad71c5defd672e","filename":"on-premise/datasaur-cli/tests/action/start/test_print_docker_swarm_join_token_action.py","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_print_docker_swarm_join_token_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_print_docker_swarm_join_token_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_print_docker_swarm_join_token_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,55 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.print_docker_swarm_join_token_action import PrintDockerSwarmJoinTokenAction\n+\n+\n+def test_name():\n+    assert PrintDockerSwarmJoinTokenAction().name() == \"print-docker-swarm-join-token\"\n+\n+\n+@patch(\"src.action.start.print_docker_swarm_join_token_action.subprocess.run\")\n+def test_run_prints_manager_address_and_token_separately(mock_run, capsys):\n+    mock_run.return_value = MagicMock(\n+        returncode=0,\n+        stdout=(\n+            \"To add a worker to this swarm, run the following command:\\n\\n\"\n+            \"    docker swarm join --token SWMTKN-1-abc 10.0.0.1:2377\\n\"\n+        ),\n+        stderr=\"\",\n+    )\n+\n+    result = PrintDockerSwarmJoinTokenAction().run({}, {})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with([\"docker\", \"swarm\", \"join-token\", \"worker\"], capture_output=True, text=True)\n+    output = capsys.readouterr().out\n+    assert \"Manager address: 10.0.0.1:2377\" in output\n+    assert \"Worker join token: SWMTKN-1-abc\" in output\n+\n+\n+@patch(\"src.action.start.print_docker_swarm_join_token_action.subprocess.run\")\n+def test_run_falls_back_to_raw_output_when_unparseable(mock_run, capsys):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"unexpected docker output format\\n\", stderr=\"\")\n+\n+    result = PrintDockerSwarmJoinTokenAction().run({}, {})\n+\n+    assert result is True\n+    assert \"unexpected docker output format\" in capsys.readouterr().out\n+\n+\n+@patch(\"src.action.start.print_docker_swarm_join_token_action.subprocess.run\")\n+def test_run_returns_false_when_command_fails(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"this node is not a swarm manager\")\n+\n+    result = PrintDockerSwarmJoinTokenAction().run({}, {})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.print_docker_swarm_join_token_action.subprocess.run\")\n+def test_run_returns_false_when_subprocess_raises(mock_run):\n+    mock_run.side_effect = FileNotFoundError(\"docker: command not found\")\n+\n+    result = PrintDockerSwarmJoinTokenAction().run({}, {})\n+\n+    assert result is False"},{"sha":"e0f9ab7c26482e7ab63a64d32429533a42671a58","filename":"on-premise/datasaur-cli/tests/action/start/test_prune_stale_docker_secrets_action.py","status":"added","additions":144,"deletions":0,"changes":144,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_prune_stale_docker_secrets_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_prune_stale_docker_secrets_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_prune_stale_docker_secrets_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,144 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.prune_stale_docker_secrets_action import PruneStaleDockerSecretsAction\n+\n+\n+def test_name():\n+    assert PruneStaleDockerSecretsAction().name() == \"prune-stale-docker-secrets\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert PruneStaleDockerSecretsAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args():\n+    args = {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    assert PruneStaleDockerSecretsAction().validate(args) is True\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_removes_secrets_not_referenced_by_the_running_service(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"registry_htpasswd_aaa11111\\nregistry_htpasswd_bbb22222\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout='[{\"SecretName\": \"registry_htpasswd_bbb22222\", \"File\": {}}]\\n', stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    )\n+\n+    assert result is True\n+    assert mock_run.call_args_list[0].args[0] == [\n+        \"docker\", \"secret\", \"ls\", \"--filter\", \"name=registry_htpasswd_\", \"--format\", \"{{.Name}}\",\n+    ]\n+    assert mock_run.call_args_list[1].args[0] == [\n+        \"docker\", \"service\", \"inspect\", \"registry\",\n+        \"--format\", \"{{json .Spec.TaskTemplate.ContainerSpec.Secrets}}\",\n+    ]\n+    assert mock_run.call_args_list[2].args[0] == [\"docker\", \"secret\", \"rm\", \"registry_htpasswd_aaa11111\"]\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_uses_a_different_prefix_and_service_for_a_different_stack(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"other_htpasswd_ccc33333\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout='[{\"SecretName\": \"other_htpasswd_ddd44444\"}]\\n', stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"other_htpasswd\", \"service_name\": \"other\"}\n+    )\n+\n+    assert result is True\n+    assert mock_run.call_args_list[0].args[0] == [\n+        \"docker\", \"secret\", \"ls\", \"--filter\", \"name=other_htpasswd_\", \"--format\", \"{{.Name}}\",\n+    ]\n+    assert mock_run.call_args_list[1].args[0] == [\n+        \"docker\", \"service\", \"inspect\", \"other\",\n+        \"--format\", \"{{json .Spec.TaskTemplate.ContainerSpec.Secrets}}\",\n+    ]\n+    assert mock_run.call_args_list[2].args[0] == [\"docker\", \"secret\", \"rm\", \"other_htpasswd_ccc33333\"]\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_is_noop_when_nothing_is_stale(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"registry_htpasswd_bbb22222\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout='[{\"SecretName\": \"registry_htpasswd_bbb22222\", \"File\": {}}]\\n', stderr=\"\"),\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    )\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_skips_pruning_when_service_not_found(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"registry_htpasswd_aaa11111\\n\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"no such service: registry\"),\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    )\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_skips_pruning_when_service_inspect_returns_unparseable_json(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"registry_htpasswd_aaa11111\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"not json\", stderr=\"\"),\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    )\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.time.sleep\")\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_returns_false_when_secret_removal_fails_after_all_retries(mock_run, mock_sleep):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"registry_htpasswd_aaa11111\\nregistry_htpasswd_bbb22222\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout='[{\"SecretName\": \"registry_htpasswd_bbb22222\", \"File\": {}}]\\n', stderr=\"\"),\n+        *[MagicMock(returncode=1, stdout=\"\", stderr=\"secret in use\") for _ in range(5)],\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    )\n+\n+    assert result is False\n+    assert mock_run.call_count == 2 + 5\n+    assert mock_sleep.call_count == 4\n+\n+\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.time.sleep\")\n+@patch(\"src.action.start.prune_stale_docker_secrets_action.subprocess.run\")\n+def test_run_retries_and_succeeds_after_a_transient_removal_failure(mock_run, mock_sleep):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"registry_htpasswd_aaa11111\\nregistry_htpasswd_bbb22222\\n\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout='[{\"SecretName\": \"registry_htpasswd_bbb22222\", \"File\": {}}]\\n', stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"secret in use\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = PruneStaleDockerSecretsAction().run(\n+        {}, {\"secret_name_prefix\": \"registry_htpasswd\", \"service_name\": \"registry\"}\n+    )\n+\n+    assert result is True\n+    assert mock_run.call_count == 4\n+    assert mock_sleep.call_count == 1"},{"sha":"75b044a4c9ef895658c339e25599b464f379a79e","filename":"on-premise/datasaur-cli/tests/action/start/test_push_docker_images_action.py","status":"added","additions":209,"deletions":0,"changes":209,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_push_docker_images_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_push_docker_images_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_push_docker_images_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,209 @@\n+import json\n+import tarfile\n+from pathlib import Path\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.push_docker_images_action import PushDockerImagesAction\n+\n+VALID_SERVICE = {\"name\": \"app\", \"image\": \"myimage:latest\", \"file_path\": \"/tmp/app.tar\"}\n+\n+MANIFEST_PATCH = \"src.action.start.push_docker_images_action.ManifestFileReader\"\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\"env_file\": str(tmp_path / \".env\"), \"domain_var\": \"REGISTRY_DOMAIN\"}\n+    args.update(overrides)\n+    return args\n+\n+\n+def _make_archive(tmp_path: Path, config_digest_hex: str = \"a\" * 64) -> str:\n+    archive_path = tmp_path / \"app.tar.gz\"\n+    manifest_path = tmp_path / \"manifest.json\"\n+    manifest_path.write_text(\n+        json.dumps([{\"Config\": f\"{config_digest_hex}.json\", \"RepoTags\": [\"myimage:latest\"], \"Layers\": []}])\n+    )\n+    with tarfile.open(archive_path, \"w:gz\") as tar:\n+        tar.add(manifest_path, arcname=\"manifest.json\")\n+    return str(archive_path)\n+\n+\n+def _make_oci_archive(tmp_path: Path, config_digest_hex: str = \"a\" * 64) -> str:\n+    archive_path = tmp_path / \"app.tar.gz\"\n+    manifest_path = tmp_path / \"manifest.json\"\n+    manifest_path.write_text(\n+        json.dumps(\n+            [{\"Config\": f\"blobs/sha256/{config_digest_hex}\", \"RepoTags\": [\"myimage:latest\"], \"Layers\": []}]\n+        )\n+    )\n+    with tarfile.open(archive_path, \"w:gz\") as tar:\n+        tar.add(manifest_path, arcname=\"manifest.json\")\n+    return str(archive_path)\n+\n+\n+def test_name():\n+    assert PushDockerImagesAction().name() == \"push-docker-images\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert PushDockerImagesAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert PushDockerImagesAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_env_file_missing(tmp_path):\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_domain_blank(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=\\n\")\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(MANIFEST_PATCH)\n+def test_run_fails_when_manifest_read_fails(mock_reader_cls, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    mock_reader_cls.return_value.read.return_value = (None, False)\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_pushes_directly_when_archive_is_unreadable(mock_reader_cls, mock_run, tmp_path):\n+    # A real file that exists but isn't a valid tar — can't determine the expected\n+    # digest, so the action skips the remote check entirely and just pushes. Distinct\n+    # from the file being missing entirely (build.sh's --include-* false), which skips\n+    # the service outright — see test_run_skips_service_when_archive_file_missing.\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    archive_path = tmp_path / \"app.tar\"\n+    archive_path.write_text(\"not a tar archive\")\n+    service = dict(VALID_SERVICE, file_path=str(archive_path))\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+    assert mock_run.call_args_list[0].args[0] == [\n+        \"docker\", \"tag\", \"myimage:latest\", \"registry.app-server.com/myimage:latest\",\n+    ]\n+    assert mock_run.call_args_list[1].args[0] == [\"docker\", \"push\", \"registry.app-server.com/myimage:latest\"]\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_service_when_archive_file_missing(mock_reader_cls, mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    missing_service = dict(VALID_SERVICE, file_path=str(tmp_path / \"missing.tar.gz\"))\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [missing_service]}, True)\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_not_called()\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_push_when_remote_config_digest_matches_archive(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    manifest_json = json.dumps({\"config\": {\"digest\": f\"sha256:{'a' * 64}\"}})\n+    mock_run.return_value = MagicMock(returncode=0, stdout=manifest_json, stderr=\"\")\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_called_once_with(\n+        [\"docker\", \"manifest\", \"inspect\", \"registry.app-server.com/myimage:latest\"],\n+        capture_output=True,\n+        text=True,\n+    )\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_skips_push_using_oci_style_archive_config_path(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_oci_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    manifest_json = json.dumps({\"config\": {\"digest\": f\"sha256:{'a' * 64}\"}})\n+    mock_run.return_value = MagicMock(returncode=0, stdout=manifest_json, stderr=\"\")\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    mock_run.assert_called_once()\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_tags_and_pushes_when_remote_digest_differs(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_archive(tmp_path, config_digest_hex=\"a\" * 64)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    manifest_json = json.dumps({\"config\": {\"digest\": f\"sha256:{'b' * 64}\"}})\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=manifest_json, stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert mock_run.call_args_list[1].args[0] == [\n+        \"docker\", \"tag\", \"myimage:latest\", \"registry.app-server.com/myimage:latest\",\n+    ]\n+    assert mock_run.call_args_list[2].args[0] == [\"docker\", \"push\", \"registry.app-server.com/myimage:latest\"]\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_tags_and_pushes_when_nothing_in_registry_yet(mock_reader_cls, mock_run, tmp_path):\n+    archive_path = _make_archive(tmp_path)\n+    service = dict(VALID_SERVICE, file_path=archive_path)\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"no such manifest\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+    ]\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert mock_run.call_count == 3\n+\n+\n+@patch(\"src.action.start.push_docker_images_action.subprocess.run\")\n+@patch(MANIFEST_PATCH)\n+def test_run_returns_false_when_push_fails(mock_reader_cls, mock_run, tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    archive_path = tmp_path / \"app.tar\"\n+    archive_path.write_bytes(b\"\")\n+    service = dict(VALID_SERVICE, file_path=str(archive_path))\n+    mock_reader_cls.return_value.read.return_value = ({\"services\": [service]}, True)\n+    mock_run.side_effect = [\n+        MagicMock(returncode=0, stdout=\"\", stderr=\"\"),\n+        MagicMock(returncode=1, stdout=\"\", stderr=\"denied: requested access to the resource is denied\"),\n+    ]\n+\n+    result = PushDockerImagesAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"ce32f9025a2eb1b7a6c0cf3cb0465f26f7a80287","filename":"on-premise/datasaur-cli/tests/action/start/test_remove_docker_registry_cert_action.py","status":"added","additions":76,"deletions":0,"changes":76,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_remove_docker_registry_cert_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_remove_docker_registry_cert_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_remove_docker_registry_cert_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,76 @@\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from src.action.start.remove_docker_registry_cert_action import RemoveDockerRegistryCertAction\n+\n+\n+def make_args(tmp_path, **overrides):\n+    args = {\n+        \"env_file\": str(tmp_path / \".env\"),\n+        \"domain_var\": \"REGISTRY_DOMAIN\",\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert RemoveDockerRegistryCertAction().name() == \"remove-docker-registry-cert\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert RemoveDockerRegistryCertAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert RemoveDockerRegistryCertAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_env_file_missing(tmp_path):\n+    result = RemoveDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_domain_blank(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=\\n\")\n+\n+    result = RemoveDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_skips_when_not_installed(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+\n+    with patch(\"src.action.start.remove_docker_registry_cert_action.CERTS_D_PATH\", str(tmp_path / \"certs.d\")):\n+        result = RemoveDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+\n+\n+def test_run_removes_the_installed_cert(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    certs_d = tmp_path / \"certs.d\"\n+    target_dir = certs_d / \"registry.app-server.com\"\n+    target_dir.mkdir(parents=True)\n+    target_path = target_dir / \"ca.crt\"\n+    target_path.write_text(\"fake ca cert content\")\n+\n+    with patch(\"src.action.start.remove_docker_registry_cert_action.CERTS_D_PATH\", str(certs_d)):\n+        result = RemoveDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is True\n+    assert not target_path.exists()\n+\n+\n+def test_run_returns_false_when_removal_fails(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    certs_d = tmp_path / \"certs.d\"\n+    target_dir = certs_d / \"registry.app-server.com\"\n+    target_dir.mkdir(parents=True)\n+    (target_dir / \"ca.crt\").mkdir()  # a directory named ca.crt — Path.unlink() will raise\n+\n+    with patch(\"src.action.start.remove_docker_registry_cert_action.CERTS_D_PATH\", str(certs_d)):\n+        result = RemoveDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is False"},{"sha":"2ef222296d251ea8239154b73c9ca462ef507e4c","filename":"on-premise/datasaur-cli/tests/action/start/test_script_runner_action.py","status":"added","additions":149,"deletions":0,"changes":149,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_script_runner_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_script_runner_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_script_runner_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,149 @@\n+import os\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.script_runner_action import ScriptRunnerAction\n+\n+\n+def _mock_process(returncode, stdout_lines=()):\n+    process = MagicMock()\n+    process.stdout = iter(stdout_lines)\n+    process.wait.return_value = returncode\n+    return process\n+\n+\n+def test_name():\n+    assert ScriptRunnerAction().name() == \"script-runner\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert ScriptRunnerAction().options() == {}\n+\n+\n+def test_validate_returns_false_for_invalid_args():\n+    assert ScriptRunnerAction().validate({}) is False\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    args = {\"scripts\": [{\"name\": \"s1\", \"file_path\": \"/tmp/s1.sh\"}]}\n+\n+    assert ScriptRunnerAction().validate(args) is True\n+\n+\n+def test_run_returns_false_when_no_scripts_specified():\n+    assert ScriptRunnerAction().run({}, {\"scripts\": []}) is False\n+\n+\n+def test_run_returns_false_when_script_has_no_file_path():\n+    args = {\"scripts\": [{\"name\": \"s1\", \"file_path\": \"\"}]}\n+\n+    assert ScriptRunnerAction().run({}, args) is False\n+\n+\n+def test_run_returns_false_when_script_file_does_not_exist(tmp_path):\n+    args = {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(tmp_path / \"missing.sh\")}]}\n+\n+    assert ScriptRunnerAction().run({}, args) is False\n+\n+\n+def test_run_returns_false_when_script_path_is_a_directory(tmp_path):\n+    dir_path = tmp_path / \"a_directory\"\n+    dir_path.mkdir()\n+    args = {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(dir_path)}]}\n+\n+    assert ScriptRunnerAction().run({}, args) is False\n+\n+\n+@patch(\"src.action.start.script_runner_action.subprocess.Popen\")\n+def test_run_executes_executable_script_directly(mock_popen, tmp_path):\n+    script = tmp_path / \"run.sh\"\n+    script.write_text(\"#!/bin/sh\\necho hi\\n\")\n+    os.chmod(script, 0o755)\n+    mock_popen.return_value = _mock_process(0, [\"hi\"])\n+    context = {}\n+\n+    result = ScriptRunnerAction().run(\n+        context, {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(script), \"args\": [\"--flag\"]}]}\n+    )\n+\n+    assert result is True\n+    assert context[\"action_name\"] == \"script-runner\"\n+    called_command = mock_popen.call_args.args[0]\n+    assert called_command == [str(script), \"--flag\"]\n+\n+\n+@patch(\"src.action.start.script_runner_action.shutil.which\", return_value=\"/bin/bash\")\n+@patch(\"src.action.start.script_runner_action.subprocess.Popen\")\n+def test_run_wraps_non_executable_script_with_shell(mock_popen, mock_which, tmp_path):\n+    script = tmp_path / \"run.sh\"\n+    script.write_text(\"echo hi\\n\")\n+    os.chmod(script, 0o644)\n+    mock_popen.return_value = _mock_process(0, [\"hi\"])\n+\n+    result = ScriptRunnerAction().run({}, {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(script)}]})\n+\n+    assert result is True\n+    called_command = mock_popen.call_args.args[0]\n+    assert called_command == [\"/bin/bash\", str(script)]\n+\n+\n+@patch(\"src.action.start.script_runner_action.shutil.which\", return_value=None)\n+@patch(\"src.action.start.script_runner_action.subprocess.Popen\")\n+def test_run_attempts_direct_execution_when_not_executable_and_no_shell_found(\n+    mock_popen, mock_which, tmp_path, capsys\n+):\n+    script = tmp_path / \"run.sh\"\n+    script.write_text(\"echo hi\\n\")\n+    os.chmod(script, 0o644)\n+    mock_popen.return_value = _mock_process(0, [\"hi\"])\n+\n+    result = ScriptRunnerAction().run({}, {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(script)}]})\n+\n+    assert result is True\n+    called_command = mock_popen.call_args.args[0]\n+    assert called_command == [str(script)]\n+    captured = capsys.readouterr()\n+    assert \"not executable and no shell found\" in captured.out\n+\n+\n+@patch(\"src.action.start.script_runner_action.subprocess.Popen\")\n+def test_run_returns_false_when_script_exits_nonzero(mock_popen, tmp_path, capsys):\n+    script = tmp_path / \"run.sh\"\n+    script.write_text(\"#!/bin/sh\\nexit 1\\n\")\n+    os.chmod(script, 0o755)\n+    mock_popen.return_value = _mock_process(1, [])\n+\n+    result = ScriptRunnerAction().run({}, {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(script)}]})\n+\n+    assert result is False\n+    captured = capsys.readouterr()\n+    assert \"No output captured from script\" in captured.out\n+\n+\n+@patch(\"src.action.start.script_runner_action.subprocess.Popen\", side_effect=OSError(\"boom\"))\n+def test_run_returns_false_when_popen_raises(mock_popen, tmp_path):\n+    script = tmp_path / \"run.sh\"\n+    script.write_text(\"#!/bin/sh\\necho hi\\n\")\n+    os.chmod(script, 0o755)\n+\n+    assert ScriptRunnerAction().run({}, {\"scripts\": [{\"name\": \"s1\", \"file_path\": str(script)}]}) is False\n+\n+\n+@patch(\"src.action.start.script_runner_action.subprocess.Popen\")\n+def test_run_stops_at_first_failing_script(mock_popen, tmp_path):\n+    script1 = tmp_path / \"run1.sh\"\n+    script1.write_text(\"#!/bin/sh\\nexit 1\\n\")\n+    os.chmod(script1, 0o755)\n+    script2 = tmp_path / \"run2.sh\"\n+    script2.write_text(\"#!/bin/sh\\necho hi\\n\")\n+    os.chmod(script2, 0o755)\n+    mock_popen.return_value = _mock_process(1, [])\n+\n+    args = {\n+        \"scripts\": [\n+            {\"name\": \"s1\", \"file_path\": str(script1)},\n+            {\"name\": \"s2\", \"file_path\": str(script2)},\n+        ]\n+    }\n+\n+    assert ScriptRunnerAction().run({}, args) is False\n+    mock_popen.assert_called_once()"},{"sha":"eb099a0d8da76a254986e79ef835855570341cb9","filename":"on-premise/datasaur-cli/tests/action/start/test_set_docker_registry_cert_action.py","status":"added","additions":106,"deletions":0,"changes":106,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_set_docker_registry_cert_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_set_docker_registry_cert_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_set_docker_registry_cert_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,106 @@\n+from src.action.start import set_docker_registry_cert_action as module\n+from src.action.start.set_docker_registry_cert_action import SetDockerRegistryCertAction\n+\n+\n+def make_args(tmp_path, ca_cert_file=None, **overrides):\n+    args = {\n+        \"env_file\": str(tmp_path / \".env\"),\n+        \"domain_var\": \"REGISTRY_DOMAIN\",\n+        \"ca_cert_file\": str(ca_cert_file if ca_cert_file is not None else (tmp_path / \"ca.crt\")),\n+    }\n+    args.update(overrides)\n+    return args\n+\n+\n+def test_name():\n+    assert SetDockerRegistryCertAction().name() == \"set-docker-registry-cert\"\n+\n+\n+def test_validate_fails_when_required_args_missing():\n+    assert SetDockerRegistryCertAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_required_args(tmp_path):\n+    assert SetDockerRegistryCertAction().validate(make_args(tmp_path)) is True\n+\n+\n+def test_run_fails_when_env_file_missing(tmp_path):\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_domain_blank(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=\\n\")\n+\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_fails_when_ca_cert_file_missing(tmp_path):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path))\n+\n+    assert result is False\n+\n+\n+def test_run_installs_ca_cert_into_certs_d(tmp_path, monkeypatch):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    ca_cert_file = tmp_path / \"ca.crt\"\n+    ca_cert_file.write_text(\"fake ca cert\")\n+    certs_d = tmp_path / \"certs.d\"\n+    monkeypatch.setattr(module, \"CERTS_D_PATH\", str(certs_d))\n+\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path, ca_cert_file=ca_cert_file))\n+\n+    assert result is True\n+    installed = certs_d / \"registry.app-server.com\" / \"ca.crt\"\n+    assert installed.read_text() == \"fake ca cert\"\n+\n+\n+def test_run_skips_when_already_installed_with_matching_content(tmp_path, monkeypatch):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    ca_cert_file = tmp_path / \"ca.crt\"\n+    ca_cert_file.write_text(\"fake ca cert\")\n+    certs_d = tmp_path / \"certs.d\"\n+    monkeypatch.setattr(module, \"CERTS_D_PATH\", str(certs_d))\n+    target_dir = certs_d / \"registry.app-server.com\"\n+    target_dir.mkdir(parents=True)\n+    (target_dir / \"ca.crt\").write_text(\"fake ca cert\")\n+\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path, ca_cert_file=ca_cert_file))\n+\n+    assert result is True\n+    assert (target_dir / \"ca.crt\").read_text() == \"fake ca cert\"\n+\n+\n+def test_run_overwrites_when_content_differs(tmp_path, monkeypatch):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    ca_cert_file = tmp_path / \"ca.crt\"\n+    ca_cert_file.write_text(\"new ca cert\")\n+    certs_d = tmp_path / \"certs.d\"\n+    monkeypatch.setattr(module, \"CERTS_D_PATH\", str(certs_d))\n+    target_dir = certs_d / \"registry.app-server.com\"\n+    target_dir.mkdir(parents=True)\n+    (target_dir / \"ca.crt\").write_text(\"old ca cert\")\n+\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path, ca_cert_file=ca_cert_file))\n+\n+    assert result is True\n+    assert (target_dir / \"ca.crt\").read_text() == \"new ca cert\"\n+\n+\n+def test_run_returns_false_when_copy_fails(tmp_path, monkeypatch):\n+    (tmp_path / \".env\").write_text(\"REGISTRY_DOMAIN=registry.app-server.com\\n\")\n+    ca_cert_file = tmp_path / \"ca.crt\"\n+    ca_cert_file.write_text(\"fake ca cert\")\n+    # Point certs.d at a path that's a file, not a directory — mkdir(parents=True) must fail.\n+    blocked = tmp_path / \"blocked\"\n+    blocked.write_text(\"not a directory\")\n+    monkeypatch.setattr(module, \"CERTS_D_PATH\", str(blocked))\n+\n+    result = SetDockerRegistryCertAction().run({}, make_args(tmp_path, ca_cert_file=ca_cert_file))\n+\n+    assert result is False"},{"sha":"e198d9bd23f3878719fc33c317040b4825a72557","filename":"on-premise/datasaur-cli/tests/action/start/test_validate_docker_images_action.py","status":"added","additions":102,"deletions":0,"changes":102,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_docker_images_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_docker_images_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_docker_images_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,102 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.start.validate_docker_images_action import ValidateDockerImagesAction\n+\n+\n+def test_name():\n+    assert ValidateDockerImagesAction().name() == \"validate-docker-images\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert ValidateDockerImagesAction().options() == {}\n+\n+\n+def test_validate_always_returns_true():\n+    assert ValidateDockerImagesAction().validate({\"anything\": \"goes\"}) is True\n+\n+\n+@patch(\"src.action.start.validate_docker_images_action.ManifestFileReader\")\n+def test_run_returns_false_when_manifest_read_fails(mock_reader_cls):\n+    mock_reader_cls.return_value.read.return_value = (None, False)\n+\n+    assert ValidateDockerImagesAction().run({}, {}) is False\n+\n+\n+@patch(\"src.action.start.validate_docker_images_action.subprocess.run\")\n+@patch(\"src.action.start.validate_docker_images_action.ManifestFileReader\")\n+def test_run_returns_true_when_all_images_exist(mock_reader_cls, mock_run, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"CI_REGISTRY\", raising=False)\n+    mock_reader_cls.return_value.read.return_value = (\n+        {\"services\": [{\"name\": \"app\", \"image\": \"myimage:latest\"}]},\n+        True,\n+    )\n+    mock_run.return_value = MagicMock(returncode=0)\n+\n+    result = ValidateDockerImagesAction().run({}, {})\n+\n+    assert result is True\n+\n+\n+@patch(\"src.action.start.validate_docker_images_action.subprocess.run\")\n+@patch(\"src.action.start.validate_docker_images_action.ManifestFileReader\")\n+def test_run_returns_false_when_an_image_is_missing(mock_reader_cls, mock_run, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"CI_REGISTRY\", raising=False)\n+    mock_reader_cls.return_value.read.return_value = (\n+        {\"services\": [{\"name\": \"app\", \"image\": \"myimage:latest\"}]},\n+        True,\n+    )\n+    mock_run.return_value = MagicMock(returncode=1)\n+\n+    result = ValidateDockerImagesAction().run({}, {})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.start.validate_docker_images_action.subprocess.run\")\n+@patch(\"src.action.start.validate_docker_images_action.ManifestFileReader\")\n+def test_run_resolves_variable_in_image_name(mock_reader_cls, mock_run, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"TAG\", \"1.2.3\")\n+    mock_reader_cls.return_value.read.return_value = (\n+        {\"services\": [{\"name\": \"app\", \"image\": \"myimage:${TAG}\"}]},\n+        True,\n+    )\n+    mock_run.return_value = MagicMock(returncode=0)\n+\n+    ValidateDockerImagesAction().run({}, {})\n+\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"image\", \"inspect\", \"myimage:1.2.3\"]\n+\n+\n+@patch(\"src.action.start.validate_docker_images_action.subprocess.run\")\n+@patch(\"src.action.start.validate_docker_images_action.ManifestFileReader\")\n+def test_run_falls_back_to_ci_registry_prefixed_candidate(\n+    mock_reader_cls, mock_run, monkeypatch, tmp_path\n+):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CI_REGISTRY\", \"registry.example.com\")\n+    # A registry-less \"org/image\" reference (no \".\" or \":\" in the part\n+    # before the \"/\") is eligible for the CI_REGISTRY-prefixed fallback\n+    # candidate; a bare \"image:tag\" with no \"/\" never is.\n+    mock_reader_cls.return_value.read.return_value = (\n+        {\"services\": [{\"name\": \"app\", \"image\": \"myorg/myimage:latest\"}]},\n+        True,\n+    )\n+    # First candidate (\"myorg/myimage:latest\") fails, second\n+    # (\"registry.example.com/myorg/myimage:latest\") succeeds.\n+    mock_run.side_effect = [MagicMock(returncode=1), MagicMock(returncode=0)]\n+\n+    result = ValidateDockerImagesAction().run({}, {})\n+\n+    assert result is True\n+    assert mock_run.call_count == 2\n+    second_call_command = mock_run.call_args_list[1].args[0]\n+    assert second_call_command == [\n+        \"docker\",\n+        \"image\",\n+        \"inspect\",\n+        \"registry.example.com/myorg/myimage:latest\",\n+    ]"},{"sha":"d77287718d2dfe111593ad1ef57b89aae03489d5","filename":"on-premise/datasaur-cli/tests/action/start/test_validate_files_and_directories_action.py","status":"added","additions":119,"deletions":0,"changes":119,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_files_and_directories_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_files_and_directories_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_files_and_directories_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,119 @@\n+import os\n+\n+from src.action.start.validate_files_and_directories_action import (\n+    ValidateFilesAndDirectoriesAction,\n+)\n+\n+\n+def test_name():\n+    assert ValidateFilesAndDirectoriesAction().name() == \"validate-files\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert ValidateFilesAndDirectoriesAction().options() == {}\n+\n+\n+def test_validate_returns_false_for_invalid_args():\n+    assert ValidateFilesAndDirectoriesAction().validate({}) is False\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    args = {\"files\": [{\"path\": \"a.txt\", \"permissions\": \"0644\"}]}\n+\n+    assert ValidateFilesAndDirectoriesAction().validate(args) is True\n+\n+\n+def test_run_returns_false_when_no_files_specified():\n+    assert ValidateFilesAndDirectoriesAction().run({}, {\"files\": []}) is False\n+\n+\n+def test_run_returns_false_when_path_does_not_exist(tmp_path):\n+    args = {\"files\": [{\"path\": str(tmp_path / \"missing.txt\"), \"permissions\": \"0644\"}]}\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is False\n+\n+\n+def test_run_returns_true_when_file_matches_expected_permissions(tmp_path):\n+    file_path = tmp_path / \"a.txt\"\n+    file_path.write_text(\"content\")\n+    os.chmod(file_path, 0o644)\n+    args = {\"files\": [{\"path\": str(file_path), \"permissions\": \"0644\"}]}\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is True\n+\n+\n+def test_run_returns_false_when_permissions_do_not_match(tmp_path):\n+    file_path = tmp_path / \"a.txt\"\n+    file_path.write_text(\"content\")\n+    os.chmod(file_path, 0o600)\n+    args = {\"files\": [{\"path\": str(file_path), \"permissions\": \"0644\"}]}\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is False\n+\n+\n+def test_run_returns_false_when_owner_does_not_match(tmp_path):\n+    file_path = tmp_path / \"a.txt\"\n+    file_path.write_text(\"content\")\n+    os.chmod(file_path, 0o644)\n+    args = {\n+        \"files\": [\n+            {\n+                \"path\": str(file_path),\n+                \"permissions\": \"0644\",\n+                \"owner\": f\"{os.getuid() + 1}:{os.getgid() + 1}\",\n+            }\n+        ]\n+    }\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is False\n+\n+\n+def test_run_returns_true_when_owner_matches(tmp_path):\n+    file_path = tmp_path / \"a.txt\"\n+    file_path.write_text(\"content\")\n+    os.chmod(file_path, 0o644)\n+    args = {\n+        \"files\": [\n+            {\n+                \"path\": str(file_path),\n+                \"permissions\": \"0644\",\n+                \"owner\": f\"{os.getuid()}:{os.getgid()}\",\n+            }\n+        ]\n+    }\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is True\n+\n+\n+def test_run_returns_false_when_wildcard_matches_nothing(tmp_path):\n+    args = {\"files\": [{\"path\": str(tmp_path / \"*.nomatch\"), \"permissions\": \"0644\"}]}\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is False\n+\n+\n+def test_run_validates_all_files_matched_by_wildcard(tmp_path):\n+    (tmp_path / \"a.txt\").write_text(\"a\")\n+    (tmp_path / \"b.txt\").write_text(\"b\")\n+    os.chmod(tmp_path / \"a.txt\", 0o644)\n+    os.chmod(tmp_path / \"b.txt\", 0o644)\n+    args = {\"files\": [{\"path\": str(tmp_path / \"*.txt\"), \"permissions\": \"0644\"}]}\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is True\n+\n+\n+def test_run_wildcard_skips_files_covered_by_later_specific_entry(tmp_path):\n+    # \"a.txt\" has the wrong permissions for the wildcard's expectation,\n+    # but a later specific entry re-declares \"a.txt\" with the correct\n+    # permissions — the precedence rule means the wildcard pass excludes\n+    # it entirely rather than flagging it.\n+    file_a = tmp_path / \"a.txt\"\n+    file_a.write_text(\"a\")\n+    os.chmod(file_a, 0o600)\n+    args = {\n+        \"files\": [\n+            {\"path\": str(tmp_path / \"*.txt\"), \"permissions\": \"0644\"},\n+            {\"path\": str(file_a), \"permissions\": \"0600\"},\n+        ]\n+    }\n+\n+    assert ValidateFilesAndDirectoriesAction().run({}, args) is True"},{"sha":"95adec3e9641d1718c43f4a0f046124acdbd85e8","filename":"on-premise/datasaur-cli/tests/action/start/test_validate_required_env_vars_action.py","status":"added","additions":136,"deletions":0,"changes":136,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_required_env_vars_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_required_env_vars_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstart%2Ftest_validate_required_env_vars_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,136 @@\n+from src.action.start.validate_required_env_vars_action import (\n+    ValidateRequiredEnvVarsAction,\n+)\n+\n+ALL_REQUIRED = {\n+    \"HOST\": \"host\",\n+    \"PUBLIC_URL\": \"url\",\n+    \"DATABASE_HOST\": \"mariadb\",\n+    \"DATABASE_PORT\": \"3306\",\n+    \"DATABASE_USERNAME\": \"user\",\n+    \"DATABASE_PASSWORD\": \"pass\",\n+    \"DATABASE_NAME\": \"db\",\n+    \"RABBITMQ_USERNAME\": \"rmq_user\",\n+    \"RABBITMQ_PASSWORD\": \"rmq_pass\",\n+    \"ENCRYPTION_VERSION\": \"0\",\n+    \"OBJECT_STORAGE_PRIMARY_CLIENT_NAME\": \"LOCAL\",\n+    \"OBJECT_STORAGE_PRIVATE_CLIENT_NAME\": \"LOCAL\",\n+    \"OBJECT_STORAGE_PRIMARY_BUCKET_NAME\": \"bucket1\",\n+    \"OBJECT_STORAGE_PRIVATE_BUCKET_NAME\": \"bucket2\",\n+    \"OBJECT_STORAGE_PRIVATE_SIGNATURE_SALT\": \"salt\",\n+}\n+\n+\n+def _write_env(path, values):\n+    path.write_text(\"\\n\".join(f\"{k}={v}\" for k, v in values.items()) + \"\\n\")\n+\n+\n+def test_name():\n+    assert ValidateRequiredEnvVarsAction().name() == \"validate-required-env-vars\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert ValidateRequiredEnvVarsAction().options() == {}\n+\n+\n+def test_validate_returns_false_for_invalid_args():\n+    assert ValidateRequiredEnvVarsAction().validate({\"env_file\": {\"not\": \"a string\"}}) is False\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    assert ValidateRequiredEnvVarsAction().validate({\"env_file\": \"datasaur.env\"}) is True\n+\n+\n+def test_run_returns_false_when_env_file_missing(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": \"datasaur.env\"})\n+\n+    assert result is False\n+\n+\n+def test_run_returns_true_when_all_required_values_present(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, ALL_REQUIRED)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is True\n+\n+\n+def test_run_returns_false_when_a_required_value_is_missing(monkeypatch, tmp_path, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    values = dict(ALL_REQUIRED)\n+    del values[\"DATABASE_PASSWORD\"]\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, values)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is False\n+    captured = capsys.readouterr()\n+    assert \"DATABASE_PASSWORD\" in captured.out\n+\n+\n+def test_run_requires_encryption_key_when_encryption_version_not_zero(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    values = dict(ALL_REQUIRED, ENCRYPTION_VERSION=\"1\")\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, values)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is False  # ENCRYPTION_KEY becomes required and is missing\n+\n+\n+def test_run_requires_aws_s3_keys_when_storage_provider_is_aws(monkeypatch, tmp_path, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    values = dict(ALL_REQUIRED, OBJECT_STORAGE_PRIMARY_CLIENT_NAME=\"AWS_S3\")\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, values)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is False\n+    captured = capsys.readouterr()\n+    assert \"OBJECT_STORAGE_PRIMARY_ACCESS_KEY\" in captured.out\n+\n+\n+def test_run_requires_azure_keys_when_storage_provider_is_azure(monkeypatch, tmp_path, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    values = dict(ALL_REQUIRED, OBJECT_STORAGE_PRIMARY_CLIENT_NAME=\"AZURE_BLOB_STORAGE\")\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, values)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is False\n+    captured = capsys.readouterr()\n+    assert \"OBJECT_STORAGE_PRIMARY_ACCESS_KEY\" in captured.out\n+\n+\n+def test_run_returns_false_on_database_host_mismatch_when_local_mariadb_enabled(monkeypatch, tmp_path, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    values = dict(ALL_REQUIRED, ENABLE_LOCAL_MARIADB=\"true\", DATABASE_HOST=\"remotehost\")\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, values)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is False\n+    captured = capsys.readouterr()\n+    assert \"DATABASE_HOST\" in captured.out\n+\n+\n+def test_run_ignores_database_host_mismatch_when_local_mariadb_disabled(monkeypatch, tmp_path, capsys):\n+    monkeypatch.chdir(tmp_path)\n+    values = dict(ALL_REQUIRED, ENABLE_LOCAL_MARIADB=\"false\", DATABASE_HOST=\"remotehost\")\n+    env_path = tmp_path / \"datasaur.env\"\n+    _write_env(env_path, values)\n+\n+    result = ValidateRequiredEnvVarsAction().run({}, {\"env_file\": str(env_path)})\n+\n+    assert result is True\n+    captured = capsys.readouterr()\n+    assert \"✓ Required configuration values are present\" in captured.out"},{"sha":"8586828bea7d44db0aae7b245b6e664fea445968","filename":"on-premise/datasaur-cli/tests/action/stop/test_docker_compose_down_action.py","status":"added","additions":94,"deletions":0,"changes":94,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstop%2Ftest_docker_compose_down_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstop%2Ftest_docker_compose_down_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstop%2Ftest_docker_compose_down_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,94 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.stop.docker_compose_down_action import DockerComposeDownAction\n+\n+\n+def test_name():\n+    assert DockerComposeDownAction().name() == \"docker-compose-down\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert DockerComposeDownAction().options() == {}\n+\n+\n+def test_validate_returns_false_for_invalid_args():\n+    assert DockerComposeDownAction().validate({}) is False\n+\n+\n+def test_validate_returns_false_when_docker_compose_file_missing(tmp_path):\n+    args = {\"env_files\": [], \"docker_compose_file\": str(tmp_path / \"missing.yaml\")}\n+\n+    assert DockerComposeDownAction().validate(args) is False\n+\n+\n+def test_validate_returns_false_when_env_file_missing(tmp_path):\n+    args = {\"env_files\": [str(tmp_path / \"missing.env\")]}\n+\n+    assert DockerComposeDownAction().validate(args) is False\n+\n+\n+def test_validate_returns_true_when_all_files_present(tmp_path):\n+    compose_file = tmp_path / \"docker-compose.yaml\"\n+    compose_file.write_text(\"services: {}\")\n+    env_file = tmp_path / \"a.env\"\n+    env_file.write_text(\"FOO=bar\")\n+    args = {\"env_files\": [str(env_file)], \"docker_compose_file\": str(compose_file)}\n+\n+    assert DockerComposeDownAction().validate(args) is True\n+\n+\n+@patch(\"src.action.stop.docker_compose_down_action.subprocess.run\")\n+def test_run_returns_true_on_success(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+    context = {}\n+\n+    result = DockerComposeDownAction().run(context, {\"env_files\": [\"a.env\"]})\n+\n+    assert result is True\n+    assert context[\"action_name\"] == \"docker-compose-down\"\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"compose\", \"--env-file\", \"a.env\", \"down\"]\n+\n+\n+@patch(\"src.action.stop.docker_compose_down_action.subprocess.run\")\n+def test_run_returns_false_when_command_fails(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"boom\")\n+\n+    assert DockerComposeDownAction().run({}, {\"env_files\": []}) is False\n+\n+\n+@patch(\"src.action.stop.docker_compose_down_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, capsys):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Container app  Removed\\n\", stderr=\"\")\n+\n+    DockerComposeDownAction().run({}, {\"env_files\": []})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Docker compose stopped successfully\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.stop.docker_compose_down_action.subprocess.run\")\n+def test_run_logs_output_before_failure_verdict(mock_run, capsys):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"some partial output\\n\", stderr=\"boom\")\n+\n+    DockerComposeDownAction().run({}, {\"env_files\": []})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✗ Failed to stop docker compose\")\n+    assert \"\\n\\n✗\" not in out\n+\n+\n+@patch(\"src.action.stop.docker_compose_down_action.subprocess.run\", side_effect=OSError(\"boom\"))\n+def test_run_returns_false_on_exception(mock_run):\n+    assert DockerComposeDownAction().run({}, {\"env_files\": []}) is False\n+\n+\n+@patch(\"src.action.stop.docker_compose_down_action.subprocess.run\")\n+def test_run_includes_docker_compose_file_flag_when_given(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"\", stderr=\"\")\n+\n+    DockerComposeDownAction().run({}, {\"env_files\": [], \"docker_compose_file\": \"custom.yaml\"})\n+\n+    called_command = mock_run.call_args.args[0]\n+    assert called_command == [\"docker\", \"compose\", \"-f\", \"custom.yaml\", \"down\"]"},{"sha":"08e4af68041e93a5549b28b2cd013391b6b68acd","filename":"on-premise/datasaur-cli/tests/action/stop/test_docker_stack_rm_action.py","status":"added","additions":115,"deletions":0,"changes":115,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstop%2Ftest_docker_stack_rm_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstop%2Ftest_docker_stack_rm_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Fstop%2Ftest_docker_stack_rm_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,115 @@\n+from unittest.mock import MagicMock, patch\n+\n+from src.action.stop.docker_stack_rm_action import DockerStackRmAction\n+\n+\n+def test_name():\n+    assert DockerStackRmAction().name() == \"docker-stack-rm\"\n+\n+\n+def test_validate_fails_when_stack_arg_missing():\n+    assert DockerStackRmAction().validate({}) is False\n+\n+\n+def test_validate_succeeds_with_stack_arg():\n+    assert DockerStackRmAction().validate({\"stack\": \"proxy\"}) is True\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_removes_stack(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Removing service proxy_traefik\\n\", stderr=\"\")\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+    mock_run.assert_called_once_with([\"docker\", \"stack\", \"rm\", \"proxy\"], capture_output=True, text=True)\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_returns_false_on_failure(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"no such stack: proxy\")\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_treats_absent_stack_as_success(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=\"Nothing found in stack: proxy\\n\")\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"proxy\"})\n+\n+    assert result is True\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_logs_output_before_success_verdict(mock_run, capsys):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"Removing service proxy_traefik\\n\", stderr=\"\")\n+\n+    DockerStackRmAction().run({}, {\"stack\": \"proxy\"})\n+\n+    out = capsys.readouterr().out\n+    assert out.index(\"Output:\") < out.index(\"✓ Stack 'proxy' removed successfully\")\n+    assert \"\\n\\n✓\" not in out\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_treats_partial_removal_race_as_success(mock_run, capsys):\n+    stderr = (\n+        \"Failed to remove network 4h3bbebb5lkgza9c8nyz6x93h: Error response from daemon: \"\n+        \"network 4h3bbebb5lkgza9c8nyz6x93h not found\"\n+        \"failed to remove some resources from stack: hello\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=stderr)\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"hello\"})\n+\n+    assert result is True\n+    out = capsys.readouterr().out\n+    assert \"✓ Stack 'hello' removed (some resources were already gone)\" in out\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_treats_partial_removal_race_as_success_with_newline_separator(mock_run):\n+    stderr = (\n+        \"Failed to remove network 4h3bbebb5lkgza9c8nyz6x93h: Error response from daemon: \"\n+        \"network 4h3bbebb5lkgza9c8nyz6x93h not found\\n\"\n+        \"failed to remove some resources from stack: hello\\n\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=stderr)\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"hello\"})\n+\n+    assert result is True\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_returns_false_when_real_failure_accompanies_not_found_resource(mock_run):\n+    stderr = (\n+        \"Failed to remove secret abc123: Error response from daemon: permission denied\\n\"\n+        \"Failed to remove network 4h3bbebb5lkgza9c8nyz6x93h: Error response from daemon: \"\n+        \"network 4h3bbebb5lkgza9c8nyz6x93h not found\\n\"\n+        \"failed to remove some resources from stack: hello\\n\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=stderr)\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"hello\"})\n+\n+    assert result is False\n+\n+\n+@patch(\"src.action.stop.docker_stack_rm_action.subprocess.run\")\n+def test_run_treats_multiple_not_found_resources_as_success(mock_run):\n+    stderr = (\n+        \"Failed to remove network 4h3bbebb5lkgza9c8nyz6x93h: Error response from daemon: \"\n+        \"network 4h3bbebb5lkgza9c8nyz6x93h not found\\n\"\n+        \"Failed to remove secret registry_htpasswd_abc123: Error response from daemon: \"\n+        \"secret registry_htpasswd_abc123 not found\\n\"\n+        \"failed to remove some resources from stack: hello\\n\"\n+    )\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\", stderr=stderr)\n+\n+    result = DockerStackRmAction().run({}, {\"stack\": \"hello\"})\n+\n+    assert result is True"},{"sha":"e24e7728becb2780be9852bcd925dbda1876f472","filename":"on-premise/datasaur-cli/tests/action/test_action.py","status":"added","additions":84,"deletions":0,"changes":84,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Ftest_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Ftest_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Ftest_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,84 @@\n+import pytest\n+\n+from src.action.action import Action\n+\n+\n+def test_action_cannot_be_instantiated_directly():\n+    with pytest.raises(TypeError):\n+        Action()\n+\n+\n+def test_concrete_subclass_implementing_all_methods_can_be_instantiated():\n+    class ConcreteAction(Action):\n+        def name(self):\n+            return \"concrete\"\n+\n+        def options(self):\n+            return {\"foo\": \"bar\"}\n+\n+        def validate(self, args):\n+            return True\n+\n+        def run(self, context, args):\n+            return True\n+\n+    action = ConcreteAction()\n+\n+    assert action.name() == \"concrete\"\n+    assert action.options() == {\"foo\": \"bar\"}\n+    assert action.validate({}) is True\n+    assert action.run({}, {}) is True\n+\n+\n+def test_subclass_missing_a_method_cannot_be_instantiated():\n+    class IncompleteAction(Action):\n+        def name(self):\n+            return \"incomplete\"\n+\n+        def options(self):\n+            return {}\n+\n+        def validate(self, args):\n+            return True\n+\n+        # run() intentionally not implemented\n+\n+    with pytest.raises(TypeError):\n+        IncompleteAction()\n+\n+\n+def test_sensitive_args_defaults_to_empty_list_when_not_overridden():\n+    class ConcreteAction(Action):\n+        def name(self):\n+            return \"concrete\"\n+\n+        def options(self):\n+            return {}\n+\n+        def validate(self, args):\n+            return True\n+\n+        def run(self, context, args):\n+            return True\n+\n+    assert ConcreteAction().sensitive_args() == []\n+\n+\n+def test_sensitive_args_can_be_overridden():\n+    class SecretAction(Action):\n+        def name(self):\n+            return \"secret\"\n+\n+        def options(self):\n+            return {}\n+\n+        def validate(self, args):\n+            return True\n+\n+        def run(self, context, args):\n+            return True\n+\n+        def sensitive_args(self):\n+            return [\"password\"]\n+\n+    assert SecretAction().sensitive_args() == [\"password\"]"},{"sha":"ddc8425f3c3d1fee67e67865668bfe8d31d4b4e4","filename":"on-premise/datasaur-cli/tests/action/test_actions_service.py","status":"added","additions":352,"deletions":0,"changes":352,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Ftest_actions_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Ftest_actions_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Faction%2Ftest_actions_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,352 @@\n+import json\n+from unittest.mock import MagicMock\n+\n+from src.action.actions_service import ActionsService\n+from src.common.state_service import StateService\n+\n+\n+def read_events(tmp_path):\n+    log_path = tmp_path / \"datasaur-cli.log\"\n+    return [json.loads(line) for line in log_path.read_text().splitlines()]\n+\n+\n+def test_init_registers_all_base_actions():\n+    service = ActionsService()\n+\n+    assert service.validate_action_existence(\"hello-world\") is True\n+    assert service.validate_action_existence(\"configure\") is True\n+    assert service.validate_action_existence(\"docker-compose-up\") is True\n+    assert service.validate_action_existence(\"docker-logout\") is True\n+    assert service.validate_action_existence(\"remove-docker-registry-cert\") is True\n+    assert service.validate_action_existence(\"docker-stack-rm-all\") is True\n+    assert len(service.actions) == 30\n+\n+\n+def test_validate_action_existence_returns_false_for_unknown_action():\n+    assert ActionsService().validate_action_existence(\"no-such-action\") is False\n+\n+\n+def test_get_action_options_maps_each_action_to_its_options():\n+    options = ActionsService().get_action_options()\n+\n+    assert options[\"hello-world\"] == {}\n+    assert set(options.keys()) == set(ActionsService().actions.keys())\n+\n+\n+def test_run_happy_path_calls_validate_then_run_and_sets_action_number(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.return_value = True\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {\"key\": \"value\"}}])\n+\n+    assert result is True\n+    assert context[\"action_number\"] == 0\n+    fake_action.validate.assert_called_once_with({\"key\": \"value\"})\n+    fake_action.run.assert_called_once_with(context, {\"key\": \"value\"})\n+\n+\n+def test_run_resolves_option_and_prompt_placeholders(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.return_value = True\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {\"env\": \"prod\"}, \"prompt_values\": {\"name\": \"alice\"}}\n+    args = {\"target\": \"{options[env]}\", \"who\": \"{prompts[name]}\"}\n+\n+    service.run(context, [{\"action\": \"fake\", \"args\": args}])\n+\n+    fake_action.validate.assert_called_once_with({\"target\": \"prod\", \"who\": \"alice\"})\n+\n+\n+def test_run_returns_false_when_validate_fails(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = False\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {}}])\n+\n+    assert result is False\n+    fake_action.run.assert_not_called()\n+\n+\n+def test_run_returns_false_when_action_run_fails(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.return_value = False\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {}}])\n+\n+    assert result is False\n+\n+\n+def test_run_sees_state_written_by_a_previous_action_in_the_same_batch(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+\n+    writer_action = MagicMock()\n+    writer_action.validate.return_value = True\n+    writer_action.sensitive_args.return_value = []\n+\n+    def _write_state(context, args):\n+        StateService().set(\"foo\", \"bar-from-state\")\n+        return True\n+\n+    writer_action.run.side_effect = _write_state\n+\n+    reader_action = MagicMock()\n+    reader_action.validate.return_value = True\n+    reader_action.run.return_value = True\n+    reader_action.sensitive_args.return_value = []\n+\n+    service.actions[\"writer\"] = writer_action\n+    service.actions[\"reader\"] = reader_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    service.run(\n+        context,\n+        [\n+            {\"action\": \"writer\", \"args\": {}},\n+            {\"action\": \"reader\", \"args\": {\"value\": \"{state[foo]}\"}},\n+        ],\n+    )\n+\n+    reader_action.validate.assert_called_once_with({\"value\": \"bar-from-state\"})\n+\n+\n+# --- event logging ---\n+\n+\n+def test_run_writes_success_event_with_duration_and_outcome(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.return_value = True\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"command_name\": \"start\", \"option_values\": {}, \"prompt_values\": {}}\n+\n+    service.run(context, [{\"action\": \"fake\", \"args\": {\"name\": \"value\"}}])\n+\n+    events = read_events(tmp_path)\n+    assert len(events) == 1\n+    event = events[0]\n+    assert event[\"command\"] == \"start\"\n+    assert event[\"action_number\"] == 0\n+    assert event[\"action\"] == \"fake\"\n+    assert event[\"args\"] == {\"name\": \"value\"}\n+    assert event[\"outcome\"] == \"success\"\n+    assert event[\"error\"] is None\n+    assert isinstance(event[\"duration_ms\"], int)\n+\n+\n+def test_run_writes_validate_failed_event(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = False\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {}}])\n+\n+    assert result is False\n+    assert read_events(tmp_path)[0][\"outcome\"] == \"validate_failed\"\n+\n+\n+def test_run_writes_run_failed_event(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.return_value = False\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {}}])\n+\n+    assert result is False\n+    assert read_events(tmp_path)[0][\"outcome\"] == \"run_failed\"\n+\n+\n+def test_run_writes_error_event_and_returns_false_when_run_raises(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.side_effect = RuntimeError(\"boom\")\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {}}])\n+\n+    assert result is False\n+    event = read_events(tmp_path)[0]\n+    assert event[\"outcome\"] == \"error\"\n+    assert event[\"error\"][\"type\"] == \"RuntimeError\"\n+    assert event[\"error\"][\"message\"] == \"boom\"\n+\n+\n+def test_run_writes_error_event_and_returns_false_when_validate_raises(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.side_effect = ValueError(\"bad args\")\n+    fake_action.sensitive_args.return_value = []\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    result = service.run(context, [{\"action\": \"fake\", \"args\": {}}])\n+\n+    assert result is False\n+    event = read_events(tmp_path)[0]\n+    assert event[\"outcome\"] == \"error\"\n+    assert event[\"error\"][\"type\"] == \"ValueError\"\n+    fake_action.run.assert_not_called()\n+\n+\n+def test_run_redacts_args_declared_sensitive_by_the_action(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.validate.return_value = True\n+    fake_action.run.return_value = True\n+    fake_action.sensitive_args.return_value = [\"htpasswd_line\"]\n+    service.actions[\"fake\"] = fake_action\n+    context = {\"option_values\": {}, \"prompt_values\": {}}\n+\n+    service.run(context, [{\"action\": \"fake\", \"args\": {\"htpasswd_line\": \"admin:$apr1$abc\", \"username\": \"admin\"}}])\n+\n+    event = read_events(tmp_path)[0]\n+    assert event[\"args\"][\"htpasswd_line\"] == \"***\"\n+    assert event[\"args\"][\"username\"] == \"admin\"\n+\n+\n+# --- _resolve_values() ---\n+\n+\n+def test_resolve_values_returns_plain_string_unchanged():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(\"plain text\", {}, {}, {}) == \"plain text\"\n+\n+\n+def test_resolve_values_resolves_options_placeholder():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(\"{options[env]}\", {\"env\": \"prod\"}, {}, {}) == \"prod\"\n+\n+\n+def test_resolve_values_resolves_prompts_placeholder():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(\"{prompts[name]}\", {}, {\"name\": \"alice\"}, {}) == \"alice\"\n+\n+\n+def test_resolve_values_resolves_state_placeholder():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(\"{state[foo]}\", {}, {}, {\"foo\": \"bar\"}) == \"bar\"\n+\n+\n+def test_resolve_values_returns_none_for_missing_key():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(\"{options[missing]}\", {}, {}, {}) is None\n+\n+\n+def test_resolve_values_converts_literal_none_string_to_none():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(\"{prompts[name]}\", {}, {\"name\": None}, {}) is None\n+\n+\n+def test_resolve_values_recurses_into_dicts_and_lists():\n+    service = ActionsService()\n+    obj = {\"a\": [\"{options[env]}\", \"literal\"], \"b\": {\"c\": \"{prompts[name]}\"}}\n+\n+    resolved = service._resolve_values(obj, {\"env\": \"prod\"}, {\"name\": \"alice\"}, {})\n+\n+    assert resolved == {\"a\": [\"prod\", \"literal\"], \"b\": {\"c\": \"alice\"}}\n+\n+\n+def test_resolve_values_passes_through_non_string_non_container_values():\n+    service = ActionsService()\n+\n+    assert service._resolve_values(42, {}, {}, {}) == 42\n+    assert service._resolve_values(True, {}, {}, {}) is True\n+    assert service._resolve_values(None, {}, {}, {}) is None\n+\n+\n+# --- _load_module_actions() ---\n+\n+\n+def test_load_module_actions_returns_empty_list_when_actions_dir_missing(tmp_path):\n+    service = ActionsService()\n+\n+    assert service._load_module_actions(str(tmp_path)) == []\n+\n+\n+def test_load_module_actions_returns_empty_list_when_get_actions_undefined(tmp_path):\n+    actions_dir = tmp_path / \"actions\"\n+    actions_dir.mkdir()\n+    (actions_dir / \"__init__.py\").write_text(\"# no get_actions() here\\n\")\n+    service = ActionsService()\n+\n+    assert service._load_module_actions(str(tmp_path)) == []\n+\n+\n+def test_load_module_actions_loads_and_registers_custom_action(tmp_path):\n+    actions_dir = tmp_path / \"actions\"\n+    actions_dir.mkdir()\n+    (actions_dir / \"__init__.py\").write_text(\n+        \"class CustomAction:\\n\"\n+        \"    def name(self):\\n\"\n+        \"        return 'custom-action'\\n\"\n+        \"    def options(self):\\n\"\n+        \"        return {}\\n\"\n+        \"    def validate(self, args):\\n\"\n+        \"        return True\\n\"\n+        \"    def run(self, context, args):\\n\"\n+        \"        return True\\n\"\n+        \"\\n\"\n+        \"def get_actions():\\n\"\n+        \"    return [CustomAction()]\\n\"\n+    )\n+\n+    service = ActionsService(command_modules=[str(tmp_path)])\n+\n+    assert service.validate_action_existence(\"custom-action\") is True\n+\n+\n+def test_docker_stack_deploy_action_is_wired_to_the_actions_service():\n+    service = ActionsService()\n+\n+    assert service.actions[\"docker-stack-deploy\"].actions_service is service\n+\n+\n+def test_docker_stack_rm_all_action_is_wired_to_the_actions_service():\n+    service = ActionsService()\n+\n+    assert service.actions[\"docker-stack-rm-all\"].actions_service is service"},{"sha":"df17805757e9c498da97203de00e1aa6312393b6","filename":"on-premise/datasaur-cli/tests/command/test_cli.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_cli.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_cli.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_cli.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,32 @@\n+from click.testing import CliRunner\n+\n+from src import __version__\n+from src.command.cli import cli\n+from src.common import logger\n+\n+\n+def test_version_flag_prints_prog_name_and_version():\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"--version\"])\n+\n+    assert result.exit_code == 0\n+    assert \"datasaur-cli\" in result.output\n+    assert __version__ in result.output\n+\n+\n+def test_verbose_flag_sets_logger_verbosity(monkeypatch):\n+    calls = []\n+    monkeypatch.setattr(logger, \"set_verbosity\", lambda count: calls.append(count))\n+\n+    cli.callback(verbose=2)\n+\n+    assert calls == [2]\n+\n+\n+def test_no_verbose_flag_defaults_to_zero(monkeypatch):\n+    calls = []\n+    monkeypatch.setattr(logger, \"set_verbosity\", lambda count: calls.append(count))\n+\n+    cli.callback(verbose=0)\n+\n+    assert calls == [0]"},{"sha":"191e2a9ba76974f9e72bf129298ca4f3d2a77d84","filename":"on-premise/datasaur-cli/tests/command/test_click_commands_service.py","status":"added","additions":502,"deletions":0,"changes":502,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_click_commands_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_click_commands_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_click_commands_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,502 @@\n+from unittest.mock import MagicMock, patch\n+\n+import click\n+import yaml\n+from click.testing import CliRunner\n+\n+from src.action.actions_service import ActionsService\n+from src.command.click_commands_service import ClickCommandsService\n+\n+\n+def _service_with_fake_action(run_result=True, validate_result=True, options=None):\n+    service = ClickCommandsService()\n+    service.actions_service = ActionsService()\n+    fake_action = MagicMock()\n+    fake_action.options.return_value = options or {}\n+    fake_action.validate.return_value = validate_result\n+    fake_action.run.return_value = run_result\n+    service.actions_service.actions[\"fake\"] = fake_action\n+    return service, fake_action\n+\n+\n+# --- _validate_commands() ---\n+\n+\n+def test_validate_commands_accepts_dict_with_actions_key():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": {\"actions\": [{\"action\": \"fake\"}]}}\n+\n+    assert service._validate_commands(commands) is True\n+\n+\n+def test_validate_commands_accepts_plain_list_format():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": [{\"action\": \"fake\"}]}\n+\n+    assert service._validate_commands(commands) is True\n+\n+\n+def test_validate_commands_rejects_command_definition_that_is_neither_dict_nor_list():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": \"not-a-valid-shape\"}\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+def test_validate_commands_rejects_actions_value_that_is_not_a_list():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": {\"actions\": {\"not\": \"a list\"}}}\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+def test_validate_commands_rejects_action_missing_required_field():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": [{\"not_action\": \"fake\"}]}\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+def test_validate_commands_rejects_unknown_action_name():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": [{\"action\": \"no-such-action\"}]}\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+def test_validate_commands_stops_at_first_invalid_command():\n+    service, _ = _service_with_fake_action()\n+    commands = {\n+        \"bad\": [{\"action\": \"no-such-action\"}],\n+        \"good\": [{\"action\": \"fake\"}],\n+    }\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+def test_validate_commands_accepts_nested_group_format():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"grp\": {\"sub1\": [{\"action\": \"fake\"}], \"sub2\": [{\"action\": \"fake\"}]}}\n+\n+    assert service._validate_commands(commands) is True\n+\n+\n+def test_validate_commands_rejects_nested_group_with_unknown_action():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"grp\": {\"sub1\": [{\"action\": \"no-such-action\"}]}}\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+def test_validate_commands_rejects_nested_group_subcommand_that_is_not_a_list():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"grp\": {\"sub1\": \"not-a-list\"}}\n+\n+    assert service._validate_commands(commands) is False\n+\n+\n+# --- _parse_commands() ---\n+\n+\n+def test_parse_commands_builds_click_command_for_dict_format_with_config():\n+    service, _ = _service_with_fake_action(options={\"env\": {\"type\": \"string\"}})\n+    commands = {\n+        \"greet\": {\n+            \"actions\": [{\"action\": \"fake\", \"prompts\": {\"name\": {\"text\": \"Your name\"}}}],\n+            \"config\": True,\n+        }\n+    }\n+\n+    click_commands = service._parse_commands(commands)\n+\n+    assert len(click_commands) == 1\n+    cmd = click_commands[0]\n+    assert cmd[\"name\"] == \"greet\"\n+    assert cmd[\"config\"] is True\n+    assert cmd[\"options\"] == [{\"name\": \"env\", \"long\": \"env\", \"type\": \"string\"}]\n+    assert cmd[\"prompts\"] == [\n+        {\"name\": \"name\", \"text\": \"Your name\", \"default\": None, \"hide_input\": False}\n+    ]\n+    assert cmd[\"actions\"] == [{\"action\": \"fake\", \"args\": {}}]\n+\n+\n+def test_parse_commands_builds_click_command_for_plain_list_format_without_config():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": [{\"action\": \"fake\"}]}\n+\n+    click_commands = service._parse_commands(commands)\n+\n+    assert click_commands[0][\"config\"] is False\n+\n+\n+def test_parse_commands_dedups_options_by_name():\n+    service, _ = _service_with_fake_action(options={\"env\": {\"type\": \"string\"}})\n+    commands = {\n+        \"greet\": [{\"action\": \"fake\"}, {\"action\": \"fake\"}],\n+    }\n+\n+    click_commands = service._parse_commands(commands)\n+\n+    assert click_commands[0][\"options\"] == [{\"name\": \"env\", \"long\": \"env\", \"type\": \"string\"}]\n+\n+\n+def test_parse_commands_builds_group_entry_for_nested_dict_without_actions_key():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"grp\": {\"sub1\": [{\"action\": \"fake\"}], \"sub2\": [{\"action\": \"fake\", \"args\": {\"k\": \"v\"}}]}}\n+\n+    click_commands = service._parse_commands(commands)\n+\n+    assert len(click_commands) == 1\n+    cmd = click_commands[0]\n+    assert cmd[\"name\"] == \"grp\"\n+    assert cmd[\"group\"] is True\n+    assert cmd[\"subcommands\"] == [\n+        {\"name\": \"sub1\", \"actions\": [{\"action\": \"fake\", \"args\": {}}]},\n+        {\"name\": \"sub2\", \"actions\": [{\"action\": \"fake\", \"args\": {\"k\": \"v\"}}]},\n+    ]\n+\n+\n+def test_parse_commands_marks_flat_commands_as_not_a_group():\n+    service, _ = _service_with_fake_action()\n+    commands = {\"greet\": [{\"action\": \"fake\"}]}\n+\n+    click_commands = service._parse_commands(commands)\n+\n+    assert click_commands[0][\"group\"] is False\n+\n+\n+# --- _parse_command_options() ---\n+\n+\n+def test_parse_command_options_merges_action_defaults_with_command_overrides():\n+    service, _ = _service_with_fake_action()\n+    action_options = {\"fake\": {\"env\": {\"type\": \"string\", \"short\": \"e\"}}}\n+    command_actions = [{\"action\": \"fake\", \"options\": {\"env\": {\"required\": True}}}]\n+\n+    parsed = service._parse_command_options(command_actions, action_options)\n+\n+    # options2 replaces options1's \"env\" entry wholesale — it's a shallow\n+    # dict merge by option name, not a per-attribute deep merge.\n+    assert parsed == [{\"name\": \"env\", \"long\": \"env\", \"required\": True}]\n+\n+\n+def test_parse_command_options_keeps_only_known_attribute_keys():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [\n+        {\n+            \"action\": \"fake\",\n+            \"options\": {\n+                \"env\": {\n+                    \"short\": \"e\",\n+                    \"long\": \"environment\",\n+                    \"type\": \"string\",\n+                    \"required\": True,\n+                    \"unknown_key\": \"ignored\",\n+                }\n+            },\n+        }\n+    ]\n+\n+    parsed = service._parse_command_options(command_actions, {})\n+\n+    assert parsed == [\n+        {\n+            \"name\": \"env\",\n+            \"long\": \"environment\",\n+            \"short\": \"e\",\n+            \"type\": \"string\",\n+            \"required\": True,\n+        }\n+    ]\n+\n+\n+def test_parse_command_options_treats_missing_action_name_as_no_defaults():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [{\"options\": {\"env\": {\"type\": \"string\"}}}]\n+\n+    parsed = service._parse_command_options(command_actions, {\"fake\": {\"other\": {}}})\n+\n+    assert parsed == [{\"name\": \"env\", \"long\": \"env\", \"type\": \"string\"}]\n+\n+\n+# --- _parse_command_prompts() ---\n+\n+\n+def test_parse_command_prompts_applies_defaults():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [{\"action\": \"fake\", \"prompts\": {\"name\": {\"text\": \"Your name\"}}}]\n+\n+    parsed = service._parse_command_prompts(command_actions)\n+\n+    assert parsed == [{\"name\": \"name\", \"text\": \"Your name\", \"default\": None, \"hide_input\": False}]\n+\n+\n+def test_parse_command_prompts_respects_overrides():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [\n+        {\n+            \"action\": \"fake\",\n+            \"prompts\": {\n+                \"secret\": {\n+                    \"text\": \"Secret\",\n+                    \"default\": \"d\",\n+                    \"hide_input\": True,\n+                    \"default_from_state\": \"saved_secret\",\n+                }\n+            },\n+        }\n+    ]\n+\n+    parsed = service._parse_command_prompts(command_actions)\n+\n+    assert parsed == [\n+        {\n+            \"name\": \"secret\",\n+            \"text\": \"Secret\",\n+            \"default\": \"d\",\n+            \"hide_input\": True,\n+            \"default_from_state\": \"saved_secret\",\n+        }\n+    ]\n+\n+\n+def test_parse_command_prompts_skips_actions_without_prompts():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [{\"action\": \"fake\"}]\n+\n+    assert service._parse_command_prompts(command_actions) == []\n+\n+\n+# --- _parse_command_actions() ---\n+\n+\n+def test_parse_command_actions_defaults_args_to_empty_dict():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [{\"action\": \"fake\"}]\n+\n+    assert service._parse_command_actions(command_actions) == [{\"action\": \"fake\", \"args\": {}}]\n+\n+\n+def test_parse_command_actions_preserves_given_args():\n+    service, _ = _service_with_fake_action()\n+    command_actions = [{\"action\": \"fake\", \"args\": {\"key\": \"value\"}}]\n+\n+    assert service._parse_command_actions(command_actions) == [\n+        {\"action\": \"fake\", \"args\": {\"key\": \"value\"}}\n+    ]\n+\n+\n+# --- register() / _register_commands() (end to end via a fresh click.Group) ---\n+\n+\n+def test_register_returns_false_when_validation_fails():\n+    # register() constructs its own real ActionsService internally, so no\n+    # fake action is needed here — \"no-such-action\" is invalid regardless.\n+    service = ClickCommandsService()\n+    commands = {\"greet\": [{\"action\": \"no-such-action\"}]}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=click.Group()) as fresh_cli:\n+        result = service.register(commands)\n+\n+    assert result is False\n+    assert fresh_cli.commands == {}\n+\n+\n+def test_register_command_calls_actions_service_run_with_expected_context():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    service.user_prompts_service.get = MagicMock(return_value={\"who\": \"alice\"})\n+    commands = {\"greet\": [{\"action\": \"fake\"}]}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    service.actions_service.run = MagicMock(return_value=True)\n+    CliRunner().invoke(fresh_cli, [\"greet\"])\n+\n+    service.actions_service.run.assert_called_once()\n+    context, actions = service.actions_service.run.call_args.args\n+    assert context[\"command_name\"] == \"greet\"\n+    assert context[\"prompt_values\"] == {\"who\": \"alice\"}\n+    assert actions == [{\"action\": \"fake\", \"args\": {}}]\n+\n+\n+def test_register_command_reads_config_file_and_skips_prompting_for_matching_keys(tmp_path):\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    config_path = tmp_path / \"config.yaml\"\n+    config_path.write_text(yaml.dump({\"name\": \"alice\"}))\n+    commands = {\n+        \"greet\": {\n+            \"actions\": [{\"action\": \"fake\", \"prompts\": {\"name\": {\"text\": \"Your name\"}}}],\n+            \"config\": True,\n+        }\n+    }\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    result = CliRunner().invoke(fresh_cli, [\"greet\", \"--config\", str(config_path)])\n+\n+    assert result.exit_code == 0\n+    context, _ = service.actions_service.run.call_args.args\n+    assert context[\"prompt_values\"] == {\"name\": \"alice\"}\n+\n+\n+def test_register_command_returns_early_when_config_file_read_fails(tmp_path):\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    commands = {\n+        \"greet\": {\n+            \"actions\": [{\"action\": \"fake\"}],\n+            \"config\": True,\n+        }\n+    }\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    # Make the config file a directory so YamlFile().read() fails.\n+    bad_config = tmp_path / \"config.yaml\"\n+    bad_config.mkdir()\n+\n+    CliRunner().invoke(fresh_cli, [\"greet\", \"--config\", str(bad_config)])\n+\n+    service.actions_service.run.assert_not_called()\n+\n+\n+def test_register_command_applies_registered_click_option():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    service.user_prompts_service.get = MagicMock(return_value={})\n+    commands = {\"greet\": [{\"action\": \"fake\", \"options\": {\"env\": {\"type\": \"string\"}}}]}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    result = CliRunner().invoke(fresh_cli, [\"greet\", \"--env\", \"prod\"])\n+\n+    assert result.exit_code == 0\n+    context, _ = service.actions_service.run.call_args.args\n+    assert context[\"option_values\"][\"env\"] == \"prod\"\n+\n+\n+def test_register_does_not_expose_config_option_when_config_is_false():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    commands = {\"greet\": [{\"action\": \"fake\"}]}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    result = CliRunner().invoke(fresh_cli, [\"greet\", \"--config\", \"whatever\"])\n+\n+    assert result.exit_code != 0\n+    assert \"No such option\" in result.output\n+\n+\n+def test_register_group_command_creates_click_group_with_subcommands():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    commands = {\"grp\": {\"sub1\": [{\"action\": \"fake\"}]}}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    assert isinstance(fresh_cli.commands[\"grp\"], click.Group)\n+    assert set(fresh_cli.commands[\"grp\"].commands.keys()) == {\"sub1\"}\n+\n+    result = CliRunner().invoke(fresh_cli, [\"grp\", \"sub1\"])\n+\n+    assert result.exit_code == 0\n+    service.actions_service.run.assert_called_once()\n+    context, actions = service.actions_service.run.call_args.args\n+    assert context[\"command_name\"] == \"grp sub1\"\n+    assert context[\"option_values\"] == {}\n+    assert context[\"prompt_values\"] == {}\n+    assert actions == [{\"action\": \"fake\", \"args\": {}}]\n+\n+\n+def test_register_group_with_multiple_subcommands_keeps_each_actions_list_independent():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    commands = {\"grp\": {\"sub1\": [{\"action\": \"fake\", \"args\": {\"k\": \"1\"}}], \"sub2\": [{\"action\": \"fake\", \"args\": {\"k\": \"2\"}}]}}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    CliRunner().invoke(fresh_cli, [\"grp\", \"sub2\"])\n+\n+    _, actions = service.actions_service.run.call_args.args\n+    assert actions == [{\"action\": \"fake\", \"args\": {\"k\": \"2\"}}]\n+\n+\n+def test_register_group_subcommand_exits_nonzero_on_action_failure():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    commands = {\"grp\": {\"sub1\": [{\"action\": \"fake\"}]}}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=False)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    result = CliRunner().invoke(fresh_cli, [\"grp\", \"sub1\"])\n+\n+    assert result.exit_code == 1\n+\n+\n+def test_register_mixes_flat_and_group_commands():\n+    fresh_cli = click.Group()\n+    service = ClickCommandsService()\n+    service.user_prompts_service.get = MagicMock(return_value={})\n+    commands = {\"greet\": [{\"action\": \"fake\"}], \"grp\": {\"sub1\": [{\"action\": \"fake\"}]}}\n+\n+    with patch(\"src.command.click_commands_service.cli\", new=fresh_cli):\n+        service.actions_service = ActionsService()\n+        service.actions_service.actions[\"fake\"] = MagicMock(options=MagicMock(return_value={}))\n+        service.actions_service.run = MagicMock(return_value=True)\n+        assert service._validate_commands(commands) is True\n+        click_commands = service._parse_commands(commands)\n+        service._register_commands(click_commands)\n+\n+    assert isinstance(fresh_cli.commands[\"greet\"], click.Command)\n+    assert not isinstance(fresh_cli.commands[\"greet\"], click.Group)\n+    assert isinstance(fresh_cli.commands[\"grp\"], click.Group)"},{"sha":"a7fad1e75655b0c70cc15ab645f756d16edf62a0","filename":"on-premise/datasaur-cli/tests/command/test_stack_commands_service.py","status":"added","additions":226,"deletions":0,"changes":226,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_stack_commands_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_stack_commands_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommand%2Ftest_stack_commands_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,226 @@\n+from unittest.mock import MagicMock\n+\n+import click\n+from click.testing import CliRunner\n+\n+from src.command.stack_commands_service import StackCommandsService\n+\n+\n+def test_discover_stacks_finds_only_dirs_with_stack_yaml(tmp_path):\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"images\").mkdir()  # no stack.yaml — must be ignored\n+    (tmp_path / \"manifest.yaml\").write_text(\"version: '1'\\n\")  # a file, not a dir\n+\n+    result = StackCommandsService().discover_stacks(tmp_path)\n+\n+    assert result == [\"proxy\", \"registry\"]\n+\n+\n+def test_discover_stacks_returns_empty_list_when_none_found(tmp_path):\n+    (tmp_path / \"images\").mkdir()\n+\n+    result = StackCommandsService().discover_stacks(tmp_path)\n+\n+    assert result == []\n+\n+\n+def test_register_creates_flat_and_nested_commands(tmp_path):\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path)\n+\n+    assert set(cli.commands.keys()) == {\"up\", \"down\", \"restart\", \"dump-logs\", \"upgrade\", \"proxy\"}\n+    assert isinstance(cli.commands[\"proxy\"], click.Group)\n+    assert set(cli.commands[\"proxy\"].commands.keys()) == {\"up\", \"down\", \"restart\", \"dump-logs\", \"upgrade\"}\n+\n+\n+def test_single_stack_up_runs_docker_stack_deploy_for_only_that_stack(tmp_path):\n+    for name in [\"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path)\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"proxy\", \"up\"])\n+\n+    assert result.exit_code == 0\n+    actions_service.run.assert_called_once()\n+    _, called_actions = actions_service.run.call_args.args\n+    assert called_actions == [{\"action\": \"docker-stack-deploy\", \"args\": {\"stack\": \"proxy\"}}]\n+\n+\n+def test_flat_up_runs_docker_stack_deploy_for_every_stack(tmp_path):\n+    for name in [\"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path)\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"up\"])\n+\n+    assert result.exit_code == 0\n+    assert actions_service.run.call_count == 2\n+    deployed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in actions_service.run.call_args_list]\n+    assert deployed_stacks == [\"proxy\", \"registry\"]\n+\n+\n+def test_flat_command_stops_on_the_first_stack_that_fails(tmp_path):\n+    for name in [\"a\", \"b\", \"c\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.side_effect = [True, False, True]\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path)\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"up\"])\n+\n+    assert result.exit_code == 1\n+    assert actions_service.run.call_count == 2\n+\n+\n+def test_restart_runs_rm_then_deploy():\n+    actions = StackCommandsService()._actions_for(\"restart\", \"proxy\")\n+\n+    assert actions == [\n+        {\"action\": \"docker-stack-rm\", \"args\": {\"stack\": \"proxy\"}},\n+        {\"action\": \"docker-stack-deploy\", \"args\": {\"stack\": \"proxy\"}},\n+    ]\n+\n+\n+def test_upgrade_reloads_images_then_deploys():\n+    actions = StackCommandsService()._actions_for(\"upgrade\", \"registry\")\n+\n+    assert actions == [\n+        {\"action\": \"load-docker-images\", \"args\": {}},\n+        {\"action\": \"docker-stack-deploy\", \"args\": {\"stack\": \"registry\"}},\n+    ]\n+\n+\n+def test_order_stacks_puts_named_stacks_first_in_the_given_order():\n+    result = StackCommandsService().order_stacks(\n+        discovered=[\"hello\", \"proxy\", \"registry\"], stack_order=[\"proxy\", \"registry\", \"hello\"]\n+    )\n+\n+    assert result == [\"proxy\", \"registry\", \"hello\"]\n+\n+\n+def test_order_stacks_appends_undeclared_stacks_after_the_named_ones():\n+    result = StackCommandsService().order_stacks(\n+        discovered=[\"hello\", \"new-stack\", \"proxy\", \"registry\"], stack_order=[\"proxy\", \"registry\", \"hello\"]\n+    )\n+\n+    assert result == [\"proxy\", \"registry\", \"hello\", \"new-stack\"]\n+\n+\n+def test_order_stacks_drops_named_stacks_that_were_not_discovered():\n+    result = StackCommandsService().order_stacks(discovered=[\"proxy\"], stack_order=[\"proxy\", \"registry\", \"hello\"])\n+\n+    assert result == [\"proxy\"]\n+\n+\n+def test_flat_up_follows_explicit_stack_order_not_alphabetical(tmp_path):\n+    for name in [\"hello\", \"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path, [\"proxy\", \"registry\", \"hello\"])\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"up\"])\n+\n+    assert result.exit_code == 0\n+    deployed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in actions_service.run.call_args_list]\n+    assert deployed_stacks == [\"proxy\", \"registry\", \"hello\"]\n+\n+\n+def test_flat_down_reverses_the_explicit_stack_order(tmp_path):\n+    for name in [\"hello\", \"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path, [\"proxy\", \"registry\", \"hello\"])\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"down\"])\n+\n+    assert result.exit_code == 0\n+    removed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in actions_service.run.call_args_list]\n+    assert removed_stacks == [\"hello\", \"registry\", \"proxy\"]\n+\n+\n+def test_flat_restart_downs_everything_in_reverse_order_then_ups_everything_in_order(tmp_path):\n+    for name in [\"hello\", \"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path, [\"proxy\", \"registry\", \"hello\"])\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"restart\"])\n+\n+    assert result.exit_code == 0\n+    calls = [\n+        (call.args[0][\"command_name\"], call.args[1][0][\"action\"], call.args[1][0][\"args\"][\"stack\"])\n+        for call in actions_service.run.call_args_list\n+    ]\n+    assert calls == [\n+        (\"down (hello)\", \"docker-stack-rm\", \"hello\"),\n+        (\"down (registry)\", \"docker-stack-rm\", \"registry\"),\n+        (\"down (proxy)\", \"docker-stack-rm\", \"proxy\"),\n+        (\"up (proxy)\", \"docker-stack-deploy\", \"proxy\"),\n+        (\"up (registry)\", \"docker-stack-deploy\", \"registry\"),\n+        (\"up (hello)\", \"docker-stack-deploy\", \"hello\"),\n+    ]\n+\n+\n+def test_flat_up_without_explicit_order_falls_back_to_alphabetical(tmp_path):\n+    for name in [\"hello\", \"proxy\", \"registry\"]:\n+        (tmp_path / name).mkdir()\n+        (tmp_path / name / \"stack.yaml\").write_text(\"services: {}\\n\")\n+\n+    actions_service = MagicMock()\n+    actions_service.run.return_value = True\n+\n+    cli = click.Group(name=\"cli\")\n+    StackCommandsService().register(cli, actions_service, tmp_path)\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"down\"])\n+\n+    assert result.exit_code == 0\n+    removed_stacks = [call.args[1][0][\"args\"][\"stack\"] for call in actions_service.run.call_args_list]\n+    assert removed_stacks == [\"hello\", \"proxy\", \"registry\"]"},{"sha":"ca856144707b8dc71629b93a09cb91c7bea0b8a1","filename":"on-premise/datasaur-cli/tests/common/test_datasaur_graphql_action.py","status":"added","additions":120,"deletions":0,"changes":120,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_datasaur_graphql_action.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_datasaur_graphql_action.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_datasaur_graphql_action.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,120 @@\n+from unittest.mock import patch\n+\n+from src.common.datasaur_graphql_action import DatasaurGraphQLAction\n+from src.common.state_service import StateService\n+\n+VALID_ARGS = {\n+    \"api_url\": \"https://api.example.com\",\n+    \"client_id\": \"client-1\",\n+    \"client_secret\": \"secret\",\n+    \"mutation\": \"mutation { createFoo { id } }\",\n+}\n+\n+\n+def test_name_returns_expected_action_name():\n+    assert DatasaurGraphQLAction().name() == \"datasaur-graphql\"\n+\n+\n+def test_options_returns_empty_dict():\n+    assert DatasaurGraphQLAction().options() == {}\n+\n+\n+def test_validate_returns_true_for_valid_args():\n+    assert DatasaurGraphQLAction().validate(dict(VALID_ARGS)) is True\n+\n+\n+def test_validate_returns_false_when_required_field_missing():\n+    args = dict(VALID_ARGS)\n+    del args[\"mutation\"]\n+\n+    assert DatasaurGraphQLAction().validate(args) is False\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\")\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\")\n+def test_run_fetches_token_and_returns_true_on_success(mock_get_token, mock_graphql):\n+    mock_get_token.return_value = \"tok-1\"\n+    mock_graphql.return_value = {\"createFoo\": {\"id\": \"abc\"}}\n+    args = dict(VALID_ARGS, client_id=\"client-run-success\")\n+\n+    result = DatasaurGraphQLAction().run({}, args)\n+\n+    assert result is True\n+    mock_get_token.assert_called_once_with(\n+        \"https://api.example.com\", \"client-run-success\", \"secret\"\n+    )\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\")\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\")\n+def test_run_reuses_cached_token_on_second_call(mock_get_token, mock_graphql):\n+    mock_get_token.return_value = \"tok-2\"\n+    mock_graphql.return_value = {\"createFoo\": {\"id\": \"abc\"}}\n+    args = dict(VALID_ARGS, client_id=\"client-run-cache\")\n+\n+    DatasaurGraphQLAction().run({}, args)\n+    DatasaurGraphQLAction().run({}, args)\n+\n+    mock_get_token.assert_called_once()\n+    assert mock_graphql.call_count == 2\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\")\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\", return_value=None)\n+def test_run_returns_false_when_token_fetch_fails(mock_get_token, mock_graphql):\n+    args = dict(VALID_ARGS, client_id=\"client-run-no-token\")\n+\n+    result = DatasaurGraphQLAction().run({}, args)\n+\n+    assert result is False\n+    mock_graphql.assert_not_called()\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\", return_value=None)\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\", return_value=\"tok-3\")\n+def test_run_returns_false_when_graphql_call_fails(mock_get_token, mock_graphql):\n+    args = dict(VALID_ARGS, client_id=\"client-run-graphql-fail\")\n+\n+    assert DatasaurGraphQLAction().run({}, args) is False\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\")\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\", return_value=\"tok-4\")\n+def test_run_saves_extracted_nested_value_into_state(mock_get_token, mock_graphql, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    mock_graphql.return_value = {\"createFoo\": {\"id\": \"abc-123\"}}\n+    args = dict(\n+        VALID_ARGS,\n+        client_id=\"client-run-save-state\",\n+        save_state={\"foo_id\": \"createFoo.id\"},\n+    )\n+\n+    assert DatasaurGraphQLAction().run({}, args) is True\n+    value, ok = StateService().get(\"foo_id\")\n+    assert ok is True\n+    assert value == \"abc-123\"\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\")\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\", return_value=\"tok-5\")\n+def test_run_auto_saves_api_url_and_team_id(mock_get_token, mock_graphql, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    mock_graphql.return_value = {\"createFoo\": {\"id\": \"abc\"}}\n+    args = dict(VALID_ARGS, client_id=\"client-run-auto-save\", team_id=\"team-42\")\n+\n+    assert DatasaurGraphQLAction().run({}, args) is True\n+    api_url_value, _ = StateService().get(\"api_url\")\n+    team_id_value, _ = StateService().get(\"team_id\")\n+    assert api_url_value == \"https://api.example.com\"\n+    assert team_id_value == \"team-42\"\n+\n+\n+@patch(\"src.common.datasaur_graphql_action.graphql\")\n+@patch(\"src.common.datasaur_graphql_action.get_access_token\", return_value=\"tok-6\")\n+def test_run_passes_empty_dict_when_variables_omitted(mock_get_token, mock_graphql):\n+    mock_graphql.return_value = {}\n+    args = dict(VALID_ARGS, client_id=\"client-run-no-vars\")\n+\n+    DatasaurGraphQLAction().run({}, args)\n+\n+    assert mock_graphql.call_args.kwargs[\"variables\"] == {}"},{"sha":"4b69050d1b41485011be3faca084ce8ffec610c7","filename":"on-premise/datasaur-cli/tests/common/test_directory_validator.py","status":"added","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_directory_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_directory_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_directory_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,44 @@\n+import os\n+\n+from src.common.directory_validator import DirectoryValidator\n+\n+\n+def test_validate_returns_true_for_existing_directory_with_correct_permissions(tmp_path):\n+    dir_path = tmp_path / \"a_directory\"\n+    dir_path.mkdir()\n+    os.chmod(dir_path, 0o755)\n+\n+    assert DirectoryValidator().validate(str(dir_path)) is True\n+\n+\n+def test_validate_returns_false_when_directory_missing(tmp_path):\n+    missing_path = tmp_path / \"missing_directory\"\n+\n+    assert DirectoryValidator().validate(str(missing_path)) is False\n+\n+\n+def test_validate_returns_false_when_path_is_a_file(tmp_path):\n+    file_path = tmp_path / \"not_a_directory\"\n+    file_path.write_text(\"content\")\n+\n+    assert DirectoryValidator().validate(str(file_path)) is False\n+\n+\n+def test_validate_returns_false_when_permissions_incorrect(tmp_path):\n+    dir_path = tmp_path / \"a_directory\"\n+    dir_path.mkdir()\n+    os.chmod(dir_path, 0o700)\n+\n+    assert DirectoryValidator().validate(str(dir_path)) is False\n+\n+\n+def test_directory_has_correct_permissions_validator_accepts_0755_and_0775(tmp_path):\n+    dir_path = tmp_path / \"a_directory\"\n+    dir_path.mkdir()\n+    validator = DirectoryValidator()\n+\n+    os.chmod(dir_path, 0o755)\n+    assert validator.directory_has_correct_permissions_validator(str(dir_path)) is True\n+\n+    os.chmod(dir_path, 0o775)\n+    assert validator.directory_has_correct_permissions_validator(str(dir_path)) is True"},{"sha":"931bd00d0189055ae97cf1c7ea49c633434b0310","filename":"on-premise/datasaur-cli/tests/common/test_docker_compose_env_service.py","status":"added","additions":61,"deletions":0,"changes":61,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_docker_compose_env_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_docker_compose_env_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_docker_compose_env_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,61 @@\n+from src.common.docker_compose_env_service import (\n+    DEFAULT_CI_REGISTRY,\n+    DockerComposeEnvService,\n+)\n+\n+\n+def test_build_env_uses_existing_docker_tag_env_var(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"DOCKER_TAG\", \"1.2.3\")\n+\n+    env = DockerComposeEnvService().build_env()\n+\n+    assert env[\"DOCKER_TAG\"] == \"1.2.3\"\n+\n+\n+def test_build_env_reads_docker_tag_from_version_file(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"DOCKER_TAG\", raising=False)\n+    (tmp_path / \"version\").write_text(\"4.5.6\\n\")\n+\n+    env = DockerComposeEnvService().build_env()\n+\n+    assert env[\"DOCKER_TAG\"] == \"4.5.6\"\n+\n+\n+def test_build_env_omits_docker_tag_when_no_env_var_and_no_version_file(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"DOCKER_TAG\", raising=False)\n+\n+    env = DockerComposeEnvService().build_env()\n+\n+    assert \"DOCKER_TAG\" not in env\n+\n+\n+def test_build_env_omits_docker_tag_when_version_file_unreadable(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"DOCKER_TAG\", raising=False)\n+    # Make \"version\" a directory so read_text() raises, hitting the except branch.\n+    (tmp_path / \"version\").mkdir()\n+\n+    env = DockerComposeEnvService().build_env()\n+\n+    assert \"DOCKER_TAG\" not in env\n+\n+\n+def test_build_env_defaults_ci_registry_when_unset(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.delenv(\"CI_REGISTRY\", raising=False)\n+\n+    env = DockerComposeEnvService().build_env()\n+\n+    assert env[\"CI_REGISTRY\"] == DEFAULT_CI_REGISTRY\n+\n+\n+def test_build_env_keeps_existing_ci_registry(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setenv(\"CI_REGISTRY\", \"custom.registry.example.com\")\n+\n+    env = DockerComposeEnvService().build_env()\n+\n+    assert env[\"CI_REGISTRY\"] == \"custom.registry.example.com\""},{"sha":"d96830b4759f47ce54923b9c0a20d28561e5cf8e","filename":"on-premise/datasaur-cli/tests/common/test_env_file.py","status":"added","additions":66,"deletions":0,"changes":66,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_env_file.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_env_file.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_env_file.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,66 @@\n+from src.common.env_file import EnvFile\n+\n+\n+def test_read_returns_not_ok_when_file_missing_and_no_create(tmp_path):\n+    file_path = tmp_path / \".env\"\n+\n+    content, ok = EnvFile().read(file_path)\n+\n+    assert content is None\n+    assert ok is False\n+\n+\n+def test_read_creates_file_when_missing_and_create_if_not_exists(tmp_path):\n+    file_path = tmp_path / \"nested\" / \".env\"\n+\n+    content, ok = EnvFile().read(file_path, create_if_not_exists=True)\n+\n+    assert ok is True\n+    assert content == {}\n+    assert file_path.exists()\n+\n+\n+def test_read_parses_existing_env_file(tmp_path):\n+    file_path = tmp_path / \".env\"\n+    file_path.write_text(\"FOO=bar\\nBAZ=qux\\n\")\n+\n+    content, ok = EnvFile().read(file_path)\n+\n+    assert ok is True\n+    assert content == {\"FOO\": \"bar\", \"BAZ\": \"qux\"}\n+\n+\n+def test_write_creates_file_with_key_value_lines(tmp_path):\n+    file_path = tmp_path / \".env\"\n+\n+    ok = EnvFile().write(file_path, {\"FOO\": \"bar\", \"BAZ\": \"qux\"})\n+\n+    assert ok is True\n+    assert file_path.read_text() == 'FOO=\"bar\"\\nBAZ=\"qux\"\\n'\n+\n+\n+def test_write_escapes_embedded_quotes_and_backslashes(tmp_path):\n+    file_path = tmp_path / \".env\"\n+\n+    ok = EnvFile().write(file_path, {\"FOO\": 'ba\"r\\\\baz'})\n+\n+    assert ok is True\n+    assert file_path.read_text() == 'FOO=\"ba\\\\\"r\\\\\\\\baz\"\\n'\n+\n+\n+def test_write_then_read_round_trips_a_value_containing_dollar_sign(tmp_path):\n+    file_path = tmp_path / \".env\"\n+\n+    EnvFile().write(file_path, {\"PASSWORD\": \"$ecretw0rd\"})\n+    content, ok = EnvFile().read(file_path)\n+\n+    assert ok is True\n+    assert content == {\"PASSWORD\": \"$ecretw0rd\"}\n+\n+\n+def test_write_returns_false_when_parent_directory_missing(tmp_path):\n+    file_path = tmp_path / \"missing_dir\" / \".env\"\n+\n+    ok = EnvFile().write(file_path, {\"FOO\": \"bar\"})\n+\n+    assert ok is False"},{"sha":"b9ffec4b85a2117446868a906d349e52ff33e1d6","filename":"on-premise/datasaur-cli/tests/common/test_event_log.py","status":"added","additions":90,"deletions":0,"changes":90,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_event_log.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_event_log.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_event_log.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,90 @@\n+import json\n+\n+from src.common import event_log\n+\n+\n+def read_events(tmp_path):\n+    log_path = tmp_path / \"datasaur-cli.log\"\n+    return [json.loads(line) for line in log_path.read_text().splitlines()]\n+\n+\n+def test_record_writes_one_json_line_with_expected_fields(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    event_log.record(\n+        command=\"start\",\n+        action_number=2,\n+        action_name=\"generate-htpasswd-secret\",\n+        args={\"username\": \"admin\"},\n+        sensitive_keys=[],\n+        duration_ms=184,\n+        outcome=\"success\",\n+    )\n+\n+    events = read_events(tmp_path)\n+    assert len(events) == 1\n+    event = events[0]\n+    assert event[\"command\"] == \"start\"\n+    assert event[\"action_number\"] == 2\n+    assert event[\"action\"] == \"generate-htpasswd-secret\"\n+    assert event[\"args\"] == {\"username\": \"admin\"}\n+    assert event[\"duration_ms\"] == 184\n+    assert event[\"outcome\"] == \"success\"\n+    assert event[\"error\"] is None\n+    assert isinstance(event[\"ts\"], str) and event[\"ts\"].endswith(\"Z\")\n+\n+\n+def test_record_appends_across_multiple_calls(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    event_log.record(\n+        command=\"start\", action_number=0, action_name=\"a\", args={},\n+        sensitive_keys=[], duration_ms=1, outcome=\"success\",\n+    )\n+    event_log.record(\n+        command=\"start\", action_number=1, action_name=\"b\", args={},\n+        sensitive_keys=[], duration_ms=2, outcome=\"success\",\n+    )\n+\n+    assert len(read_events(tmp_path)) == 2\n+\n+\n+def test_record_includes_error_dict_when_given(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    event_log.record(\n+        command=\"start\", action_number=0, action_name=\"a\", args={},\n+        sensitive_keys=[], duration_ms=5, outcome=\"error\",\n+        error={\"type\": \"RuntimeError\", \"message\": \"boom\", \"traceback\": \"Traceback...\"},\n+    )\n+\n+    event = read_events(tmp_path)[0]\n+    assert event[\"error\"] == {\"type\": \"RuntimeError\", \"message\": \"boom\", \"traceback\": \"Traceback...\"}\n+\n+\n+def test_record_redacts_keys_named_in_sensitive_keys(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    event_log.record(\n+        command=\"start\", action_number=0, action_name=\"a\",\n+        args={\"htpasswd_line\": \"admin:$apr1$abc\", \"username\": \"admin\"},\n+        sensitive_keys=[\"htpasswd_line\"], duration_ms=1, outcome=\"success\",\n+    )\n+\n+    event = read_events(tmp_path)[0]\n+    assert event[\"args\"][\"htpasswd_line\"] == \"***\"\n+    assert event[\"args\"][\"username\"] == \"admin\"\n+\n+\n+def test_record_redacts_keys_matching_the_heuristic_even_when_not_declared(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    event_log.record(\n+        command=\"start\", action_number=0, action_name=\"a\",\n+        args={\"api_token\": \"shh\", \"username\": \"admin\"},\n+        sensitive_keys=[], duration_ms=1, outcome=\"success\",\n+    )\n+\n+    event = read_events(tmp_path)[0]\n+    assert event[\"args\"][\"api_token\"] == \"***\"\n+    assert event[\"args\"][\"username\"] == \"admin\""},{"sha":"c2f17edcdc906a771a7e520b9ab96691b6333c54","filename":"on-premise/datasaur-cli/tests/common/test_file_validator.py","status":"added","additions":52,"deletions":0,"changes":52,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_file_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_file_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_file_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,52 @@\n+import os\n+\n+from src.common.file_validator import FileValidator\n+\n+\n+def test_validate_returns_true_for_existing_file_with_correct_permissions(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    os.chmod(file_path, 0o644)\n+\n+    assert FileValidator().validate(str(file_path)) is True\n+\n+\n+def test_validate_returns_false_when_file_missing(tmp_path):\n+    missing_path = tmp_path / \"missing.yaml\"\n+\n+    assert FileValidator().validate(str(missing_path)) is False\n+\n+\n+def test_validate_returns_false_when_path_is_a_directory(tmp_path):\n+    dir_path = tmp_path / \"a_directory\"\n+    dir_path.mkdir()\n+\n+    assert FileValidator().validate(str(dir_path)) is False\n+\n+\n+def test_validate_returns_false_when_permissions_incorrect(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    os.chmod(file_path, 0o600)\n+\n+    assert FileValidator().validate(str(file_path)) is False\n+\n+\n+def test_validate_skips_permission_check_when_disabled(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    os.chmod(file_path, 0o600)\n+\n+    assert FileValidator().validate(str(file_path), check_permissions=False) is True\n+\n+\n+def test_file_has_correct_permissions_validator_accepts_0644_and_0664(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    validator = FileValidator()\n+\n+    os.chmod(file_path, 0o644)\n+    assert validator.file_has_correct_permissions_validator(str(file_path)) is True\n+\n+    os.chmod(file_path, 0o664)\n+    assert validator.file_has_correct_permissions_validator(str(file_path)) is True"},{"sha":"21a858bda4a1dfeae4d38c4ab5c974413b656ecf","filename":"on-premise/datasaur-cli/tests/common/test_helper.py","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_helper.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_helper.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_helper.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,43 @@\n+from src.common.helper import redact_if_sensitive, unique_list\n+\n+\n+def test_redact_if_sensitive_masks_secret_key():\n+    assert redact_if_sensitive(\"api_secret\", \"hunter2\") == \"***\"\n+\n+\n+def test_redact_if_sensitive_masks_password_key_case_insensitive():\n+    assert redact_if_sensitive(\"DB_PASSWORD\", \"hunter2\") == \"***\"\n+\n+\n+def test_redact_if_sensitive_masks_token_and_credential_keys():\n+    assert redact_if_sensitive(\"auth_token\", \"abc\") == \"***\"\n+    assert redact_if_sensitive(\"aws_credential\", \"abc\") == \"***\"\n+\n+\n+def test_redact_if_sensitive_matches_key_as_substring():\n+    # \"key\" is checked as a substring of the lowercased key name, so any key\n+    # containing \"key\" is redacted, including unrelated words like \"monkey\".\n+    # This documents existing behavior; it is not a bug fix.\n+    assert redact_if_sensitive(\"monkey\", \"value\") == \"***\"\n+\n+\n+def test_redact_if_sensitive_passes_through_non_sensitive_key():\n+    assert redact_if_sensitive(\"username\", \"alice\") == \"alice\"\n+\n+\n+def test_redact_if_sensitive_stringifies_non_string_value():\n+    assert redact_if_sensitive(\"count\", 42) == \"42\"\n+\n+\n+def test_unique_list_removes_duplicates_by_key_keeping_first():\n+    items = [\n+        {\"id\": 1, \"name\": \"a\"},\n+        {\"id\": 2, \"name\": \"b\"},\n+        {\"id\": 1, \"name\": \"a-dup\"},\n+    ]\n+    result = unique_list(items, \"id\")\n+    assert result == [{\"id\": 1, \"name\": \"a\"}, {\"id\": 2, \"name\": \"b\"}]\n+\n+\n+def test_unique_list_returns_empty_for_empty_input():\n+    assert unique_list([], \"id\") == []"},{"sha":"61eac02b08d171254047f15af87b20f0f32b64ee","filename":"on-premise/datasaur-cli/tests/common/test_image_digest_validator.py","status":"added","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_image_digest_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_image_digest_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_image_digest_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,46 @@\n+from hashlib import sha256\n+\n+from src.common.image_digest_validator import ImageDigestValidator\n+\n+\n+def test_validate_returns_true_when_no_sha256_file(tmp_path):\n+    file_path = tmp_path / \"image.tar\"\n+    file_path.write_bytes(b\"image-bytes\")\n+\n+    assert ImageDigestValidator().validate(str(file_path)) is True\n+\n+\n+def test_validate_returns_true_when_digest_matches(tmp_path):\n+    file_path = tmp_path / \"image.tar\"\n+    file_path.write_bytes(b\"image-bytes\")\n+    digest = sha256(b\"image-bytes\").hexdigest()\n+    (tmp_path / \"image.tar.sha256\").write_text(f\"sha256:{digest}\\n\")\n+\n+    assert ImageDigestValidator().validate(str(file_path)) is True\n+\n+\n+def test_validate_returns_true_when_digest_matches_without_sha256_prefix(tmp_path):\n+    file_path = tmp_path / \"image.tar\"\n+    file_path.write_bytes(b\"image-bytes\")\n+    digest = sha256(b\"image-bytes\").hexdigest()\n+    (tmp_path / \"image.tar.sha256\").write_text(digest)\n+\n+    assert ImageDigestValidator().validate(str(file_path)) is True\n+\n+\n+def test_validate_returns_false_when_digest_mismatches(tmp_path):\n+    file_path = tmp_path / \"image.tar\"\n+    file_path.write_bytes(b\"image-bytes\")\n+    (tmp_path / \"image.tar.sha256\").write_text(\"sha256:deadbeef\")\n+\n+    assert ImageDigestValidator().validate(str(file_path)) is False\n+\n+\n+def test_validate_returns_false_when_sha256_file_cannot_be_read(tmp_path):\n+    file_path = tmp_path / \"image.tar\"\n+    file_path.write_bytes(b\"image-bytes\")\n+    # Make the .sha256 path a directory so open() raises IsADirectoryError,\n+    # exercising the except branch without mocking.\n+    (tmp_path / \"image.tar.sha256\").mkdir()\n+\n+    assert ImageDigestValidator().validate(str(file_path)) is False"},{"sha":"501047ec6dc2b7de14b646a502c44cdbe96b078f","filename":"on-premise/datasaur-cli/tests/common/test_logger.py","status":"added","additions":76,"deletions":0,"changes":76,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_logger.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_logger.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_logger.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,76 @@\n+from src.common import logger\n+\n+\n+def teardown_function():\n+    logger.set_verbosity(0)\n+\n+\n+def test_set_verbosity_zero_is_the_default_info_threshold():\n+    logger.set_verbosity(0)\n+    assert logger._threshold == logger.INFO\n+\n+\n+def test_set_verbosity_one_lowers_threshold_to_debug():\n+    logger.set_verbosity(1)\n+    assert logger._threshold == logger.DEBUG\n+\n+\n+def test_set_verbosity_two_or_more_lowers_threshold_to_trace():\n+    logger.set_verbosity(2)\n+    assert logger._threshold == logger.TRACE\n+    logger.set_verbosity(5)\n+    assert logger._threshold == logger.TRACE\n+\n+\n+def test_info_prints_plain_message_at_default_verbosity(capsys):\n+    logger.set_verbosity(0)\n+    logger.info(\"Validating commands...\")\n+    assert capsys.readouterr().out == \"Validating commands...\\n\"\n+\n+\n+def test_info_applies_style_when_color_kwarg_given(capsys):\n+    logger.set_verbosity(0)\n+    logger.info(\"✓ Commands are valid\", fg=\"green\")\n+    assert capsys.readouterr().out == \"✓ Commands are valid\\n\"\n+\n+\n+def test_info_blank_call_prints_blank_line(capsys):\n+    logger.set_verbosity(0)\n+    logger.info()\n+    assert capsys.readouterr().out == \"\\n\"\n+\n+\n+def test_error_is_always_shown_regardless_of_verbosity(capsys):\n+    logger.set_verbosity(0)\n+    logger.error(\"✗ Docker version check timed out\")\n+    assert capsys.readouterr().out == \"✗ Docker version check timed out\\n\"\n+\n+\n+def test_warn_is_always_shown_regardless_of_verbosity(capsys):\n+    logger.set_verbosity(0)\n+    logger.warn(\"Copy wps/.env.example to wps/.env and fill in the registry values first.\")\n+    assert capsys.readouterr().out == \"Copy wps/.env.example to wps/.env and fill in the registry values first.\\n\"\n+\n+\n+def test_debug_is_hidden_at_default_verbosity(capsys):\n+    logger.set_verbosity(0)\n+    logger.debug(\"resolved args: {}\")\n+    assert capsys.readouterr().out == \"\"\n+\n+\n+def test_debug_is_shown_at_verbosity_one(capsys):\n+    logger.set_verbosity(1)\n+    logger.debug(\"resolved args: {}\")\n+    assert capsys.readouterr().out == \"[DEBUG] resolved args: {}\\n\"\n+\n+\n+def test_trace_is_hidden_below_verbosity_two(capsys):\n+    logger.set_verbosity(1)\n+    logger.trace(\"context: {}\")\n+    assert capsys.readouterr().out == \"\"\n+\n+\n+def test_trace_is_shown_at_verbosity_two(capsys):\n+    logger.set_verbosity(2)\n+    logger.trace(\"context: {}\")\n+    assert capsys.readouterr().out == \"[TRACE] context: {}\\n\""},{"sha":"bc72974c28590574258531c17ec77193751b2997","filename":"on-premise/datasaur-cli/tests/common/test_manifest_file_reader.py","status":"added","additions":95,"deletions":0,"changes":95,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_manifest_file_reader.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_manifest_file_reader.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_manifest_file_reader.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,95 @@\n+from pathlib import Path\n+\n+import yaml\n+\n+from src.common.manifest_file_reader import ManifestFileReader\n+\n+\n+def _write_yaml(path: Path, content: dict) -> None:\n+    path.write_text(yaml.dump(content))\n+\n+\n+def test_read_returns_not_ok_when_manifest_missing(tmp_path):\n+    manifest, ok = ManifestFileReader().read(tmp_path)\n+\n+    assert manifest is None\n+    assert ok is False\n+\n+\n+def test_read_returns_not_ok_when_version_field_missing(tmp_path):\n+    _write_yaml(tmp_path / \"manifest.yaml\", {\"commands\": {}})\n+\n+    manifest, ok = ManifestFileReader().read(tmp_path)\n+\n+    assert manifest is None\n+    assert ok is False\n+\n+\n+def test_read_returns_manifest_content_on_valid_file(tmp_path):\n+    _write_yaml(tmp_path / \"manifest.yaml\", {\"version\": \"1.0.0\", \"commands\": {\"start\": {}}})\n+\n+    manifest, ok = ManifestFileReader().read(tmp_path)\n+\n+    assert ok is True\n+    assert manifest[\"version\"] == \"1.0.0\"\n+    assert manifest[\"commands\"] == {\"start\": {}}\n+\n+\n+def test_read_merges_commands_from_command_modules(tmp_path):\n+    module_dir = tmp_path / \"modules\" / \"extra\"\n+    module_dir.mkdir(parents=True)\n+    _write_yaml(\n+        tmp_path / \"manifest.yaml\",\n+        {\"version\": \"1.0.0\", \"command_modules\": [\"modules/extra\"], \"commands\": {\"start\": {}}},\n+    )\n+    _write_yaml(module_dir / \"manifest.yaml\", {\"version\": \"1.0.0\", \"commands\": {\"extra-cmd\": {}}})\n+\n+    manifest, ok = ManifestFileReader().read(tmp_path)\n+\n+    assert ok is True\n+    assert manifest[\"commands\"] == {\"start\": {}, \"extra-cmd\": {}}\n+\n+\n+def test_read_skips_command_module_with_missing_manifest(tmp_path):\n+    _write_yaml(\n+        tmp_path / \"manifest.yaml\",\n+        {\"version\": \"1.0.0\", \"command_modules\": [\"modules/missing\"], \"commands\": {\"start\": {}}},\n+    )\n+\n+    manifest, ok = ManifestFileReader().read(tmp_path)\n+\n+    assert ok is True\n+    assert manifest[\"commands\"] == {\"start\": {}}\n+\n+\n+def test_read_does_not_overwrite_version_with_resolved_value(tmp_path, monkeypatch):\n+    # _resolve_variables() only affects what's echoed to the console; the\n+    # returned manifest keeps the original, unresolved version string. This\n+    # documents existing behavior, not a bug fix.\n+    monkeypatch.setenv(\"APP_VERSION\", \"9.9.9\")\n+    _write_yaml(tmp_path / \"manifest.yaml\", {\"version\": \"${APP_VERSION}\"})\n+\n+    manifest, ok = ManifestFileReader().read(tmp_path)\n+\n+    assert ok is True\n+    assert manifest[\"version\"] == \"${APP_VERSION}\"\n+\n+\n+def test_resolve_variables_substitutes_known_env_var(monkeypatch):\n+    monkeypatch.setenv(\"APP_VERSION\", \"2.0.0\")\n+\n+    resolved = ManifestFileReader()._resolve_variables(\"v${APP_VERSION}\")\n+\n+    assert resolved == \"v2.0.0\"\n+\n+\n+def test_resolve_variables_substitutes_empty_string_for_unknown_var(monkeypatch):\n+    monkeypatch.delenv(\"UNKNOWN_VAR\", raising=False)\n+\n+    resolved = ManifestFileReader()._resolve_variables(\"v${UNKNOWN_VAR}\")\n+\n+    assert resolved == \"v\"\n+\n+\n+def test_resolve_variables_stringifies_non_string_input():\n+    assert ManifestFileReader()._resolve_variables(123) == \"123\""},{"sha":"59d6f61dee1baf95afe4b1d1c558387a7eb5b5e7","filename":"on-premise/datasaur-cli/tests/common/test_operating_systems_validator.py","status":"added","additions":68,"deletions":0,"changes":68,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_operating_systems_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_operating_systems_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_operating_systems_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,68 @@\n+from unittest.mock import mock_open, patch\n+\n+from src.common.operating_systems_validator import OperatingSystemsValidator\n+\n+UBUNTU_22_04_OS_RELEASE = 'NAME=\"Ubuntu\"\\nVERSION_ID=\"22.04\"\\nID=ubuntu\\n'\n+RHEL_9_OS_RELEASE = 'NAME=\"Red Hat Enterprise Linux\"\\nVERSION_ID=\"9.3\"\\nID=\"rhel\"\\n'\n+CENTOS_OS_RELEASE = 'NAME=\"CentOS Linux\"\\nVERSION_ID=\"8\"\\nID=\"centos\"\\n'\n+\n+\n+def test_validate_returns_true_when_no_operating_systems_requirement():\n+    assert OperatingSystemsValidator().validate({}) is True\n+\n+\n+def test_validate_returns_false_when_requirement_dict_has_no_supported_os_keys():\n+    # Neither \"rhel\" nor \"ubuntu\" is present, so no checker ever runs, and\n+    # all(... for x in []) is vacuously True — the \"requirement not met\"\n+    # branch is taken even though nothing was actually checked. This\n+    # documents existing behavior, not a bug fix.\n+    manifest = {\"operating_systems\": {\"windows\": \">=10\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.operating_systems_validator.platform.system\", return_value=\"Windows\")\n+def test_validate_returns_false_when_not_running_on_linux(mock_system):\n+    manifest = {\"operating_systems\": {\"ubuntu\": \">=20.0\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.operating_systems_validator.platform.system\", return_value=\"Linux\")\n+@patch(\"builtins.open\", side_effect=FileNotFoundError(\"no such file\"))\n+def test_validate_returns_false_when_os_release_file_missing(mock_file, mock_system):\n+    manifest = {\"operating_systems\": {\"ubuntu\": \">=20.0\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.operating_systems_validator.platform.system\", return_value=\"Linux\")\n+@patch(\"builtins.open\", new_callable=mock_open, read_data=CENTOS_OS_RELEASE)\n+def test_validate_returns_false_when_os_release_does_not_match_expected_distro(mock_file, mock_system):\n+    manifest = {\"operating_systems\": {\"ubuntu\": \">=20.0\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.operating_systems_validator.platform.system\", return_value=\"Linux\")\n+@patch(\"builtins.open\", new_callable=mock_open, read_data=UBUNTU_22_04_OS_RELEASE)\n+def test_validate_returns_true_when_ubuntu_version_satisfies_constraint(mock_file, mock_system):\n+    manifest = {\"operating_systems\": {\"ubuntu\": \">=18.0\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is True\n+\n+\n+@patch(\"src.common.operating_systems_validator.platform.system\", return_value=\"Linux\")\n+@patch(\"builtins.open\", new_callable=mock_open, read_data=UBUNTU_22_04_OS_RELEASE)\n+def test_validate_returns_false_when_ubuntu_version_does_not_satisfy_constraint(mock_file, mock_system):\n+    manifest = {\"operating_systems\": {\"ubuntu\": \">=99.0\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.operating_systems_validator.platform.system\", return_value=\"Linux\")\n+@patch(\"builtins.open\", new_callable=mock_open, read_data=RHEL_9_OS_RELEASE)\n+def test_validate_returns_true_when_rhel_version_satisfies_constraint(mock_file, mock_system):\n+    manifest = {\"operating_systems\": {\"rhel\": \">=8.0\"}}\n+\n+    assert OperatingSystemsValidator().validate(manifest) is True"},{"sha":"d37eaa4fd852bf19c483aeca7dccbc087e15476f","filename":"on-premise/datasaur-cli/tests/common/test_request_client.py","status":"added","additions":153,"deletions":0,"changes":153,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_request_client.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_request_client.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_request_client.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,153 @@\n+from unittest.mock import MagicMock, patch\n+\n+import requests\n+\n+from src.common.request_client import get_access_token, graphql, http_get, http_post\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_get_access_token_returns_token_on_success(mock_post):\n+    mock_post.return_value = MagicMock(status_code=200, json=lambda: {\"access_token\": \"tok123\"})\n+\n+    token = get_access_token(\"https://api.example.com\", \"client-id\", \"secret\")\n+\n+    assert token == \"tok123\"\n+    called_kwargs = mock_post.call_args.kwargs\n+    assert called_kwargs[\"data\"][\"client_id\"] == \"client-id\"\n+    assert called_kwargs[\"data\"][\"grant_type\"] == \"client_credentials\"\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_get_access_token_returns_none_on_http_error(mock_post):\n+    mock_post.return_value = MagicMock(status_code=401, text=\"unauthorized\")\n+\n+    assert get_access_token(\"https://api.example.com\", \"client-id\", \"secret\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.post\", side_effect=requests.RequestException(\"boom\"))\n+def test_get_access_token_returns_none_on_request_exception(mock_post):\n+    assert get_access_token(\"https://api.example.com\", \"client-id\", \"secret\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_graphql_returns_data_on_success(mock_post):\n+    mock_post.return_value = MagicMock(status_code=200, json=lambda: {\"data\": {\"foo\": 1}})\n+\n+    result = graphql(\"https://api.example.com/graphql\", \"token\", \"mutation { foo }\")\n+\n+    assert result == {\"foo\": 1}\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_graphql_strips_none_valued_variables(mock_post):\n+    mock_post.return_value = MagicMock(status_code=200, json=lambda: {\"data\": {}})\n+\n+    graphql(\n+        \"https://api.example.com/graphql\",\n+        \"token\",\n+        \"mutation { foo }\",\n+        variables={\"a\": 1, \"b\": None},\n+    )\n+\n+    sent_json = mock_post.call_args.kwargs[\"json\"]\n+    assert sent_json[\"variables\"] == {\"a\": 1}\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_graphql_returns_none_on_http_error(mock_post):\n+    mock_post.return_value = MagicMock(status_code=500, text=\"server error\")\n+\n+    assert graphql(\"https://api.example.com/graphql\", \"token\", \"mutation { foo }\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_graphql_returns_none_when_errors_present(mock_post):\n+    mock_post.return_value = MagicMock(\n+        status_code=200, json=lambda: {\"errors\": [{\"message\": \"bad\"}]}\n+    )\n+\n+    assert graphql(\"https://api.example.com/graphql\", \"token\", \"mutation { foo }\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.post\", side_effect=requests.RequestException(\"boom\"))\n+def test_graphql_returns_none_on_request_exception(mock_post):\n+    assert graphql(\"https://api.example.com/graphql\", \"token\", \"mutation { foo }\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.get\")\n+def test_http_get_returns_json_on_200(mock_get):\n+    mock_get.return_value = MagicMock(status_code=200, json=lambda: {\"ok\": True})\n+\n+    assert http_get(\"https://api.example.com\", \"token\", \"/path\") == {\"ok\": True}\n+\n+\n+@patch(\"src.common.request_client.requests.get\")\n+def test_http_get_returns_json_on_201(mock_get):\n+    mock_get.return_value = MagicMock(status_code=201, json=lambda: {\"created\": True})\n+\n+    assert http_get(\"https://api.example.com\", \"token\", \"/path\") == {\"created\": True}\n+\n+\n+@patch(\"src.common.request_client.requests.get\")\n+def test_http_get_returns_none_on_error_status(mock_get):\n+    mock_get.return_value = MagicMock(status_code=404, text=\"not found\")\n+\n+    assert http_get(\"https://api.example.com\", \"token\", \"/path\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.get\")\n+def test_http_get_returns_empty_dict_when_body_is_not_json(mock_get):\n+    response = MagicMock(status_code=200)\n+    response.json.side_effect = ValueError(\"no json\")\n+    mock_get.return_value = response\n+\n+    assert http_get(\"https://api.example.com\", \"token\", \"/path\") == {}\n+\n+\n+@patch(\"src.common.request_client.requests.get\", side_effect=requests.RequestException(\"boom\"))\n+def test_http_get_returns_none_on_request_exception(mock_get):\n+    assert http_get(\"https://api.example.com\", \"token\", \"/path\") is None\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_http_post_sends_json_body_by_default(mock_post):\n+    mock_post.return_value = MagicMock(status_code=200, json=lambda: {\"ok\": True})\n+\n+    result = http_post(\"https://api.example.com\", \"token\", \"/path\", {\"key\": \"value\"})\n+\n+    assert result == {\"ok\": True}\n+    called_kwargs = mock_post.call_args.kwargs\n+    assert called_kwargs[\"json\"] == {\"key\": \"value\"}\n+    assert called_kwargs[\"headers\"][\"Content-Type\"] == \"application/json\"\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_http_post_form_mode_lowercases_boolean_values(mock_post):\n+    mock_post.return_value = MagicMock(status_code=200, json=lambda: {\"ok\": True})\n+\n+    http_post(\"https://api.example.com\", \"token\", \"/path\", {\"flag\": True, \"name\": \"x\"}, form=True)\n+\n+    called_kwargs = mock_post.call_args.kwargs\n+    assert called_kwargs[\"data\"] == {\"flag\": \"true\", \"name\": \"x\"}\n+    assert \"json\" not in called_kwargs\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_http_post_returns_none_on_error_status(mock_post):\n+    mock_post.return_value = MagicMock(status_code=400, text=\"bad request\")\n+\n+    assert http_post(\"https://api.example.com\", \"token\", \"/path\", {}) is None\n+\n+\n+@patch(\"src.common.request_client.requests.post\")\n+def test_http_post_returns_empty_dict_when_body_is_not_json(mock_post):\n+    response = MagicMock(status_code=201)\n+    response.json.side_effect = ValueError(\"no json\")\n+    mock_post.return_value = response\n+\n+    assert http_post(\"https://api.example.com\", \"token\", \"/path\", {}) == {}\n+\n+\n+@patch(\"src.common.request_client.requests.post\", side_effect=requests.RequestException(\"boom\"))\n+def test_http_post_returns_none_on_request_exception(mock_post):\n+    assert http_post(\"https://api.example.com\", \"token\", \"/path\", {}) is None"},{"sha":"593869299a1746c2052f463bc37a0916fd093e2b","filename":"on-premise/datasaur-cli/tests/common/test_software_requirements_validator.py","status":"added","additions":123,"deletions":0,"changes":123,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_software_requirements_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_software_requirements_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_software_requirements_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,123 @@\n+import subprocess\n+from unittest.mock import MagicMock, patch\n+\n+from src.common.software_requirements_validator import SoftwareRequirementsValidator\n+\n+\n+def test_validate_returns_true_when_no_software_requirements():\n+    assert SoftwareRequirementsValidator().validate({}) is True\n+\n+\n+def test_validate_returns_true_when_requirements_present_but_keys_absent():\n+    manifest = {\"software_requirements\": {\"other\": \"x\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is True\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_validate_returns_true_when_docker_version_satisfies_constraint(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"24.0.5\\n\")\n+    manifest = {\"software_requirements\": {\"docker\": \">=20.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is True\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_validate_stops_at_docker_check_and_skips_compose_check_on_failure(mock_run):\n+    mock_run.return_value = MagicMock(returncode=1, stdout=\"\")\n+    manifest = {\"software_requirements\": {\"docker\": \">=20.0.0\", \"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+    mock_run.assert_called_once()\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_check_docker_version_returns_false_when_stdout_empty(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"   \")\n+    manifest = {\"software_requirements\": {\"docker\": \">=20.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\", side_effect=FileNotFoundError())\n+def test_check_docker_version_returns_false_when_docker_not_found(mock_run):\n+    manifest = {\"software_requirements\": {\"docker\": \">=20.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\n+    \"src.common.software_requirements_validator.subprocess.run\",\n+    side_effect=subprocess.TimeoutExpired(cmd=[\"docker\", \"version\"], timeout=10),\n+)\n+def test_check_docker_version_returns_false_on_timeout(mock_run):\n+    manifest = {\"software_requirements\": {\"docker\": \">=20.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_check_docker_version_returns_false_when_constraint_not_satisfied(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"18.0.0\\n\")\n+    manifest = {\"software_requirements\": {\"docker\": \">=20.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_check_docker_compose_version_satisfied_via_short_flag(mock_run):\n+    mock_run.return_value = MagicMock(returncode=0, stdout=\"2.39.1\\n\")\n+    manifest = {\"software_requirements\": {\"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is True\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_check_docker_compose_version_falls_back_to_full_version_output(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\"),\n+        MagicMock(returncode=0, stdout=\"Docker Compose version v2.38.2\\n\"),\n+    ]\n+    manifest = {\"software_requirements\": {\"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is True\n+    assert mock_run.call_count == 2\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_check_docker_compose_version_returns_false_when_plugin_not_installed(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\"),\n+        MagicMock(returncode=1, stdout=\"\"),\n+    ]\n+    manifest = {\"software_requirements\": {\"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\")\n+def test_check_docker_compose_version_returns_false_when_output_unparseable(mock_run):\n+    mock_run.side_effect = [\n+        MagicMock(returncode=1, stdout=\"\"),\n+        MagicMock(returncode=0, stdout=\"garbage output with no version\\n\"),\n+    ]\n+    manifest = {\"software_requirements\": {\"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\"src.common.software_requirements_validator.subprocess.run\", side_effect=FileNotFoundError())\n+def test_check_docker_compose_version_returns_false_when_command_not_found(mock_run):\n+    manifest = {\"software_requirements\": {\"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False\n+\n+\n+@patch(\n+    \"src.common.software_requirements_validator.subprocess.run\",\n+    side_effect=subprocess.TimeoutExpired(cmd=[\"docker\", \"compose\", \"version\"], timeout=10),\n+)\n+def test_check_docker_compose_version_returns_false_on_timeout(mock_run):\n+    manifest = {\"software_requirements\": {\"docker-compose\": \">=2.0.0\"}}\n+\n+    assert SoftwareRequirementsValidator().validate(manifest) is False"},{"sha":"caf3077c62f72cfaf2d468a15910f8fb4508a082","filename":"on-premise/datasaur-cli/tests/common/test_stack_discovery.py","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_stack_discovery.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_stack_discovery.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_stack_discovery.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,42 @@\n+from src.common.stack_discovery import discover_stacks, order_stacks\n+\n+\n+def test_discover_stacks_finds_only_dirs_with_stack_yaml(tmp_path):\n+    (tmp_path / \"proxy\").mkdir()\n+    (tmp_path / \"proxy\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"registry\").mkdir()\n+    (tmp_path / \"registry\" / \"stack.yaml\").write_text(\"services: {}\\n\")\n+    (tmp_path / \"images\").mkdir()  # no stack.yaml — must be ignored\n+    (tmp_path / \"manifest.yaml\").write_text(\"version: '1'\\n\")  # a file, not a dir\n+\n+    result = discover_stacks(tmp_path)\n+\n+    assert result == [\"proxy\", \"registry\"]\n+\n+\n+def test_discover_stacks_returns_empty_list_when_none_found(tmp_path):\n+    (tmp_path / \"images\").mkdir()\n+\n+    result = discover_stacks(tmp_path)\n+\n+    assert result == []\n+\n+\n+def test_order_stacks_puts_named_stacks_first_in_the_given_order():\n+    result = order_stacks(discovered=[\"hello\", \"proxy\", \"registry\"], stack_order=[\"proxy\", \"registry\", \"hello\"])\n+\n+    assert result == [\"proxy\", \"registry\", \"hello\"]\n+\n+\n+def test_order_stacks_appends_undeclared_stacks_after_the_named_ones():\n+    result = order_stacks(\n+        discovered=[\"hello\", \"new-stack\", \"proxy\", \"registry\"], stack_order=[\"proxy\", \"registry\", \"hello\"]\n+    )\n+\n+    assert result == [\"proxy\", \"registry\", \"hello\", \"new-stack\"]\n+\n+\n+def test_order_stacks_drops_named_stacks_that_were_not_discovered():\n+    result = order_stacks(discovered=[\"proxy\"], stack_order=[\"proxy\", \"registry\", \"hello\"])\n+\n+    assert result == [\"proxy\"]"},{"sha":"51cb2dc21e81111e46c4a4248ccfb1e3e093f7a3","filename":"on-premise/datasaur-cli/tests/common/test_state_service.py","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_state_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_state_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_state_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,55 @@\n+from datetime import datetime\n+\n+from src.common.state_service import STATE_KEY_SEPARATOR, StateService\n+\n+\n+def test_get_returns_empty_dict_for_missing_key_on_fresh_state(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    value, ok = StateService().get(\"missing\")\n+\n+    assert ok is True\n+    assert value == {}\n+\n+\n+def test_set_then_get_round_trips_top_level_key(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = StateService()\n+\n+    set_ok = service.set(\"foo\", {\"bar\": \"baz\"})\n+    value, get_ok = service.get(\"foo\")\n+\n+    assert set_ok is True\n+    assert get_ok is True\n+    assert value == {\"bar\": \"baz\"}\n+\n+\n+def test_set_then_get_round_trips_nested_key(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = StateService()\n+    nested_key = f\"parent{STATE_KEY_SEPARATOR}child\"\n+\n+    service.set(nested_key, {\"value\": 1})\n+    value, ok = service.get(nested_key)\n+\n+    assert ok is True\n+    assert value == {\"value\": 1}\n+\n+\n+def test_set_records_a_parseable_last_updated_at_timestamp(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    service = StateService()\n+\n+    service.set(\"foo\", {\"bar\": \"baz\"})\n+    all_state = service.get_all()\n+\n+    # Assert on shape/parseability rather than the exact instant, since\n+    # StateService.set() stamps the real current time via datetime.now().\n+    assert \"last_updated_at\" in all_state\n+    datetime.fromisoformat(all_state[\"last_updated_at\"])\n+\n+\n+def test_get_all_returns_empty_dict_when_state_file_absent(monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+\n+    assert StateService().get_all() == {}"},{"sha":"9884a9b7f2f37b235c2de908f27c3ec62143cf1e","filename":"on-premise/datasaur-cli/tests/common/test_version_constraint_parser.py","status":"added","additions":96,"deletions":0,"changes":96,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_version_constraint_parser.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_version_constraint_parser.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_version_constraint_parser.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,96 @@\n+from src.common.version_constraint_parser import VersionConstraintParser\n+\n+\n+def test_no_constraint_is_always_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.2.3\", \"\") == (True, [])\n+\n+\n+def test_simple_gte_constraint_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.2.3\", \">=1.0.0\") == (True, [])\n+\n+\n+def test_simple_gte_constraint_not_satisfied():\n+    is_satisfied, errors = VersionConstraintParser().is_version_satisfied(\"0.9.0\", \">=1.0.0\")\n+    assert is_satisfied is False\n+    assert errors == [\"not (>=1.0.0)\"]\n+\n+\n+def test_exact_version_match():\n+    assert VersionConstraintParser().is_version_satisfied(\"2.0.0\", \"2.0.0\") == (True, [])\n+\n+\n+def test_exact_version_mismatch():\n+    is_satisfied, errors = VersionConstraintParser().is_version_satisfied(\"2.0.1\", \"2.0.0\")\n+    assert is_satisfied is False\n+    # A bare version with no operator prefix is stored as op \"=\" (not\n+    # normalized to \"==\"), unlike an explicit \"==\" constraint.\n+    assert errors == [\"not (=2.0.0)\"]\n+\n+\n+def test_caret_range_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.5.0\", \"^1.2.3\") == (True, [])\n+\n+\n+def test_caret_range_not_satisfied():\n+    is_satisfied, errors = VersionConstraintParser().is_version_satisfied(\"0.9.0\", \"^1.0.0\")\n+    assert is_satisfied is False\n+    assert errors == [\"not (^1.0.0)\"]\n+\n+\n+def test_tilde_range_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.2.5\", \"~1.2.3\") == (True, [])\n+\n+\n+def test_tilde_range_not_satisfied():\n+    is_satisfied, _ = VersionConstraintParser().is_version_satisfied(\"1.3.0\", \"~1.2.3\")\n+    assert is_satisfied is False\n+\n+\n+def test_wildcard_constraint_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.2.5\", \"1.2.*\") == (True, [])\n+\n+\n+def test_wildcard_x_range_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.5.0\", \"1.x\") == (True, [])\n+\n+\n+def test_full_wildcard_accepts_any_version():\n+    # A bare \"*\" constraint parses to zero constraint groups, meaning any\n+    # version is acceptable.\n+    assert VersionConstraintParser().is_version_satisfied(\"0.0.1\", \"*\") == (True, [])\n+\n+\n+def test_hyphen_range_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"2.0.0\", \"1.2.3 - 2.3.4\") == (True, [])\n+\n+\n+def test_hyphen_range_not_satisfied():\n+    is_satisfied, errors = VersionConstraintParser().is_version_satisfied(\n+        \"3.0.0\", \"1.2.3 - 2.3.4\"\n+    )\n+    assert is_satisfied is False\n+    assert errors == [\"not (>=1.2.3,<=2.3.4)\"]\n+\n+\n+def test_multiple_and_constraints_in_one_group():\n+    assert VersionConstraintParser().is_version_satisfied(\"1.5.0\", \">=1.0.0 <2.0.0\") == (True, [])\n+\n+\n+def test_or_constraints_second_group_satisfied():\n+    assert VersionConstraintParser().is_version_satisfied(\"2.5.0\", \"^1.0.0 || ^2.0.0\") == (True, [])\n+\n+\n+def test_or_constraints_none_satisfied():\n+    is_satisfied, errors = VersionConstraintParser().is_version_satisfied(\"4.0.0\", \"^1.0.0 || ^2.0.0\")\n+    assert is_satisfied is False\n+    # One error message per OR-group, describing each group's raw\n+    # (unexpanded) constraint tuples.\n+    assert errors == [\"not (^1.0.0)\", \"not (^2.0.0)\"]\n+\n+\n+def test_comma_treated_as_or():\n+    assert VersionConstraintParser().is_version_satisfied(\"2.5.0\", \"^1.0.0, ^2.0.0\") == (True, [])\n+\n+\n+def test_invalid_version_falls_back_to_string_equality():\n+    assert VersionConstraintParser().is_version_satisfied(\"not-a-version\", \"not-a-version\") == (True, [])"},{"sha":"3b2930e79ccd53c94bcae1140a32555071933ffe","filename":"on-premise/datasaur-cli/tests/common/test_yaml_file.py","status":"added","additions":60,"deletions":0,"changes":60,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_yaml_file.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_yaml_file.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Ftest_yaml_file.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,60 @@\n+from src.common.yaml_file import YamlFile\n+\n+\n+def test_read_returns_not_ok_when_file_missing_and_no_create(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+\n+    content, ok = YamlFile().read(file_path)\n+\n+    assert content is None\n+    assert ok is False\n+\n+\n+def test_read_creates_empty_file_when_missing_and_create_if_not_exists(tmp_path):\n+    file_path = tmp_path / \"nested\" / \"config.yaml\"\n+\n+    content, ok = YamlFile().read(file_path, create_if_not_exists=True)\n+\n+    assert ok is True\n+    assert content == {}\n+    assert file_path.exists()\n+\n+\n+def test_read_parses_existing_yaml_file(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"foo: bar\\nbaz: 1\\n\")\n+\n+    content, ok = YamlFile().read(file_path)\n+\n+    assert ok is True\n+    assert content == {\"foo\": \"bar\", \"baz\": 1}\n+\n+\n+def test_read_returns_not_ok_on_malformed_yaml(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"foo: [unclosed\")\n+\n+    content, ok = YamlFile().read(file_path)\n+\n+    assert content is None\n+    assert ok is False\n+\n+\n+def test_write_then_read_round_trips_content(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    data = {\"foo\": \"bar\", \"nested\": {\"a\": 1}}\n+\n+    write_ok = YamlFile().write(file_path, data)\n+    content, read_ok = YamlFile().read(file_path)\n+\n+    assert write_ok is True\n+    assert read_ok is True\n+    assert content == data\n+\n+\n+def test_write_returns_false_when_parent_directory_missing(tmp_path):\n+    file_path = tmp_path / \"missing_dir\" / \"config.yaml\"\n+\n+    ok = YamlFile().write(file_path, {\"foo\": \"bar\"})\n+\n+    assert ok is False"},{"sha":"eaff60e0888c61780487169611a315a2b7118573","filename":"on-premise/datasaur-cli/tests/common/validators/test_file_owner_validator.py","status":"added","additions":80,"deletions":0,"changes":80,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Fvalidators%2Ftest_file_owner_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Fvalidators%2Ftest_file_owner_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Fvalidators%2Ftest_file_owner_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,80 @@\n+import grp\n+import os\n+import pwd\n+\n+from src.common.validators.file_owner_validator import FileOwnerValidator\n+\n+\n+def test_validate_returns_true_when_explicit_uid_gid_matches(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    expected = f\"{os.getuid()}:{os.getgid()}\"\n+\n+    assert FileOwnerValidator.validate(str(file_path), expected) is True\n+\n+\n+def test_validate_returns_true_when_username_groupname_matches(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    user_name = pwd.getpwuid(os.getuid()).pw_name\n+    group_name = grp.getgrgid(os.getgid()).gr_name\n+\n+    assert FileOwnerValidator.validate(str(file_path), f\"{user_name}:{group_name}\") is True\n+\n+\n+def test_validate_returns_false_when_explicit_owner_mismatches(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    # A UID/GID that (almost certainly) doesn't own the file we just created.\n+    mismatched = f\"{os.getuid() + 1}:{os.getgid() + 1}\"\n+\n+    assert FileOwnerValidator.validate(str(file_path), mismatched) is False\n+\n+\n+def test_validate_returns_false_for_missing_colon_format(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+\n+    assert FileOwnerValidator.validate(str(file_path), \"not-a-valid-format\") is False\n+\n+\n+def test_validate_returns_false_for_unknown_username_or_groupname(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+\n+    assert FileOwnerValidator.validate(str(file_path), \"no_such_user_xyz:no_such_group_xyz\") is False\n+\n+\n+def test_validate_returns_false_when_explicit_owner_path_missing(tmp_path):\n+    missing_path = tmp_path / \"missing.yaml\"\n+\n+    assert FileOwnerValidator.validate(str(missing_path), \"0:0\") is False\n+\n+\n+def test_validate_supports_shell_pattern_matching_current_process(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+\n+    assert FileOwnerValidator.validate(str(file_path), \"$(id -u):$(id -g)\") is True\n+\n+\n+def test_validate_rejects_unsupported_shell_pattern(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+\n+    assert FileOwnerValidator.validate(str(file_path), \"$(whoami):$(id -g)\") is False\n+\n+\n+def test_validate_returns_false_when_shell_pattern_path_missing(tmp_path):\n+    missing_path = tmp_path / \"missing.yaml\"\n+\n+    assert FileOwnerValidator.validate(str(missing_path), \"$(id -u):$(id -g)\") is False\n+\n+\n+def test_validate_returns_false_and_does_not_crash_for_mismatched_unresolvable_uid(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    # A UID/GID pair that both mismatches the real owner AND has no\n+    # corresponding pwd/grp entry, exercising _print_owner_mismatch's\n+    # fallback branch when name resolution itself fails.\n+    assert FileOwnerValidator.validate(str(file_path), \"999999:999999\") is False"},{"sha":"f7116aa64a705f3177ed51940593b8503226e745","filename":"on-premise/datasaur-cli/tests/common/validators/test_file_permission_validator.py","status":"added","additions":41,"deletions":0,"changes":41,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Fvalidators%2Ftest_file_permission_validator.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Fvalidators%2Ftest_file_permission_validator.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fcommon%2Fvalidators%2Ftest_file_permission_validator.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,41 @@\n+import os\n+\n+from src.common.validators.file_permission_validator import FilePermissionValidator\n+\n+\n+def test_validate_returns_true_when_permissions_match(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    os.chmod(file_path, 0o644)\n+\n+    assert FilePermissionValidator.validate(str(file_path), \"0644\") is True\n+\n+\n+def test_validate_returns_false_when_permissions_do_not_match(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+    os.chmod(file_path, 0o600)\n+\n+    assert FilePermissionValidator.validate(str(file_path), \"0644\") is False\n+\n+\n+def test_validate_returns_false_for_invalid_expected_permissions_format(tmp_path):\n+    file_path = tmp_path / \"config.yaml\"\n+    file_path.write_text(\"key: value\")\n+\n+    assert FilePermissionValidator.validate(str(file_path), \"644\") is False\n+    assert FilePermissionValidator.validate(str(file_path), \"abcd\") is False\n+\n+\n+def test_validate_returns_false_when_path_does_not_exist(tmp_path):\n+    missing_path = tmp_path / \"missing.yaml\"\n+\n+    assert FilePermissionValidator.validate(str(missing_path), \"0644\") is False\n+\n+\n+def test_validate_works_on_directories_too(tmp_path):\n+    dir_path = tmp_path / \"a_directory\"\n+    dir_path.mkdir()\n+    os.chmod(dir_path, 0o755)\n+\n+    assert FilePermissionValidator.validate(str(dir_path), \"0755\") is True"},{"sha":"c1773d0ec97810761f412ee1fab165f07d66a15a","filename":"on-premise/datasaur-cli/tests/option/test_click_option_consume_all_options.py","status":"added","additions":49,"deletions":0,"changes":49,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Foption%2Ftest_click_option_consume_all_options.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Foption%2Ftest_click_option_consume_all_options.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Foption%2Ftest_click_option_consume_all_options.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,49 @@\n+import click\n+import pytest\n+from click.testing import CliRunner\n+\n+from src.option.click_option_consume_all_options import ClickOptionConsumeAllOptions\n+\n+\n+def test_consumes_all_remaining_args_when_no_other_options_registered():\n+    @click.command()\n+    @click.option(\"--items\", cls=ClickOptionConsumeAllOptions, nargs=-1)\n+    def cmd(items):\n+        click.echo(f\"items={items}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--items\", \"a\", \"b\", \"c\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"items=('a', 'b', 'c')\\n\"\n+\n+\n+def test_stops_consuming_at_next_option_prefix_by_default():\n+    @click.command()\n+    @click.option(\"--items\", cls=ClickOptionConsumeAllOptions, nargs=-1)\n+    @click.option(\"--flag\", is_flag=True)\n+    def cmd(items, flag):\n+        click.echo(f\"items={items} flag={flag}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--items\", \"a\", \"b\", \"--flag\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"items=('a', 'b') flag=True\\n\"\n+\n+\n+def test_save_other_options_false_consumes_everything_remaining():\n+    @click.command()\n+    @click.option(\n+        \"--items\", cls=ClickOptionConsumeAllOptions, nargs=-1, save_other_options=False\n+    )\n+    def cmd(items):\n+        click.echo(f\"items={items}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--items\", \"a\", \"b\", \"--not-a-real-flag\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"items=('a', 'b', '--not-a-real-flag')\\n\"\n+\n+\n+def test_rejects_explicit_nargs_other_than_negative_one():\n+    with pytest.raises(AssertionError):\n+        click.option(\"--items\", cls=ClickOptionConsumeAllOptions, nargs=1)(lambda: None)"},{"sha":"d5533aa60eb7db9bf5b13ec772dec985b9c6288d","filename":"on-premise/datasaur-cli/tests/option/test_click_options.py","status":"added","additions":88,"deletions":0,"changes":88,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Foption%2Ftest_click_options.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Foption%2Ftest_click_options.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Foption%2Ftest_click_options.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,88 @@\n+import click\n+from click.testing import CliRunner\n+\n+from src.option.click_options import click_options\n+\n+\n+def test_long_option_string_type():\n+    @click.command()\n+    @click_options([{\"name\": \"foo\", \"long\": \"foo\", \"type\": \"string\"}])\n+    def cmd(foo):\n+        click.echo(f\"foo={foo}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--foo\", \"bar\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"foo=bar\\n\"\n+\n+\n+def test_short_option_alias():\n+    @click.command()\n+    @click_options([{\"name\": \"foo\", \"short\": \"f\", \"long\": \"foo\", \"type\": \"string\"}])\n+    def cmd(foo):\n+        click.echo(f\"foo={foo}\")\n+\n+    result = CliRunner().invoke(cmd, [\"-f\", \"bar\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"foo=bar\\n\"\n+\n+\n+def test_required_option_missing_errors():\n+    @click.command()\n+    @click_options([{\"name\": \"foo\", \"long\": \"foo\", \"type\": \"string\", \"required\": True}])\n+    def cmd(foo):\n+        click.echo(f\"foo={foo}\")\n+\n+    result = CliRunner().invoke(cmd, [])\n+\n+    assert result.exit_code != 0\n+    assert \"Missing option\" in result.output\n+\n+\n+def test_integer_type_is_parsed_as_int():\n+    @click.command()\n+    @click_options([{\"name\": \"count\", \"long\": \"count\", \"type\": \"integer\"}])\n+    def cmd(count):\n+        click.echo(f\"count={count!r}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--count\", \"5\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"count=5\\n\"\n+\n+\n+def test_number_type_is_parsed_as_float():\n+    @click.command()\n+    @click_options([{\"name\": \"ratio\", \"long\": \"ratio\", \"type\": \"number\"}])\n+    def cmd(ratio):\n+        click.echo(f\"ratio={ratio!r}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--ratio\", \"1.5\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"ratio=1.5\\n\"\n+\n+\n+def test_array_type_consumes_multiple_values_into_a_tuple():\n+    @click.command()\n+    @click_options([{\"name\": \"items\", \"long\": \"items\", \"type\": \"array\"}])\n+    def cmd(items):\n+        click.echo(f\"items={items}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--items\", \"a\", \"b\", \"c\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"items=('a', 'b', 'c')\\n\"\n+\n+\n+def test_missing_type_key_defaults_to_string():\n+    @click.command()\n+    @click_options([{\"name\": \"foo\", \"long\": \"foo\"}])\n+    def cmd(foo):\n+        click.echo(f\"foo={foo}\")\n+\n+    result = CliRunner().invoke(cmd, [\"--foo\", \"bar\"])\n+\n+    assert result.exit_code == 0\n+    assert result.output == \"foo=bar\\n\""},{"sha":"185fe9d4c78181b5a45fd7bd4bab8dd984e8ae2e","filename":"on-premise/datasaur-cli/tests/prompt/test_user_prompts_service.py","status":"added","additions":99,"deletions":0,"changes":99,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fprompt%2Ftest_user_prompts_service.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Fprompt%2Ftest_user_prompts_service.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Fprompt%2Ftest_user_prompts_service.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,99 @@\n+from unittest.mock import patch\n+\n+from src.common.state_service import StateService\n+from src.prompt.user_prompts_service import UserPromptsService\n+\n+\n+def test_get_returns_empty_dict_for_no_prompts():\n+    assert UserPromptsService().get([]) == {}\n+\n+\n+def test_get_uses_config_value_without_prompting():\n+    prompts = [{\"name\": \"foo\", \"text\": \"Foo\", \"hide_input\": False, \"default\": \"d\"}]\n+\n+    with patch(\"src.prompt.user_prompts_service.click.prompt\") as mock_prompt:\n+        result = UserPromptsService().get(prompts, config_values={\"foo\": \"bar\"})\n+\n+    assert result == {\"foo\": \"bar\"}\n+    mock_prompt.assert_not_called()\n+\n+\n+def test_get_converts_none_config_value_to_empty_string():\n+    prompts = [{\"name\": \"foo\", \"text\": \"Foo\", \"hide_input\": False, \"default\": \"d\"}]\n+\n+    result = UserPromptsService().get(prompts, config_values={\"foo\": None})\n+\n+    assert result == {\"foo\": \"\"}\n+\n+\n+def test_get_masks_hidden_input_config_value_in_echo(capsys):\n+    prompts = [{\"name\": \"secret\", \"text\": \"Secret\", \"hide_input\": True, \"default\": \"d\"}]\n+\n+    UserPromptsService().get(prompts, config_values={\"secret\": \"hunter2\"})\n+\n+    captured = capsys.readouterr()\n+    assert \"hunter2\" not in captured.out\n+    assert \"****\" in captured.out\n+\n+\n+@patch(\"src.prompt.user_prompts_service.click.prompt\", return_value=\"typed-answer\")\n+def test_get_prompts_interactively_when_no_config_value(mock_prompt):\n+    prompts = [{\"name\": \"foo\", \"text\": \"Foo\", \"hide_input\": False, \"default\": \"d\"}]\n+\n+    result = UserPromptsService().get(prompts)\n+\n+    assert result == {\"foo\": \"typed-answer\"}\n+    mock_prompt.assert_called_once_with(\"Foo\", default=\"d\", hide_input=False)\n+\n+\n+@patch(\"src.prompt.user_prompts_service.click.prompt\", return_value=\"typed-answer\")\n+def test_get_uses_prompt_default_when_no_default_from_state_key_given(mock_prompt):\n+    # _resolve_default only consults StateService when \"default_from_state\"\n+    # is present and truthy; with no such key, it returns prompt[\"default\"]\n+    # directly without touching the state file at all.\n+    prompts = [{\"name\": \"foo\", \"text\": \"Foo\", \"hide_input\": False, \"default\": \"plain-default\"}]\n+\n+    UserPromptsService().get(prompts)\n+\n+    mock_prompt.assert_called_once_with(\"Foo\", default=\"plain-default\", hide_input=False)\n+\n+\n+@patch(\"src.prompt.user_prompts_service.click.prompt\", return_value=\"typed-answer\")\n+def test_get_resolves_default_from_state_when_present(mock_prompt, monkeypatch, tmp_path):\n+    monkeypatch.chdir(tmp_path)\n+    StateService().set(\"saved_foo\", \"state-value\")\n+    prompts = [\n+        {\n+            \"name\": \"foo\",\n+            \"text\": \"Foo\",\n+            \"hide_input\": False,\n+            \"default\": \"fallback\",\n+            \"default_from_state\": \"saved_foo\",\n+        }\n+    ]\n+\n+    UserPromptsService().get(prompts)\n+\n+    mock_prompt.assert_called_once_with(\"Foo\", default=\"state-value\", hide_input=False)\n+\n+\n+@patch(\"src.prompt.user_prompts_service.click.prompt\", return_value=\"typed-answer\")\n+def test_get_falls_back_to_prompt_default_when_state_key_absent(mock_prompt, monkeypatch, tmp_path):\n+    # StateService.get() on a key that was never set returns ({}, True) —\n+    # never (None, False) — so an absent state key must be treated as {}\n+    # (falsy sentinel), not as a real found value, or the fallback to\n+    # prompt[\"default\"] would be unreachable.\n+    monkeypatch.chdir(tmp_path)\n+    prompts = [\n+        {\n+            \"name\": \"foo\",\n+            \"text\": \"Foo\",\n+            \"hide_input\": False,\n+            \"default\": \"fallback\",\n+            \"default_from_state\": \"no_such_state_key\",\n+        }\n+    ]\n+\n+    UserPromptsService().get(prompts)\n+\n+    mock_prompt.assert_called_once_with(\"Foo\", default=\"fallback\", hide_input=False)"},{"sha":"c8c7c2dabe162d76ac9db3091013a08c64fce23f","filename":"on-premise/datasaur-cli/tests/test_main.py","status":"added","additions":146,"deletions":0,"changes":146,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Ftest_main.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Ftest_main.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Ftest_main.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,146 @@\n+import runpy\n+from pathlib import Path\n+from unittest.mock import MagicMock, patch\n+\n+import pytest\n+\n+MAIN_PATH = str(Path(__file__).parent.parent / \"src\" / \"main.py\")\n+\n+PATCH_TARGETS = {\n+    \"manifest_reader\": \"src.common.manifest_file_reader.ManifestFileReader\",\n+    \"os_validator\": \"src.common.operating_systems_validator.OperatingSystemsValidator\",\n+    \"sw_validator\": \"src.common.software_requirements_validator.SoftwareRequirementsValidator\",\n+    \"click_commands_service\": \"src.command.click_commands_service.ClickCommandsService\",\n+    \"stack_commands_service\": \"src.command.stack_commands_service.StackCommandsService\",\n+    \"cli\": \"src.command.cli.cli\",\n+}\n+\n+\n+def _run_main():\n+    runpy.run_path(MAIN_PATH, run_name=\"__main__\")\n+\n+\n+def test_exits_1_when_manifest_read_fails():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls:\n+        mock_reader_cls.return_value.read.return_value = (None, False)\n+\n+        with pytest.raises(SystemExit) as exc_info:\n+            _run_main()\n+\n+    assert exc_info.value.code == 1\n+\n+\n+def test_exits_1_when_os_validation_fails():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls, patch(\n+        PATCH_TARGETS[\"os_validator\"]\n+    ) as mock_os_validator_cls:\n+        mock_reader_cls.return_value.read.return_value = ({\"commands\": {\"start\": {}}}, True)\n+        mock_os_validator_cls.return_value.validate.return_value = False\n+\n+        with pytest.raises(SystemExit) as exc_info:\n+            _run_main()\n+\n+    assert exc_info.value.code == 1\n+\n+\n+def test_exits_1_when_software_validation_fails():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls, patch(\n+        PATCH_TARGETS[\"os_validator\"]\n+    ) as mock_os_validator_cls, patch(PATCH_TARGETS[\"sw_validator\"]) as mock_sw_validator_cls:\n+        mock_reader_cls.return_value.read.return_value = ({\"commands\": {\"start\": {}}}, True)\n+        mock_os_validator_cls.return_value.validate.return_value = True\n+        mock_sw_validator_cls.return_value.validate.return_value = False\n+\n+        with pytest.raises(SystemExit) as exc_info:\n+            _run_main()\n+\n+    assert exc_info.value.code == 1\n+\n+\n+def test_exits_1_when_commands_key_missing_from_manifest():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls, patch(\n+        PATCH_TARGETS[\"os_validator\"]\n+    ) as mock_os_validator_cls, patch(PATCH_TARGETS[\"sw_validator\"]) as mock_sw_validator_cls:\n+        mock_reader_cls.return_value.read.return_value = ({}, True)\n+        mock_os_validator_cls.return_value.validate.return_value = True\n+        mock_sw_validator_cls.return_value.validate.return_value = True\n+\n+        with pytest.raises(SystemExit) as exc_info:\n+            _run_main()\n+\n+    assert exc_info.value.code == 1\n+\n+\n+def test_exits_1_when_click_commands_registration_fails():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls, patch(\n+        PATCH_TARGETS[\"os_validator\"]\n+    ) as mock_os_validator_cls, patch(\n+        PATCH_TARGETS[\"sw_validator\"]\n+    ) as mock_sw_validator_cls, patch(\n+        PATCH_TARGETS[\"click_commands_service\"]\n+    ) as mock_click_commands_service_cls:\n+        mock_reader_cls.return_value.read.return_value = ({\"commands\": {\"start\": {}}}, True)\n+        mock_os_validator_cls.return_value.validate.return_value = True\n+        mock_sw_validator_cls.return_value.validate.return_value = True\n+        mock_click_commands_service_cls.return_value.register.return_value = False\n+\n+        with pytest.raises(SystemExit) as exc_info:\n+            _run_main()\n+\n+    assert exc_info.value.code == 1\n+\n+\n+def test_happy_path_registers_stack_commands_and_invokes_cli():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls, patch(\n+        PATCH_TARGETS[\"os_validator\"]\n+    ) as mock_os_validator_cls, patch(\n+        PATCH_TARGETS[\"sw_validator\"]\n+    ) as mock_sw_validator_cls, patch(\n+        PATCH_TARGETS[\"click_commands_service\"]\n+    ) as mock_click_commands_service_cls, patch(\n+        PATCH_TARGETS[\"stack_commands_service\"]\n+    ) as mock_stack_commands_service_cls, patch(\n+        PATCH_TARGETS[\"cli\"]\n+    ) as mock_cli:\n+        mock_reader_cls.return_value.read.return_value = ({\"commands\": {\"start\": {}}}, True)\n+        mock_os_validator_cls.return_value.validate.return_value = True\n+        mock_sw_validator_cls.return_value.validate.return_value = True\n+        mock_click_commands_service_instance = mock_click_commands_service_cls.return_value\n+        mock_click_commands_service_instance.register.return_value = True\n+        mock_click_commands_service_instance.actions_service = MagicMock()\n+\n+        _run_main()\n+\n+        mock_stack_commands_service_cls.return_value.register.assert_called_once_with(\n+            mock_cli, mock_click_commands_service_instance.actions_service, Path(\".\"), []\n+        )\n+        mock_cli.assert_called_once()\n+\n+\n+def test_passes_manifests_stack_order_through_to_stack_commands_service():\n+    with patch(PATCH_TARGETS[\"manifest_reader\"]) as mock_reader_cls, patch(\n+        PATCH_TARGETS[\"os_validator\"]\n+    ) as mock_os_validator_cls, patch(\n+        PATCH_TARGETS[\"sw_validator\"]\n+    ) as mock_sw_validator_cls, patch(\n+        PATCH_TARGETS[\"click_commands_service\"]\n+    ) as mock_click_commands_service_cls, patch(\n+        PATCH_TARGETS[\"stack_commands_service\"]\n+    ) as mock_stack_commands_service_cls, patch(\n+        PATCH_TARGETS[\"cli\"]\n+    ) as mock_cli:\n+        mock_reader_cls.return_value.read.return_value = (\n+            {\"commands\": {\"start\": {}}, \"stack_order\": [\"proxy\", \"registry\", \"hello\"]},\n+            True,\n+        )\n+        mock_os_validator_cls.return_value.validate.return_value = True\n+        mock_sw_validator_cls.return_value.validate.return_value = True\n+        mock_click_commands_service_instance = mock_click_commands_service_cls.return_value\n+        mock_click_commands_service_instance.register.return_value = True\n+        mock_click_commands_service_instance.actions_service = MagicMock()\n+\n+        _run_main()\n+\n+        mock_stack_commands_service_cls.return_value.register.assert_called_once_with(\n+            mock_cli, mock_click_commands_service_instance.actions_service, Path(\".\"), [\"proxy\", \"registry\", \"hello\"]\n+        )"},{"sha":"9fab87517af02c8d7dd355174ef9efd99712bfa1","filename":"on-premise/datasaur-cli/tests/test_version.py","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Ftest_version.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fdatasaur-cli%2Ftests%2Ftest_version.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fdatasaur-cli%2Ftests%2Ftest_version.py?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,22 @@\n+import sys\n+import types\n+\n+\n+def test_version_falls_back_when_generated_module_absent(monkeypatch):\n+    monkeypatch.delitem(sys.modules, \"src._version\", raising=False)\n+    monkeypatch.delitem(sys.modules, \"src\", raising=False)\n+\n+    import src\n+\n+    assert src.__version__ == \"0.0.0-dev\"\n+\n+\n+def test_version_uses_generated_module_when_present(monkeypatch):\n+    fake_module = types.ModuleType(\"src._version\")\n+    fake_module.__version__ = \"9.9.9\"\n+    monkeypatch.setitem(sys.modules, \"src._version\", fake_module)\n+    monkeypatch.delitem(sys.modules, \"src\", raising=False)\n+\n+    import src\n+\n+    assert src.__version__ == \"9.9.9\""},{"sha":"7b66bd356eb39361ffb57975b9cf960213073ae8","filename":"on-premise/datasaur-cli/uv.lock","status":"added","additions":512,"deletions":0,"changes":512,"blob_url":"https://g