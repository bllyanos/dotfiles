rating_systems_handler.py\n-class OperatingSystemsChecker:\n-    def check(self, manifest: Dict) -> Optional[str]:\n-        \"\"\"\n-        Check if the operating system meets the minimum version requirement.\n-\n-        Returns: error_message\n-        \"\"\"\n-        operating_systems = manifest.get('operating-systems')\n-        if not operating_systems:\n-            return None\n-\n-        click.echo(\"  Checking operating system...\")\n-\n-        checkers = [self._check_rhel, self._check_ubuntu]\n-        error_messages = []\n-        for checker in checkers:\n-            is_checked, error_message = checker(operating_systems)\n-            if is_checked:\n-                error_messages.append(error_message)\n-\n-        if all(error_message is not None for error_message in error_messages):\n-            click.echo(click.style(\"  ✗ Operating system is not supported\", fg='red'))\n-            return ', '.join(error_messages)\n-\n-        click.echo(click.style(\"  ✓ Operating system is supported\", fg='green'))\n-        return None\n-\n-    def _check_rhel(self, operating_systems: Dict) -> Tuple[bool, Optional[str]]:\n-        \"\"\"\n-        Check if the RHEL operating system meets the minimum version requirement.\n-\n-        Returns: (is_checked, error_message)\n-        \"\"\"\n-        return self._check_linux('RHEL', operating_systems.get('rhel'), lambda os_release: 'Red Hat Enterprise Linux' in os_release or 'RHEL' in os_release)\n-\n-    def _check_ubuntu(self, operating_systems: Dict) -> Tuple[bool, Optional[str]]:\n-        \"\"\"\n-        Check if the Ubuntu operating system meets the minimum version requirement.\n-\n-        Returns: (is_checked, error_message)\n-        \"\"\"\n-        return self._check_linux('Ubuntu', operating_systems.get('ubuntu'), lambda os_release: 'Ubuntu' in os_release)\n-\n-    def _check_linux(self, os_name: str, min_version: str, validator: Callable[[str], bool]) -> Tuple[bool, Optional[str]]:\n-        \"\"\"\n-        Check if the Linux operating system meets the minimum version requirement.\n-\n-        Returns: (is_checked, error_message)\n-        \"\"\"\n-        if not min_version:\n-            return False, None\n-\n-        click.echo(f\"    Checking {os_name} operating system...\")\n-\n-        if platform.system() != 'Linux':\n-            error_message = \"Operating system is not Linux\"\n-            click.echo(click.style(f\"    ✗ {error_message}\", fg='red'))\n-            return True, error_message\n-        click.echo(click.style(\"      ✓ Operating system is Linux\", fg='green'))\n-\n-        try:\n-            with open('/etc/os-release', 'r') as f:\n-                os_release = f.read()\n-        except FileNotFoundError as e:\n-            error_message = f\"Could not open /etc/os-release: {str(e)}\"\n-            click.echo(click.style(f\"    ✗ {error_message}\", fg='red'))\n-            return True, error_message\n-        click.echo(click.style(\"      ✓ /etc/os-release is read\", fg='green'))\n-\n-        version_match = re.search(r'VERSION_ID=\"?([^\"]+)\"?', os_release, re.MULTILINE)\n-\n-        if not validator(os_release) or not version_match:\n-            error_message = f\"{os_name} {min_version} is required\"\n-            click.echo(click.style(f\"    ⚠ {error_message}\", fg='yellow'))\n-            return True, error_message\n-\n-        version = version_match.group(1).strip('\"')\n-        if compare_versions(version, min_version) < 0:\n-            error_message = f\"{os_name} version {version} detected, but {os_name} {min_version} is required\"\n-            click.echo(click.style(f\"    ✗ {error_message}\", fg='red'))\n-            return True, error_message\n-\n-        click.echo(click.style(f\"    ✓ {os_name} {version} is supported (minimal: {min_version})\", fg='green'))\n-        return True, None"},{"sha":"e5885f6652c86a49ea2e42684a431fbc56ac0371","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/steps/c