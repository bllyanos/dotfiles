n-\n-class SoftwareRequirementsHandler:\n-    def handle(self, docker_manifest: Dict[str, Any]) -> bool:\n-        software_requirements = docker_manifest.get('software_requirements')\n-        if not software_requirements:\n-            return True\n-\n-        checkers = [self._check_docker_version, self._check_docker_compose_version]\n-        for checker in checkers:\n-            if not checker(software_requirements):\n-                return False\n-\n-        return True\n-\n-    def _check_docker_version(self, software_requirements: Dict) -> bool:\n-        version_constraint = software_requirements.get('docker')\n-        if version_constraint is None:\n-            return True\n-\n-        click.echo(\"Checking Docker version...\")\n-        try:\n-            result = subprocess.run(\n-                ['docker', 'version', '-f', '{{.Server.Version}}'],\n-                capture_output=True,\n-                text=True,\n-                timeout=10\n-            )\n-            if result.returncode != 0:\n-                click.echo(click.style(\"✗ Docker is not installed or not running. Please make sure Docker is installed and running.\", fg='red'))\n-                return False\n-\n-            current_version = result.stdout.strip()\n-            if not current_version:\n-                click.echo(click.style(\"✗ Could not determine Docker version\", fg='red'))\n-                return False\n-\n-            is_satisfied, error_messages = VersionConstraintParser().is_version_satisfied(current_version, version_constraint)\n-            if not is_satisfied:\n-                click.echo(click.style(f\"✗ Docker {current_version} does not satisfy any of: \" + \" OR \".join(error_messages), fg='red'))\n-                return False\n-        except FileNotFoundError:\n-            click.echo(click.style(\"✗ Docker command not found. Please make sure Docker is installed.\", fg='red'))\n-            return False\n-        except subprocess.TimeoutExpired:\n-            click.echo(click.style(\"✗ Docker version check timed out\", fg='red'))\n-            return False\n-        except Exception as e:\n-            click.echo(click.style(f\"✗ Error while checking Docker version: {str(e)}\", fg='red'))\n-            return False\n-\n-        click.echo(click.style(f\"✓ Docker {current_version} is supported (constraint: {version_constraint})\", fg='green'))\n-        click.echo()\n-        return True\n-\n-    def _check_docker_compose_version(self, software_requirements: Dict) -> bool:\n-        version_constraint = software_requirements.get('docker-compose')\n-        if version_constraint is None:\n-            return True\n-\n-        click.echo(\"Checking Docker Compose version...\")\n-        try:\n-            result = subprocess.run(\n-                ['docker', 'compose', 'version', '--short'],\n-                capture_output=True,\n-                text=True,\n-                timeout=10\n-            )\n-\n-            if result.returncode == 0:\n-                version_output = result.stdout.strip().lstrip('v')\n-\n-                # Extract version number (handle formats like \"2.39.1\" or \"2-desktop\")\n-                version_match = re.search(r'^(\\d+\\.\\d+\\.\\d+)', version_output)\n-                if version_match:\n-                    return self._is_docker_compose_version_satisfied(version_match.group(1), version_constraint)\n-\n-                # Handle non-standard formats like \"2-desktop\" or \"2.39-desktop\" - extract major.minor\n-                version_match = re.search(r'^(\\d+)\\.(\\d+)', version_output)\n-                if version_match:\n-                    major = int(version_match.group(1))\n-                    minor = int(version_match.group(2))\n-                    return self._is_docker_compose_version_satisfied(f\"{major}.{minor}\", version_constraint)\n-\n-                # Handle formats like \"2-desktop\" (only major version)\n-                version_match = re.search(r'^(\\d+)', version_output)\n-                if version_match:\n-                    major = int(version_match.group(1))\n-                    return self._is_docker_compose_version_satisfied(f\"{major}\", version_constraint)\n-\n-            # Fallback: try docker compose version (full output)\n-            result = subprocess.run(\n-                ['docker', 'compose', 'version'],\n-                capture_output=True,\n-                text=True,\n-                timeout=10\n-            )\n-            if result.returncode != 0:\n-                click.echo(click.style(\"✗ Docker Compose plugin is not installed\", fg='red'))\n-                return False\n-\n-            # Parse version from output like \"Docker Compose version v2.38.2\" or \"Docker Compose version v2-desktop\"\n-            version_output = result.stdout.strip()\n-\n-            # Try to find standard version format first\n-            version_match = re.search(r'v?(\\d+\\.\\d+\\.\\d+)', version_output)\n-            if version_match:\n-                return self._is_docker_compose_version_satisfied(version_match.group(1), version_constraint)\n-\n-            # Try to extract major.minor from non-standard formats\n-            version_match = re.search(r'v?(\\d+)\\.(\\d+)', version_output)\n-            if version_match:\n-                major = int(version_match.group(1))\n-                minor = int(version_match.group(2))\n-                return self._is_docker_compose_version_satisfied(f\"{major}.{minor}\", version_constraint)\n-\n-            click.echo(click.style(f\"✗ Could not parse Docker Compose version from: {version_output}\", fg='red'))\n-            return False\n-        except FileNotFoundError:\n-            click.echo(click.style(\"✗ Docker Compose command not found. Please make sure Docker Compose plugin is installed.\", fg='red'))\n-            return False\n-        except subprocess.TimeoutExpired:\n-            click.echo(click.style(\"✗ Docker Compose version check timed out\", fg='red'))\n-            return False\n-        except Exception as e:\n-            click.echo(click.style(f\"✗ Error while checking Docker Compose version: {str(e)}\", fg='red'))\n-            return False\n-\n-    def _is_docker_compose_version_satisfied(self, current_version: str, version_constraint: str) -> Optional[bool]:\n-        \"\"\"\n-        Check if the operating system meets the version requirement.\n-\n-        Args:\n-            current_version: The current version of Docker Compose\n-            version_constraint: The version constraint string\n-\n-        Returns:\n-            is_satisfied: True if the version constraint is satisfied, False otherwise\n-        \"\"\"\n-        is_satisfied, error_messages = VersionConstraintParser().is_version_satisfied(current_version, version_constraint)\n-        if not is_satisfied:\n-            click.echo(click.style(f\"✗ Docker Compose {current_version} does not satisfy any of: \" + \" OR \".join(error_messages), fg='red'))\n-            return False\n-\n-        click.echo(click.style(f\"✓ Docker Compose {current_version} is supported (constraint: {version_constraint})\", fg='green'))\n-        click.echo()\n-        return True"},{"sha":"9176cbc9ab5d3d0ba2bb7bedaae24b02c3152f7e","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/steps/checkers/helpers.py","status":"removed","additions":0,"deletions":22,"changes":22,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fcheckers%2Fhelpers.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fcheckers%2Fhelpers.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fcheckers%2Fhelpers.py?ref=f70264d0457779a35a4fb6