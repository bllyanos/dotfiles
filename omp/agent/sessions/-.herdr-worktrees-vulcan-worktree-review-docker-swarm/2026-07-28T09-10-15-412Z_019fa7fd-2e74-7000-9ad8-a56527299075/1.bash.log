mmand work with `stop` field in ../../../../docker/nlp/build/manifest.json\n-@click.command()\n-@click.argument(\n-    'artifact_directory',\n-    type=click.Path(exists=True, file_okay=False, dir_okay=True, path_type=Path),\n-    default=DEFAULT_ARTIFACT_DIRECTORY\n-)\n-def stop(artifact_directory: Path):\n-    \"\"\"\n-    Stop Datasaur services using docker compose.\n-\n-    ARTIFACT_DIR: Artifact directory containing docker-compose.yaml\n-    \"\"\"\n-    manifest, ok = ManifestFileHandler().handle(artifact_directory)\n-    if not ok:\n-        return 1\n-\n-    docker_manifest, ok = SubManifestHandler().handle(manifest, 'docker')\n-    if not ok:\n-        return 1\n-\n-    if not OperatingSystemsHandler().handle(docker_manifest):\n-        return 1\n-\n-    if not SoftwareRequirementsHandler().handle(docker_manifest):\n-        return 1\n-\n-    stop_manifest, ok = SubManifestHandler().handle(docker_manifest, 'stop')\n-    if not ok:\n-        return 1\n-\n-    # Dict to track forbidden items for permission errors\n-    forbidden_items = {}\n-\n-    if not FilesHandler().handle(artifact_directory, stop_manifest, forbidden_items):\n-        return 1\n-\n-    # Check if there are any forbidden items after handler\n-    if len(forbidden_items) > 0:\n-        click.echo(click.style(\"Some files have the wrong permission and this script is unable to set the correct one. Please run the following commands: \", fg=\"blue\"))\n-        click.echo()\n-\n-        for path, permission in forbidden_items.items():\n-            click.echo(f\"sudo chmod {permission} {path}\")\n-        click.echo()\n-        return 1\n-\n-    if not StepsHandler().run(artifact_directory, stop_manifest):\n-        return 1\n-\n-    return 0"},{"sha":"d481fffbf571d500e84b483d37bee9c6d3fd98d7","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/upgrade/__init__.py","status":"removed","additions":0,"deletions":6,"changes":6,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fupgrade%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fupgrade%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fupgrade%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,6 +0,0 @@\n-\"\"\"Upgrade command package for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.upgrade.upgrade import upgrade\n-\n-__all__ = ['upgrade']\n-"},{"sha":"de3d03a0e2dec80c208b3aa64652e7d455b08f73","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/upgrade/upgrade.py","status":"removed","additions":0,"deletions":59,"changes":59,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fupgrade%2Fupgrade.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fupgrade%2Fupgrade.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fupgrade%2Fupgrade.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,59 +0,0 @@\n-\"\"\"Upgrade command for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.common.files_handler import FilesHandler\n-from datasaur_cli.commands.common.manifest_file_handler import ManifestFileHandler\n-from datasaur_cli.commands.common.operating_systems_handler import OperatingSystemsHandler\n-from datasaur_cli.commands.common.software_requirements_handler import SoftwareRequirementsHandler\n-from datasaur_cli.commands.common.steps_handler import StepsHandler\n-from datasaur_cli.commands.common.sub_manifest_handler import SubManifestHandler\n-from datasaur_cli.constants import DEFAULT_ARTIFACT_DIRECTORY\n-from datasaur_cli.commands.common.helpers import argument_parser\n-from pathlib import Path\n-import click\n-\n-@click.command()\n-@click.argument(\n-    'artifact_directory',\n-    type=click.Path(path_type=Path),\n-    default=DEFAULT_ARTIFACT_DIRECTORY\n-)\n-@click.option(\n-    '--install_dir',\n-    '-i',\n-    help=\"Location of the installation_directory\",\n-    required=True,\n-    type=str\n-)\n-def upgrade(artifact_directory: Path, install_dir: Path):\n-    \"\"\"\n-    Upgrade Datasaur on-premise.\n-\n-    ARTIFACT_DIRECTORY: Directory containing manifest.json file\n-    INSTALLATION_DIRECTORY: Directory containing the installation folder\n-    \"\"\"\n-    argument_parser.setArg('install_dir', install_dir)\n-    manifest, ok = ManifestFileHandler().handle(artifact_directory)\n-    if not ok:\n-        return 1\n-\n-    docker_manifest, ok = SubManifestHandler().handle(manifest, 'docker')\n-    if not ok:\n-        return 1\n-\n-    if not OperatingSystemsHandler().handle(docker_manifest):\n-        return 1\n-\n-    if not SoftwareRequirementsHandler().handle(docker_manifest):\n-        return 1\n-\n-    upgrade_manifest, ok = SubManifestHandler().handle(docker_manifest, 'upgrade')\n-    if not ok:\n-        return 1\n-\n-    if not FilesHandler().handle(artifact_directory, upgrade_manifest):\n-        return 1\n-\n-    if not StepsHandler().run(artifact_directory, upgrade_manifest):\n-        return 1\n-\n-    return 0"},{"sha":"7bc2ca7f318b33a738d36b358ff712aab1f33dc4","filename":"datasaur-cli/datasaur-cli/datasaur_cli/constants.py","status":"removed","additions":0,"deletions":3,"changes":3,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fconstants.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fconstants.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fconstants.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,3 +0,0 @@\n-COMMAND_TIMEOUT_IN_SECONDS = 300 # TODO: Please remove this constant after run_raw_linux_command has been removed\n-DEFAULT_ARTIFACT_DIRECTORY = '.'\n-TAR_GZ_EXTENSION = '.tar.gz' # TODO: Please remove this constant after docker_image_files_validator.py has been removed"},{"sha":"9a4df8ffd017ad044020f3d0f96840c23f194d9a","filename":"datasaur-cli/datasaur-cli/requirements.txt","status":"removed","additions":0,"deletions":4,"changes":4,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Frequirements.txt","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Frequirements.txt","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Frequirements.txt?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,4 +0,0 @@\n-click>=8.3.1\n-jsonschema>=4.25.1\n-pyinstaller>=6.17.0\n-PyYAML>=6.0.3"},{"sha":"3630f4bf6c3ccc2f8857f1bd9beda29ba7ec8c99","filename":"datasaur-cli/datasaur-cli/setup.py","status":"removed","additions":0,"deletions":45,"changes":45,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fsetup.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fsetup.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fsetup.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,45 +0,0 @@\n-\"\"\"Setup configuration for datasaur-cli.\"\"\"\n-\n-from setuptools import setup, find_packages\n-from pathlib import Path\n-\n-# Import version from package\n-from datasaur_cli import __version__\n-\n-# Read README.md if it exists, otherwise use a default description\n-readme_path = Path(\"README.md\")\n-if readme_path.exists():\n-    with open(readme_path, \"r\", encoding=\"utf-8\") as fh:\n-        long_description = fh.read()\n-else:\n-    long_description = \"CLI tool for managing Datasaur on-premise installation.\"\n-\n-# Read requirements.txt\n-requirements_path = Path(\"requirements.txt\")\n-if requirements_path.exists():\n-    with open(requirements_path, \"r\", encoding=\"utf-8\") as fh:\n-        requirements = [line.strip() for line in fh if line.strip() and not line.startswith(\"#\")]\n-else:\n-    requirements = [\"click>=8.0.0\"]\n-\n-setup(\n-    name=\"datasaur-cli\",\n-    version=__version__,\n-    author=\"Datasaur\",\n-    description=\"CLI tool for managing Datasaur on-premise installation\",\n-    long_description=long_description,\n-    long_description_content_type=\"text/markdown\",\n-    packages=find_packages(),\n-    classifiers=[\n-        \"Development Status ::5 - Production/Stable\",\n-        \"Intended Audience :: System Administrators\",\n-        \"Programming Language :: Python :: 3.13.3\",\n-    ],\n-    python_requires=\">=3.13.3\",\n-    install_requires=requirements,\n-    entry_points={\n-        \"console_scripts\": [\n-            \"datasaur-cli=datasaur_cli.cli:cli\",\n-        ],\n-    },\n-)"},{"sha":"4d44dbb8d88a7a5cba4550da86be144da94fe094","filename":"datasaur-cli/docker/nlp/.gitignore","status":"removed","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2F.gitignore","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2F.gitignore","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdocker%2Fnlp%2F.gitignore?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1 +0,0 @@\n-/datasaur*"},{"sha":"67c23480d2c50d4ee558a0cde63897a4602a0683","filename":"datasaur-cli/docker/nlp/backend.Dockerfile","status":"removed","additions":0,"deletions":32,"changes":32,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbackend.Dockerfile","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbackend.Dockerfile","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdocker%2Fnlp%2Fbackend.Dockerfile?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,32 +0,0 @@\n-ARG CI_REGISTRY\n-ARG DOCKER_TAG\n-FROM ${CI_REGISTRY}/vulcan-ai/vulcan/backend:${DOCKER_TAG}\n-\n-ARG EXPIRED_DATE\n-\n-USER root\n-\n-RUN apk update && \\\n-  apk add --no-cache \\\n-    aws-cli \\\n-    busybox-extras \\\n-    curl \\\n-    dcron \\\n-    jq \\\n-    libcap \\\n-    nano -f\n-\n-COPY services/backend /usr/src/app/\n-RUN jq -s add /usr/src/app/app.config.json /usr/src/app/app.on-prem.json > /usr/src/app/app.merged.json && \\\n-  rm -rf /usr/src/app/app.config.json /usr/src/app/app.on-prem.json && \\\n-  mv /usr/src/app/app.merged.json /usr/src/app/app.config.json\n-RUN mkdir -p /usr/src/app/logs && \\\n-  chown -R 111:111 /usr/src/app && \\\n-  chmod -R 744 /usr/src/app\n-\n-RUN sed -i \"s/EXPIRED_DATE/${EXPIRED_DATE}/g\" /usr/src/app/entrypoint.sh\n-RUN sed -i \"s/%EXPIRED_DATE/${EXPIRED_DATE}/g\" /usr/src/app/dist/app/modules/etc/modules/expiry-validation/expiry-validation.cron.js\n-\n-USER 111:111\n-\n-ENTRYPOINT [\"/usr/src/app/entrypoint.sh\"]"},{"sha":"dded049061eb2c1310af6db4503ee88eff8856ec","filename":"datasaur-cli/docker/nlp/build.sh","status":"removed","additions":0,"deletions":177,"changes":177,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbuild.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbuild.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdocker%2Fnlp%2Fbuild.sh?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,177 +0,0 @@\n-#!/bin/bash\n-\n-set -e\n-\n-usage() {\n-  echo \"Usage: $0 [options...]\"\n-  echo \"Example: $0 --expired-date 2025-12-31 --customer-name lucas --docker-tag 6.120.0 --pull-docker-tag feature-1 --output-tag feature-1\"\n-  echo \"\"\n-  echo \"Options:\"\n-  echo \"  --expired-date <EXPIRED_DATE>                       Expiration date\"\n-  echo \"  --customer-name <CUSTOMER_NAME>                     Customer name\"\n-  echo \"  --docker-tag <DOCKER_TAG>                           Docker tag version\"\n-  echo \"  --pull-docker-tag <PULL_DOCKER_TAG>                 Docker tag to be pulled\"\n-  echo \"  --output-tag <OUTPUT_TAG>                           Output tag\"\n-  exit 1\n-}\n-\n-EXPIRED_DATE=\"\"\n-CUSTOMER_NAME=\"\"\n-DOCKER_TAG=\"\"\n-PULL_DOCKER_TAG=\"\"\n-OUTPUT_TAG=\"\"\n-\n-while [[ $# -gt 0 ]]; do\n-  case \"$1\" in\n-    --expired-date)\n-      EXPIRED_DATE=\"$2\"\n-      shift 2\n-      ;;\n-    --customer-name)\n-      CUSTOMER_NAME=\"$2\"\n-      shift 2\n-      ;;\n-    --docker-tag)\n-      DOCKER_TAG=\"$2\"\n-      shift 2\n-      ;;\n-    --pull-docker-tag)\n-      PULL_DOCKER_TAG=\"$2\"\n-      shift 2\n-      ;;\n-    --output-tag)\n-      OUTPUT_TAG=\"$2\"\n-      shift 2\n-      ;;\n-    *)\n-      echo \"Unknown option: $1\"\n-      usage\n-      ;;\n-  esac\n-done\n-\n-REQUIRED_PARAMS=(EXPIRED_DATE CUSTOMER_NAME DOCKER_TAG PULL_DOCKER_TAG OUTPUT_TAG)\n-for param in \"${REQUIRED_PARAMS[@]}\"; do\n-  if [[ -z \"${!param}\" ]]; then\n-    echo \"Error: Missing required parameter: $param\"\n-    usage\n-  fi\n-done\n-\n-CI_REGISTRY=\"682361690817.dkr.ecr.us-east-1.amazonaws.com\"\n-\n-main() {\n-  initialize_variables\n-  copy_files\n-  pull_base_docker_images\n-  build_docker_images\n-  save_docker_images\n-  save_common_docker_images\n-  build_datasaur_cli\n-  package_build_directory\n-  echo \"Build finished\"\n-}\n-\n-initialize_variables() {\n-  echo \"Initializing variables...\"\n-  export CI_REGISTRY=\"$CI_REGISTRY\"\n-  export DOCKER_TAG=\"$DOCKER_TAG\"\n-  export PULL_DOCKER_TAG=\"$PULL_DOCKER_TAG\"\n-  export EXPIRED_DATE=\"$EXPIRED_DATE\"\n-  PREBUILD_DIR=datasaur\n-  IMAGES_DIR=\"$PREBUILD_DIR/images\"\n-  BUILD_DIR=\"$PREBUILD_DIR\"-\"$OUTPUT_TAG\"\n-  FILENAME=\"$PREBUILD_DIR\"-\"$CUSTOMER_NAME\"-\"$OUTPUT_TAG\".tar.gz\n-}\n-\n-copy_files() {\n-  echo \"Copying files...\"\n-  rm -rf \"$PREBUILD_DIR\"\n-  cp -r build \"$PREBUILD_DIR\"\n-  mkdir -p \"$IMAGES_DIR\"\n-\n-  local files=(\"scripts/install/install.sh\" \"docker-compose.yaml\" \"manifest.json\")\n-  for file in \"${files[@]}\"; do\n-    envsubst '${DOCKER_TAG}' < build/$file > \"$PREBUILD_DIR/$file\"\n-  done\n-}\n-\n-pull_base_docker_images() {\n-  echo \"Pulling base Docker images...\"\n-  docker pull \"$CI_REGISTRY/vulcan-ai/vulcan/backend:$PULL_DOCKER_TAG\"\n-  docker pull \"$CI_REGISTRY/vulcan-ai/vulcan/frontend:$PULL_DOCKER_TAG\"\n-}\n-\n-build_docker_images() {\n-  echo \"Building Docker images...\"\n-  docker compose -f docker-compose.build.yaml build\n-}\n-\n-save_docker_images() {\n-  echo \"Saving Docker images...\"\n-  save_docker_image \"backend-on-premise\"\n-  save_docker_image \"frontend-on-premise\"\n-  save_docker_image \"proxy-on-premise\"\n-}\n-\n-save_docker_image() {\n-  local image_name=\"$1\"\n-  echo \"Saving $image_name image...\"\n-  docker save \"datasaur/$image_name:$DOCKER_TAG\" | pigz > \"$IMAGES_DIR/datasaur-$image_name-$DOCKER_TAG\".tar.gz\n-}\n-\n-save_common_docker_images() {\n-  echo \"Saving common Docker images...\"\n-\n-  # NLP dependencies\n-  pull_image_and_save_to \"$CI_REGISTRY/erikvl87/languagetool:6.6-1\" \"$IMAGES_DIR/language-tool-6.6-1.tar.gz\"\n-  pull_image_tag_and_save_to \"$CI_REGISTRY/vulcan-ai/vulcan/audiowaveform-generator\" \"$PULL_DOCKER_TAG\" \"$DOCKER_TAG\" \"$IMAGES_DIR/audiowaveform-generator-$DOCKER_TAG.tar.gz\"\n-\n-  pull_image_and_save_to \"$CI_REGISTRY/apache/tika:3.2.5\" \"$IMAGES_DIR/apache-tika-3.2.5.tar.gz\"\n-  pull_image_and_save_to \"$CI_REGISTRY/gotenberg/gotenberg:8.24.3\" \"$IMAGES_DIR/gotenberg-8.24.3.tar.gz\"\n-\n-  # Common\n-  pull_image_and_save_to \"$CI_REGISTRY/vulcan-ai/presidio-analyzer:v1.1.14\" \"$IMAGES_DIR/presidio-analyzer-1.1.14.tar.gz\"\n-\n-  pull_image_and_save_to mariadb:10.6.19 \"$IMAGES_DIR/mariadb-10.6.19.tar.gz\"\n-  pull_image_and_save_to rabbitmq:3.13.7-management-alpine \"$IMAGES_DIR/rabbitmq-3.13.7-management-alpine.tar.gz\"\n-  pull_image_and_save_to redis:7.2.9-alpine3.21 \"$IMAGES_DIR/redis-7.2.9-alpine3.21.tar.gz\"\n-}\n-\n-build_datasaur_cli() {\n-  echo \"Building datasaur-cli...\"\n-  cd ../../datasaur-cli\n-  python3 -m venv venv\n-  source venv/bin/activate\n-  pip install -r requirements.txt\n-  ./build.sh\n-  cp dist/datasaur-cli \"../docker/nlp/$PREBUILD_DIR/datasaur-cli\"\n-  cd ../docker/nlp\n-}\n-\n-pull_image_and_save_to() {\n-  local image=\"$1\"\n-  local output=\"$2\"\n-  docker pull \"$image\"\n-  docker save \"$image\" | pigz > \"$output\"\n-}\n-\n-pull_image_tag_and_save_to() {\n-  local image=\"$1\"\n-  local tag=\"$2\"\n-  local newTag=\"$3\"\n-  local output=\"$4\"\n-  docker pull \"$image:$tag\"\n-  docker tag \"$image:$tag\" \"$image:$newTag\"\n-  docker save \"$image:$newTag\" | pigz > \"$output\"\n-}\n-\n-package_build_directory() {\n-  echo \"Packaging $PREBUILD_DIR directory...\"\n-  rm -rf \"$BUILD_DIR\"\n-  mv \"$PREBUILD_DIR\" \"$BUILD_DIR\"\n-  # tar -cf - \"$BUILD_DIR\" | pigz > \"$FILENAME\"\n-  # rm -rf \"$BUILD_DIR\"\n-}\n-\n-main"},{"sha":"e823c3c2cf0de21859659604a0182ff7d2bdc3e0","filename":"datasaur-cli/docker/nlp/build/.ssl/app.crt","status":"removed","additions":0,"deletions":24,"changes":24,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdocker%2Fnlp%2Fbuild%2F.ssl%2Fapp.crt","raw_url":"https://githu