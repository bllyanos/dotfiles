ur_cli%2Fcommands%2Fstart%2Fsteps%2Fvalidate_docker_images_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,40 +0,0 @@\n-from datasaur_cli.commands.common.helpers.helpers import read_manifest_file\n-from datasaur_cli.commands.common.helpers.helpers import run_linux_command\n-from pathlib import Path\n-import click\n-\n-class ValidateDockerImagesStep:\n-    def run(self, artifact_directory: Path) -> bool:\n-        click.echo(\"Validating the Docker images...\")\n-\n-        manifest, error_message = read_manifest_file(Path(artifact_directory))\n-        if error_message:\n-            click.echo(click.style(f\"✗ Docker images validation failed: {error_message}\", fg='red'))\n-            return False\n-\n-        images = manifest.get('images', [])\n-        for image in images:\n-            click.echo(f\"  {image}...\", nl=False)\n-            command = f\"docker image inspect {image} > /dev/null 2>&1\"\n-            result, error_message = run_linux_command(artifact_directory, command)\n-            if error_message:\n-                click.echo(click.style(\" ✗\", fg='red'))\n-                click.echo(click.style(f\"    Error: {error_message}\", fg='red'))\n-                click.echo(click.style(f\"✗ Docker images validation failed: {error_message}\", fg='red'))\n-                click.echo(\"\")\n-                click.echo(\"Next step:\")\n-                click.echo(\"  ./datasaur-cli install\")\n-                return False\n-            if result and result.returncode == 1:\n-                click.echo(click.style(\" ✗\", fg='red'))\n-                click.echo(click.style(f\"    Error: not found\", fg='red'))\n-                click.echo(click.style(f\"✗ Docker images validation failed: {image} not found\", fg='red'))\n-                click.echo(\"\")\n-                click.echo(\"Next step:\")\n-                click.echo(\"  ./datasaur-cli install\")\n-                return False\n-            click.echo(click.style(\" ✓ found\", fg='green'))\n-\n-        click.echo(click.style(\"✓ Docker images validation success\", fg='green'))\n-        click.echo(\"\")\n-        return True"},{"sha":"f9617e577620aea716db37d6bd91d9e68b96375c","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/start/steps/verify_started_services_step.py","status":"removed","additions":0,"deletions":25,"changes":25,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2Fsteps%2Fverify_started_services_step.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2Fsteps%2Fverify_started_services_step.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2Fsteps%2Fverify_started_services_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,25 +0,0 @@\n-from datasaur_cli.commands.common.helpers.helpers import get_service_status\n-from pathlib import Path\n-import click\n-import time\n-\n-class VerifyStartedServicesStep:\n-    def run(self, artifact_directory: Path, env_file_path: Path) -> bool:\n-        click.echo(\"Verifying service status...\")\n-        time.sleep(2)\n-\n-        service_status, error_message = get_service_status(artifact_directory, env_file_path)\n-        if error_message:\n-            click.echo(\"The services are starting...\")\n-            click.echo(\"\")\n-            return True\n-\n-        running = [name for name, state in service_status.items() if 'running' in state.lower()]\n-        if not running:\n-            click.echo(click.style(\"⚠ No services appear to be running\", fg='yellow'))\n-            click.echo(\"\")\n-            return True\n-\n-        click.echo(click.style(f\"✓ {len(running)} service(s) are running: {', '.join(running)}\", fg='green'))\n-        click.echo(\"\")\n-        return True"},{"sha":"f0c0cf0d864670bbee8a4b0edb254910c5eb9ef2","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/stop/__init__.py","status":"removed","additions":0,"deletions":6,"changes":6,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstop%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstop%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstop%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,6 +0,0 @@\n-\"\"\"Stop command package for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.stop.stop import stop\n-\n-__all__ = ['stop']\n-"},{"sha":"8c729aa4f1c7d10fe4f626096c2e6c2b9a2f24ae","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/stop/steps/stop_services_step.py","status":"removed","additions":0,"deletions":17,"changes":17,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstop%2Fsteps%2Fstop_services_step.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstop%2Fsteps%2Fstop_services_step.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstop%2Fsteps%2Fstop_services_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,17 +0,0 @@\n-from datasaur_cli.commands.common.helpers.helpers import run_linux_command\n-from pathlib import Path\n-import click\n-\n-class StopServicesStep:\n-    def run(self, artifact_directory: Path, env_file_path: Path) -> bool:\n-        click.echo(\"Stopping the services...\")\n-\n