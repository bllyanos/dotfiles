 timeout=10\n-            )\n-\n-            if result.returncode != 0:\n-                return \"Docker is not installed or not running\"\n-            current_version = result.stdout.strip()\n-            if not current_version:\n-                return \"Could not determine Docker version\"\n-            if compare_versions(current_version, min_version) < 0:\n-                return f\"Docker {current_version} is below minimum required version {min_version}\"\n-            click.echo(click.style(f\"  ✓ Docker {current_version} is supported (minimal: {min_version})\", fg='green'))\n-            return None\n-        except FileNotFoundError:\n-            return \"Docker command not found. Please install Docker.\"\n-        except subprocess.TimeoutExpired:\n-            return \"Docker version check timed out\"\n-        except Exception as e:\n-            return f\"Error checking Docker version: {str(e)}\"\n-\n-    def check_docker_compose_version(self, manifest: Dict) -> Optional[str]:\n-        \"\"\"\n-        Check if Docker Compose is installed and meets the minimum version requirement.\n-        Returns: error_message\n-        \"\"\"\n-        min_version = manifest.get('requirements', {}).get('docker-compose')\n-        if min_version is None:\n-            return None\n-\n-        click.echo(\"  Checking Docker Compose version...\")\n-        try:\n-            # Try docker compose version --short first (cleaner output)\n-            result = subprocess.run(\n-                ['docker', 'compose', 'version', '--short'],\n-                capture_output=True,\n-                text=True,\n-                timeout=10\n-            )\n-\n-            if result.returncode == 0:\n-                version_output = result.stdout.strip().lstrip('v')\n-                # Extract version number (handle formats like \"2.39.1\" or \"2-desktop\")\n-                version_match = re.search(r'^(\\d+\\.\\d+\\.\\d+)', version_output)\n-                if version_match:\n-                    current_version = version_match.group(1)\n-                    # Compare versions\n-                    if compare_versions(current_version, min_version) < 0:\n-                        return f\"Docker Compose {current_version} is below minimum required version {min_version}\"\n-                    click.echo(click.style(f\"    ✓ Docker Compose {current_version} is supported (minimal: {min_version})\", fg='green'))\n-                    return None\n-                # Handle non-standard formats like \"2-desktop\" or \"2.39-desktop\" - extract major.minor\n-                version_match = re.search(r'^(\\d+)\\.(\\d+)', version_output)\n-                if version_match:\n-                    try:\n-                        major = int(version_match.group(1))\n-                        minor = int(version_match.group(2))\n-                        # For Docker Desktop, check if major.minor >= 2.38\n-                        min_major, min_minor, _ = [int(x) for x in min_version.split('.')]\n-                        if major > min_major or (major == min_major and minor >= min_minor):\n-                            click.echo(click.style(f\"    ✓ Docker Compose {current_version} is supported (minimal: {min_version})\", fg='green'))\n-                            return None\n-                        return f\"Docker Compose version {version_output} is below minimum required version {min_version}\"\n-                    except ValueError:\n-                        pass\n-\n-                # Handle formats like \"2-desktop\" (only major version)\n-                version_match = re.search(r'^(\\d+)', version_output)\n-                if version_match:\n-                    try:\n-                        major = int(version_match.group(1))\n-                        min_major, min_minor, _ = [int(x) for x in min_version.split('.')]\n-                        # If only major version is available and it's >= 2, assume it meets requirement\n-                        # (Docker Desktop typically has latest features)\n-                        if major >= min_major:\n-                            click.echo(click.style(f\"    ✓ Docker Compose {version_output} is supported (minimal: {min_version})\", fg='green'))\n-                            return None\n-                        return f\"Docker Compose version {version_output} is below minimum required version {min_version}\"\n-                    except ValueError:\n-                        pass\n-\n-            # Fallback: try docker compose version (full output)\n-            result = subprocess.run(\n-                ['docker', 'compose', 'version'],\n-                capture_output=True,\n-                text=True,\n-                timeout=10\n-            )\n-\n-            if result.returncode != 0:\n-                return \"Docker Compose plugin is not installed\"\n-\n-            # Parse version from output like \"Docker Compose version v2.38.2\" or \"Docker Compose version v2-desktop\"\n-            output = result.stdout.strip()\n-            # Try to find standard version format first\n-            version_match = re.search(r'v?(\\d+\\.\\d+\\.\\d+)', output)\n-\n-            if version_match:\n-                current_version = version_match.group(1)\n-                # Compare versions\n-                if compare_versions(current_version, min_version) < 0:\n-                    return f\"Docker Compose {current_version} is below minimum required version {min_version}\"\n-                click.echo(click.style(f\"    ✓ Docker Compose {current_version} is supported (minimal: {min_version})\", fg='green'))\n-                return None\n-            # Try to extract major.minor from non-standard formats\n-            version_match = re.search(r'v?(\\d+)\\.(\\d+)', output)\n-            if version_match:\n-                major = int(version_match.group(1))\n-                minor = int(version_match.group(2))\n-                min_major, min_minor, _ = [int(x) for x in min_version.split('.')]\n-                version_str = f\"{major}.{minor}\"\n-                if major > min_major or (major == min_major and minor >= min_minor):\n-                    click.echo(click.style(f\"  ✓ Docker Compose {version_output} is supported (minimal: {min_version})\", fg='green'))\n-                    return None\n-                return f\"Docker Compose {version_str} is below minimum required version {min_version}\"\n-            return f\"Could not parse Docker Compose version from: {output}\"\n-        except FileNotFoundError:\n-            return \"Docker Compose command not found. Please install Docker Compose plugin.\"\n-        except subprocess.TimeoutExpired:\n-            return \"Docker Compose version check timed out\"\n-        except Exception as e:\n-            return f\"Error checking Docker Compose version: {str(e)}\""},{"sha":"36073e99ede443476496ad07fc6b572d77b15bda","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/steps/checkers_step.py","status":"removed","additions":0,"deletions":41,"changes":41,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fcheckers_step.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fcheckers_step.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fcheckers_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,41 +0,0 @@\n-from datasaur_cli.commands.common.steps.checkers.operating_systems_checker import OperatingSystemsChecker\n-from datasaur_cli.commands.common.steps.checkers.requirements_checker import RequirementsChecker\n-from datasaur_cli.commands.common.helpers.helpers import read_manifest_file\n-from pathlib import Path\n-