rements validation passes\", fg='green'))\n-\n-        error_message = self._validate_manifest_operating_systems(manifest)\n-        if error_message:\n-            error_message = f\"manifest operating systems validation failed: {error_message}\"\n-            click.echo(click.style(f\"    ✗ {error_message}\", fg='red'))\n-            return error_message\n-        click.echo(click.style(\"    ✓ manifest operating systems validation passes\", fg='green'))\n-\n-        click.echo(click.style(\"  ✓ manifest.json is valid\", fg='green'))\n-        return None\n-\n-    def _validate_manifest_structure(self, manifest: Dict) -> Optional[str]:\n-        allowed_keys = {'version', 'images', 'image-files', 'requirements', 'operating-systems', 'hooks'}\n-        invalid_keys = set(manifest.keys()) - allowed_keys\n-        if invalid_keys:\n-            return f\"Invalid key(s) in the manifest: {', '.join(invalid_keys)}. Allowed keys are: {', '.join(allowed_keys)}\"\n-        return None\n-\n-    def _validate_manifest_version(self, manifest: Dict) -> Optional[str]:\n-        if 'version' not in manifest:\n-            return f\"Missing 'version' field in manifest.json\"\n-\n-        if not isinstance(manifest['version'], str):\n-            return f\"The manifest key 'version' must be a string\"\n-\n-        return None\n-\n-    def _validate_manifest_images(self, manifest: Dict) -> Optional[str]:\n-        if 'images' not in manifest:\n-            return f\"Missing 'images' field in manifest.json\"\n-        if not isinstance(manifest['images'], list):\n-            return f\"'images' field must be a list\"\n-        if len(manifest['images']) == 0:\n-            return f\"'images' list cannot be empty\"\n-        for i, image in enumerate(manifest['images']):\n-            if isinstance(image, str):\n-                # Simple string format: just filename\n-                # Accept any string format\n-                pass\n-            elif isinstance(image, dict):\n-                # Object format: { \"file\": \"image.tar.gz\", \"name\": \"...\", ... }\n-                if 'file' not in image:\n-                    return f\"Image {i+1} missing 'file' field\"\n-            else:\n-                return f\"Image {i+1} must be a string or object\"\n-        return None\n-\n-    def _validate_manifest_image_files(self, manifest: Dict) -> Optional[str]:\n-        if 'image-files' not in manifest:\n-            return f\"Missing 'image-files' field in manifest.json\"\n-        if not isinstance(manifest['image-files'], list):\n-            return f\"'image-files' field must be a list\"\n-        if len(manifest['image-files']) == 0:\n-            return f\"'image-files' list cannot be empty\"\n-        for i, image in enumerate(manifest['image-files']):\n-            if isinstance(image, str):\n-                # Simple string format: just filename\n-                # Accept any string format\n-                pass\n-            elif isinstance(image, dict):\n-                # Object format: { \"file\": \"image.tar.gz\", \"name\": \"...\", ... }\n-                if 'file' not in image:\n-                    return f\"Image {i+1} missing 'file' field\"\n-            else:\n-                return f\"Image {i+1} must be a string or object\"\n-        return None\n-\n-    def _validate_manifest_requirements(self, manifest: Dict) -> Optional[str]:\n-        if not 'requirements' in manifest:\n-            return None\n-\n-        requirements = manifest['requirements']\n-        if not isinstance(requirements, dict):\n-            return f\"'requirements' field must be a dictionary\"\n-\n-        allowed_keys = {'docker', 'docker-compose'}\n-        invalid_keys = set(requirements.keys()) - allowed_keys\n-        if invalid_keys:\n-            return f\"Invalid key(s) in 'requirements': {', '.join(invalid_keys)}. Allowed keys are: {', '.join(allowed_keys)}\"\n-\n-        for key in requirements:\n-            if not isinstance(requirements[key], str):\n-                return f\"'requirements' field '{key}' must be a string\"\n-\n-        return None\n-\n-    def _validate_manifest_operating_systems(self, manifest: Dict) -> Optional[str]:\n-        if not 'operating-systems' in manifest:\n-            return None\n-\n-        operating_systems = manifest['operating-systems']\n-        if not isinstance(operating_systems, dict):\n-            return f\"'operating-systems' field must be a dictionary\"\n-\n-        allowed_keys = {'rhel', 'ubuntu'}\n-        invalid_keys = set(operating_systems.keys()) - allowed_keys\n-        if invalid_keys:\n-            return f\"Invalid key(s) in 'operating-systems': {', '.join(invalid_keys)}. Allowed keys are: {', '.join(allowed_keys)}\"\n-\n-        for key in operating_systems:\n-            if not isinstance(operating_systems[key], str):\n-                return f\"'operating-systems' field '{key}' must be a string\"\n-\n-        return None"},{"sha":"8b696d899d95734f4e6ec26e5c99dac4d7a1eae8","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/steps/validators_step.py","status":"removed","additions":0,"deletions":51,"changes":51,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fvalidators_step.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fvalidators_step.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsteps%2Fvalidators_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,51 +0,0 @@\n-from datasaur_cli.commands.common.helpers.helpers import read_manifest_file\n-from datasaur_cli.commands.common.steps.validators.artifact_directory_validator import ArtifactDirectoryValidator\n-from datasaur_cli.commands.common.steps.validators.config_schema_file_validator import ConfigSchemaFileValidator\n-from datasaur_cli.commands.common.steps.validators.docker_compose_file_validator import DockerComposeFileValidator\n-from datasaur_cli.commands.common.steps.validators.docker_image_files_validator import DockerImageFilesValidator\n-from datasaur_cli.commands.common.steps.validators.manifest_file_validator import ManifestFileValidator\n-from pathlib import Path\n-import click\n-\n-# TODO\n-# Please remove this class because the validators have been moved to each ../*.py file\n-class ValidatorsStep:\n-    def run(self, artifact_directory: str) -> bool:\n-        \"\"\"\n-        Validate the artifact directory structure.\n-\n-        Returns: is_valid\n-        \"\"\"\n-        click.echo(\"Validating artifact directory...\")\n-\n-        validators = [\n-            ArtifactDirectoryValidator(),\n-            ConfigSchemaFileValidator(),\n-            DockerComposeFileValidator(),\n-            ManifestFileValidator(),\n-        ]\n-\n-        for validator in validators:\n-            error_message = validator.validate(artifact_directory)\n-            if error_message:\n-                self._print_error_message(error_message)\n-                return False\n-\n-        artifact_path = Path(artifact_directory)\n-\n-        manifest, error_message = read_manifest_file(artifact_path)\n-        if error_message:\n-            self._print_error_message(error_message)\n-            return False\n-\n-        error_message = DockerImageFilesValidator().validate(artifact_path, manifest)\n-        if error_message:\n-            self._print_error_message(error_message)\n-            return False\n-\n-        click.echo(click.style(\"✓ Artifact directory is valid\", fg='green'))\n-        click.echo(\"\")\n-        return True\n-\n-    def _print_error_message(self, error_message: str):\n-        click.echo(click.style(f\"✗ Artifact directory is invalid: {error_message}\", fg='red'))"},{"sh