[{"sha":"d20c0fe4bdba98d3521079d2535222adddb2bf0c","filename":".codegraph/.gitignore","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/.codegraph%2F.gitignore","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/.codegraph%2F.gitignore","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/.codegraph%2F.gitignore?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,5 @@\n+# CodeGraph data files — local to each machine, not for committing.\n+# Ignore everything in .codegraph/ except this file itself, so transient\n+# files (the database, daemon.pid, sockets, logs) never show up in git.\n+*\n+!.gitignore"},{"sha":"4a506510cceb09be828d4e76281e0c04b5ed3197","filename":".github/workflows/artifact-builder-forge.yml","status":"modified","additions":2,"deletions":8,"changes":10,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/.github%2Fworkflows%2Fartifact-builder-forge.yml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/.github%2Fworkflows%2Fartifact-builder-forge.yml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/.github%2Fworkflows%2Fartifact-builder-forge.yml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -390,14 +390,8 @@ jobs:\n           # Install skopeo\n           sudo apt-get install -y skopeo\n \n-      - name: Setup Python\n-        uses: actions/setup-python@v6\n-        with:\n-          python-version: \"3.13\"\n-\n-      - name: Python Requirements\n-        run: |\n-          pip install -r ./datasaur-cli/datasaur-cli/requirements.txt\n+      - name: Setup uv\n+        uses: astral-sh/setup-uv@v6\n \n       - name: Setup Variables\n         id: variables"},{"sha":"655ff07381317cec85f442d8d611ab94e837fa31","filename":"datasaur-cli/datasaur-cli/.python-version","status":"removed","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2F.python-version","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2F.python-version","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2F.python-version?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1 +0,0 @@\n-3.13.9"},{"sha":"06638531df7e4e1384667616207e90e71d1861bc","filename":"datasaur-cli/datasaur-cli/README.md","status":"removed","additions":0,"deletions":147,"changes":147,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2FREADME.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2FREADME.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2FREADME.md?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,147 +0,0 @@\n-# Datasaur CLI\n-\n-CLI tool for managing Datasaur on-premise installation. This tool simplifies the installation, upgrade, and uninstallation of your Datasaur application packaged as Docker containers.\n-\n-## Features\n-\n-- 🚀 Simple installation process\n-- 🔄 Easy upgrades with data preservation\n-- 🗑️ Clean uninstallation\n-- 📊 Status checking and health monitoring\n-- 🐳 Docker-based deployment management\n-\n-## Installation\n-\n-### Prerequisites\n-\n-- [pyenv](https://github.com/pyenv/pyenv?tab=readme-ov-file#installation) >= 2.6.13\n-- [pyenv-virtualenv](https://github.com/pyenv/pyenv-virtualenv?tab=readme-ov-file#installing-as-a-pyenv-plugin) >= 1.2.4\n-- [Docker](https://docs.docker.com/engine/install/) >= 28.5.2\n-- [Docker Compose](https://docs.docker.com/engine/install/) >= 2.40.3\n-\n-### Initial Setup\n-\n-For the initial setup, please follow the steps below:\n-\n-1. Install python:\n-   ```\n-   pyenv install\n-   ```\n-2. Use the installed python:\n-   ```\n-   pyenv local\n-   ```\n-3. Create a python virtual environment for Datasaur CLI from the current python version:\n-   ```\n-   pyenv virtualenv datasaur-cli\n-   ```\n-4. Use datasaur-cli virtual environment:\n-   ```\n-   pyenv activate datasaur-cli\n-   ```\n-5. Install Datasaur CLI's dependencies:\n-   ```\n-   pip install -r requirements.txt\n-   ```\n-\n-### Setup\n-\n-If you have done the initial setup, you only need to run this:\n-\n-1. Change python version:\n-   ```\n-   pyenv local\n-   ```\n-2. Use datasaur-cli virtual environment:\n-   ```\n-   pyenv activate datasaur-cli\n-   ```\n-\n-## Development\n-\n-### Project Structure\n-\n-```\n-datasaur-cli/\n-├── datasaur_cli/\n-│   ├── __init__.py      # Package initialization and version\n-│   └── cli.py           # Main CLI entry point with Click\n-├── requirements.txt     # Python dependencies\n-├── setup.py             # Package setup configuration\n-└── README.md            # This file\n-```\n-\n-### Running the CLI\n-\n-You can run the CLI directly:\n-\n-```bash\n-# Show help\n-python -m datasaur_cli.cli --help\n-\n-# Show version\n-python -m datasaur_cli.cli --version\n-\n-# Get help for a specific command\n-python -m datasaur_cli.cli install --help\n-\n-# 1. Install\n-python -m datasaur_cli.cli install /path/to/installation-package\n-\n-# 2. Configure\n-python -m datasaur_cli.cli configure /path/to/installation-package\n-\n-# 3. Start services\n-python -m datasaur_cli.cli start /path/to/installation-package\n-\n-# 4. Stop services when needed\n-python -m datasaur_cli.cli stop /path/to/installation-package\n-```\n-\n-## Building Standalone Executable\n-\n-### Requirements\n-\n-- Python 3.13.3+ (for building only)\n-- PyInstaller (will be installed automatically if missing)\n-\n-### Build\n-\n-To create a standalone executable that customers can run without Python installation:\n-\n-```bash\n-./build.sh\n-```\n-\n-This will create an executable file in `dist/datasaur-cli`\n-\n-### Basic Commands\n-\n-```bash\n-# Show help\n-./datasaur-cli --help\n-\n-# Show version\n-./datasaur-cli --version\n-\n-# Get help for a specific command\n-./datasaur-cli install --help\n-```\n-\n-### Complete Workflow\n-\n-Here's a complete workflow from installation to upgrade:\n-\n-```bash\n-# 1. Install\n-./datasaur-cli install\n-\n-# 2. Configure\n-./datasaur-cli configure\n-\n-# 3. Start services\n-./datasaur-cli start\n-\n-# 4. Stop services\n-./datasaur-cli stop\n-```"},{"sha":"41fc7da5f4dd3849f56633ba58daa1c857136def","filename":"datasaur-cli/datasaur-cli/datasaur_cli/__init__.py","status":"removed","additions":0,"deletions":4,"changes":4,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,4 +0,0 @@\n-\"\"\"Datasaur CLI - Manage your Datasaur on-premise installation.\"\"\"\n-\n-__version__ = \"1.0.0\"\n-"},{"sha":"c546acf49519a4b35a584bf36fc87d8c311a8dce","filename":"datasaur-cli/datasaur-cli/datasaur_cli/cli.py","status":"removed","additions":0,"deletions":23,"changes":23,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcli.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcli.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcli.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,23 +0,0 @@\n-\"\"\"Main CLI entry point using Click.\"\"\"\n-\n-import click\n-from datasaur_cli import __version__\n-from datasaur_cli.commands.install import install\n-from datasaur_cli.commands.configure import configure\n-from datasaur_cli.commands.start import start\n-from datasaur_cli.commands.stop import stop\n-from datasaur_cli.commands.upgrade import upgrade\n-\n-@click.group()\n-@click.version_option(version=__version__)\n-def cli():\n-    \"\"\"Datasaur CLI - Manage your Datasaur on-premise installation.\"\"\"\n-    pass\n-\n-cli.add_command(install)\n-cli.add_command(configure)\n-cli.add_command(start)\n-cli.add_command(stop)\n-cli.add_command(upgrade)\n-if __name__ == \"__main__\":\n-    cli()"},{"sha":"269be7283c9ae99790d4db78f166ed9ff762e58d","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/__init__.py","status":"removed","additions":0,"deletions":2,"changes":2,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,2 +0,0 @@\n-\"\"\"Commands package for datasaur-cli.\"\"\"\n-"},{"sha":"d48828aa0816d0f1609dd0d042f9e43f2fbd4603","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/directories_handler.py","status":"removed","additions":0,"deletions":403,"changes":403,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fdirectories_handler.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fdirectories_handler.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fdirectories_handler.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,403 +0,0 @@\n-import os\n-from pathlib import Path\n-from typing import Any, Dict, List, Optional\n-\n-import click\n-\n-\n-class DirectoryActionHandler:\n-    def run(self, directory: Dict[str, Any], directories_on_error: Optional[Dict[str, Dict[str, Any]]], error_key: str) -> bool:\n-        action = directory.get('on_error', {}).get(error_key, {}).get('action')\n-        if directories_on_error:\n-            action = action if action else directories_on_error.get(error_key, {}).get('action')\n-\n-        if action == 'create':\n-            return self._create_directory(directory)\n-\n-        return False\n-\n-    def _create_directory(self, directory: Dict[str, Any]) -> bool:\n-        directory_path = Path(directory.get('directory_path'))\n-        directory_path.mkdir(parents=True, exist_ok=True)\n-        return True\n-\n-class DirectoriesHandler:\n-    def handle(self, artifact_directory: Path, manifest: Dict[str, Any], forbidden_items: Optional[Dict[str, str]] = None) -> bool:\n-        \"\"\"\n-        Validate directories.\n-\n-        Args:\n-            artifact_directory: Base artifact directory\n-            manifest: Manifest dictionary\n-            forbidden_items: Optional shared dict to track paths where permission setting failed.\n-                           If provided, will be updated in place. Later handlers can override earlier entries.\n-\n-        Returns: ok\n-        \"\"\"\n-        directories = manifest.get('directories')\n-        if not directories or len(directories) == 0:\n-            return True\n-\n-        ok = self._validate_directories_schema(directories)\n-        if not ok:\n-            return False\n-\n-        directories_on_error = manifest.get('directories_on_error')\n-        ok = self._validate_directories_on_error_schema(directories_on_error)\n-        if not ok:\n-            return False\n-\n-        ok = self._validate_directories(artifact_directory, directories, directories_on_error, forbidden_items)\n-        if not ok:\n-            return False\n-\n-        return True\n-\n-    def _validate_directories_schema(self, directories: List[Dict[str, Any]]) -> bool:\n-        click.echo(\"Validating directories schema...\")\n-\n-        required_fields = ['directory_path']\n-        optional_fields = ['permission', 'content_permission']\n-        optional_bool_fields = ['recursive']\n-        for index, directory in enumerate(directories):\n-            for field in required_fields:\n-                if field not in directory:\n-                    click.echo(click.style(f\"✗ Directories schema is invalid: Directory schema in index {index} must have `{field}` field\", fg='red'))\n-                    return False\n-                if not isinstance(directory[field], str):\n-                    click.echo(click.style(f\"✗ Directories schema is invalid: Directory schema in index {index} must have `{field}` field of type string\", fg='red'))\n-                    return False\n-\n-            for field in optional_fields:\n-                if field in directory and not isinstance(directory[field], str):\n-                    click.echo(click.style(f\"✗ Directories schema is invalid: Directory schema in index {index} must have `{field}` field of type string\", fg='red'))\n-                    return False\n-\n-            for field in optional_bool_fields:\n-                if field in directory and not isinstance(directory[field], bool):\n-                    click.echo(click.style(f\"✗ Directories schema is invalid: Directory schema in index {index} must have `{field}` field of type boolean\", fg='red'))\n-                    return False\n-\n-        click.echo(click.style(\"✓ Directories schema is valid\", fg='green'))\n-        click.echo()\n-        return True\n-\n-    def _validate_directories_on_error_schema(self, directories_on_error: Optional[Dict[str, Dict[str, Any]]]) -> bool:\n-        if not directories_on_error:\n-            return True\n-\n-        click.echo(\"Validating directories on error schema...\")\n-\n-        optional_fields = ['directory_path_not_found']\n-        sub_fields = ['action', 'message']\n-\n-        for field in optional_fields:\n-            if field in directories_on_error:\n-                if not isinstance(directories_on_error[field], Dict):\n-                    click.echo(click.style(f\"✗ Directories on error schema is invalid: Must have `{field}` field of type dictionary\", fg='red'))\n-                    return False\n-\n-                for sub_field in sub_fields:\n-                    if sub_field in directories_on_error[field] and not isinstance(directories_on_error[field][sub_field], str):\n-                        click.echo(click.style(f\"✗ Directories on error schema is invalid: Must have `{field}.{sub_field}` field of type string\", fg='red'))\n-                        return False\n-\n-        click.echo(click.style(\"✓ Directories on error schema is valid\", fg='green'))\n-        click.echo()\n-        return True\n-\n-    def _validate_directories(self, artifact_directory: Path, directories: List[Dict[str, Any]], directories_on_error: Optional[Dict[str, Dict[str, Any]]], forbidden_items: Optional[Dict[str, str]] = None) -> bool:\n-        click.echo(\"Validating directories...\")\n-        directory_action_handler = DirectoryActionHandler()\n-\n-        # Use dict to track forbidden paths and permissions (later entries override earlier ones)\n-        if forbidden_items is None:\n-            forbidden_items = {}\n-\n-        # Process directories in order. Later entries will override permissions set by earlier entries.\n-        # This allows for fine-grained control over nested directories and their contents.\n-        for directory in directories:\n-            directory_path = Path(directory.get('directory_path'))\n-            full_directory_path = artifact_directory / directory_path\n-            click.echo(f\"  {directory_path}...\", nl=False)\n-\n-            if not self._validate_directory_existence(full_directory_path, directory_action_handler, directory, directories_on_error):\n-                return False\n-\n-            if not self._validate_directory_type(full_directory_path):\n-                return False\n-\n-            if 'permission' in directory:\n-                if self._set_directory_permission(full_directory_path, directory.get('permission')):\n-                    # Remove from forbidden if it succeeded this time (may have failed earlier)\n-                    forbidden_items.pop(str(full_directory_path), None)\n-                else:\n-                    forbidden_items[str(full_directory_path)] = directory.get('permission')\n-                    continue\n-\n-            click.echo(click.style(\" ✓\", fg='green'))\n-\n-            # Handle recursive validation if enabled\n-            if directory.get('recursive', False):\n-                # Use content_permission if provided, otherwise fall back to permission\n-                content_permission = directory.get('content_permission') or directory.get('permission')\n-                self._validate_directory_recursive(\n-                    artifact_directory,\n-                    full_directory_path,\n-                    content_permission,\n-                    forbidden_items\n-                )\n-\n-        # Don't print errors here - let the caller decide after all handlers run\n-        # This allows later handlers (like files) to override permissions\n-        if len(forbidden_items) == 0:\n-            click.echo(click.style(\"✓ Directories are valid\", fg='green'))\n-        else:\n-            click.echo(click.style(\"⚠ Some directories or files failed permission check (may be fixed by files handler)\", fg='yellow'))\n-\n-        click.echo()\n-        return True\n-\n-    def _validate_directory_recursive(self, artifact_directory: Path, full_directory_path: Path,\n-                                     content_permission: Optional[str], forbidden_items: Dict[str, str]) -> None:\n-        \"\"\"\n-        Recursively validate all subdirectories and files within a directory.\n-\n-        Args:\n-            artifact_directory: Base artifact directory\n-            full_directory_path: Full path to the directory to validate recursively\n-            content_permission: Permission string to apply to subdirectories and files (optional).\n-                              Falls back to parent directory's permission if not specified.\n-            forbidden_items: Dict to update with paths where permission setting failed.\n-                           Paths that succeed are removed from this dict.\n-\n-        Returns:\n-            None (updates forbidden_items dict in place)\n-        \"\"\"\n-        try:\n-            # Walk through all subdirectories and files\n-            for root, dirs, files in os.walk(full_directory_path):\n-                root_path = Path(root)\n-\n-                # Validate subdirectories\n-                for dir_name in dirs:\n-                    dir_path = root_path / dir_name\n-                    relative_path = dir_path.relative_to(artifact_directory)\n-                    click.echo(f\"  {relative_path}...\", nl=False)\n-\n-                    # Validate it's actually a directory\n-                    if not dir_path.is_dir():\n-                        click.echo()\n-                        click.echo(click.style(\"    ✗ Path is not a directory\", fg='red'))\n-                        self._print_validate_directories_failed(directory=None, directories_on_error=None, error_key=None)\n-                        continue\n-\n-                    # Apply content_permission if specified\n-                    if content_permission:\n-                        if self._set_directory_permission(dir_path, content_permission):\n-                            # Remove from forbidden if it succeeded (may have failed earlier)\n-                            forbidden_items.pop(str(dir_path), None)\n-                        else:\n-                            # Add to forbidden if it failed\n-                            forbidden_items[str(dir_path)] = content_permission\n-                            continue\n-\n-                    click.echo(click.style(\" ✓\", fg='green'))\n-\n-                # Validate files\n-                for file_name in files:\n-                    file_path = root_path / file_name\n-                    relative_path = file_path.relative_to(artifact_directory)\n-                    click.echo(f\"  {relative_path}...\", nl=False)\n-\n-                    # Validate it's actually a file\n-                    if not file_path.is_file():\n-                        click.echo()\n-                        click.echo(click.style(\"    ✗ Path is not a file\", fg='red'))\n-                        self._print_validate_directories_failed(directory=None, directories_on_error=None, error_key=None)\n-                        continue\n-\n-                    # Apply content_permission if specified\n-                    if content_permission:\n-                        if self._set_file_permission(file_path, content_permission):\n-                            # Remove from forbidden if it succeeded (may have failed earlier)\n-                            forbidden_items.pop(str(file_path), None)\n-                        else:\n-                            # Add to forbidden if it failed\n-                            forbidden_items[str(file_path)] = content_permission\n-                            continue\n-\n-                    click.echo(click.style(\" ✓\", fg='green'))\n-\n-        except Exception as e:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ Error during recursive validation: {e}\", fg='red'))\n-            self._print_validate_directories_failed(directory=None, directories_on_error=None, error_key=None)\n-\n-    def _optimize_chmod_commands(self, forbidden_items: Dict[str, str]) -> List[str]:\n-        \"\"\"\n-        Optimize chmod commands by grouping by permission and using -R for directories.\n-\n-        Args:\n-            forbidden_items: Dict mapping path to permission\n-\n-        Returns:\n-            List of optimized chmod commands\n-        \"\"\"\n-        # Group paths by permission\n-        permission_groups: Dict[str, List[str]] = {}\n-        for path, permission in forbidden_items.items():\n-            if permission not in permission_groups:\n-                permission_groups[permission] = []\n-            permission_groups[permission].append(path)\n-\n-        commands = []\n-\n-        for permission, paths in permission_groups.items():\n-            # Convert to Path objects and sort by depth (parents first)\n-            path_objects = [(Path(p), p) for p in paths]\n-            path_objects.sort(key=lambda x: (len(x[0].parts), str(x[0])))\n-\n-            processed_paths = set()\n-\n-            for path_obj, path_str in path_objects:\n-                # Skip if already processed\n-                if path_str in processed_paths:\n-                    continue\n-\n-                # Skip if this path is already covered by a parent directory\n-                is_covered = False\n-                for processed_str in processed_paths:\n-                    processed_path = Path(processed_str)\n-                    if processed_path.is_dir():\n-                        try:\n-                            path_obj.relative_to(processed_path)\n-                            is_covered = True\n-                            break\n-                        except ValueError:\n-                            continue\n-\n-                if is_covered:\n-                    continue\n-\n-                # Check if this is a directory\n-                if path_obj.is_dir():\n-                    # Use -R for directories to cover all contents\n-                    commands.append(f\"sudo chmod -R {permission} {path_str}\")\n-                    processed_paths.add(path_str)\n-                else:\n-                    # For individual files, just add them\n-                    commands.append(f\"sudo chmod {permission} {path_str}\")\n-                    processed_paths.add(path_str)\n-\n-        return commands\n-\n-    def _validate_directory_existence(self, directory_path: Path, directory_action_handler: DirectoryActionHandler,\n-                                   directory: Dict[str, Any], directories_on_error: Optional[Dict[str, Dict[str, Any]]]) -> bool:\n-        \"\"\"\n-        Validate directory existence.\n-\n-        Args:\n-            directory_path: Path to the directory to validate\n-            directory_action_handler: Handler for directory actions\n-            directory: Directory dictionary from manifest\n-            directories_on_error: Error handling configuration\n-\n-        Returns:\n-            bool: True if directory exists or was created, False otherwise\n-        \"\"\"\n-        if not directory_path.exists():\n-            error_key = 'directory_path_not_found'\n-            if not directory_action_handler.run(directory, directories_on_error, error_key):\n-                click.echo()\n-                click.echo(click.style(\"    ✗ Directory not found\", fg='red'))\n-                self._print_validate_directories_failed(\n-                    directory=directory,\n-                    directories_on_error=directories_on_error,\n-                    error_key=error_key\n-                )\n-                return False\n-        return True\n-\n-    def _validate_directory_type(self, directory_path: Path) -> bool:\n-        \"\"\"\n-        Validate the directory type.\n-\n-        Args:\n-            directory_path: Path to the directory to validate\n-\n-        Returns:\n-            bool: True if directory type is valid, False otherwise\n-        \"\"\"\n-        if directory_path.exists() and not directory_path.is_dir():\n-            click.echo()\n-            click.echo(click.style(\"    ✗ Path exists but is not a directory\", fg='red'))\n-            self._print_validate_directories_failed(directory=None, directories_on_error=None, error_key=None)\n-            return False\n-        return True\n-\n-    def _set_directory_permission(self, directory_path: Path, permission: str) -> bool:\n-        \"\"\"\n-        Set directory permissions.\n-\n-        Args:\n-            directory_path: Path to the directory\n-            permission: Permission string in octal format (e.g., '755')\n-\n-        Returns:\n-            bool: True if permission was set successfully, False otherwise\n-        \"\"\"\n-        try:\n-            directory_mode = os.stat(directory_path).st_mode\n-            octal_directory_mode = oct(directory_mode)[-4:]\n-            if octal_directory_mode != permission:\n-                os.chmod(directory_path, int(permission, 8))\n-            return True\n-        except ValueError:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ Directory permission {permission} is invalid\", fg='red'))\n-        except Exception as e:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ Failed to set directory permission {permission}: {e}\", fg='red'))\n-\n-        return False\n-\n-    def _set_file_permission(self, file_path: Path, permission: str) -> bool:\n-        \"\"\"\n-        Set file permissions.\n-\n-        Args:\n-            file_path: Path to the file\n-            permission: Permission string in octal format (e.g., '644')\n-\n-        Returns:\n-            bool: True if permission was set successfully, False otherwise\n-        \"\"\"\n-        try:\n-            file_mode = os.stat(file_path).st_mode\n-            octal_file_mode = oct(file_mode)[-4:]\n-            if octal_file_mode != permission:\n-                os.chmod(file_path, int(permission, 8))\n-            return True\n-        except ValueError:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ File permission {permission} is invalid\", fg='red'))\n-        except Exception as e:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ Failed to set file permission {permission}: {e}\", fg='red'))\n-\n-        return False\n-\n-    def _print_validate_directories_failed(self, directory: Optional[Dict[str, Any]], directories_on_error: Optional[Dict[str, Dict[str, Any]]], error_key: Optional[str]) -> None:\n-        click.echo(click.style(\"✗ Directories validation failed\", fg='orange'))\n-\n-        if not directory or not error_key:\n-            return\n-        error_message = directory.get('on_error', {}).get(error_key, {}).get('message')\n-        if directories_on_error:\n-            error_message = error_message if error_message else directories_on_error.get(error_key, {}).get('message')\n-        if not error_message:\n-            return\n-        click.echo()\n-        click.echo(click.style(error_message, fg='red'))\n-"},{"sha":"a2e3967d4adb0595b2d2ff03f186e71005b8092d","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/file_readers/json_file_reader.py","status":"removed","additions":0,"deletions":23,"changes":23,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Ffile_readers%2Fjson_file_reader.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Ffile_readers%2Fjson_file_reader.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcomman