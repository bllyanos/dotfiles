file_content, error_message)\n-        \"\"\"\n-        if not file_path.exists():\n-            return None, f\"{file_path.name} not found\"\n-\n-        try:\n-            with open(file_path, 'r') as f:\n-                file_content = yaml.safe_load(f)\n-        except yaml.YAMLError as e:\n-            return None, f\"Error while reading {file_path.name}: YAML error: {str(e)}\"\n-        except Exception as e:\n-            return None, f\"Error while reading {file_path.name}: {str(e)}\"\n-\n-        return file_content, None"},{"sha":"15c6c654a0c690a2594a0d413c818f04afdfba76","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/files_handler.py","status":"removed","additions":0,"deletions":304,"changes":304,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Ffiles_handler.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Ffiles_handler.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Ffiles_handler.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,304 +0,0 @@\n-import hashlib\n-import os\n-import stat\n-from pathlib import Path\n-from typing import Any, Dict, List, Optional\n-\n-import click\n-from datasaur_cli.commands.common.file_readers.yaml_file_reader import \\\n-    YamlFileReader\n-\n-FILE_CHUNK_SIZE_FOR_CHECKSUM = 4096\n-\n-class FileActionHandler:\n-    def run(self, file_path: Path, file: Dict[str, Any], files_on_error: Optional[Dict[str, Dict[str, Any]]], error_key: str) -> bool:\n-        action = file.get('on_error', {}).get(error_key, {}).get('action')\n-        if files_on_error:\n-            action = action if action else files_on_error.get(error_key, {}).get('action')\n-\n-        if action == 'create':\n-            return self._create_file(file_path)\n-\n-        return False\n-\n-    def _create_file(self, file_path: Path) -> bool:\n-        \"\"\"\n-        Create a file at the specified path.\n-\n-        Args:\n-            file_path: Full path to the file to create\n-\n-        Returns:\n-            bool: True if file was created successfully, False otherwise\n-        \"\"\"\n-        # Ensure parent directories exist\n-        file_path.parent.mkdir(parents=True, exist_ok=True)\n-        # Create the file (touch() creates an empty file if it doesn't exist)\n-        file_path.touch()\n-        # Verify it's actually a file, not a directory\n-        if not file_path.is_file():\n-            return False\n-        return True\n-\n-class FilesHandler:\n-    def handle(self, artifact_directory: Path, manifest: Dict[str, Any], forbidden_items: Optional[Dict[str, str]] = None) -> bool:\n-        \"\"\"\n-        Validate files.\n-\n-        Args:\n-            artifact_directory: Base artifact directory\n-            manifest: Manifest dictionary\n-            forbidden_items: Optional shared dict to track paths where permission setting failed.\n-                           If provided, will be updated in place. Later handlers can override earlier entries.\n-\n-        Returns: ok\n-        \"\"\"\n-        files = manifest.get('files')\n-        if not files or len(files) == 0:\n-            return True\n-\n-        ok = self._validate_files_schema(files)\n-        if not ok:\n-            return False\n-\n-        files_on_error = manifest.get('files_on_error')\n-        ok = self._validate_files_on_error_schema(files_on_error)\n-        if not ok:\n-            return False\n-\n-        ok = self._validate_files(artifact_directory, files, files_on_error, forbidden_items)\n-        if not ok:\n-            return False\n-\n-        return True\n-\n-    def _validate_files_schema(self, files: List[Dict[str, Any]]) -> bool:\n-        click.echo(\"Validating files schema...\")\n-\n-        required_fields = ['file_path']\n-        optional_fields = ['sha256_checksum', 'permission']\n-        for index, file in enumerate(files):\n-            for field in required_fields:\n-                if field not in file:\n-                    click.echo(click.style(f\"✗ Files schema is invalid: File schema in index {index} must have `{field}` field\", fg='red'))\n-                    return False\n-                if not isinstance(file[field], str):\n-                    click.echo(click.style(f\"✗ Files schema is invalid: File schema in index {index} must have `{field}` field of type string\", fg='red'))\n-                    return False\n-\n-            for field in optional_fields:\n-                if field in file and not isinstance(file[field], str):\n-                    click.echo(click.style(f\"✗ Files schema is invalid: File schema in index {index} must have `{field}` field of type string\", fg='red'))\n-                    return False\n-\n-        click.echo(click.style(\"✓ Files schema is valid\", fg='green'))\n-        click.echo()\n-        return True\n-\n-    def _validate_files_on_error_schema(self, files_on_error: Optional[Dict[str, Dict[str, Any]]]) -> bool:\n-        if not files_on_error:\n-            return True\n-\n-        click.echo(\"Validating files on error schema...\")\n-\n-        optional_fields = ['file_path_not_found', 'sha256_checksum_not_match']\n-        sub_fields = ['action', 'message']\n-\n-        for field in optional_fields:\n-            if field in files_on_error:\n-                if not isinstance(files_on_error[field], Dict):\n-                    click.echo(click.style(f\"✗ Files on error schema is invalid: Must have `{field}` field of type dictionary\", fg='red'))\n-                    return False\n-\n-                for sub_field in sub_fields:\n-                    if sub_field in files_on_error[field] and not isinstance(files_on_error[field][sub_field], str):\n-                        click.echo(click.style(f\"✗ Files on error schema is invalid: Must have `{field}.{sub_field}` field of type string\", fg='red'))\n-                        return False\n-\n-        click.echo(click.style(\"✓ Files on error schema is valid\", fg='green'))\n-        click.echo()\n-        return True\n-\n-    def _validate_files(self, artifact_directory: Path, files: List[Dict[str, Any]], files_on_error: Optional[Dict[str, Dict[str, Any]]], forbidden_items: Optional[Dict[str, str]] = None) -> bool:\n-        click.echo(\"Validating files...\")\n-        file_action_handler = FileActionHandler()\n-\n-        # Use dict to track forbidden paths and permissions (later entries override earlier ones)\n-        if forbidden_items is None:\n-            forbidden_items = {}\n-\n-        for file in files:\n-            file_path = Path(file.get('file_path'))\n-            full_file_path = artifact_directory / file_path\n-            click.echo(f\"  {file_path}...\", nl=False)\n-\n-            if not self._validate_file_existence(full_file_path, file_action_handler, file, files_on_error):\n-                return False\n-\n-            if not self._validate_file_type(full_file_path):\n-                return False\n-\n-            if 'permission' in file:\n-                if self._set_file_permission(full_file_path, file.get('permission')):\n-                    # Remove from forbidden if it succeeded this time (may have failed earlier)\n-                    forbidden_items.pop(str(full_file_path), None)\n-                else:\n-                    forbidden_items[str(full_file_path)] = file.get('permission')\n-                    continue\n-\n-            if 'sha256_checksum' in file and not self._validate_file_checksum(full_file_path, file.get('sha256_checksum'), file, files_on_error):\n-                return False\n-\n-            click.echo(click.style(\" ✓\", fg='green'))\n-        # Don't print errors here - let the caller decide after all handlers run\n-        # This allows later handlers to override permissions\n-        if len(forbidden_items) == 0:\n-            click.echo(click.style(\"✓ Files are valid\", fg='green'))\n-        else:\n-            click.echo(click.style(\"⚠ Some files failed permission check\", fg='yellow'))\n-\n-        click.echo()\n-        return True\n-\n-    def _validate_file_existence(self, file_path: Path, file_action_handler: FileActionHandler,\n-                               file: Dict[str, Any], files_on_error: Optional[Dict[str, Dict[str, Any]]]) -> bool:\n-        \"\"\"\n-        Validate file existence.\n-\n-        Args:\n-            file_path: Path to the file to validate\n-            file_action_handler: Handler for file actions\n-            file: File dictionary from manifest\n-            files_on_error: Error handling configuration\n-\n-        Returns:\n-            bool: True if file exists or was created, False otherwise\n-        \"\"\"\n-        # Check if a directory exists at the file path\n-        if file_path.exists() and file_path.is_dir():\n-            click.echo()\n-            click.echo(click.style(\"    ✗ Path exists as a directory, not a file\", fg='orange'))\n-            self._print_validate_files_failed(file=None, files_on_error=None, error_key=None)\n-            return False\n-\n-        if not file_path.exists():\n-            error_key = 'file_path_not_found'\n-            if not file_action_handler.run(file_path, file, files_on_error, error_key):\n-                click.echo(click.style(\"    ✗ File not found\", fg='red'))\n-                self._print_validate_files_failed(\n-                    file=file,\n-                    files_on_error=files_on_error,\n-                    error_key=error_key\n-                )\n-                return False\n-        return True\n-\n-    def _validate_file_type(self, file_path: Path) -> bool:\n-        \"\"\"\n-        Validate the file type.\n-\n-        Args:\n-            file_path: Path to the file to validate\n-\n-        Returns:\n-            bool: True if file type is valid, False otherwise\n-        \"\"\"\n-        # Ensure the path is actually a file, not a directory\n-        if not file_path.is_file():\n-            click.echo()\n-            click.echo(click.style(\"    ✗ Path is a directory, not a file\", fg='red'))\n-            self._print_validate_files_failed(file=None, files_on_error=None, error_key=None)\n-            return False\n-\n-        if file_path.suffix:\n-            file_type = file_path.suffix[1:]\n-            if file_type == 'yaml' or file_type == 'yml':\n-                _, error_message = YamlFileReader().read(file_path)\n-                if error_message:\n-                    click.echo()\n-                    click.echo(click.style(f\"    ✗ File is not a valid YAML file: {error_message}\", fg='red'))\n-                    self._print_validate_files_failed(file=None, files_on_error=None, error_key=None)\n-                    return False\n-        return True\n-\n-    def _set_file_permission(self, file_path: Path, permission: str) -> bool:\n-        \"\"\"\n-        Set file permissions.\n-\n-        Args:\n-            file_path: Path to the file\n-            permission: Permission string in octal format (e.g., '644')\n-\n-        Returns:\n-            bool: True if permission was set successfully, False otherwise\n-        \"\"\"\n-        try:\n-            file_mode = os.stat(file_path).st_mode\n-            octal_file_mode = oct(file_mode)[-4:]\n-            if octal_file_mode != permission:\n-                os.chmod(file_path, int(permission, 8))\n-            return True\n-        except ValueError:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ File permission {permission} is invalid\", fg='red'))\n-        except Exception as e:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ Failed to set file permission {permission}: {e}\", fg='red'))\n-\n-        self._print_validate_files_failed(file=None, files_on_error=None, error_key=None)\n-        return False\n-\n-    def _validate_file_checksum(self, file_path: Path, expected_checksum: str, file: Dict[str, Any],\n-                              files_on_error: Optional[Dict[str, Dict[str, Any]]]) -> bool:\n-        \"\"\"\n-        Validate file checksum against expected value.\n-\n-        Args:\n-            file_path: Path to the file\n-            expected_checksum: Expected SHA-256 checksum\n-            file: File dictionary from manifest\n-            files_on_error: Error handling configuration\n-\n-        Returns:\n-            bool: True if checksum matches, False otherwise\n-        \"\"\"\n-        sha256_hash = hashlib.sha256()\n-        try:\n-            with open(file_path, 'rb') as f:\n-                for byte_block in iter(lambda: f.read(FILE_CHUNK_SIZE_FOR_CHECKSUM), b\"\"):\n-                    sha256_hash.update(byte_block)\n-            actual_checksum = sha256_hash.hexdigest()\n-\n-            if actual_checksum != expected_checksum:\n-                click.echo()\n-                click.echo(click.style(\n-                    f\"    ✗ File checksum does not match. File checksum: {actual_checksum}. \"\n-                    f\"Expected checksum: {expected_checksum}.\",\n-                    fg='red'\n-                ))\n-                self._print_validate_files_failed(\n-                    error_key='sha256_checksum_not_match',\n-                    file=file,\n-                    files_on_error=files_on_error\n-                )\n-                return False\n-            return True\n-\n-        except Exception as e:\n-            click.echo()\n-            click.echo(click.style(f\"    ✗ Failed to calculate file checksum: {e}\", fg='red'))\n-            self._print_validate_files_failed(file=None, files_on_error=None, error_key=None)\n-            return False\n-\n-    def _print_validate_files_failed(self, file: Optional[Dict[str, Any]], files_on_error