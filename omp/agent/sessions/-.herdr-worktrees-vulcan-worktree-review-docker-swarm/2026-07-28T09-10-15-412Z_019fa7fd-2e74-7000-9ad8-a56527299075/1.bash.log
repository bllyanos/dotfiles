\", fg='red'))\n-                    return False\n-                if not isinstance(step[field], str):\n-                    click.echo(click.style(f\"✗ Steps schema is invalid: Step schema in index {index} must have `{field}` field of type string\", fg='red'))\n-                    return False\n-            for field in optional_fields:\n-                if field in step:\n-                    if not isinstance(step[field], list):\n-                        click.echo(click.style(f\"✗ Steps schema is invalid: Step schema in index {index} must have `{field}` field of type array/list\", fg='red'))\n-                        return False\n-                    for arg in step[field]:\n-                        if not isinstance(arg, str):\n-                            click.echo(click.style(f\"✗ Steps schema is invalid: Step schema in index {index} must have `{field}` field of type array/list of strings\", fg='red'))\n-                            return False\n-\n-        click.echo(click.style(\"✓ Steps schema is valid\", fg='green'))\n-        click.echo()\n-        return True\n-\n-    def _run_step(self, artifact_directory: Path, step: Dict, index: int, total_steps: int) -> bool:\n-        name = step.get('name')\n-        script_path = step.get('script_path')\n-        args = argument_parser.parseArgs(step.get('args', []))\n-        click.echo(f\"in steps: {args}\")\n-        click.echo(f\"Step {index + 1}/{total_steps}: {name}...\")\n-\n-        try:\n-            result = subprocess.run(\n-                f\"./{script_path} {' '.join(args)}\",\n-                cwd=str(artifact_directory),\n-                shell=True,\n-                timeout=SCRIPT_TIMEOUT_IN_SECONDS,\n-            )\n-            if result.returncode != 0:\n-                click.echo(click.style(f\"✗ Step failed with return code: {result.returncode}\", fg='red'))\n-                return False\n-\n-        except Exception as e:\n-            click.echo(click.style(f\"✗ Step failed: {e}\", fg='red'))\n-            return False\n-\n-        click.echo(click.style(\"✓ Step finished\", fg='green'))\n-        click.echo()\n-        return True"},{"sha":"799e5341d9549eb3b6b357e3aedd957277c335b7","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/common/sub_manifest_handler.py","status":"removed","additions":0,"deletions":20,"changes":20,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsub_manifest_handler.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsub_manifest_handler.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fcommon%2Fsub_manifest_handler.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,20 +0,0 @@\n-from typing import Dict, Tuple, Optional\n-import click\n-\n-class SubManifestHandler:\n-    def handle(self, manifest: Dict, key: str) -> Tuple[Optional[Dict], bool]:\n-        \"\"\"\n-        Get the sub manifest.\n-\n-        Returns: (sub_manifest, ok)\n-        \"\"\"\n-        click.echo(f\"Reading `{key}` from manifest...\")\n-\n-        sub_manifest = manifest.get(key)\n-        if not sub_manifest:\n-            click.echo(click.style(f\"✗ Failed to read `{key}` from manifest: `{key}` not found\", fg='red'))\n-            return None, False\n-\n-        click.echo(click.style(f\"✓ `{key}` is read\", fg='green'))\n-        click.echo()\n-        return sub_manifest, True"},{"sha":"808a7e7dea5d9811993397351c019854a2e92b54","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/configure/__init__.py","status":"removed","additions":0,"deletions":6,"changes":6,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,6 +0,0 @@\n-\"\"\"Configure command package for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.configure.configure import configure\n-\n-__all__ = ['configure']\n-"},{"sha":"7ca765cf31b4a55f1ca4e35c3a26c280c7314f44","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/configure/configure.py","status":"removed","additions":0,"deletions":57,"changes":57,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fconfigure.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fconfigure.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fconfigure.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,57 +0,0 @@\n-\"\"\"Configure command for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.common.helpers.helpers import get_env_file_path\n-from datasaur_cli.commands.common.steps.checkers_step import CheckersStep\n-from datasaur_cli.commands.common.steps.hook_steps_step import HookStepsStep\n-from datasaur_cli.commands.common.steps.load_config_schema_step import LoadConfigSchemaStep\n-from datasaur_cli.commands.configure.steps.generate_env_file_step import GenerateEnvFileStep\n-from datasaur_cli.commands.configure.steps.prompt_all_fields_step import PromptAllFieldsStep\n-from datasaur_cli.constants import DEFAULT_ARTIFACT_DIRECTORY\n-from pathlib import Path\n-import click\n-\n-# TODO\n-# Please make this command work with `configure` field in ../../../../docker/nlp/build/manifest.json\n-@click.command()\n-@click.argument(\n-    'artifact_directory',\n-    type=click.Path(exists=True, file_okay=False, dir_okay=True, path_type=Path),\n-    default=DEFAULT_ARTIFACT_DIRECTORY\n-)\n-def configure(artifact_directory: Path):\n-    \"\"\"\n-    Configure Datasaur installation interactively.\n-\n-    ARTIFACT_DIRECTORY: Directory containing config-schema.json\n-    \"\"\"\n-    from datasaur_cli.commands.common.steps.validators_step import ValidatorsStep\n-    steps = [ValidatorsStep(), CheckersStep()]\n-    for step in steps:\n-        is_success = step.run(artifact_directory)\n-        if not is_success:\n-            return 1\n-\n-    is_success = HookStepsStep().run('pre-configure', artifact_directory)\n-    if not is_success:\n-        return 1\n-\n-    config_schema = LoadConfigSchemaStep().run(artifact_directory)\n-    if not config_schema:\n-        return 1\n-\n-    env_file_path = get_env_file_path(artifact_directory, config_schema)\n-    config = PromptAllFieldsStep().run(config_schema, env_file_path)\n-    if not config:\n-        return 1\n-\n-    is_success = GenerateEnvFileStep().run(config, env_file_path)\n-    if not is_success:\n-        return 1\n-\n-    is_success = HookStepsStep().run('post-configure', artifact_directory)\n-    if not is_success:\n-        return 1\n-\n-    click.echo(\"Next step:\")\n-    click.echo(\"  ./datasaur-cli start\")\n-    return 0"},{"sha":"030f834620976682b30cdf7a2bd61a2492eefc57","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/configure/steps/generate_env_file_step.py","status":"removed","additions":0,"deletions":58,"changes":58,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fgenerate_env_file_step.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fgenerate_env_file_step.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fgenerate_env_file_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,58 +0,0 @@\n-from pathlib import Path\n-from typing import Dict, Optional\n-import click\n-\n-class GenerateEnvFileStep:\n-    def run(self, config: Dict, env_file_path: Path) -> bool:\n-        click.echo(\"Generating configuration file...\")\n-        success = self._generate_env_file(config, env_file_path)\n-\n-        if not success:\n-            click.echo(click.style(f\"✗ Failed to generate configuration file\", fg='red'))\n-            click.echo(\"\")\n-            return False\n-\n-        click.echo(click.style(f\"✓ Configuration saved to: {env_file_path}\", fg='green'))\n-        click.echo(\"\")\n-        return True\n-\n-    def _generate_env_file(self, config: Dict, env_file_path: Path, template_path: Optional[Path] = None) -> bool:\n-        \"\"\"\n-        Generate datasaur.env file from configuration values.\n-\n-        Args:\n-            config: Dictionary of configuration key-value pairs\n-            env_file_path: Path where to write the .env file\n-            template_path: Optional template file to use as base\n-\n-        Returns: True if successful\n-        \"\"\"\n-        try:\n-            # If template exists, use it as base\n-            if template_path and template_path.exists():\n-                with open(template_path, 'r') as f:\n-                    content = f.read()\n-\n-                # Replace values in template\n-                for key, value in config.items():\n-                    # Replace KEY=value or KEY= (empty)\n-                    import re\n-                    pattern = rf'^{re.escape(key)}=.*$'\n-                    replacement = f\"{key}={value}\"\n-                    content = re.sub(pattern, replacement, content, flags=re.MULTILINE)\n-\n-                # Write to env file\n-                with open(env_file_path, 'w') as f:\n-                    f.write(content)\n-            else:\n-                # Generate new file\n-                with open(env_file_path, 'w') as f:\n-                    f.write(\"# Datasaur Configuration\\n\")\n-                    f.write(\"# Generated by datasaur-cli configure\\n\\n\")\n-\n-                    for key, value in sorted(config.items()):\n-                        f.write(f\"{key}={value}\\n\")\n-\n-            return True\n-        except Exception as e:\n-            return False"},{"sha":"a2948b8cffc3ff2f3b6afa703116e740ab66e2f8","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/configure/steps/helpers.py","status":"removed","additions":0,"deletions":45,"changes":45,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fhelpers.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fhelpers.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fhelpers.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,45 +0,0 @@\n-from typing import Dict\n-\n-def clean_schema_for_validation(schema: Dict) -> Dict:\n-    \"\"\"\n-    Remove custom fields from schema before JSON Schema validation.\n-    Custom fields: requiredConfigs, required (on properties), prompt, secret, generate, generateLength, requiredIf\n-\n-    Also generates a standard JSON Schema 'required' array from requiredConfigs and individual required: true properties.\n-\n-    Returns: Cleaned schema dict\n-    \"\"\"\n-    import copy\n-    cleaned = copy.deepcopy(schema)\n-\n-    # Remove custom root-level field\n-    cleaned.pop(\"requiredConfigs\", None)\n-\n-    # Collect required fields from requiredConfigs and individual required: true properties\n-    required_fields = set()\n-\n-    # Add fields from requiredConfigs\n-    if \"requiredConfigs\" in schema:\n-        required_fields.update(schema.get(\"requiredConfigs\", []))\n-\n-    # Add fields with required: true on individual properties\n-    if \"properties\" in cleaned:\n-        for prop_name, prop_schema in cleaned[\"properties\"].items():\n-            if isinstance(prop_schema, dict):\n-                # Check if field is marked as required\n-                if prop_schema.get(\"required\"):\n-                    required_fields.add(prop_name)\n-\n-                # Remove custom fields that are not part of JSON Schema\n-                prop_schema.pop(\"required\", None)\n-                prop_schema.pop(\"prompt\", None)\n-                prop_schema.pop(\"secret\", None)\n-                prop_schema.pop(\"generate\", None)\n-                prop_schema.pop(\"generateLength\", None)\n-                prop_schema.pop(\"requiredIf\", None)\n-\n-    # Add standard JSON Schema 'required' array if we have required fields\n-    if required_fields:\n-        cleaned[\"required\"] = list(required_fields)\n-\n-    return cleaned"},{"sha":"75be1f9fbbce97b14a1306c35c3913c517f0bf73","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/configure/steps/prompt_all_fields_step.py","status":"removed","additions":0,"deletions":302,"changes":302,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fprompt_all_fields_step.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fprompt_all_fields_step.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fconfigure%2Fsteps%2Fprompt_all_fields_step.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,302 +0,0 @@\n-from datasaur_cli.commands.configure.steps.helpers import clean_schema_for_validation\n-from jsonschema import validate, ValidationError\n-from pathlib import Path\n-from typing import Any, Dict, Optional\n-import click\n-import string\n-import secrets\n-\n-class PromptAllFieldsStep:\n-    def run(self, config_schema: Dict, env_file_path: Path) -> Dict:\n-        existing_config = {}\n-        if env_file_path.exists():\n-            click.echo(f\"Found existing configuration: {env_file_path}\")\n-            if click.confirm(\"Load existing values?\", default=True):\n-                existing_config = self._load_existing_config(env_file_path)\n-            click.echo(\"\")\n-\n-        try:\n-            config = self._prompt_all_fields(config_schema, existing_config)\n-        except KeyboardInterrupt:\n-            click.echo(\"\")\n-            click.echo(click.style(\"! Configuration cancelled by user\", fg='yellow'))\n-            return None\n-\n-        if not config:\n-            click.echo(click.style(\"✗ No configuration values provided\", fg='red'))\n-            return None\n-\n-        return config\n-\n-    def _load_existing_config(self, env_file_path: Path) -> Dict[str, str]:\n-        \"\"\"\n-        Load existing configuration from .env file.\n-\n-        Returns: Dictionary of key-value pairs\n-        \"\"\"\n-        config = {}\n-\n-        try:\n-            with open(env_file_path, 'r') as f:\n-                for line in f:\n-                    line = line.strip()\n-                    # Skip comments and empty lines\n-                    if not line or line.startswith('#'):\n-                        continue\n-\n-                    # Parse KEY=VALUE\n-                    if '=' in line:\n-                        key, value = line.split('=', 1)\n-                        key = key.strip()\n-                        value = value.strip()\n-                        # Remove quotes if present\n-                        if value.startswith('\"') and value.endswith('\"'):\n-                            value = value[1:-1]\n-                        elif value.startswith(\"'\") and value.endswith(\"'\"):\n-                            value = value[1:-1]\n-                        config[key] = value\n-        except Exception:\n-            pass\n-\n-        return config\n-\n-    def _prompt_all_fields(self, config_schema: Dict, existing_config: Dict = None) -> Dict[str, str]:\n-        \"\"\"\n-        Prompt for all required configuration fields.\n-\n-        Args:\n-            schema: JSON Schema for configuration\n-            existing_config: Existing configuration values (for editing)\n-\n-        Returns: Dictionary of configuration values\n-        \"\"\"\n-        config = {}\n-        existing_config = existing_config or {}\n-        properties = config_schema.get(\"properties\", {})\n-        required_fields = self._get_required_fields(config_schema)\n-\n-        click.echo(\"Configuration Setup\")\n-        click.echo(\"=\" * 50)\n-        click.echo(\"\")\n-\n-        # First pass: prompt for all required fields\n-        for prop_name in required_fields:\n-            if prop_name in config:\n-                continue  # Already set\n-\n-            prop_schema = properties.get(prop_name, {})\n-            existing_value = existing_config.get(prop_name)\n-\n-            value = self._prompt_for_value(prop_name, prop_schema, existing_value, config)\n-            if value is None:\n-                continue\n-            config[prop_name] = value\n-\n-        # Second pass: handle conditional fields\n-        for prop_name, prop_schema in properties.items():\n-            if prop_name in config:\n-                continue  # Already set\n-\n-            if self._should_skip_field(prop_schema, config):\n-                continue\n-\n-            # Check if field has requiredIf\n-            required_if = prop_schema.get(\"requiredIf\")\n-            if not required_if:\n-                continue\n-\n-            # Check if condition is met\n-            should_prompt = False\n-            for condition_key, condition_value in required_if.items():\n-                if config.get(condition_key) == condition_value:\n-                    should_prompt = True\n-                    break\n-\n-            if not should_prompt:\n-                continue\n-\n-            existing_value = existing_config.get(prop_name)\n-            value = self._prompt_for_value(prop_name, prop_schema, existing_value, config)\n-            if value is None:\n-                continue\n-            config[prop_name] = value\n-\n-        click.echo(\"\")\n-        return config\n-\n-    def _get_required_fields(self, config_schema: Dict) -> list:\n-        \"\"\"\n-        Extract list of required field names from config schema.\n-        Checks individual required: true properties.\n-\n-        Returns: List of required field names\n-        \"\"\"\n-        # Get required fields from requiredConfigs (custom field)\n-        properties = config_schema.get(\"properties\", {})\n-\n-        # Also check for custom requiredIf conditions\n-        required_fields = set()\n-\n-        for prop_name, prop_schema in properties.items():\n-            if not isinstance(prop_schema, dict):\n-                continue\n-\n-            # Check if field has requiredIf condition\n-            required_if = prop_schema.get(\"requiredIf\")\n-            if required_if:\n-                # This will be handled during interactive prompts\n-                pass\n-\n-            # Check if field is marked as required\n-            if prop_schema.get(\"required\"):\n-                required_fields.add(prop_name)\n-\n-        return list(required_fields)\n-\n-    def _prompt_for_value(\n-        self,\n-        property_name: str,\n-        property_schema: Dict,\n-        existing_value: Optional[str] = None,\n-        context: Dict[str, Any] = None\n-    ) -> Optional[str]:\n-        \"\"\"\n-        Prompt user for a configuration value.\n-\n-        Args:\n-            property_name: Name of the property\n-            property_schema: JSON Schema for this property\n-            existing_value: Existing value if editing\n-            context: Current configuration context (for conditional fields)\n-\n-        Returns: User input value or None if skipped\n-        \"\"\"\n-        context = context or {}\n-\n-        # Check if the field should be skipped based on conditions\n-        if self._should_skip_field(property_schema, context):\n-            return None\n-\n-        # Get description and prompt text\n-        description = property_schema.get(\"description\", property_name)\n-        prompt_text = property_schema.get(\"prompt\", f\"Enter {description}\")\n-\n-        # Get default value\n-        default = property_schema.get(\"default\")\n-        if existing_value:\n-            default = existing_value\n-        elif default is not None:\n-            # Convert default to string for display\n-            default = str(default)\n-\n-        # Check if the field is secret (password)\n-        is_secret = property_schema.get(\"secret\", False)\n-\n-        # Check if the field should be auto-generated\n-        should_generate = property_schema.get(\"generate\", False)\n-\n-        if should_generate and not existing_value:\n-            # Ask if user wants to generate\n-            generate = click.confirm(\n-                f\"Generate random {description.lower()}?\",\n-                default=True\n-            )\n-            if generate:\n-                generated_value = self._generate_random_string(\n-                    property_schema.get(\"generateLength\", 32)\n-                )\n-                click.echo(click.style(f\"  Generated: {generated_value}\", fg='green'))\n-                return generated_value\n-\n-        # Prompt for value\n-        if is_secret:\n-            value = click.prompt(\n-                prompt_text,\n-                default=default,\n-                hide_input=True,\n-                show_default=False\n-            )\n-        else:\n-            value = click.prompt(\n-                prompt_text,\n-                default=default,\n-                show_default=default is not None\n-            )\n-\n-        # Validate value\n-        error_message = self._validate_config_value(value, property_schema, property_name)\n-        if error_message:\n-            click.echo(click.style(f\"  ✗ Validation error: {error_message}\", fg='red'))\n-            # Retry once\n-            if is_secret:\n-                value = click.prompt(\n-                    f\"{prompt_text} (retry)\",\n-                    hide_input=True\n-                )\n-            else:\n-                value = click.prompt(\n-                    f\"{prompt_text} (retry)\"\n-                )\n-            # Validate again\n-            error_message = self._validate_config_value(value, property_schema, property_name)\n-            if error_message:\n-                click.echo(click.style(f\"  ✗ Validation failed: {error_message}\", fg='red'))\n-                return None\n-\n-        return value\n-\n-    def _should_skip_field(self, property_schema: Dict, context: Dict[str, Any]) -> bool:\n-        \"\"\"\n-        Check if a field should be skipped based on conditional requirements.\n-\n-        Returns: True if field should be skipped\n-        \"\"\"\n-        required_if = property_schema.get(\"requiredIf\")\n-        if not required_if:\n-            return False\n-\n-        # Check if condition is met\n-        for condition_key, condition_value in required_if.items():\n-            if context.get(condition_key) != condition_value:\n-                return True  # Skip this field\n-\n-        return False\n-\n-    def _generate_random_string(self, length: int = 32) -> str:\n-        \"\"\"Generate a random string for encryption keys, passwords, etc.\"\"\"\n-        alphanumeric = string.ascii_letters + string.digits\n-        return ''.join(secrets.choice(alphanumeric) for _ in range(length))\n-\n-    def _validate_config_value(self, value: any, property_schema: Dict, property_name: str) -> Optional[str]:\n-        \"\"\"\n-        Validate a single configuration value against its property schema.\n-\n-        Returns: error_message\n-        \"\"\"\n-        # Clean property schema by removing custom fields\n-        cleaned_prop_schema = clean_schema_for_validation({\n-            \"type\": \"object\",\n-            \"properties\": {property_name: property_schema}\n-        })\n-        cleaned_prop_schema = cleaned_prop_schema[\"properties\"][property_name]\n-\n-        # Create a minimal schema for this property\n-        property_full_schema = {\n-            \"type\": \"object\",\n-            \"properties\": {\n-                property_name: cleaned_prop_schema\n-            },\n-            \"required\": [property_name] if property_schema.get(\"required\") else []\n-        }\n-\n-        try:\n-            validate(instance={property_name: value}, schema=property_full_schema)\n-            return None\n-        except ValidationError as e:\n-            # Extract meaningful error message\n-            error_message = e.message\n-            if e.path:\n-                error_message = f\"{'.'.join(str(p) for p in e.path)}: {error_message}\"\n-            return error_message\n-        except Exception as e:\n-            return f\"Validation error: {str(e)}\""},{"sha":"e1b4c07cdf6e8ebbfe8d7ea79e5bb44023bf7921","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/install/__init__.py","status":"removed","additions":0,"deletions":6,"changes":6,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Finstall%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Finstall%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Finstall%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,6 +0,0 @@\n-\"\"\"Install command package for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.install.install import install\n-\n-__all__ = ['install']\n-"},{"sha":"679a2eb8916965ac6f46d1de6d4bf72c0d74f306","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/install/install.py","status":"removed","additions":0,"deletions":49,"changes":49,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Finstall%2Finstall.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Finstall%2Finstall.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Finstall%2Finstall.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,49 +0,0 @@\n-\"\"\"Install command for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.common.files_handler import FilesHandler\n-from datasaur_cli.commands.common.manifest_file_handler import ManifestFileHandler\n-from datasaur_cli.commands.common.operating_systems_handler import OperatingSystemsHandler\n-from datasaur_cli.commands.common.software_requirements_handler import SoftwareRequirementsHandler\n-from datasaur_cli.commands.common.steps_handler import StepsHandler\n-from datasaur_cli.commands.common.sub_manifest_handler import SubManifestHandler\n-from datasaur_cli.constants import DEFAULT_ARTIFACT_DIRECTORY\n-from pathlib import Path\n-import click\n-\n-@click.command()\n-@click.argument(\n-    'artifact_directory',\n-    type=click.Path(path_type=Path),\n-    default=DEFAULT_ARTIFACT_DIRECTORY\n-)\n-def install(artifact_directory: Path):\n-    \"\"\"\n-    Install Datasaur on-premise.\n-\n-    ARTIFACT_DIRECTORY: Directory containing manifest.json file\n-    \"\"\"\n-    manifest, ok = ManifestFileHandler().handle(artifact_directory)\n-    if not ok:\n-        return 1\n-\n-    docker_manifest, ok = SubManifestHandler().handle(manifest, 'docker')\n-    if not ok:\n-        return 1\n-\n-    if not OperatingSystemsHandler().handle(docker_manifest):\n-        return 1\n-\n-    if not SoftwareRequirementsHandler().handle(docker_manifest):\n-        return 1\n-\n-    install_manifest, ok = SubManifestHandler().handle(docker_manifest, 'install')\n-    if not ok:\n-        return 1\n-\n-    if not FilesHandler().handle(artifact_directory, install_manifest):\n-        return 1\n-\n-    if not StepsHandler().run(artifact_directory, install_manifest):\n-        return 1\n-\n-    return 0"},{"sha":"45c4854ca7ba186c2b4cc8b217be5892b0c6e71a","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/start/__init__.py","status":"removed","additions":0,"deletions":6,"changes":6,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2F__init__.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2F__init__.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2F__init__.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,6 +0,0 @@\n-\"\"\"Start command package for datasaur-cli.\"\"\"\n-\n-from datasaur_cli.commands.start.start import start\n-\n-__all__ = ['start']\n-"},{"sha":"df05e5ab9bb7a9d314b8f7289a7ee415df108ad0","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/start/start.py","status":"removed","additions":0,"deletions":79,"changes":79,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2Fstart.py","raw_url":"https://github.com/vulcan-ai/vulcan/raw/f70264d0457779a35a4fb662bae02ded62b69ed0/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2Fstart.py","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/datasaur-cli%2Fdatasaur-cli%2Fdatasaur_cli%2Fcommands%2Fstart%2Fstart.py?ref=f70264d0457779a35a4fb662bae02ded62b69ed0","patch":"@@ -1,79 +0,0 @@\n-\"\"\"Start command for datasaur-cli.\"\"\"\n-\n-from pathlib import Path\n-\n-import click\n-from datasaur_cli.commands.common.directories_handler import DirectoriesHandler\n-from datasaur_cli.commands.common.files_handler import FilesHandler\n-from datasaur_cli.commands.common.manifest_file_handler import \\\n-    ManifestFileHandler\n-from datasaur_cli.commands.common.operating_systems_handler import \\\n-    OperatingSystemsHandler\n-from datasaur_cli.commands.common.software_requirements_handler import \\\n-    SoftwareRequirementsHandler\n-from datasaur_cli.commands.common.steps.validate_artifact_directory_step import \\\n-    ValidateArtifactDirectoryStep\n-from datasaur_cli.commands.common.steps_handler import StepsHandler\n-from datasaur_cli.commands.common.sub_manifest_handler import \\\n-    SubManifestHandler\n-from datasaur_cli.constants import DEFAULT_ARTIFACT_DIRECTORY\n-\n-\n-@click.command()\n-@click.argument(\n-    'artifact_directory',\n-    type=click.Path(exists=True, file_okay=False, dir_okay=True, path_type=Path),\n-    default=DEFAULT_ARTIFACT_DIRECTORY\n-)\n-def start(artifact_directory: Path):\n-    \"\"\"\n-    Start Datasaur services using docker compose.\n-\n-    ARTIFACT_DIR: Artifact directory containing docker-compose.yaml\n-    \"\"\"\n-\n-    manifest, ok = ManifestFileHandler().handle(artifact_directory)\n-    if not ok:\n-        return 1\n-\n-    docker_manifest, ok = SubManifestHandler().handle(manifest, 'docker')\n-    if not ok:\n-        return 1\n-\n-    if not OperatingSystemsHandler().handle(docker_manifest):\n-        return 1\n-\n-    if not SoftwareRequirementsHandler().handle(docker_manifest):\n-        return 1\n-\n-    start_manifest, ok = SubManifestHandler().handle(docker_manifest, 'start')\n-    if not ok:\n-        return 1\n-\n-    # Shared dict to track forbidden items across directories and files handlers\n-    # This allows later handlers (files) to override earlier ones (directories)\n-    forbidden_items = {}\n-\n-    directories_handler = DirectoriesHandler()\n-    if not directories_handler.handle(artifact_directory, start_manifest, forbidden_items):\n-        return 1\n-\n-    if not FilesHandler().handle(artifact_directory, start_manifest, forbidden_items):\n-        return 1\n-\n-    # Check if there are any remaining forbidden items after all handlers\n-    if len(forbidden_items) > 0:\n-        click.echo(click.style(\"Some directories or files have the wrong permission and this script is unable to set the correct one. Please run the following commands: \", fg=\"blue\"))\n-        click.echo()\n-\n-        # Optimize and print chmod commands\n-        optimized_commands = directories_handler._optimize_chmod_commands(forbidden_items)\n-        for cmd in optimized_commands:\n-            click.echo(cmd)\n-        click.echo()\n-        return 1\n-\n-    if not StepsHandler().run(artifact_directory, start_manifest):\n-        return 1\n-\n-    return 0"},{"sha":"d95c8e8c343cb832f56044087cd9d872c35656e3","filename":"datasaur-cli/datasaur-cli/datasaur_cli/commands/start/steps/start_services_step.py","status":"removed","additions":0,"deletions":17,"changes":17,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/f70264d0457779a35a4fb662bae02d