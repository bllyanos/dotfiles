:23.66Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/97/0b/776ffcb66783637b0031f6d58d6fb55913c8b5abf00aeecd46bf933fb477/rpds_py-2026.6.3-cp315-cp315t-musllinux_1_2_aarch64.whl\", hash = \"sha256:f0840b5b17057f7fd918b76183a4b5a0635f43e14eb2ce60dce1d4ee4707ea00\", size = 546584, upload-time = \"2026-06-30T07:17:25.264Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/55/33/ba3bc04d7092bd553c9b2b195624992d2cc4f3de1f380b7b93cbee67bd79/rpds_py-2026.6.3-cp315-cp315t-musllinux_1_2_i686.whl\", hash = \"sha256:faa679d19a6696fd54259ad321251ad77a13e70e03dd834daa762a44fb6196ef\", size = 614357, upload-time = \"2026-06-30T07:17:26.888Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/8b/71/14edf065f04630b1a8472f7653cad03f6c478bcf95ea0e6aed55451e33ea/rpds_py-2026.6.3-cp315-cp315t-musllinux_1_2_x86_64.whl\", hash = \"sha256:23a439f31ccbeff1574e24889128821d1f7917470e830cf6544dced1c662262a\", size = 576533, upload-time = \"2026-06-30T07:17:28.546Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/ba/76/65002b08596c389105720a8c0d22298b8dc25a4baf89b2ce431343c8b1de/rpds_py-2026.6.3-cp315-cp315t-win32.whl\", hash = \"sha256:913ca42ccad3f8cc6e292b587ae8ae49c8c823e5dce51a736252fc7c7cdfa577\", size = 201204, upload-time = \"2026-06-30T07:17:30.193Z\" },\n+    { url = \"https://files.pythonhosted.org/packages/8c/97/d855d6b3c322d1f27e26f5241c42016b56cf01377ea8ed348285f54652f0/rpds_py-2026.6.3-cp315-cp315t-win_amd64.whl\", hash = \"sha256:ae3d4fe8c0b9213624fdce7279d70e3b148b682ca20719ebd193a23ebfa47324\", size = 220719, upload-time = \"2026-06-30T07:17:31.788Z\" },\n+]\n+\n+[[package]]\n+name = \"setuptools\"\n+version = \"83.0.0\"\n+source = { registry = \"https://pypi.org/simple\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/34/26/f5d29e25ffdb535afef2d35cdb55b325298f96debd670da4c325e08d70f4/setuptools-83.0.0.tar.gz\", hash = \"sha256:025bccbbf0fa05b6192bc64ae1e7b16e001fd6d6d4d5de03c97b1c1ade523bef\", size = 1154254, upload-time = \"2026-07-04T15:31:22.699Z\" }\n+wheels = [\n+    { url = \"https://files.pythonhosted.org/packages/5d/40/e1e72872c6354b306daef1703549e8e83b4d43cfea356311bf722a043752/setuptools-83.0.0-py3-none-any.whl\", hash = \"sha256:29b23c360f22f414dc7336bb39178cc7bcbf6021ed2733cde173f09dba19abb3\", size = 1008090, upload-time = \"2026-07-04T15:31:20.885Z\" },\n+]\n+\n+[[package]]\n+name = \"typing-extensions\"\n+version = \"4.16.0\"\n+source = { registry = \"https://pypi.org/simple\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/f6/cc/6253133b5bb138fc3306cebfbda2c520f545d36b5be2c7255cc528bb45d6/typing_extensions-4.16.0.tar.gz\", hash = \"sha256:dc983d19a509c94dba722ee6abd33940f7c05a89e243c47e907eb4db6f1a43e5\", size = 113555, upload-time = \"2026-07-02T08:40:05.92Z\" }\n+wheels = [\n+    { url = \"https://files.pythonhosted.org/packages/49/d3/b8441a820a491ddfc024b0b0cf0393375b75ea13866d9c66727e54c2fc80/typing_extensions-4.16.0-py3-none-any.whl\", hash = \"sha256:481caa481374e813c1b176ada14e97f1f67a4539ce9cfeb3f350d78d6370c2e8\", size = 45571, upload-time = \"2026-07-02T08:40:04.659Z\" },\n+]\n+\n+[[package]]\n+name = \"typing-inspection\"\n+version = \"0.4.2\"\n+source = { registry = \"https://pypi.org/simple\" }\n+dependencies = [\n+    { name = \"typing-extensions\" },\n+]\n+sdist = { url = \"https://files.pythonhosted.org/packages/55/e3/70399cb7dd41c10ac53367ae42139cf4b1ca5f36bb3dc6c9d33acdb43655/typing_inspection-0.4.2.tar.gz\", hash = \"sha256:ba561c48a67c5958007083d386c3295464928b01faa735ab8547c5692e87f464\", size = 75949, upload-time = \"2025-10-01T02:14:41.687Z\" }\n+wheels = [\n+    { url = \"https://files.pythonhosted.org/packages/dc/9b/47798a6c91d8bdb567fe2698fe81e0c6b7cb7ef4d13da4114b41d239f65d/typing_inspection-0.4.2-py3-none-any.whl\", hash = \"sha256:4ed1cacbdc298c220f1bd249ed5287caa16f34d44ef4e9c3d0cbad5b521545e7\", size = 14611, upload-time = \"2025-10-01T02:14:40.154Z\" },\n+]\n+\n+[[package]]\n+name = \"urllib3\"\n+version = \"2.7.0\"\n+source = { registry = \"https://pypi.org/simple\" }\n+sdist = { url = \"https://files.pythonhosted.org/packages/53/0c/06f8b233b8fd13b9e5ee11424ef85419ba0d8ba0b3138bf360be2ff56953/urllib3-2.7.0.tar.gz\", hash = \"sha256:231e0ec3b63ceb14667c67be60f2f2c40a518cb38b03af60abc813da26505f4c\", size = 433602, upload-time = \"2026-05-07T16:13:18.596Z\" }\n+wheels = [\n+    { url = \"https://files.pythonhosted.org/packages/7f/3e/5db95bcf282c52709639744ca2a8b149baccf648e39c8cc87553df9eae0c/urllib3-2.7.0-py3-none-any.whl\", hash = \"sha256:9fb4c81ebbb1ce9531cce37674bbc6f1360472bc18ca9a553ede278ef7276897\", size = 131087, upload-time = \"2026-05-07T16:13:17.151Z\" },\n+]"},{"sha":"651e5d83a54c116ef15d3e0c8632c38ea65ad316","filename":"on-premise/forge/wps/docker-swarm/.gitignore","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2F.gitignore","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2F.gitignore","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2F.gitignore?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1 @@\n+wps-*.tar.gz"},{"sha":"66a0eaf52a27a18c04fcdc87b1b96abeff86c1c1","filename":"on-premise/forge/wps/docker-swarm/README.md","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2FREADME.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2FREADME.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2FREADME.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,33 @@\n+# WPS Docker Swarm — Build\n+\n+`build.sh` packages the `wps/` directory into a customer-deliverable `wps-<version>.tar.gz`: a working `datasaur-cli` binary, the root manifest, and the `proxy`/`registry`/`hello` Docker Swarm stacks.\n+\n+## Usage\n+\n+```bash\n+./build.sh [--include-proxy-docker-images <true|false>] [--include-registry-docker-images <true|false>] [--include-hello-docker-images <true|false>] [--version <VERSION>]\n+```\n+\n+| Option | Default | Description |\n+|---|---|---|\n+| `--include-proxy-docker-images` | `false` | Pull `traefik` (version from `wps/proxy/.env`) and save it into `wps/proxy/images/` |\n+| `--include-registry-docker-images` | `false` | Pull `registry` (version from `wps/registry/.env`) and save it into `wps/registry/images/` |\n+| `--include-hello-docker-images` | `false` | Pull `alpine` (version from `wps/hello/.env`) and save it into `wps/hello/images/` |\n+| `--version` | `vulcan-backend/package.json`'s `version` field | Output archive version — `wps/` packages into `wps-<VERSION>.tar.gz` |\n+\n+Bare `./build.sh` produces a text-only bundle (no Docker images) tagged with the current `vulcan-backend` version.\n+\n+## What it does\n+\n+1. Resolves the output version (`--version`, or `vulcan-backend/package.json`).\n+2. Builds the `datasaur-cli` binary via `on-premise/datasaur-cli/build.sh` and copies it into `wps/datasaur-cli`.\n+3. Optionally pulls and saves the `traefik`/`registry`/`alpine` images into their stack's `images/` directory, per the three `--include-*-docker-images` flags.\n+4. Copies `wps/` into an ephemeral `wps-<VERSION>/` build directory and stamps its `manifest.yaml` with the resolved version and each service's real image/file_path — the tracked source `wps/manifest.yaml` is never modified.\n+5. Tars and `pigz`-compresses the build directory into `wps-<VERSION>.tar.gz`, then removes the ephemeral directory.\n+\n+## Example\n+\n+```bash\n+./build.sh --include-proxy-docker-images true --include-registry-docker-images true --include-hello-docker-images true --version 6.153.0\n+# -> wps-6.153.0.tar.gz, with traefik + registry + alpine images bundled\n+```"},{"sha":"09a7a79726b8758d66113b983e8db8643f6a1a97","filename":"on-premise/forge/wps/docker-swarm/build.sh","status":"added","additions":192,"deletions":0,"changes":192,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fbuild.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fbuild.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fbuild.sh?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,192 @@\n+#!/bin/bash\n+\n+set -euo pipefail\n+\n+usage() {\n+  echo \"Usage: $0 [options...]\"\n+  echo \"\"\n+  echo \"Options:\"\n+  echo \"  --include-proxy-docker-images <true|false>     Pull+save the traefik image (default: false)\"\n+  echo \"  --include-registry-docker-images <true|false>  Pull+save the registry image (default: false)\"\n+  echo \"  --include-hello-docker-images <true|false>      Pull+save the alpine image (default: false)\"\n+  echo \"  --version <VERSION>                             Output archive version (default: vulcan-backend/package.json's version)\"\n+  exit 1\n+}\n+\n+INCLUDE_PROXY_IMAGES=\"false\"\n+INCLUDE_REGISTRY_IMAGES=\"false\"\n+INCLUDE_HELLO_IMAGES=\"false\"\n+VERSION=\"\"\n+\n+while [[ $# -gt 0 ]]; do\n+  case \"$1\" in\n+  --include-proxy-docker-images)\n+    INCLUDE_PROXY_IMAGES=\"$2\"\n+    shift 2\n+    ;;\n+  --include-registry-docker-images)\n+    INCLUDE_REGISTRY_IMAGES=\"$2\"\n+    shift 2\n+    ;;\n+  --include-hello-docker-images)\n+    INCLUDE_HELLO_IMAGES=\"$2\"\n+    shift 2\n+    ;;\n+  --version)\n+    VERSION=\"$2\"\n+    shift 2\n+    ;;\n+  *)\n+    echo \"Unknown option: $1\"\n+    usage\n+    ;;\n+  esac\n+done\n+\n+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n+REPO_ROOT=\"$(cd \"$SCRIPT_DIR/../../../..\" && pwd)\"\n+PREBUILD_DIR=\"wps\"\n+CLI_DIR=\"$REPO_ROOT/on-premise/datasaur-cli\"\n+\n+main() {\n+  cd \"$SCRIPT_DIR\"\n+  resolve_version\n+  clean_build_artifacts\n+  build_cli_binary\n+  include_proxy_image\n+  include_registry_image\n+  include_hello_image\n+  copy_build_directory\n+  stamp_manifest_version\n+  package_tarball\n+  echo \"Build finished: $FILENAME\"\n+}\n+\n+resolve_version() {\n+  if [[ -z \"$VERSION\" ]]; then\n+    VERSION=\"$(node -p \"require('$REPO_ROOT/vulcan-backend/package.json').version\")\"\n+  fi\n+  BUILD_DIR=\"${PREBUILD_DIR}-${VERSION}\"\n+  FILENAME=\"${PREBUILD_DIR}-${VERSION}.tar.gz\"\n+}\n+\n+clean_build_artifacts() {\n+  echo \"Cleaning up gitignored build artifacts in $PREBUILD_DIR...\"\n+  # Removes stale bundled image tarballs and the previous datasaur-cli binary\n+  # (both gitignored) — without this, a bundle-less run after a bundled one\n+  # would silently re-tar the OLD images, since package_tarball just archives\n+  # whatever's sitting in $PREBUILD_DIR regardless of this run's flags.\n+  git -C \"$REPO_ROOT\" clean -Xdf -- \"$SCRIPT_DIR/$PREBUILD_DIR\"\n+\n+  echo \"Cleaning up stale output archives...\"\n+  rm -f \"$SCRIPT_DIR\"/wps-*.tar.gz\n+}\n+\n+build_cli_binary() {\n+  echo \"Building datasaur-cli binary...\"\n+  (cd \"$CLI_DIR\" && ./build.sh --version \"$VERSION\")\n+  cp \"$CLI_DIR/dist/datasaur-cli\" \"$SCRIPT_DIR/$PREBUILD_DIR/datasaur-cli\"\n+  chmod 0755 \"$SCRIPT_DIR/$PREBUILD_DIR/datasaur-cli\"\n+}\n+\n+format_image_for_filename() {\n+  # \"traefik:v3.7.8\" -> \"traefik-v3.7.8\"; \"host:5000/traefik:v3.7.8\" -> \"host-5000-traefik-v3.7.8\"\n+  # (a registry host with a port is the only realistic case with more than one ':' or '/' —\n+  # both characters are filesystem-unsafe, so both get replaced, not just the last one.)\n+  echo \"$1\" | tr ':/' '--'\n+}\n+\n+pull_image_and_save_to() {\n+  local image=\"$1\"\n+  local output=\"$2\"\n+  echo \"Pulling $image...\"\n+  docker pull \"$image\"\n+  save_image_to \"$image\" \"$output\"\n+}\n+\n+include_proxy_image() {\n+  if [[ \"$INCLUDE_PROXY_IMAGES\" != \"true\" ]]; then\n+    echo \"Skipping proxy Docker image (--include-proxy-docker-images not true)\"\n+    return\n+  fi\n+  local traefik_image traefik_filename\n+  traefik_image=\"$(grep '^TRAEFIK_IMAGE=' \"$PREBUILD_DIR/proxy/.env\" | cut -d '=' -f2)\"\n+  traefik_filename=\"$(format_image_for_filename \"$traefik_image\")\"\n+  pull_image_and_save_to \"$traefik_image\" \"$PREBUILD_DIR/proxy/images/$traefik_filename.tar.gz\"\n+}\n+\n+include_registry_image() {\n+  if [[ \"$INCLUDE_REGISTRY_IMAGES\" != \"true\" ]]; then\n+    echo \"Skipping registry Docker image (--include-registry-docker-images not true)\"\n+    return\n+  fi\n+  local registry_image registry_filename\n+  registry_image=\"$(grep '^REGISTRY_IMAGE=' \"$PREBUILD_DIR/registry/.env\" | cut -d '=' -f2)\"\n+  registry_filename=\"$(format_image_for_filename \"$registry_image\")\"\n+  pull_image_and_save_to \"$registry_image\" \"$PREBUILD_DIR/registry/images/$registry_filename.tar.gz\"\n+}\n+\n+include_hello_image() {\n+  if [[ \"$INCLUDE_HELLO_IMAGES\" != \"true\" ]]; then\n+    echo \"Skipping hello Docker image (--include-hello-docker-images not true)\"\n+    return\n+  fi\n+  local alpine_image alpine_filename\n+  alpine_image=\"$(grep '^ALPINE_IMAGE=' \"$PREBUILD_DIR/hello/.env\" | cut -d '=' -f2)\"\n+  alpine_filename=\"$(format_image_for_filename \"$alpine_image\")\"\n+  pull_image_and_save_to \"$alpine_image\" \"$PREBUILD_DIR/hello/images/$alpine_filename.tar.gz\"\n+}\n+\n+save_image_to() {\n+  local image=\"$1\"\n+  local output=\"$2\"\n+  docker save \"$image\" | pigz >\"$output\"\n+  chmod 0644 \"$output\"\n+}\n+\n+stamp_manifest_version() {\n+  echo \"Stamping manifest version $VERSION...\"\n+  local traefik_image registry_image alpine_image\n+  traefik_image=\"$(grep '^TRAEFIK_IMAGE=' \"$BUILD_DIR/proxy/.env\" | cut -d '=' -f2)\"\n+  registry_image=\"$(grep '^REGISTRY_IMAGE=' \"$BUILD_DIR/registry/.env\" | cut -d '=' -f2)\"\n+  alpine_image=\"$(grep '^ALPINE_IMAGE=' \"$BUILD_DIR/hello/.env\" | cut -d '=' -f2)\"\n+  uv run --project \"$CLI_DIR\" python3 - \"$SCRIPT_DIR/$BUILD_DIR/manifest.yaml\" \"$VERSION\" \"$traefik_image\" \"$registry_image\" \"$alpine_image\" <<'PYEOF'\n+import sys\n+import yaml\n+\n+manifest_path, version, traefik_image, registry_image, alpine_image = sys.argv[1:6]\n+\n+def format_image_for_filename(image):\n+    return image.replace(\":\", \"-\").replace(\"/\", \"-\")\n+\n+with open(manifest_path) as f:\n+    manifest = yaml.safe_load(f)\n+manifest[\"version\"] = version\n+for service in manifest[\"services\"]:\n+    if service[\"name\"] == \"traefik\":\n+        service[\"image\"] = traefik_image\n+        service[\"file_path\"] = f\"./proxy/images/{format_image_for_filename(traefik_image)}.tar.gz\"\n+    elif service[\"name\"] == \"registry\":\n+        service[\"image\"] = registry_image\n+        service[\"file_path\"] = f\"./registry/images/{format_image_for_filename(registry_image)}.tar.gz\"\n+    elif service[\"name\"] == \"hello\":\n+        service[\"image\"] = alpine_image\n+        service[\"file_path\"] = f\"./hello/images/{format_image_for_filename(alpine_image)}.tar.gz\"\n+with open(manifest_path, \"w\") as f:\n+    yaml.dump(manifest, f, sort_keys=False)\n+PYEOF\n+}\n+\n+copy_build_directory() {\n+  echo \"Copying $PREBUILD_DIR directory...\"\n+  rm -rf \"$BUILD_DIR\"\n+  cp -r \"$PREBUILD_DIR\" \"$BUILD_DIR\"\n+}\n+\n+package_tarball() {\n+  echo \"Packaging $BUILD_DIR directory...\"\n+  tar -cf - \"$BUILD_DIR\" | pigz >\"$FILENAME\"\n+  rm -rf \"$BUILD_DIR\"\n+}\n+\n+main"},{"sha":"83da150e62279b70bd4b69f77d6a3f534fe857c8","filename":"on-premise/forge/wps/docker-swarm/wps/.env","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.env","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.env","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.env?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,3 @@\n+REGISTRY_DOMAIN=\n+REGISTRY_USERNAME=\n+REGISTRY_PASSWORD="},{"sha":"b5098553d129ab889fbf643cc67a2f1ce5dd79ff","filename":"on-premise/forge/wps/docker-swarm/wps/.gitignore","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.gitignore","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.gitignore","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.gitignore?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,8 @@\n+proxy/images/*.tar.gz\n+registry/images/*.tar.gz\n+hello/images/*.tar.gz\n+datasaur-cli\n+!.env\n+!proxy/.env\n+!registry/.env\n+!hello/.env"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"on-premise/forge/wps/docker-swarm/wps/.ssl/.gitkeep","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.ssl%2F.gitkeep","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.ssl%2F.gitkeep","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2F.ssl%2F.gitkeep?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e"},{"sha":"7d123daa602feff95900a7b8a2fbc9111f684416","filename":"on-premise/forge/wps/docker-swarm/wps/README.md","status":"added","additions":142,"deletions":0,"changes":142,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2FREADME.md","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2FREADME.md","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2FREADME.md?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,142 @@\n+# WPS Docker Swarm — App Server Bootstrap\n+\n+Delivered package for bootstrapping the WPS Docker Swarm app server on 3 nodes (1 manager, 2 workers): a `proxy` stack (Traefik), a `registry` stack (Docker Registry), a `hello` cross-node smoke test, and the `datasaur-cli` binary that deploys and operates them.\n+\n+Follow the steps below **in order, top to bottom**. Steps are labeled with which node to run them on. Commands are copy-paste-ready; where a command prompts interactively, the expected input is called out right above it.\n+\n+## Before you start\n+\n+- All 3 nodes have Docker installed and can reach each other.\n+- Pick a domain for the registry (e.g. `registry.app-server.com`) and make it resolve to the **manager's** IP from all 3 nodes — either real DNS, or on each node:\n+  ```bash\n+  echo \"<manager-ip> <your-registry-domain>\" | sudo tee -a /etc/hosts\n+  ```\n+- This package (the extracted `wps-<version>/` directory) is present on all 3 nodes. `cd` into it before running any command below.\n+\n+## Step 1 — Manager: provision TLS\n+\n+```bash\n+./datasaur-cli manager generate-ssl-certificates\n+```\n+\n+You'll be prompted for:\n+- **Registry domain** — the domain from [Before you start](#before-you-start), e.g. `registry.app-server.com`.\n+- **Registry username** / **Registry password** — press Enter to accept the auto-generated values shown in brackets (or type your own).\n+\n+These 3 values are only asked once: rerunning this command (or Step 2) after they're already set won't ask again — use `./datasaur-cli manager configure` if you need to change one later.\n+\n+Writes all three into `.env`, then generates a self-signed CA (`.ssl/ca.crt`/`.ssl/ca.key`) and a registry cert/key pair signed by it (`.ssl/registry.crt`/`.ssl/registry.key`). Safe to re-run — skipped if the files already exist. (Have a real CA-signed cert instead? Drop `<domain>.crt`/`<domain>.key` into `.ssl/` yourself and skip the cert-generation part — but then also drop in your own CA's cert as `.ssl/ca.crt`, since Step 3 installs it into every node's Docker trust store.) **This has to happen before Step 2** — `manager init` deploys `proxy` with whatever cert exists at that moment, and Traefik only reads `.ssl/` at container startup, not live.\n+\n+## Step 2 — Manager: bring up proxy + registry\n+\n+```bash\n+./datasaur-cli manager init\n+```\n+\n+**Since Step 1 already set these 3 values, this step won't ask for them again** — it just proceeds straight to deploying. (Skipped Step 1, or starting from a completely fresh `.env`? It asks the same 3 questions Step 1 does, this time.)\n+\n+This single command then: loads the bundled `traefik`/`registry`/`alpine` images, initializes this node as a Swarm manager, deploys `proxy` then `registry`, sets up registry auth, pushes the images into the registry, and **prints a worker join token at the end**.\n+\n+**Copy the printed `docker swarm join --token ... <host>:<port>` line** — you'll need the token and `<host>:<port>` in Steps 4 and 5.\n+\n+## Step 3 — Manager: copy the CA cert to both workers\n+\n+```bash\n+scp .ssl/ca.crt <worker-1-host>:/path/to/wps/.ssl/ca.crt\n+scp .ssl/ca.crt <worker-2-host>:/path/to/wps/.ssl/ca.crt\n+```\n+\n+Only `.ssl/ca.crt` needs copying (not `registry.crt`/`registry.key`/`ca.key` — those are manager-only), so Step 4/5's `set-docker-registry-cert` step has a CA to install. `REGISTRY_DOMAIN`/`REGISTRY_USERNAME`/`REGISTRY_PASSWORD` don't need copying anywhere — Steps 4 and 5 prompt for them directly on each worker.\n+\n+## Step 4 — Worker 1: join the swarm\n+\n+```bash\n+./datasaur-cli worker join\n+```\n+\n+You'll be prompted for:\n+- **Registry domain** / **Registry username** / **Registry password** — must match the manager's values exactly (run `cat .env` on the manager to check). Only asked the first time — a rerun after these are set on this worker won't ask again; use `./datasaur-cli worker configure` to change them later.\n+- **Manager address** — the `<host>:<port>` from Step 2's join command.\n+- **Worker join token** — the token from Step 2's join command.\n+\n+Also only asked the first time — a rerun after these two are set on this worker won't ask again either, and if this node is already a swarm member the join step is skipped outright.\n+\n+Joins the swarm, then installs the CA cert into this node's Docker trust store and logs in to the registry.\n+\n+## Step 5 — Worker 2: join the swarm\n+\n+```bash\n+./datasaur-cli worker join\n+```\n+\n+Same command, same prompts, run on the second worker node.\n+\n+## Step 6 — Manager: verify everything works\n+\n+```bash\n+docker node ls\n+```\n+\n+Expect all 3 nodes listed as `Ready`/`Active`.\n+\n+```bash\n+./datasaur-cli up\n+docker service ps hello\n+```\n+\n+`up` deploys every discovered stack (currently `proxy`, `registry`, `hello` — more as later packages add them). Expect `hello`'s task `Running` on the manager **and both workers** — proof every node independently pulled `alpine` from the registry, not just the manager.\n+\n+You're done. Everything below is reference for ongoing operation, not part of first-time setup.\n+\n+---\n+\n+## Day-2 operations\n+\n+Every stack (`proxy`, `registry`, `hello`, and any added by later packages) supports the same verbs, either for all stacks or scoped to one:\n+\n+```bash\n+./datasaur-cli up            # deploy every stack\n+./datasaur-cli proxy up      # deploy only the proxy stack\n+\n+./datasaur-cli down          # remove every stack\n+./datasaur-cli registry down # remove only the registry stack\n+\n+./datasaur-cli restart       # down then up, every stack\n+./datasaur-cli proxy restart # down then up, only the proxy stack\n+\n+./datasaur-cli dump-logs       # print logs for every service in every stack\n+./datasaur-cli proxy dump-logs # print logs for only the proxy stack's services\n+```\n+\n+Manager commands:\n+\n+- `./datasaur-cli manager generate-ssl-certificates` — provision TLS (Step 1). Safe to re-run.\n+- `./datasaur-cli manager init` — bring up `proxy`/`registry`, wire up registry auth, push images, print the worker join token (Step 2). Fully idempotent — safe to re-run any time, e.g. to reprint the join token for a replacement worker, or re-push images after an update. Covers what used to be separate `push-docker-images`/`print-docker-swarm-join-token` commands.\n+- `./datasaur-cli manager configure` — sets or rotates `REGISTRY_DOMAIN`/`REGISTRY_USERNAME`/`REGISTRY_PASSWORD` (always asks, unlike `init`), then runs the same sync `init` does so the new values actually take effect immediately — no separate follow-up command needed.\n+- `./datasaur-cli manager tear-down` — fully decommissions this manager: removes every stack, logs out of the registry, removes the trusted CA cert, and force-leaves the Swarm (destroying it, since this is the only manager). Irreversible — re-bootstrapping from scratch means `manager init` again and every worker rejoining with a new token.\n+\n+Worker commands:\n+\n+- `./datasaur-cli worker join` — join the swarm and configure registry access (Steps 4/5). Idempotent — safe to re-run; skips whatever's already done.\n+- `./datasaur-cli worker configure` — sets or rotates this worker's registry credentials (always asks), then re-syncs (`docker-login` etc.) so the change takes effect. Manager address/join token are not something `configure` touches — they're not a value you rotate, only re-set via `worker leave` + `worker join` if you ever needed to join a different swarm.\n+- `./datasaur-cli worker leave` — cleanly removes this worker: logs out of the registry, removes the trusted CA cert, then leaves the swarm. Idempotent — a no-op if it isn't currently a member.\n+\n+**Rotating registry credentials:** `manager configure`/`worker configure` are the only commands that change an already-set `REGISTRY_DOMAIN`/`REGISTRY_USERNAME`/`REGISTRY_PASSWORD` — every other command that touches these values skips its prompt once a value already exists. Unlike before, you don't need a separate follow-up step — each `configure` re-syncs itself:\n+\n+- **On the manager:** run `./datasaur-cli manager configure` — this mints a new Swarm secret from the new credentials, rolling-updates the `registry` service to it, prunes the old one, and re-pushes images if needed.\n+- **On each worker:** run `./datasaur-cli worker configure` — re-installs the cert (no-op if unchanged) and re-runs `docker-login` with the new password.\n+\n+## Layout reference\n+\n+```\n+wps/\n+  datasaur-cli        # this package's own CLI binary\n+  manifest.yaml        # root manifest — services: (image tarballs) + commands:\n+  .env                 # REGISTRY_DOMAIN=, REGISTRY_USERNAME=, REGISTRY_PASSWORD= — ships blank\n+  .ssl/                # TLS cert/key pair for the registry's domain — empty until populated\n+  proxy/               # Traefik stack (reverse proxy + service discovery)\n+  registry/            # Docker Registry stack (image distribution across swarm nodes)\n+  hello/               # cross-node registry-pull smoke test (not a real product stack)\n+```\n+\n+`registry/.env` and `hello/.env` never need a copy of `REGISTRY_DOMAIN` — both reference it via a `$REGISTRY_DOMAIN` line, resolved fresh from root `.env` on every deploy. **Never edit a `$VAR`-style line in a per-stack `.env` to a literal value** — doing so stops it from tracking root `.env` changes."},{"sha":"1eec14ea26020f4505b01c539591339c00f9c300","filename":"on-premise/forge/wps/docker-swarm/wps/hello/.env","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2F.env","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2F.env","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2F.env?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,2 @@\n+ALPINE_IMAGE=alpine:3.23.5\n+REGISTRY_DOMAIN=$REGISTRY_DOMAIN"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"on-premise/forge/wps/docker-swarm/wps/hello/images/.gitkeep","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2Fimages%2F.gitkeep","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2Fimages%2F.gitkeep","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2Fimages%2F.gitkeep?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e"},{"sha":"99619a387bcb769e9ecf101c32589e53f73292e5","filename":"on-premise/forge/wps/docker-swarm/wps/hello/stack.yaml","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2Fstack.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2Fstack.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fhello%2Fstack.yaml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,6 @@\n+services:\n+  hello:\n+    image: ${REGISTRY_DOMAIN}/${ALPINE_IMAGE}\n+    command: [\"sleep\", \"infinity\"]\n+    deploy:\n+      mode: global"},{"sha":"4e3de72bddc0b5596c6bd7f76a4964b184f92ad6","filename":"on-premise/forge/wps/docker-swarm/wps/manifest.yaml","status":"added","additions":333,"deletions":0,"changes":333,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fmanifest.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fmanifest.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fmanifest.yaml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,333 @@\n+version: \"0.0.0-placeholder\"   # stamped by build.sh with the resolved --version value at package time\n+\n+# `up`/`upgrade`/`dump-logs` process stacks in this order; `down` reverses it;\n+# `restart` downs everything in reverse order, then ups everything in this\n+# order. registry's network is external to proxy's, and hello only works once\n+# registry can serve the alpine image it pulls from.\n+stack_order:\n+  - proxy\n+  - registry\n+  - hello\n+\n+# Actions to run immediately before/after a given stack's docker-stack-deploy —\n+# executed by docker-stack-deploy itself (src/action/start/docker_stack_deploy_action.py),\n+# so every entry point that deploys `registry` (`up`, `registry up`, `restart`,\n+# `init-app-server`) regenerates/prunes the htpasswd secret, not just init-app-server.\n+stack_hooks:\n+  registry:\n+    pre_deploy:\n+      - action: generate-htpasswd-docker-secret\n+        args:\n+          source_env_file: .env\n+          username_var: REGISTRY_USERNAME\n+          password_var: REGISTRY_PASSWORD\n+          secret_name_prefix: registry_htpasswd\n+          target_env_file: registry/.env\n+          secret_name_var: REGISTRY_HTPASSWD_SECRET_NAME\n+    post_deploy:\n+      - action: prune-stale-docker-secrets\n+        args:\n+          secret_name_prefix: registry_htpasswd\n+          service_name: registry_registry\n+\n+services:\n+  - name: traefik\n+    image: placeholder\n+    file_path: ./proxy/images/placeholder.tar.gz\n+  - name: registry\n+    image: placeholder\n+    file_path: ./registry/images/placeholder.tar.gz\n+  - name: hello\n+    image: placeholder\n+    file_path: ./hello/images/placeholder.tar.gz\n+\n+commands:\n+  manager:\n+    generate-ssl-certificates:\n+      - action: run-workflow\n+        args:\n+          workflow: [registry]\n+          actions:\n+            - name: registry\n+              action: set-environment-variables\n+              title: \"Registry\"\n+              skip_if_set: true\n+              prompts:\n+                REGISTRY_DOMAIN:\n+                  text: \"Registry domain (e.g. registry.app-server.com)\"\n+                  required: true\n+                REGISTRY_USERNAME:\n+                  text: \"Registry username\"\n+                  generate: true\n+                  generate_length: 8\n+                REGISTRY_PASSWORD:\n+                  text: \"Registry password\"\n+                  generate: true\n+                  generate_length: 16\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    REGISTRY_DOMAIN: \"prompts[REGISTRY_DOMAIN]\"\n+                    REGISTRY_USERNAME: \"prompts[REGISTRY_USERNAME]\"\n+                    REGISTRY_PASSWORD: \"prompts[REGISTRY_PASSWORD]\"\n+      - action: generate-self-signed-ca\n+        args:\n+          ssl_dir: .ssl\n+          cert_filename: ca.crt\n+          key_filename: ca.key\n+      - action: generate-self-signed-ssl-certificate\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+          ssl_dir: .ssl\n+          cert_filename: registry.crt\n+          key_filename: registry.key\n+          ca_cert_filename: ca.crt\n+          ca_key_filename: ca.key\n+\n+    init:\n+      - action: run-workflow\n+        args:\n+          workflow: [registry]\n+          actions:\n+            - name: registry\n+              action: set-environment-variables\n+              title: \"Registry\"\n+              skip_if_set: true\n+              prompts:\n+                REGISTRY_DOMAIN:\n+                  text: \"Registry domain (e.g. registry.app-server.com)\"\n+                  required: true\n+                REGISTRY_USERNAME:\n+                  text: \"Registry username\"\n+                  generate: true\n+                  generate_length: 8\n+                REGISTRY_PASSWORD:\n+                  text: \"Registry password\"\n+                  generate: true\n+                  generate_length: 16\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    REGISTRY_DOMAIN: \"prompts[REGISTRY_DOMAIN]\"\n+                    REGISTRY_USERNAME: \"prompts[REGISTRY_USERNAME]\"\n+                    REGISTRY_PASSWORD: \"prompts[REGISTRY_PASSWORD]\"\n+      - action: load-docker-images\n+      - action: docker-swarm-init\n+      - action: docker-stack-deploy\n+        args:\n+          stack: proxy\n+      - action: docker-stack-deploy\n+        args:\n+          stack: registry\n+      - action: set-docker-registry-cert\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+          ca_cert_file: .ssl/ca.crt\n+      - action: docker-login\n+        args:\n+          env_file: .env\n+          username_var: REGISTRY_USERNAME\n+          password_var: REGISTRY_PASSWORD\n+          domain_var: REGISTRY_DOMAIN\n+      - action: push-docker-images\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+      - action: print-docker-swarm-join-token\n+\n+    configure:\n+      - action: run-workflow\n+        args:\n+          workflow: [registry]\n+          actions:\n+            - name: registry\n+              action: set-environment-variables\n+              title: \"Registry\"\n+              prompts:\n+                REGISTRY_DOMAIN:\n+                  text: \"Registry domain (e.g. registry.app-server.com)\"\n+                  required: true\n+                REGISTRY_USERNAME:\n+                  text: \"Registry username\"\n+                  generate: true\n+                  generate_length: 8\n+                REGISTRY_PASSWORD:\n+                  text: \"Registry password\"\n+                  generate: true\n+                  generate_length: 16\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    REGISTRY_DOMAIN: \"prompts[REGISTRY_DOMAIN]\"\n+                    REGISTRY_USERNAME: \"prompts[REGISTRY_USERNAME]\"\n+                    REGISTRY_PASSWORD: \"prompts[REGISTRY_PASSWORD]\"\n+      - action: load-docker-images\n+      - action: docker-swarm-init\n+      - action: docker-stack-deploy\n+        args:\n+          stack: proxy\n+      - action: docker-stack-deploy\n+        args:\n+          stack: registry\n+      - action: set-docker-registry-cert\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+          ca_cert_file: .ssl/ca.crt\n+      - action: docker-login\n+        args:\n+          env_file: .env\n+          username_var: REGISTRY_USERNAME\n+          password_var: REGISTRY_PASSWORD\n+          domain_var: REGISTRY_DOMAIN\n+      - action: push-docker-images\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+      - action: print-docker-swarm-join-token\n+\n+    tear-down:\n+      - action: docker-stack-rm-all\n+      - action: docker-logout\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+      - action: remove-docker-registry-cert\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+      - action: docker-swarm-leave\n+        args:\n+          force: true\n+\n+  worker:\n+    join:\n+      - action: run-workflow\n+        args:\n+          workflow: [registry, swarm]\n+          actions:\n+            - name: registry\n+              action: set-environment-variables\n+              title: \"Registry\"\n+              skip_if_set: true\n+              prompts:\n+                REGISTRY_DOMAIN:\n+                  text: \"Registry domain (must match the manager's — run `cat .env` on the manager to check)\"\n+                  required: true\n+                REGISTRY_USERNAME:\n+                  text: \"Registry username (must match the manager's — run `cat .env` on the manager to check)\"\n+                  required: true\n+                REGISTRY_PASSWORD:\n+                  text: \"Registry password (must match the manager's — run `cat .env` on the manager to check)\"\n+                  required: true\n+                  hide_input: true\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    REGISTRY_DOMAIN: \"prompts[REGISTRY_DOMAIN]\"\n+                    REGISTRY_USERNAME: \"prompts[REGISTRY_USERNAME]\"\n+                    REGISTRY_PASSWORD: \"prompts[REGISTRY_PASSWORD]\"\n+            - name: swarm\n+              action: set-environment-variables\n+              title: \"Docker Swarm Join\"\n+              skip_if_set: true\n+              prompts:\n+                DOCKER_SWARM_MANAGER_ADDRESS:\n+                  text: \"Manager address (host:port, e.g. 10.0.0.1:2377)\"\n+                  required: true\n+                DOCKER_SWARM_WORKER_JOIN_TOKEN:\n+                  text: \"Worker join token\"\n+                  required: true\n+                  hide_input: true\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    DOCKER_SWARM_MANAGER_ADDRESS: \"prompts[DOCKER_SWARM_MANAGER_ADDRESS]\"\n+                    DOCKER_SWARM_WORKER_JOIN_TOKEN: \"prompts[DOCKER_SWARM_WORKER_JOIN_TOKEN]\"\n+      - action: docker-swarm-join\n+        args:\n+          env_file: .env\n+          manager_address_var: DOCKER_SWARM_MANAGER_ADDRESS\n+          worker_join_token_var: DOCKER_SWARM_WORKER_JOIN_TOKEN\n+      - action: set-docker-registry-cert\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+          ca_cert_file: .ssl/ca.crt\n+      - action: docker-login\n+        args:\n+          env_file: .env\n+          username_var: REGISTRY_USERNAME\n+          password_var: REGISTRY_PASSWORD\n+          domain_var: REGISTRY_DOMAIN\n+\n+    leave:\n+      - action: docker-logout\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+      - action: remove-docker-registry-cert\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+      - action: docker-swarm-leave\n+\n+    configure:\n+      - action: run-workflow\n+        args:\n+          workflow: [registry, swarm]\n+          actions:\n+            - name: registry\n+              action: set-environment-variables\n+              title: \"Registry\"\n+              prompts:\n+                REGISTRY_DOMAIN:\n+                  text: \"Registry domain (must match the manager's — run `cat .env` on the manager to check)\"\n+                  required: true\n+                REGISTRY_USERNAME:\n+                  text: \"Registry username (must match the manager's — run `cat .env` on the manager to check)\"\n+                  required: true\n+                REGISTRY_PASSWORD:\n+                  text: \"Registry password (must match the manager's — run `cat .env` on the manager to check)\"\n+                  required: true\n+                  hide_input: true\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    REGISTRY_DOMAIN: \"prompts[REGISTRY_DOMAIN]\"\n+                    REGISTRY_USERNAME: \"prompts[REGISTRY_USERNAME]\"\n+                    REGISTRY_PASSWORD: \"prompts[REGISTRY_PASSWORD]\"\n+            - name: swarm\n+              action: set-environment-variables\n+              title: \"Docker Swarm Join\"\n+              prompts:\n+                DOCKER_SWARM_MANAGER_ADDRESS:\n+                  text: \"Manager address (host:port, e.g. 10.0.0.1:2377)\"\n+                  required: true\n+                DOCKER_SWARM_WORKER_JOIN_TOKEN:\n+                  text: \"Worker join token\"\n+                  required: true\n+                  hide_input: true\n+              targets:\n+                - file_path: .env\n+                  values:\n+                    DOCKER_SWARM_MANAGER_ADDRESS: \"prompts[DOCKER_SWARM_MANAGER_ADDRESS]\"\n+                    DOCKER_SWARM_WORKER_JOIN_TOKEN: \"prompts[DOCKER_SWARM_WORKER_JOIN_TOKEN]\"\n+      - action: docker-swarm-join\n+        args:\n+          env_file: .env\n+          manager_address_var: DOCKER_SWARM_MANAGER_ADDRESS\n+          worker_join_token_var: DOCKER_SWARM_WORKER_JOIN_TOKEN\n+      - action: set-docker-registry-cert\n+        args:\n+          env_file: .env\n+          domain_var: REGISTRY_DOMAIN\n+          ca_cert_file: .ssl/ca.crt\n+      - action: docker-login\n+        args:\n+          env_file: .env\n+          username_var: REGISTRY_USERNAME\n+          password_var: REGISTRY_PASSWORD\n+          domain_var: REGISTRY_DOMAIN"},{"sha":"08e3cf6c0d14d45bfacd393d45a0ecd93123a532","filename":"on-premise/forge/wps/docker-swarm/wps/proxy/.env","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2F.env","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2F.env","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2F.env?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1 @@\n+TRAEFIK_IMAGE=traefik:v3.7.8"},{"sha":"e9e792f2c75440f58913abd000934e96e4c575f0","filename":"on-premise/forge/wps/docker-swarm/wps/proxy/entrypoint.sh","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fentrypoint.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fentrypoint.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fentrypoint.sh?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,19 @@\n+#!/bin/sh\n+set -eu\n+\n+DYNAMIC_DIR=/etc/traefik/dynamic\n+mkdir -p \"$DYNAMIC_DIR\"\n+\n+{\n+  echo \"tls:\"\n+  echo \"  certificates:\"\n+  for crt in /ssl/*.crt; do\n+    [ -e \"$crt\" ] || continue\n+    key=\"${crt%.crt}.key\"\n+    [ -e \"$key\" ] || continue\n+    echo \"    - certFile: $crt\"\n+    echo \"      keyFile: $key\"\n+  done\n+} > \"$DYNAMIC_DIR/tls.yml\"\n+\n+exec traefik \"$@\""},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"on-premise/forge/wps/docker-swarm/wps/proxy/images/.gitkeep","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fimages%2F.gitkeep","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fimages%2F.gitkeep","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fimages%2F.gitkeep?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e"},{"sha":"8f10aed3e4865ab922e89f61b9233524f6059704","filename":"on-premise/forge/wps/docker-swarm/wps/proxy/stack.yaml","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fstack.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fstack.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fproxy%2Fstack.yaml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,32 @@\n+networks:\n+  proxy:\n+    name: proxy\n+    driver: overlay\n+    attachable: true\n+\n+services:\n+  traefik:\n+    image: ${TRAEFIK_IMAGE}\n+    entrypoint: [\"/entrypoint.sh\"]\n+    command:\n+      - --providers.swarm.endpoint=unix:///var/run/docker.sock\n+      - --providers.swarm.exposedByDefault=false\n+      - --providers.swarm.network=proxy\n+      - --providers.swarm.refreshSeconds=1\n+      - --entrypoints.websecure.address=:443\n+      - --providers.file.directory=/etc/traefik/dynamic\n+      - --providers.file.watch=true\n+    ports:\n+      - target: 443\n+        published: 443\n+        mode: host\n+    networks:\n+      - proxy\n+    volumes:\n+      - /var/run/docker.sock:/var/run/docker.sock:ro\n+      - ../.ssl:/ssl:ro\n+      - ./entrypoint.sh:/entrypoint.sh:ro\n+    deploy:\n+      placement:\n+        constraints:\n+          - node.role == manager"},{"sha":"6f7d96d7b80bb975d2e1f7acd735a0e141ed3717","filename":"on-premise/forge/wps/docker-swarm/wps/registry/.env","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2F.env","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2F.env","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2F.env?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,2 @@\n+REGISTRY_IMAGE=registry:3.1.1\n+REGISTRY_DOMAIN=$REGISTRY_DOMAIN"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"on-premise/forge/wps/docker-swarm/wps/registry/images/.gitkeep","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2Fimages%2F.gitkeep","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2Fimages%2F.gitkeep","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2Fimages%2F.gitkeep?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e"},{"sha":"ad0aa94de1f493a38ec010ac72f4230b91382c12","filename":"on-premise/forge/wps/docker-swarm/wps/registry/stack.yaml","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2Fstack.yaml","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2Fstack.yaml","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fdocker-swarm%2Fwps%2Fregistry%2Fstack.yaml?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -0,0 +1,36 @@\n+volumes:\n+  registry_data:\n+\n+networks:\n+  proxy:\n+    external: true\n+\n+secrets:\n+  registry_htpasswd:\n+    external: true\n+    name: ${REGISTRY_HTPASSWD_SECRET_NAME}\n+\n+services:\n+  registry:\n+    image: ${REGISTRY_IMAGE}\n+    networks:\n+      - proxy\n+    volumes:\n+      - registry_data:/var/lib/registry\n+    secrets:\n+      - source: registry_htpasswd\n+        target: /auth/htpasswd\n+    environment:\n+      REGISTRY_AUTH: htpasswd\n+      REGISTRY_AUTH_HTPASSWD_REALM: Registry\n+      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd\n+    deploy:\n+      placement:\n+        constraints:\n+          - node.role == manager\n+      labels:\n+        - \"traefik.enable=true\"\n+        - \"traefik.http.routers.registry.rule=Host(`${REGISTRY_DOMAIN}`)\"\n+        - \"traefik.http.routers.registry.entrypoints=websecure\"\n+        - \"traefik.http.routers.registry.tls=true\"\n+        - \"traefik.http.services.registry.loadbalancer.server.port=5000\""},{"sha":"641342594f436fcfaf14487f7bace5ca79cfe359","filename":"on-premise/forge/wps/glchat/build.sh","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fglchat%2Fbuild.sh","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/on-premise%2Fforge%2Fwps%2Fglchat%2Fbuild.sh","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/on-premise%2Fforge%2Fwps%2Fglchat%2Fbuild.sh?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -93,8 +93,8 @@ package_build_directory() {\n build_datasaur_cli() {\n   cd ../../../..\n \n-  ./datasaur-cli/datasaur-cli/build.sh\n-  cp ./datasaur-cli/datasaur-cli/dist/datasaur-cli on-premise/forge/wps/glchat/$PREBUILD_DIR\n+  ./on-premise/datasaur-cli/build.sh\n+  cp ./on-premise/datasaur-cli/dist/datasaur-cli on-premise/forge/wps/glchat/$PREBUILD_DIR\n \n   cd on-premise/forge/wps/glchat\n }"},{"sha":"9aadbd4fa97567a18a0a051f0663530e1ba8cd8a","filename":"vulcan.code-workspace","status":"modified","additions":22,"deletions":25,"changes":47,"blob_url":"https://github.com/vulcan-ai/vulcan/blob/dfdf02182e290567d1133940cd8dfebedf9d0e2e/vulcan.code-workspace","raw_url":"https://github.com/vulcan-ai/vulcan/raw/dfdf02182e290567d1133940cd8dfebedf9d0e2e/vulcan.code-workspace","contents_url":"https://api.github.com/repos/vulcan-ai/vulcan/contents/vulcan.code-workspace?ref=dfdf02182e290567d1133940cd8dfebedf9d0e2e","patch":"@@ -1,56 +1,53 @@\n {\n   \"folders\": [\n     {\n-      \"path\": \".\"\n+      \"path\": \".\",\n     },\n     {\n-      \"path\": \"audiowaveform-generator\"\n+      \"path\": \"audiowaveform-generator\",\n     },\n     {\n-      \"path\": \"automation-test\"\n+      \"path\": \"automation-test\",\n     },\n     {\n-      \"path\": \"forestadmin\"\n+      \"path\": \"forestadmin\",\n     },\n     {\n-      \"path\": \"frontend-build-tools\"\n+      \"path\": \"frontend-build-tools\",\n     },\n     {\n-      \"path\": \"frontend-shared\"\n+      \"path\": \"frontend-shared\",\n     },\n     {\n-      \"path\": \"vulcan-frontend\"\n+      \"path\": \"vulcan-frontend\",\n     },\n     {\n-      \"path\": \"llm-lab-frontend\"\n+      \"path\": \"llm-lab-frontend\",\n     },\n     {\n-      \"path\": \"forge/wps/wps-frontend\"\n+      \"path\": \"forge/wps/wps-frontend\",\n     },\n     {\n-      \"path\": \"llm-labs-python\"\n+      \"path\": \"llm-labs-python\",\n     },\n     {\n-      \"path\": \"vulcan-backend\"\n+      \"path\": \"vulcan-backend\",\n     },\n     {\n-      \"path\": \"vulcan-common\"\n+      \"path\": \"vulcan-common\",\n     },\n     {\n-      \"path\": \"datasaur-cli\"\n+      \"path\": \"on-premise\",\n     },\n     {\n-      \"path\": \"on-premise\"\n+      \"path\": \"infra\",\n     },\n     {\n-      \"path\": \"infra\"\n+      \"path\": \"datasaur-ui\",\n     },\n     {\n-      \"path\": \"datasaur-ui\"\n+      \"path\": \"forge/wps/wps-agent-frontend\",\n     },\n-    {\n-      \"path\": \"forge/wps/wps-agent-frontend\"\n-    }\n   ],\n   \"extensions\": {\n     \"recommendations\": [\n@@ -59,8 +56,8 @@\n       \"sonarsource.sonarlint-vscode\",\n       \"kumar-harsh.graphql-for-vscode\",\n       \"mikestead.dotenv\",\n-      \"yzhang.markdown-all-in-one\"\n-    ]\n+      \"yzhang.markdown-all-in-one\",\n+    ],\n   },\n   \"settings\": {\n     \"editor.tabSize\": 2,\n@@ -71,12 +68,12 @@\n     \"editor.defaultFormatter\": \"esbenp.prettier-vscode\",\n     \"[typescript]\": {\n       \"editor.formatOnSave\": true,\n-      \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n+      \"editor.defaultFormatter\": \"esbenp.prettier-vscode\",\n     },\n     \"eslint.validate\": [\"javascript\", \"typescript\"],\n     \"markdown.extension.toc.levels\": \"2..6\",\n     \"editor.codeActionsOnSave\": {\n-      \"source.organizeImports\": \"explicit\"\n-    }\n-  }\n+      \"source.organizeImports\": \"explicit\",\n+    },\n+  },\n }"}]