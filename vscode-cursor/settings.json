{
  "window.commandCenter": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "editor.minimap.enabled": false,
  "vim.useSystemClipboard": true,
  "window.titleBarStyle": "custom",
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "editor.formatOnSave": true,
  "chat.editor.fontSize": 14,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "editor.letterSpacing": 0.15,
  "editor.lineHeight": 1.20,
  "editor.fontSize": 16,
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",
  "editor.fontLigatures": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<C-n>"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.showHover"
      ],
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
      "before": [
        "<leader>",
        "c",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
    {
      "before": [
        "[",
        "d"
      ],
      "commands": [
        "editor.action.marker.next"
      ]
    },
    {
      "before": [
        "]",
        "d"
      ],
      "commands": [
        "editor.action.marker.prev"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    {
      "before": [
        "g",
        "i"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ]
    },
    {
      "before": [
        "g",
        "R"
      ],
      "commands": [
        "references-view.findReferences"
      ]
    },
    {
      "before": [
        "g",
        "I"
      ],
      "commands": [
        "references-view.findImplementations"
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.view.explorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "w"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "r",
        "n"
      ],
      "commands": [
        "editor.action.rename"
      ]
    },
    {
      "before": [
        "<leader>",
        "h"
      ],
      "commands": [
        ":nohl"
      ]
    }
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-b>": false
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "typescript.tsserver.maxTsServerMemory": 6144,
  "githubPullRequests.pullBranch": "never",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[handlebars]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "remote.SSH.remotePlatform": {
    "billy@localhost": "linux",
    "datasaur-billy": "linux"
  },
  "workbench.iconTheme": "catppuccin-mocha",
  "remote.autoForwardPortsSource": "hybrid",
  "json.schemaDownload.enable": true,
  "[json]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "files.watcherExclude": {
    "**/.bloop": true,
    "**/.metals": true
  },
  "rubyLsp.rubyVersionManager": {
    "identifier": "mise"
  },
  "workbench.colorTheme": "Catppuccin Mocha",
  "typescript.updateImportsOnFileMove.enabled": "always"
}
