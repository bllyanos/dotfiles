{
  "window.commandCenter": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "editor.minimap.enabled": false,
  "vim.useSystemClipboard": true,
  "window.titleBarStyle": "custom",
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "chat.editor.fontSize": 14,
  "terminal.integrated.fontSize": 14,
  "editor.letterSpacing": 0.2,
  "editor.lineHeight": 1.45,
  "editor.fontSize": 13.5,
  "editor.fontWeight": 600,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.fontLigatures": true,
  "elixirLS.suggestSpecs": false,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.showHover"],
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.quickFix"]
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.next"]
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.prev"]
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"]
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["g", "R"],
      "commands": ["references-view.findReferences"]
    },
    {
      "before": ["g", "I"],
      "commands": ["references-view.findImplementations"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.view.explorer"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "w"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["<leader>", "r", "n"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": ["<leader>", "h"],
      "commands": [":nohl"]
    }
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-b>": false
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "typescript.tsserver.maxTsServerMemory": 6144,
  "githubPullRequests.pullBranch": "never",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[handlebars]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "remote.SSH.remotePlatform": {
    "billy@localhost": "linux",
    "datasaur-billy": "linux"
  },
  "cursor.cpp.disabledLanguages": [],
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "remote.autoForwardPortsSource": "hybrid",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.colorTheme": "Cursor Dark Midnight",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cursor.composer.usageSummaryDisplay": "always",
  "elixirLS.mcpEnabled": true,
  "workbench.iconTheme": "se98"
}
